import OAI.AlgebraicTopology.Kunneth.AcyclicModelsF
import OAI.AlgebraicTopology.Kunneth.TensorHomologyD
import OAI.AlgebraicTopology.Cohomology.Singular.ChainDual
import OAI.AlgebraicGeometry.CycleClass.Geometric.SimplexFillings
import Mathlib.Topology.Category.TopCat.Limits.Products

/-! # Product Models As -/

namespace OAI.AlgebraicTopology.Kunneth.ProductModelsAs

noncomputable section

/-! The genuine simplex models for Kunneth's product-chain comparison. -/

set_option backward.isDefEq.respectTransparency false

open _root_.CategoryTheory _root_.CategoryTheory.Limits _root_.CategoryTheory.MonoidalCategory
open _root_.AlgebraicTopology OAI.AlgebraicTopology.Cohomology.Singular.ChainDual
open scoped Simplicial TensorProduct

namespace Construction.ProductModels

abbrev SpacePair := TopCat.{0} × TopCat.{0}

def productSpace : SpacePair ⥤ TopCat.{0} where
  obj X := TopCat.of (X.1 × X.2)
  map f := TopCat.ofHom
    ⟨fun x => (f.1 x.1, f.2 x.2),
      (f.1.hom.continuous.comp continuous_fst).prodMk
        (f.2.hom.continuous.comp continuous_snd)⟩
  map_id X := by ext x <;> rfl
  map_comp f g := by ext x <;> rfl

variable (k : Type) [Field k]

abbrev scalarChains : TopCat.{0} ⥤ ChainComplex (ModuleCat.{0} k) ℕ :=
  (singularChainComplexFunctor (ModuleCat.{0} k)).obj (ModuleCat.of k k)

abbrev productChainFunctor : SpacePair ⥤ ChainComplex (ModuleCat.{0} k) ℕ :=
  productSpace ⋙ scalarChains k

def tensorChainFunctor : SpacePair ⥤ ChainComplex (ModuleCat.{0} k) ℕ :=
  ((scalarChains k).prod (scalarChains k)) ⋙ tensor (ChainComplex (ModuleCat.{0} k) ℕ)

/-- Regard a functor of complexes as a complex in the functor category. -/
def asComplex (F : SpacePair ⥤ ChainComplex (ModuleCat.{0} k) ℕ) :
    ChainComplex (SpacePair ⥤ ModuleCat.{0} k) ℕ where
  X n := F ⋙ HomologicalComplex.eval _ _ n
  d i j :=
    { app X := (F.obj X).d i j
      naturality _ _ f := (F.map f).comm i j }
  shape i j hij := by
    apply NatTrans.ext
    funext X
    exact (F.obj X).shape i j hij
  d_comp_d' i j l _ _ := by
    apply NatTrans.ext
    funext X
    exact (F.obj X).d_comp_d i j l

abbrev productChains := asComplex k (productChainFunctor k)
abbrev tensorChains := asComplex k (tensorChainFunctor k)

def simplexModel (p q : ℕ) : SpacePair :=
  (SimplexCategory.toTop.obj ⦋p⦌, SimplexCategory.toTop.obj ⦋q⦌)

/-- A singular simplex in a product is a pair of singular simplices. -/
def productSimplexEquiv (n : ℕ) (X : SpacePair) :
    (TopCat.toSSet.obj (productSpace.obj X)) _⦋n⦌ ≃ (simplexModel n n ⟶ X) where
  toFun s := (s.down ≫ TopCat.prodFst, s.down ≫ TopCat.prodSnd)
  invFun f := ULift.up (TopCat.ofHom
    ⟨fun t => (f.1 t, f.2 t), f.1.hom.continuous.prodMk f.2.hom.continuous⟩)
  left_inv s := by
    apply ULift.ext
    apply TopCat.ext
    intro t
    rfl
  right_inv f := by
    apply Prod.ext
    · apply TopCat.ext
      intro t
      rfl
    · apply TopCat.ext
      intro t
      rfl

/-- Identify the free module on product simplices with the representable
 functor generated by the pair of universal simplices. -/
def productDegreeFreeIso (n : ℕ) (X : SpacePair) :
    (AcyclicModelsF.Construction.AcyclicModels.FreeModel (k := k) (simplexModel n n)).obj X ≅
      ((productChainFunctor k).obj X).X n where
  hom := Sigma.desc (fun f : simplexModel n n ⟶ X =>
    (TopCat.toSSet.obj (productSpace.obj X)).ιChainComplex
      (R := ModuleCat.of k k) ((productSimplexEquiv n X).symm f))
  inv := Sigma.desc (fun s : (TopCat.toSSet.obj (productSpace.obj X)) _⦋n⦌ =>
    Sigma.ι (fun _ : simplexModel n n ⟶ X => ModuleCat.of k k)
      (productSimplexEquiv n X s))
  hom_inv_id := by
    apply Sigma.hom_ext
    intro f
    simp only [Sigma.ι_comp_desc_assoc, SSet.ιChainComplex,
      Sigma.ι_comp_desc, Equiv.apply_symm_apply]
    exact (Category.comp_id _).symm
  inv_hom_id := by
    apply SSet.chainComplex_hom_ext
    intro s
    simp only [SSet.ιChainComplex, Sigma.ι_comp_desc_assoc, Sigma.ι_comp_desc,
      Equiv.symm_apply_apply]
    exact (Category.comp_id _).symm

/-- The degreewise free-module identifications are natural in both spaces. -/
def productDegreeFreeNatIso (n : ℕ) :
    AcyclicModelsF.Construction.AcyclicModels.FreeModel (k := k) (simplexModel n n) ≅ (productChains k).X n :=
  NatIso.ofComponents (productDegreeFreeIso k n) (by
    intro X Y f
    apply Sigma.hom_ext
    intro s
    dsimp only [AcyclicModelsF.Construction.AcyclicModels.FreeModel, evaluationLeftAdjoint,
      productDegreeFreeIso]
    erw [Sigma.ι_comp_desc_assoc, Sigma.ι_comp_desc, Sigma.ι_comp_desc_assoc]
    change (TopCat.toSSet.obj (productSpace.obj Y)).ιChainComplex
        (R := ModuleCat.of k k) ((productSimplexEquiv n Y).symm (s ≫ f)) =
      (TopCat.toSSet.obj (productSpace.obj X)).ιChainComplex
        (R := ModuleCat.of k k) ((productSimplexEquiv n X).symm s) ≫
          (SSet.chainComplexMap (TopCat.toSSet.map (productSpace.map f))
            (ModuleCat.of k k)).f n
    erw [SSet.ι_chainComplexMap_f]
    rfl)

def productPresentation (n : ℕ) : AcyclicModelsF.Construction.AcyclicModels.Presentation ((productChains k).X n) :=
  AcyclicModelsF.Construction.AcyclicModels.Presentation.ofSingle (simplexModel n n) (productDegreeFreeNatIso k n)

/-- Extend values on pairs of simplex generators to the tensor product. -/
def pairLinear (X Y : TopCat.{0}) (p q : ℕ) (M : ModuleCat.{0} k)
    (v : (TopCat.toSSet.obj X) _⦋p⦌ → (TopCat.toSSet.obj Y) _⦋q⦌ → M) :
    ((scalarChains k).obj X).X p ⊗[k] ((scalarChains k).obj Y).X q →ₗ[k] M :=
  TensorProduct.lift
    (Cohomology.Singular.ChainDual.chainFunctionalOfFunction (TopCat.toSSet.obj X)
      (ModuleCat.of k (((scalarChains k).obj Y).X q →ₗ[k] M)) p
      (fun s => Cohomology.Singular.ChainDual.chainFunctionalOfFunction (TopCat.toSSet.obj Y) M q (v s)))

@[simp]
theorem pairLinear_simplex (X Y : TopCat.{0}) (p q : ℕ) (M : ModuleCat.{0} k)
    (v : (TopCat.toSSet.obj X) _⦋p⦌ → (TopCat.toSSet.obj Y) _⦋q⦌ → M)
    (s : (TopCat.toSSet.obj X) _⦋p⦌) (t : (TopCat.toSSet.obj Y) _⦋q⦌) :
    pairLinear k X Y p q M v
      (Cohomology.Singular.ChainDual.simplexChain (R := k) (TopCat.toSSet.obj X) s ⊗ₜ[k]
        Cohomology.Singular.ChainDual.simplexChain (R := k) (TopCat.toSSet.obj Y) t) = v s t := by
  simp only [pairLinear, TensorProduct.lift.tmul]
  erw [Cohomology.Singular.ChainDual.chainFunctionalOfFunction_simplex, Cohomology.Singular.ChainDual.chainFunctionalOfFunction_simplex]

abbrev tensorBidegree (p q : ℕ) (X : SpacePair) : ModuleCat.{0} k :=
  ((scalarChains k).obj X.1).X p ⊗ ((scalarChains k).obj X.2).X q

def tensorFreeHom (p q : ℕ) (X : SpacePair) :
    (AcyclicModelsF.Construction.AcyclicModels.FreeModel (k := k) (simplexModel p q)).obj X ⟶
      tensorBidegree k p q X :=
  Sigma.desc (fun f : simplexModel p q ⟶ X => ModuleCat.ofHom
    (LinearMap.toSpanSingleton k _
      (Cohomology.Singular.ChainDual.simplexChain (R := k) (TopCat.toSSet.obj X.1) (ULift.up f.1) ⊗ₜ[k]
        Cohomology.Singular.ChainDual.simplexChain (R := k) (TopCat.toSSet.obj X.2) (ULift.up f.2))))

@[simp]
theorem tensorFreeHom_generator (p q : ℕ) (X : SpacePair)
    (f : simplexModel p q ⟶ X) :
    tensorFreeHom k p q X
      (Sigma.ι (fun _ : simplexModel p q ⟶ X => ModuleCat.of k k) f 1) =
      Cohomology.Singular.ChainDual.simplexChain (R := k) (TopCat.toSSet.obj X.1) (ULift.up f.1) ⊗ₜ[k]
        Cohomology.Singular.ChainDual.simplexChain (R := k) (TopCat.toSSet.obj X.2) (ULift.up f.2) := by
  have h := Sigma.ι_comp_desc (fun g : simplexModel p q ⟶ X => ModuleCat.ofHom
    (LinearMap.toSpanSingleton k _
      (Cohomology.Singular.ChainDual.simplexChain (R := k) (TopCat.toSSet.obj X.1) (ULift.up g.1) ⊗ₜ[k]
        Cohomology.Singular.ChainDual.simplexChain (R := k) (TopCat.toSSet.obj X.2) (ULift.up g.2)))) f
  exact (ConcreteCategory.congr_hom h 1).trans (LinearMap.toSpanSingleton_apply_one k _ _)

def tensorFreeInv (p q : ℕ) (X : SpacePair) :
    tensorBidegree k p q X ⟶
      (AcyclicModelsF.Construction.AcyclicModels.FreeModel (k := k) (simplexModel p q)).obj X :=
  ModuleCat.ofHom (pairLinear k X.1 X.2 p q
    ((AcyclicModelsF.Construction.AcyclicModels.FreeModel (k := k) (simplexModel p q)).obj X)
    (fun s t => Sigma.ι (fun _ : simplexModel p q ⟶ X => ModuleCat.of k k)
      (s.down, t.down) 1))

/-- A tensor of free simplex modules is freely represented by a pair of
 independently chosen standard simplices. -/
def tensorBidegreeFreeIso (p q : ℕ) (X : SpacePair) :
    (AcyclicModelsF.Construction.AcyclicModels.FreeModel (k := k) (simplexModel p q)).obj X ≅
      tensorBidegree k p q X where
  hom := tensorFreeHom k p q X
  inv := tensorFreeInv k p q X
  hom_inv_id := by
    apply Sigma.hom_ext
    intro f
    apply ModuleCat.hom_ext
    apply LinearMap.ext_ring
    change tensorFreeInv k p q X
      (tensorFreeHom k p q X
        (Sigma.ι (fun _ : simplexModel p q ⟶ X => ModuleCat.of k k) f 1)) = _
    rw [tensorFreeHom_generator]
    exact pairLinear_simplex k X.1 X.2 p q _ _ (ULift.up f.1) (ULift.up f.2)
  inv_hom_id := by
    apply ModuleCat.hom_ext
    apply TensorProduct.ext
    apply Cohomology.Singular.ChainDual.chainFunctional_ext (TopCat.toSSet.obj X.1)
      (ModuleCat.of k (((scalarChains k).obj X.2).X q →ₗ[k] tensorBidegree k p q X))
    intro s
    apply Cohomology.Singular.ChainDual.chainFunctional_ext (TopCat.toSSet.obj X.2) (tensorBidegree k p q X)
    intro t
    change tensorFreeHom k p q X
      (pairLinear k X.1 X.2 p q _ _
        (Cohomology.Singular.ChainDual.simplexChain (R := k) (TopCat.toSSet.obj X.1) s ⊗ₜ[k]
          Cohomology.Singular.ChainDual.simplexChain (R := k) (TopCat.toSSet.obj X.2) t)) = _
    rw [pairLinear_simplex, tensorFreeHom_generator]
    rfl

def tensorBidegreeFunctor (p q : ℕ) : SpacePair ⥤ ModuleCat.{0} k :=
  (((scalarChains k) ⋙ HomologicalComplex.eval _ _ p).prod
    ((scalarChains k) ⋙ HomologicalComplex.eval _ _ q)) ⋙ tensor (ModuleCat.{0} k)

@[simp]
theorem freeModel_map_generator (M X Y : SpacePair) (f : X ⟶ Y) (g : M ⟶ X) :
    (AcyclicModelsF.Construction.AcyclicModels.FreeModel (k := k) M).map f
      (Sigma.ι (fun _ : M ⟶ X => ModuleCat.of k k) g 1) =
        Sigma.ι (fun _ : M ⟶ Y => ModuleCat.of k k) (g ≫ f) 1 :=
  ConcreteCategory.congr_hom (Sigma.ι_comp_desc (fun h : M ⟶ X =>
    Sigma.ι (fun _ : M ⟶ Y => ModuleCat.of k k) (h ≫ f)) g) 1

@[simp]
theorem scalarChains_map_simplex {X Y : TopCat.{0}} (f : X ⟶ Y) (n : ℕ)
    (s : (TopCat.toSSet.obj X) _⦋n⦌) :
    ((scalarChains k).map f).f n (Cohomology.Singular.ChainDual.simplexChain (R := k) (TopCat.toSSet.obj X) s) =
      Cohomology.Singular.ChainDual.simplexChain (R := k) (TopCat.toSSet.obj Y) ((TopCat.toSSet.map f).app _ s) :=
  ConcreteCategory.congr_hom
    (SSet.ι_chainComplexMap_f (TopCat.toSSet.obj X) (TopCat.toSSet.obj Y)
      (TopCat.toSSet.map f) (ModuleCat.of k k) s) 1

def tensorBidegreeFreeNatIso (p q : ℕ) :
    AcyclicModelsF.Construction.AcyclicModels.FreeModel (k := k) (simplexModel p q) ≅ tensorBidegreeFunctor k p q :=
  NatIso.ofComponents (tensorBidegreeFreeIso k p q) (by
    intro X Y f
    apply Sigma.hom_ext
    intro g
    apply ModuleCat.hom_ext
    apply LinearMap.ext_ring
    change tensorFreeHom k p q Y
      ((AcyclicModelsF.Construction.AcyclicModels.FreeModel (k := k) (simplexModel p q)).map f
        (Sigma.ι (fun _ : simplexModel p q ⟶ X => ModuleCat.of k k) g 1)) =
      (tensorBidegreeFunctor k p q).map f
        (tensorFreeHom k p q X
          (Sigma.ι (fun _ : simplexModel p q ⟶ X => ModuleCat.of k k) g 1))
    rw [freeModel_map_generator, tensorFreeHom_generator, tensorFreeHom_generator]
    change _ = TensorProduct.map (((scalarChains k).map f.1).f p).hom
      (((scalarChains k).map f.2).f q).hom
      (Cohomology.Singular.ChainDual.simplexChain (R := k) (TopCat.toSSet.obj X.1) (ULift.up g.1) ⊗ₜ[k]
        Cohomology.Singular.ChainDual.simplexChain (R := k) (TopCat.toSSet.obj X.2) (ULift.up g.2))
    rw [TensorProduct.map_tmul, scalarChains_map_simplex, scalarChains_map_simplex]
    rfl)

/-- The native tensor-complex summand inclusions are natural in both spaces. -/
def tensorSummandInclusion (n p q : ℕ) (hpq : p + q = n) :
    tensorBidegreeFunctor k p q ⟶ (tensorChains k).X n where
  app X := HomologicalComplex.ιTensorObj
    ((scalarChains k).obj X.1) ((scalarChains k).obj X.2) p q n hpq
  naturality X Y f := by
    have h := HomologicalComplex.ι_mapBifunctorMap
      ((scalarChains k).map f.1) ((scalarChains k).map f.2)
      (curriedTensor (ModuleCat.{0} k)) (ComplexShape.down ℕ) p q n hpq
    change _ ≫ _ = _ ≫ (HomologicalComplex.tensorHom
      ((scalarChains k).map f.1) ((scalarChains k).map f.2)).f n
    rw [h]
    exact (congrArg (fun z => z ≫ HomologicalComplex.ιTensorObj
        ((scalarChains k).obj Y.1) ((scalarChains k).obj Y.2) p q n hpq)
        (tensorHom_def (((scalarChains k).map f.1).f p)
          (((scalarChains k).map f.2).f q))).trans (Category.assoc _ _ _)

abbrev tensorModelFamily (n : ℕ) (ij : TensorHomologyD.Construction.TensorHomology.DegreePairs n) :
    SpacePair ⥤ ModuleCat.{0} k :=
  AcyclicModelsF.Construction.AcyclicModels.FreeModel (k := k) (simplexModel ij.val.1 ij.val.2)

def tensorModelsHom (n : ℕ) :
    (∐ tensorModelFamily k n) ⟶ (tensorChains k).X n :=
  Sigma.desc (fun ij => (tensorBidegreeFreeNatIso k ij.val.1 ij.val.2).hom ≫
    tensorSummandInclusion k n ij.val.1 ij.val.2 ij.property)

def tensorModelsInvApp (n : ℕ) (X : SpacePair) :
    ((tensorChains k).X n).obj X ⟶ (∐ tensorModelFamily k n).obj X :=
  HomologicalComplex.mapBifunctorDesc (fun p q hpq =>
    (tensorBidegreeFreeIso k p q X).inv ≫
      (Sigma.ι (tensorModelFamily k n) ⟨(p, q), hpq⟩).app X)

@[reassoc (attr := simp)]
theorem generator_tensorModelsHom (n : ℕ) (ij : TensorHomologyD.Construction.TensorHomology.DegreePairs n)
    (X : SpacePair) :
    (Sigma.ι (tensorModelFamily k n) ij).app X ≫ (tensorModelsHom k n).app X =
      (tensorBidegreeFreeIso k ij.val.1 ij.val.2 X).hom ≫
        HomologicalComplex.ιTensorObj ((scalarChains k).obj X.1)
          ((scalarChains k).obj X.2) ij.val.1 ij.val.2 n ij.property :=
  NatTrans.congr_app (Sigma.ι_comp_desc (fun d : TensorHomologyD.Construction.TensorHomology.DegreePairs n =>
    (tensorBidegreeFreeNatIso k d.val.1 d.val.2).hom ≫
      tensorSummandInclusion k n d.val.1 d.val.2 d.property) ij) X

@[reassoc (attr := simp)]
theorem ι_tensorModelsInvApp (n p q : ℕ) (hpq : p + q = n) (X : SpacePair) :
    HomologicalComplex.ιTensorObj ((scalarChains k).obj X.1)
        ((scalarChains k).obj X.2) p q n hpq ≫ tensorModelsInvApp k n X =
      (tensorBidegreeFreeIso k p q X).inv ≫
        (Sigma.ι (tensorModelFamily k n) ⟨(p, q), hpq⟩).app X :=
  HomologicalComplex.ι_mapBifunctorDesc _ p q hpq

def tensorModelNatIso (n : ℕ) :
    (∐ tensorModelFamily k n) ≅ (tensorChains k).X n :=
  NatIso.ofComponents (fun X =>
    { hom := (tensorModelsHom k n).app X
      inv := tensorModelsInvApp k n X
      hom_inv_id := by
        apply colimit_obj_ext
        intro d
        change (Sigma.ι (tensorModelFamily k n) d.as).app X ≫
          (tensorModelsHom k n).app X ≫ tensorModelsInvApp k n X = _
        rw [← Category.assoc, generator_tensorModelsHom, Category.assoc,
          ι_tensorModelsInvApp, Iso.hom_inv_id_assoc]
        exact (Category.comp_id _).symm
      inv_hom_id := by
        apply HomologicalComplex.mapBifunctor.hom_ext
        intro p q hpq
        erw [← Category.assoc, ι_tensorModelsInvApp k n p q hpq X, Category.assoc,
          generator_tensorModelsHom, Iso.inv_hom_id_assoc]
        exact (Category.comp_id _).symm })
    (fun {X Y} f => (tensorModelsHom k n).naturality f)

/-- The degree-n tensor complex is free on pairs of simplices of total degree n. -/
def tensorPresentation (n : ℕ) : AcyclicModelsF.Construction.AcyclicModels.Presentation ((tensorChains k).X n) where
  Index := TensorHomologyD.Construction.TensorHomology.DegreePairs n
  model ij := simplexModel ij.val.1 ij.val.2
  iso := tensorModelNatIso k n

/-- Product singular chains are acyclic in positive degrees on every
 pair of standard-simplex models. -/
theorem product_model_positive_exact (p q n : ℕ) :
    (((productChains k).sc' (n + 2) (n + 1) n).map
      ((evaluation SpacePair (ModuleCat.{0} k)).obj (simplexModel p q))).Exact := by
  let : ContractibleSpace (SimplexCategory.toTop.{0}.obj ⦋p⦌) :=
    AlgebraicGeometry.CycleClass.Geometric.SimplexFillings.Cycles.toTopSimplex_contractible p
  let : ContractibleSpace (SimplexCategory.toTop.{0}.obj ⦋q⦌) :=
    AlgebraicGeometry.CycleClass.Geometric.SimplexFillings.Cycles.toTopSimplex_contractible q
  let X := productSpace.obj (simplexModel p q)
  let : ContractibleSpace X := inferInstanceAs
    (ContractibleSpace ((SimplexCategory.toTop.{0}.obj ⦋p⦌) ×
      (SimplexCategory.toTop.{0}.obj ⦋q⦌)))
  let C := (scalarChains k).obj X
  let : Subsingleton (C.homology (n + 1)) := ModuleCat.subsingleton_of_isZero
    (AlgebraicGeometry.CycleClass.Geometric.ContractibleModel.Cycles.isZero_singularHomology_of_contractible (ModuleCat.of k k) X
      (n + 1) (Nat.succ_ne_zero n))
  apply (ShortComplex.moduleCat_exact_iff _).mpr
  change ∀ c : C.X (n + 1), (C.d (n + 1) n) c = 0 →
    ∃ b : C.X (n + 2), (C.d (n + 2) (n + 1)) b = c
  intro c hc
  exact (Cohomology.Singular.ChainRepresentatives.chainClass_eq_zero_iff_exists C (n + 1)
    ⟨c, (Cohomology.Singular.ChainRepresentatives.mem_chainCycles_iff_succ C n c).mpr hc⟩).mp (Subsingleton.elim _ _)

/-- Tensor singular chains have the same model acyclicity, by the proved
 algebraic Künneth theorem. -/
theorem tensor_model_positive_exact (p q n : ℕ) :
    (((tensorChains k).sc' (n + 2) (n + 1) n).map
      ((evaluation SpacePair (ModuleCat.{0} k)).obj (simplexModel p q))).Exact := by
  let : ContractibleSpace (SimplexCategory.toTop.{0}.obj ⦋p⦌) :=
    AlgebraicGeometry.CycleClass.Geometric.SimplexFillings.Cycles.toTopSimplex_contractible p
  let : ContractibleSpace (SimplexCategory.toTop.{0}.obj ⦋q⦌) :=
    AlgebraicGeometry.CycleClass.Geometric.SimplexFillings.Cycles.toTopSimplex_contractible q
  let C := (scalarChains k).obj (SimplexCategory.toTop.{0}.obj ⦋p⦌)
  let D := (scalarChains k).obj (SimplexCategory.toTop.{0}.obj ⦋q⦌)
  let : Subsingleton ((C ⊗ D).homology (n + 1)) := ModuleCat.subsingleton_of_isZero
    (TensorHomologyD.Construction.TensorHomology.tensorHomology_isZero_of_positive C D
      (fun m hm => AlgebraicGeometry.CycleClass.Geometric.ContractibleModel.Cycles.isZero_singularHomology_of_contractible
        (ModuleCat.of k k) _ m hm)
      (fun m hm => AlgebraicGeometry.CycleClass.Geometric.ContractibleModel.Cycles.isZero_singularHomology_of_contractible
        (ModuleCat.of k k) _ m hm) (n + 1) (Nat.succ_ne_zero n))
  apply (ShortComplex.moduleCat_exact_iff _).mpr
  change ∀ c : (C ⊗ D).X (n + 1), ((C ⊗ D).d (n + 1) n) c = 0 →
    ∃ b : (C ⊗ D).X (n + 2), ((C ⊗ D).d (n + 2) (n + 1)) b = c
  intro c hc
  exact (Cohomology.Singular.ChainRepresentatives.chainClass_eq_zero_iff_exists (C ⊗ D) (n + 1)
    ⟨c, (Cohomology.Singular.ChainRepresentatives.mem_chainCycles_iff_succ (C ⊗ D) n c).mpr hc⟩).mp (Subsingleton.elim _ _)

def productNaturalHomotopy
    (f g : productChains k ⟶ productChains k) (h0 : f.f 0 = g.f 0) : Homotopy f g :=
  AcyclicModelsF.Construction.AcyclicModels.homotopy (productChains k) (productChains k)
    (productPresentation k) (fun n _ q => product_model_positive_exact k n n q) f g h0

def tensorNaturalHomotopy
    (f g : tensorChains k ⟶ tensorChains k) (h0 : f.f 0 = g.f 0) : Homotopy f g :=
  AcyclicModelsF.Construction.AcyclicModels.homotopy (tensorChains k) (tensorChains k)
    (tensorPresentation k)
    (fun _ i q => tensor_model_positive_exact k i.val.1 i.val.2 q) f g h0

end Construction.ProductModels

end

end OAI.AlgebraicTopology.Kunneth.ProductModelsAs
