import OAI.AlgebraicGeometry.CycleClass.Geometric.RationalSingularChains
import OAI.AlgebraicGeometry.CycleClass.Geometric.SmallSingularQuasiIso
import OAI.AlgebraicTopology.Duality.Poincare.ConnectingRepresentatives
import Mathlib.Algebra.Homology.HomologicalComplexBiprod

/-! # Rational Homology Mayer Vietoris -/

namespace OAI.AlgebraicTopology.Duality.Poincare.RationalHomologyMayerVietoris

noncomputable section

/-!
# Ordinary rational Mayer--Vietoris for an open cover

The actual simplicial pushout for binary-cover small singular simplices gives
the rational small-chain short exact sequence. Exact scalar extension from
the integers transports the already proved small-to-all quasi-isomorphism.
The resulting long exact sequence therefore concerns ordinary rational
singular homology. The inclusion signs are `(+,-)`, and the map to the union
adds the two inclusions.
-/

open _root_.CategoryTheory _root_.CategoryTheory.Limits

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

/-- The coefficient comparison on an arbitrary actual simplicial set. -/
def rationalSimplicialChainsIso (K : SSet.{0}) :
    (AlgebraicGeometry.CycleClass.Geometric.RationalScalarExtension.Cycles.rationalizeModules.mapHomologicalComplex (ComplexShape.down ℕ)).obj
        (Cohomology.Singular.ChainDual.simplicialScalarChains (R := ℤ) K) ≅
      Cohomology.Singular.ChainDual.simplicialScalarChains (R := ℚ) K :=
  AlgebraicGeometry.CycleClass.Geometric.RationalSingularChains.Cycles.coefficientFunctorChainsIso AlgebraicGeometry.CycleClass.Geometric.RationalScalarExtension.Cycles.rationalizeModules (ModuleCat.of ℤ ℤ) (ModuleCat.of ℚ ℚ)
    AlgebraicGeometry.CycleClass.Geometric.RationalScalarExtension.Cycles.rationalizeUnitIso K

/-- The coefficient comparison respects the actual map induced by a simplicial map. -/
@[reassoc]
theorem rationalSimplicialChainsIso_naturality {K L : SSet.{0}} (f : K ⟶ L) :
    (AlgebraicGeometry.CycleClass.Geometric.RationalScalarExtension.Cycles.rationalizeModules.mapHomologicalComplex (ComplexShape.down ℕ)).map
        (Cohomology.Singular.EvaluationNaturality.simplicialScalarChainMap (R := ℤ) f) ≫ (rationalSimplicialChainsIso L).hom =
      (rationalSimplicialChainsIso K).hom ≫ Cohomology.Singular.EvaluationNaturality.simplicialScalarChainMap (R := ℚ) f :=
  AlgebraicGeometry.CycleClass.Geometric.RationalSingularChains.Cycles.coefficientFunctorChainsIso_hom_naturality AlgebraicGeometry.CycleClass.Geometric.RationalScalarExtension.Cycles.rationalizeModules
    (ModuleCat.of ℤ ℤ) (ModuleCat.of ℚ ℚ) AlgebraicGeometry.CycleClass.Geometric.RationalScalarExtension.Cycles.rationalizeUnitIso f

/-- Exact scalar extension transports an integral simplicial-chain
quasi-isomorphism to the corresponding actual rational-chain map. -/
theorem rationalSimplicialChainMap_quasiIso {K L : SSet.{0}} (f : K ⟶ L)
    [QuasiIso (Cohomology.Singular.EvaluationNaturality.simplicialScalarChainMap (R := ℤ) f)] :
    QuasiIso (Cohomology.Singular.EvaluationNaturality.simplicialScalarChainMap (R := ℚ) f) := by
  have h : QuasiIso
      ((AlgebraicGeometry.CycleClass.Geometric.RationalScalarExtension.Cycles.rationalizeModules.mapHomologicalComplex (ComplexShape.down ℕ)).map
        (Cohomology.Singular.EvaluationNaturality.simplicialScalarChainMap (R := ℤ) f)) := inferInstance
  exact (quasiIso_iff_of_arrow_mk_iso _ _
    (Arrow.isoMk (rationalSimplicialChainsIso K) (rationalSimplicialChainsIso L)
      (rationalSimplicialChainsIso_naturality f).symm)).mp h

/-- Genuine rational chains generated by the binary-cover small simplices. -/
abbrev binarySmallRationalChains (X : TopCat.{0}) (U V : Set X) :
    ChainComplex (ModuleCat.{0} ℚ) ℕ :=
  Cohomology.Singular.ChainDual.simplicialScalarChains (R := ℚ) (AlgebraicGeometry.CycleClass.Geometric.SmallMayerVietoris.Cycles.binarySmallSingularSubcomplex X U V : SSet)

/-- The canonical inclusion of binary small rational chains into all rational chains. -/
abbrev binarySmallRationalChainInclusion (X : TopCat.{0}) (U V : Set X) :
    binarySmallRationalChains X U V ⟶ Cohomology.Singular.Evaluation.singularScalarChains (R := ℚ) X :=
  Cohomology.Singular.EvaluationNaturality.simplicialScalarChainMap (R := ℚ) (AlgebraicGeometry.CycleClass.Geometric.SmallMayerVietoris.Cycles.binarySmallSingularSubcomplex X U V).ι

/-- The rational small-chain square is the actual integral pushout transported
by exact coefficient extension and its simplexwise comparison isomorphisms. -/
theorem binarySmallRationalChain_isPushout (X : TopCat.{0}) (U V : Set X) :
    IsPushout
      (Cohomology.Singular.EvaluationNaturality.singularScalarChainMap (R := ℚ)
        (AlgebraicGeometry.CycleClass.Geometric.SmallMayerVietoris.Cycles.subsetInclusion X (Set.inter_subset_left : U ∩ V ⊆ U)))
      (Cohomology.Singular.EvaluationNaturality.singularScalarChainMap (R := ℚ)
        (AlgebraicGeometry.CycleClass.Geometric.SmallMayerVietoris.Cycles.subsetInclusion X (Set.inter_subset_right : U ∩ V ⊆ V)))
      (Cohomology.Singular.EvaluationNaturality.simplicialScalarChainMap (R := ℚ) (AlgebraicGeometry.CycleClass.Geometric.SmallMayerVietoris.Cycles.binarySmallSingularLeft X U V))
      (Cohomology.Singular.EvaluationNaturality.simplicialScalarChainMap (R := ℚ) (AlgebraicGeometry.CycleClass.Geometric.SmallMayerVietoris.Cycles.binarySmallSingularRight X U V)) := by
  let F := AlgebraicGeometry.CycleClass.Geometric.RationalScalarExtension.Cycles.rationalizeModules.mapHomologicalComplex (ComplexShape.down ℕ)
  have h := F.map_isPushout (AlgebraicGeometry.CycleClass.Geometric.SmallMayerVietoris.Cycles.binarySmallChain_isPushout X U V)
  exact h.of_iso
    (AlgebraicGeometry.CycleClass.Geometric.RationalSingularChains.Cycles.rationalSingularChainsIso (TopCat.of (U ∩ V : Set X)))
    (AlgebraicGeometry.CycleClass.Geometric.RationalSingularChains.Cycles.rationalSingularChainsIso (TopCat.of U))
    (AlgebraicGeometry.CycleClass.Geometric.RationalSingularChains.Cycles.rationalSingularChainsIso (TopCat.of V))
    (rationalSimplicialChainsIso (AlgebraicGeometry.CycleClass.Geometric.SmallMayerVietoris.Cycles.binarySmallSingularSubcomplex X U V : SSet))
    (AlgebraicGeometry.CycleClass.Geometric.RationalSingularChains.Cycles.rationalSingularChainsIso_hom_naturality
      (AlgebraicGeometry.CycleClass.Geometric.SmallMayerVietoris.Cycles.subsetInclusion X (Set.inter_subset_left : U ∩ V ⊆ U)))
    (AlgebraicGeometry.CycleClass.Geometric.RationalSingularChains.Cycles.rationalSingularChainsIso_hom_naturality
      (AlgebraicGeometry.CycleClass.Geometric.SmallMayerVietoris.Cycles.subsetInclusion X (Set.inter_subset_right : U ∩ V ⊆ V)))
    (rationalSimplicialChainsIso_naturality (AlgebraicGeometry.CycleClass.Geometric.SmallMayerVietoris.Cycles.binarySmallSingularLeft X U V))
    (rationalSimplicialChainsIso_naturality (AlgebraicGeometry.CycleClass.Geometric.SmallMayerVietoris.Cycles.binarySmallSingularRight X U V))

/-- The native rational chain sequence with first map `(+,-)` and second map sum. -/
def rationalSmallMayerVietorisSequence (X : TopCat.{0}) (U V : Set X) :
    ShortComplex (ChainComplex (ModuleCat.{0} ℚ) ℕ) :=
  (binarySmallRationalChain_isPushout X U V).shortComplex

@[simp]
theorem rationalSmallMayerVietorisSequence_f (X : TopCat.{0}) (U V : Set X) :
    (rationalSmallMayerVietorisSequence X U V).f =
      biprod.lift
        (Cohomology.Singular.EvaluationNaturality.singularScalarChainMap (R := ℚ)
          (AlgebraicGeometry.CycleClass.Geometric.SmallMayerVietoris.Cycles.subsetInclusion X (Set.inter_subset_left : U ∩ V ⊆ U)))
        (-Cohomology.Singular.EvaluationNaturality.singularScalarChainMap (R := ℚ)
          (AlgebraicGeometry.CycleClass.Geometric.SmallMayerVietoris.Cycles.subsetInclusion X (Set.inter_subset_right : U ∩ V ⊆ V))) := rfl

@[simp]
theorem rationalSmallMayerVietorisSequence_g (X : TopCat.{0}) (U V : Set X) :
    (rationalSmallMayerVietorisSequence X U V).g =
      biprod.desc
        (Cohomology.Singular.EvaluationNaturality.simplicialScalarChainMap (R := ℚ) (AlgebraicGeometry.CycleClass.Geometric.SmallMayerVietoris.Cycles.binarySmallSingularLeft X U V))
        (Cohomology.Singular.EvaluationNaturality.simplicialScalarChainMap (R := ℚ) (AlgebraicGeometry.CycleClass.Geometric.SmallMayerVietoris.Cycles.binarySmallSingularRight X U V)) := rfl

/-- This small-chain sequence is short exact without openness assumptions. -/
theorem rationalSmallMayerVietorisSequence_shortExact (X : TopCat.{0}) (U V : Set X) :
    (rationalSmallMayerVietorisSequence X U V).ShortExact := by
  have hm : Mono (Cohomology.Singular.EvaluationNaturality.singularScalarChainMap (R := ℚ)
      (AlgebraicGeometry.CycleClass.Geometric.SmallMayerVietoris.Cycles.subsetInclusion X (Set.inter_subset_left : U ∩ V ⊆ U))) := by
    change Mono ((AlgebraicGeometry.CycleClass.Geometric.RelativeScalarChains.Cycles.scalarSingularChainFunctor ℚ).map
      (AlgebraicGeometry.CycleClass.Geometric.SmallMayerVietoris.Cycles.subsetInclusion X (Set.inter_subset_left : U ∩ V ⊆ U)))
    exact Functor.map_mono (AlgebraicGeometry.CycleClass.Geometric.RelativeScalarChains.Cycles.scalarSingularChainFunctor ℚ) _
  have : Mono (rationalSmallMayerVietorisSequence X U V).f := by
    rw [rationalSmallMayerVietorisSequence_f]
    exact @mono_of_mono_fac _ _ _ _ _ _ _ _ hm (biprod.lift_fst _ _)
  have : Epi (rationalSmallMayerVietorisSequence X U V).g :=
    (binarySmallRationalChain_isPushout X U V).epi_shortComplex_g
  exact { exact := (binarySmallRationalChain_isPushout X U V).exact_shortComplex }

/-- Degreewise short exactness is available for actual cycle lifts. -/
theorem rationalSmallMayerVietorisSequence_degreewiseShortExact
    (X : TopCat.{0}) (U V : Set X) (n : ℕ) :
    ((rationalSmallMayerVietorisSequence X U V).map
      (HomologicalComplex.eval (ModuleCat.{0} ℚ) (ComplexShape.down ℕ) n)).ShortExact :=
  (HomologicalComplex.shortExact_iff_degreewise_shortExact _).mp
    (rationalSmallMayerVietorisSequence_shortExact X U V) n

/-- Rational small chains calculate ordinary rational homology for an actual open cover. -/
theorem binarySmallRationalChainInclusion_quasiIso (X : TopCat.{0}) (U V : Set X)
    (hU : IsOpen U) (hV : IsOpen V) (hcover : U ∪ V = Set.univ) :
    QuasiIso (binarySmallRationalChainInclusion X U V) := by
  have : QuasiIso (Cohomology.Singular.EvaluationNaturality.simplicialScalarChainMap (R := ℤ)
      (AlgebraicGeometry.CycleClass.Geometric.SmallMayerVietoris.Cycles.binarySmallSingularSubcomplex X U V).ι) := by
    change QuasiIso (AlgebraicGeometry.CycleClass.Geometric.SmallMayerVietoris.Cycles.integralSimplicialChainFunctor.map
      (AlgebraicGeometry.CycleClass.Geometric.SmallMayerVietoris.Cycles.binarySmallSingularSubcomplex X U V).ι)
    rw [← AlgebraicGeometry.CycleClass.Geometric.BinarySmallInclusion.Cycles.binarySmallIntegralChainInclusion_eq_canonical]
    exact AlgebraicGeometry.CycleClass.Geometric.SmallSingularQuasiIso.Cycles.binarySmallIntegralChainInclusion_quasiIso X U V hU hV hcover
  exact rationalSimplicialChainMap_quasiIso (AlgebraicGeometry.CycleClass.Geometric.SmallMayerVietoris.Cycles.binarySmallSingularSubcomplex X U V).ι

/-- The canonical small-to-all isomorphism on actual rational homology. -/
def binarySmallRationalHomologyIso (X : TopCat.{0}) (U V : Set X)
    (hU : IsOpen U) (hV : IsOpen V) (hcover : U ∪ V = Set.univ) (n : ℕ) :
    (binarySmallRationalChains X U V).homology n ≅
      (Cohomology.Singular.Evaluation.singularScalarChains (R := ℚ) X).homology n := by
  have := binarySmallRationalChainInclusion_quasiIso X U V hU hV hcover
  exact isoOfQuasiIsoAt (binarySmallRationalChainInclusion X U V) n

@[simp]
theorem binarySmallRationalHomologyIso_hom (X : TopCat.{0}) (U V : Set X)
    (hU : IsOpen U) (hV : IsOpen V) (hcover : U ∪ V = Set.univ) (n : ℕ) :
    (binarySmallRationalHomologyIso X U V hU hV hcover n).hom =
      HomologicalComplex.homologyMap (binarySmallRationalChainInclusion X U V) n := rfl

/-- The left small-chain map followed by inclusion is the true subspace chain map. -/
@[reassoc (attr := simp)]
theorem binarySmallRationalChainInclusion_left (X : TopCat.{0}) (U V : Set X) :
    Cohomology.Singular.EvaluationNaturality.simplicialScalarChainMap (R := ℚ) (AlgebraicGeometry.CycleClass.Geometric.SmallMayerVietoris.Cycles.binarySmallSingularLeft X U V) ≫
        binarySmallRationalChainInclusion X U V =
      Cohomology.Singular.EvaluationNaturality.singularScalarChainMap (R := ℚ) (AlgebraicGeometry.CycleClass.Geometric.LocalHomology.Cycles.subspaceInclusion X U) := by
  change ((SSet.chainComplexFunctor (ModuleCat.{0} ℚ)).obj (ModuleCat.of ℚ ℚ)).map _ ≫
    ((SSet.chainComplexFunctor (ModuleCat.{0} ℚ)).obj (ModuleCat.of ℚ ℚ)).map _ = _
  rw [← Functor.map_comp]
  congr 1

/-- The analogous identification for the right subspace. -/
@[reassoc (attr := simp)]
theorem binarySmallRationalChainInclusion_right (X : TopCat.{0}) (U V : Set X) :
    Cohomology.Singular.EvaluationNaturality.simplicialScalarChainMap (R := ℚ) (AlgebraicGeometry.CycleClass.Geometric.SmallMayerVietoris.Cycles.binarySmallSingularRight X U V) ≫
        binarySmallRationalChainInclusion X U V =
      Cohomology.Singular.EvaluationNaturality.singularScalarChainMap (R := ℚ) (AlgebraicGeometry.CycleClass.Geometric.LocalHomology.Cycles.subspaceInclusion X V) := by
  change ((SSet.chainComplexFunctor (ModuleCat.{0} ℚ)).obj (ModuleCat.of ℚ ℚ)).map _ ≫
    ((SSet.chainComplexFunctor (ModuleCat.{0} ℚ)).obj (ModuleCat.of ℚ ℚ)).map _ = _
  rw [← Functor.map_comp]
  congr 1

local instance rationalHomologyPreservesBinaryBiproducts (n : ℕ) :
    PreservesBinaryBiproducts
      (HomologicalComplex.homologyFunctor (ModuleCat.{0} ℚ) (ComplexShape.down ℕ) n) :=
  preservesBinaryBiproducts_of_preservesBiproducts _

/-- The middle small-chain homology is the canonical sum of the two ordinary homologies. -/
def rationalSmallMayerVietorisMiddleIso (X : TopCat.{0}) (U V : Set X) (n : ℕ) :
    (rationalSmallMayerVietorisSequence X U V).X₂.homology n ≅
      (Cohomology.Singular.Evaluation.singularScalarChains (R := ℚ) (TopCat.of U)).homology n ⊞
        (Cohomology.Singular.Evaluation.singularScalarChains (R := ℚ) (TopCat.of V)).homology n :=
  (HomologicalComplex.homologyFunctor (ModuleCat.{0} ℚ) (ComplexShape.down ℕ) n).mapBiprod _ _

/-- The first ordinary homology map, with signs `(+,-)` on the two inclusions. -/
def rationalMayerVietorisInclusion (X : TopCat.{0}) (U V : Set X) (n : ℕ) :
    (Cohomology.Singular.Evaluation.singularScalarChains (R := ℚ) (TopCat.of (U ∩ V : Set X))).homology n ⟶
      (Cohomology.Singular.Evaluation.singularScalarChains (R := ℚ) (TopCat.of U)).homology n ⊞
        (Cohomology.Singular.Evaluation.singularScalarChains (R := ℚ) (TopCat.of V)).homology n :=
  HomologicalComplex.homologyMap (rationalSmallMayerVietorisSequence X U V).f n ≫
    (rationalSmallMayerVietorisMiddleIso X U V n).hom

/-- The next ordinary homology map adds the images of the two subspaces. -/
def rationalMayerVietorisSum (X : TopCat.{0}) (U V : Set X) (n : ℕ) :
    (Cohomology.Singular.Evaluation.singularScalarChains (R := ℚ) (TopCat.of U)).homology n ⊞
        (Cohomology.Singular.Evaluation.singularScalarChains (R := ℚ) (TopCat.of V)).homology n ⟶
      (Cohomology.Singular.Evaluation.singularScalarChains (R := ℚ) X).homology n :=
  (rationalSmallMayerVietorisMiddleIso X U V n).inv ≫
    HomologicalComplex.homologyMap (rationalSmallMayerVietorisSequence X U V).g n ≫
      HomologicalComplex.homologyMap (binarySmallRationalChainInclusion X U V) n

/-- The first map is literally the pair of inclusion-induced homomorphisms. -/
theorem rationalMayerVietorisInclusion_formula (X : TopCat.{0}) (U V : Set X) (n : ℕ) :
    rationalMayerVietorisInclusion X U V n =
      biprod.lift
        (Cohomology.Singular.EvaluationNaturality.singularHomologyPushforward (R := ℚ)
          (AlgebraicGeometry.CycleClass.Geometric.SmallMayerVietoris.Cycles.subsetInclusion X (Set.inter_subset_left : U ∩ V ⊆ U)) n)
        (-Cohomology.Singular.EvaluationNaturality.singularHomologyPushforward (R := ℚ)
          (AlgebraicGeometry.CycleClass.Geometric.SmallMayerVietoris.Cycles.subsetInclusion X (Set.inter_subset_right : U ∩ V ⊆ V)) n) := by
  have hfst : (rationalSmallMayerVietorisMiddleIso X U V n).hom ≫ biprod.fst =
      HomologicalComplex.homologyMap
        (biprod.fst : Cohomology.Singular.Evaluation.singularScalarChains (R := ℚ) (TopCat.of U) ⊞
          Cohomology.Singular.Evaluation.singularScalarChains (R := ℚ) (TopCat.of V) ⟶ _) n :=
    biprod.lift_fst _ _
  have hsnd : (rationalSmallMayerVietorisMiddleIso X U V n).hom ≫ biprod.snd =
      HomologicalComplex.homologyMap
        (biprod.snd : Cohomology.Singular.Evaluation.singularScalarChains (R := ℚ) (TopCat.of U) ⊞
          Cohomology.Singular.Evaluation.singularScalarChains (R := ℚ) (TopCat.of V) ⟶ _) n :=
    biprod.lift_snd _ _
  apply biprod.hom_ext
  · simp only [rationalMayerVietorisInclusion, Category.assoc, hfst,
      ← HomologicalComplex.homologyMap_comp, rationalSmallMayerVietorisSequence_f,
      biprod.lift_fst]
  · simp only [rationalMayerVietorisInclusion, Category.assoc, hsnd,
      ← HomologicalComplex.homologyMap_comp, rationalSmallMayerVietorisSequence_f,
      biprod.lift_snd, HomologicalComplex.homologyMap_neg]

/-- The second map is literally the sum of the two ambient inclusion maps. -/
theorem rationalMayerVietorisSum_formula (X : TopCat.{0}) (U V : Set X) (n : ℕ) :
    rationalMayerVietorisSum X U V n =
      biprod.desc
        (Cohomology.Singular.EvaluationNaturality.singularHomologyPushforward (R := ℚ) (AlgebraicGeometry.CycleClass.Geometric.LocalHomology.Cycles.subspaceInclusion X U) n)
        (Cohomology.Singular.EvaluationNaturality.singularHomologyPushforward (R := ℚ) (AlgebraicGeometry.CycleClass.Geometric.LocalHomology.Cycles.subspaceInclusion X V) n) := by
  have hg : (rationalSmallMayerVietorisMiddleIso X U V n).inv ≫
      HomologicalComplex.homologyMap (rationalSmallMayerVietorisSequence X U V).g n =
      biprod.desc
        (HomologicalComplex.homologyMap
          (Cohomology.Singular.EvaluationNaturality.simplicialScalarChainMap (R := ℚ) (AlgebraicGeometry.CycleClass.Geometric.SmallMayerVietoris.Cycles.binarySmallSingularLeft X U V)) n)
        (HomologicalComplex.homologyMap
          (Cohomology.Singular.EvaluationNaturality.simplicialScalarChainMap (R := ℚ) (AlgebraicGeometry.CycleClass.Geometric.SmallMayerVietoris.Cycles.binarySmallSingularRight X U V)) n) :=
    biprod.mapBiprod_inv_map_desc
      (HomologicalComplex.homologyFunctor (ModuleCat.{0} ℚ) (ComplexShape.down ℕ) n)
      (Cohomology.Singular.Evaluation.singularScalarChains (R := ℚ) (TopCat.of U))
      (Cohomology.Singular.Evaluation.singularScalarChains (R := ℚ) (TopCat.of V)) _ _
  rw [rationalMayerVietorisSum, ← Category.assoc, hg]
  apply biprod.hom_ext'
  · simp only [biprod.inl_desc_assoc, biprod.inl_desc,
      ← HomologicalComplex.homologyMap_comp, binarySmallRationalChainInclusion_left]
  · simp only [biprod.inr_desc_assoc, biprod.inr_desc,
      ← HomologicalComplex.homologyMap_comp, binarySmallRationalChainInclusion_right]

/-- The ordinary rational Mayer--Vietoris boundary, transported from the
native short exact sequence along the proved small-to-all isomorphism. -/
def rationalMayerVietorisBoundary (X : TopCat.{0}) (U V : Set X)
    (hU : IsOpen U) (hV : IsOpen V) (hcover : U ∪ V = Set.univ) (n : ℕ) :
    (Cohomology.Singular.Evaluation.singularScalarChains (R := ℚ) X).homology (n + 1) ⟶
      (Cohomology.Singular.Evaluation.singularScalarChains (R := ℚ) (TopCat.of (U ∩ V : Set X))).homology n :=
  (binarySmallRationalHomologyIso X U V hU hV hcover (n + 1)).inv ≫
    (rationalSmallMayerVietorisSequence_shortExact X U V).δ (n + 1) n rfl

@[reassoc (attr := simp)]
theorem binarySmallRationalHomologyIso_boundary (X : TopCat.{0}) (U V : Set X)
    (hU : IsOpen U) (hV : IsOpen V) (hcover : U ∪ V = Set.univ) (n : ℕ) :
    (binarySmallRationalHomologyIso X U V hU hV hcover (n + 1)).hom ≫
        rationalMayerVietorisBoundary X U V hU hV hcover n =
      (rationalSmallMayerVietorisSequence_shortExact X U V).δ (n + 1) n rfl := by
  rw [rationalMayerVietorisBoundary, Iso.hom_inv_id_assoc]

@[reassoc (attr := simp)]
theorem rationalMayerVietorisInclusion_sum (X : TopCat.{0}) (U V : Set X) (n : ℕ) :
    rationalMayerVietorisInclusion X U V n ≫ rationalMayerVietorisSum X U V n = 0 := by
  simp only [rationalMayerVietorisInclusion, rationalMayerVietorisSum, Category.assoc,
    Iso.hom_inv_id_assoc]
  rw [← Category.assoc, ← HomologicalComplex.homologyMap_comp,
    (rationalSmallMayerVietorisSequence X U V).zero,
    HomologicalComplex.homologyMap_zero, zero_comp]

@[reassoc (attr := simp)]
theorem rationalMayerVietorisSum_boundary (X : TopCat.{0}) (U V : Set X)
    (hU : IsOpen U) (hV : IsOpen V) (hcover : U ∪ V = Set.univ) (n : ℕ) :
    rationalMayerVietorisSum X U V (n + 1) ≫
        rationalMayerVietorisBoundary X U V hU hV hcover n = 0 := by
  simp only [rationalMayerVietorisSum, rationalMayerVietorisBoundary, Category.assoc]
  rw [← binarySmallRationalHomologyIso_hom X U V hU hV hcover (n + 1),
    Iso.hom_inv_id_assoc,
    (rationalSmallMayerVietorisSequence_shortExact X U V).comp_δ (n + 1) n rfl,
    comp_zero]

@[reassoc (attr := simp)]
theorem rationalMayerVietorisBoundary_inclusion (X : TopCat.{0}) (U V : Set X)
    (hU : IsOpen U) (hV : IsOpen V) (hcover : U ∪ V = Set.univ) (n : ℕ) :
    rationalMayerVietorisBoundary X U V hU hV hcover n ≫
        rationalMayerVietorisInclusion X U V n = 0 := by
  simp only [rationalMayerVietorisBoundary, rationalMayerVietorisInclusion, Category.assoc]
  rw [← Category.assoc
      ((rationalSmallMayerVietorisSequence_shortExact X U V).δ (n + 1) n rfl),
    (rationalSmallMayerVietorisSequence_shortExact X U V).δ_comp (n + 1) n rfl,
    zero_comp, comp_zero]

/-- Exactness at the direct sum of ordinary rational homologies. -/
theorem rationalMayerVietoris_exact_middle (X : TopCat.{0}) (U V : Set X)
    (hU : IsOpen U) (hV : IsOpen V) (hcover : U ∪ V = Set.univ) (n : ℕ) :
    (ShortComplex.mk (rationalMayerVietorisInclusion X U V n)
      (rationalMayerVietorisSum X U V n) (rationalMayerVietorisInclusion_sum X U V n)).Exact := by
  let S := (rationalSmallMayerVietorisSequence X U V).map
    (HomologicalComplex.homologyFunctor (ModuleCat.{0} ℚ) (ComplexShape.down ℕ) n)
  have hS : S.Exact := (rationalSmallMayerVietorisSequence_shortExact X U V).homology_exact₂ n
  refine ShortComplex.exact_of_iso (S₁ := S) ?_ hS
  refine ShortComplex.isoMk (Iso.refl _) (rationalSmallMayerVietorisMiddleIso X U V n)
    (binarySmallRationalHomologyIso X U V hU hV hcover n) ?_ ?_
  · simp [S, rationalMayerVietorisInclusion]
  · simp [S, rationalMayerVietorisSum]

/-- Exactness at ordinary positive-degree rational homology of the covered space. -/
theorem rationalMayerVietoris_exact_ambient (X : TopCat.{0}) (U V : Set X)
    (hU : IsOpen U) (hV : IsOpen V) (hcover : U ∪ V = Set.univ) (n : ℕ) :
    (ShortComplex.mk (rationalMayerVietorisSum X U V (n + 1))
      (rationalMayerVietorisBoundary X U V hU hV hcover n)
      (rationalMayerVietorisSum_boundary X U V hU hV hcover n)).Exact := by
  let h := rationalSmallMayerVietorisSequence_shortExact X U V
  let S := ShortComplex.mk
    (HomologicalComplex.homologyMap (rationalSmallMayerVietorisSequence X U V).g (n + 1))
    (h.δ (n + 1) n rfl) (h.comp_δ (n + 1) n rfl)
  have hS : S.Exact := h.homology_exact₃ (n + 1) n rfl
  refine ShortComplex.exact_of_iso (S₁ := S) ?_ hS
  refine ShortComplex.isoMk (rationalSmallMayerVietorisMiddleIso X U V (n + 1))
    (binarySmallRationalHomologyIso X U V hU hV hcover (n + 1)) (Iso.refl _) ?_ ?_
  · simp [S, rationalMayerVietorisSum]
  · simp [S, rationalMayerVietorisBoundary, -binarySmallRationalHomologyIso_hom]

/-- Exactness at the ordinary rational homology of the intersection. -/
theorem rationalMayerVietoris_exact_intersection (X : TopCat.{0}) (U V : Set X)
    (hU : IsOpen U) (hV : IsOpen V) (hcover : U ∪ V = Set.univ) (n : ℕ) :
    (ShortComplex.mk (rationalMayerVietorisBoundary X U V hU hV hcover n)
      (rationalMayerVietorisInclusion X U V n)
      (rationalMayerVietorisBoundary_inclusion X U V hU hV hcover n)).Exact := by
  let h := rationalSmallMayerVietorisSequence_shortExact X U V
  let S := ShortComplex.mk (h.δ (n + 1) n rfl)
    (HomologicalComplex.homologyMap (rationalSmallMayerVietorisSequence X U V).f n)
    (h.δ_comp (n + 1) n rfl)
  have hS : S.Exact := h.homology_exact₁ (n + 1) n rfl
  refine ShortComplex.exact_of_iso (S₁ := S) ?_ hS
  refine ShortComplex.isoMk (binarySmallRationalHomologyIso X U V hU hV hcover (n + 1))
    (Iso.refl _) (rationalSmallMayerVietorisMiddleIso X U V n) ?_ ?_
  · simp [S, rationalMayerVietorisBoundary, -binarySmallRationalHomologyIso_hom]
  · simp [S, rationalMayerVietorisInclusion]

/-- Six consecutive terms, all expressed as ordinary rational singular homology. -/
def rationalMayerVietorisHomologySequence (X : TopCat.{0}) (U V : Set X)
    (hU : IsOpen U) (hV : IsOpen V) (hcover : U ∪ V = Set.univ) (n : ℕ) :
    ComposableArrows (ModuleCat.{0} ℚ) 5 :=
  ComposableArrows.mk₅ (rationalMayerVietorisInclusion X U V (n + 1))
    (rationalMayerVietorisSum X U V (n + 1))
    (rationalMayerVietorisBoundary X U V hU hV hcover n)
    (rationalMayerVietorisInclusion X U V n) (rationalMayerVietorisSum X U V n)

/-- The actual ordinary rational Mayer--Vietoris sequence is exact. -/
theorem rationalMayerVietorisHomologySequence_exact (X : TopCat.{0}) (U V : Set X)
    (hU : IsOpen U) (hV : IsOpen V) (hcover : U ∪ V = Set.univ) (n : ℕ) :
    (rationalMayerVietorisHomologySequence X U V hU hV hcover n).Exact :=
  ComposableArrows.exact_of_δ₀
    (rationalMayerVietoris_exact_middle X U V hU hV hcover (n + 1)).exact_toComposableArrows
    (ComposableArrows.exact_of_δ₀
      (rationalMayerVietoris_exact_ambient X U V hU hV hcover n).exact_toComposableArrows
      (ComposableArrows.exact_of_δ₀
        (rationalMayerVietoris_exact_intersection X U V hU hV hcover n).exact_toComposableArrows
        (rationalMayerVietoris_exact_middle X U V hU hV hcover n).exact_toComposableArrows))

/-- The ordinary Mayer--Vietoris sequence ends with a surjection onto degree zero. -/
theorem rationalMayerVietorisSum_zero_epi (X : TopCat.{0}) (U V : Set X)
    (hU : IsOpen U) (hV : IsOpen V) (hcover : U ∪ V = Set.univ) :
    Epi (rationalMayerVietorisSum X U V 0) := by
  have : Epi ((rationalSmallMayerVietorisSequence X U V).g.f 0) :=
    (rationalSmallMayerVietorisSequence_degreewiseShortExact X U V 0).epi_g
  have : Epi (HomologicalComplex.homologyMap
      (rationalSmallMayerVietorisSequence X U V).g 0) :=
    HomologicalComplex.epi_homologyMap_of_epi_of_not_rel _ _
      (fun j hj => Nat.succ_ne_zero j hj)
  have : IsIso (HomologicalComplex.homologyMap
      (binarySmallRationalChainInclusion X U V) 0) := by
    rw [← binarySmallRationalHomologyIso_hom X U V hU hV hcover 0]
    infer_instance
  dsimp only [rationalMayerVietorisSum]
  infer_instance

/-- Every ordinary rational degree-zero class is a sum of classes from the two opens. -/
theorem rationalMayerVietorisSum_zero_surjective (X : TopCat.{0}) (U V : Set X)
    (hU : IsOpen U) (hV : IsOpen V) (hcover : U ∪ V = Set.univ) :
    Function.Surjective (rationalMayerVietorisSum X U V 0) :=
  (ModuleCat.epi_iff_surjective _).mp
    (rationalMayerVietorisSum_zero_epi X U V hU hV hcover)

/-- The connecting map has the native lift/differentiate representative formula. -/
theorem rationalMayerVietorisBoundary_eq_of_lift (X : TopCat.{0}) (U V : Set X)
    (hU : IsOpen U) (hV : IsOpen V) (hcover : U ∪ V = Set.univ) (n : ℕ)
    (z : Cohomology.Singular.ChainRepresentatives.chainCycles (binarySmallRationalChains X U V) (n + 1))
    (b : (rationalSmallMayerVietorisSequence X U V).X₂.X (n + 1))
    (a : Cohomology.Singular.ChainRepresentatives.chainCycles (Cohomology.Singular.Evaluation.singularScalarChains (R := ℚ) (TopCat.of (U ∩ V : Set X))) n)
    (hb : (rationalSmallMayerVietorisSequence X U V).g.f (n + 1) b = z.val)
    (ha : (rationalSmallMayerVietorisSequence X U V).f.f n a.val =
      (rationalSmallMayerVietorisSequence X U V).X₂.d (n + 1) n b) :
    rationalMayerVietorisBoundary X U V hU hV hcover n
      (HomologicalComplex.homologyMap (binarySmallRationalChainInclusion X U V) (n + 1)
        (Cohomology.Singular.ChainRepresentatives.chainClass (binarySmallRationalChains X U V) (n + 1) z)) =
      Cohomology.Singular.ChainRepresentatives.chainClass (Cohomology.Singular.Evaluation.singularScalarChains (R := ℚ) (TopCat.of (U ∩ V : Set X))) n a := by
  change (rationalSmallMayerVietorisSequence_shortExact X U V).δ (n + 1) n rfl
    ((binarySmallRationalHomologyIso X U V hU hV hcover (n + 1)).inv
      ((binarySmallRationalHomologyIso X U V hU hV hcover (n + 1)).hom
        (Cohomology.Singular.ChainRepresentatives.chainClass (binarySmallRationalChains X U V) (n + 1) z))) = _
  rw [ModuleCat.inv_hom_apply]
  exact ConnectingRepresentatives.homologyConnecting_eq_of_lift (rationalSmallMayerVietorisSequence X U V)
    (rationalSmallMayerVietorisSequence_shortExact X U V) n z b a hb ha

/-- Every ordinary class admits actual small-chain and middle-chain lifts
which calculate its Mayer--Vietoris boundary. -/
theorem rationalMayerVietorisBoundary_representatives_exist (X : TopCat.{0}) (U V : Set X)
    (hU : IsOpen U) (hV : IsOpen V) (hcover : U ∪ V = Set.univ) (n : ℕ)
    (c : (Cohomology.Singular.Evaluation.singularScalarChains (R := ℚ) X).homology (n + 1)) :
    ∃ (z : Cohomology.Singular.ChainRepresentatives.chainCycles (binarySmallRationalChains X U V) (n + 1))
      (b : (rationalSmallMayerVietorisSequence X U V).X₂.X (n + 1))
      (a : Cohomology.Singular.ChainRepresentatives.chainCycles (Cohomology.Singular.Evaluation.singularScalarChains (R := ℚ) (TopCat.of (U ∩ V : Set X))) n),
      HomologicalComplex.homologyMap (binarySmallRationalChainInclusion X U V) (n + 1)
          (Cohomology.Singular.ChainRepresentatives.chainClass (binarySmallRationalChains X U V) (n + 1) z) = c ∧
      (rationalSmallMayerVietorisSequence X U V).g.f (n + 1) b = z.val ∧
      (rationalSmallMayerVietorisSequence X U V).f.f n a.val =
        (rationalSmallMayerVietorisSequence X U V).X₂.d (n + 1) n b ∧
      rationalMayerVietorisBoundary X U V hU hV hcover n c =
        Cohomology.Singular.ChainRepresentatives.chainClass (Cohomology.Singular.Evaluation.singularScalarChains (R := ℚ) (TopCat.of (U ∩ V : Set X))) n a := by
  let e := binarySmallRationalHomologyIso X U V hU hV hcover (n + 1)
  obtain ⟨z, hz⟩ := Cohomology.Singular.ChainRepresentatives.chainClass_surjective (binarySmallRationalChains X U V) (n + 1) (e.inv c)
  obtain ⟨b, a, hb, ha, hδ⟩ := ConnectingRepresentatives.homologyConnecting_representatives_exist
    (rationalSmallMayerVietorisSequence X U V)
    (rationalSmallMayerVietorisSequence_shortExact X U V) n z
  refine ⟨z, b, a, ?_, hb, ha, ?_⟩
  · change e.hom (Cohomology.Singular.ChainRepresentatives.chainClass (binarySmallRationalChains X U V) (n + 1) z) = c
    rw [hz, ModuleCat.hom_inv_apply]
  · change (rationalSmallMayerVietorisSequence_shortExact X U V).δ (n + 1) n rfl (e.inv c) = _
    rw [← hz]
    exact hδ

end

end OAI.AlgebraicTopology.Duality.Poincare.RationalHomologyMayerVietoris
