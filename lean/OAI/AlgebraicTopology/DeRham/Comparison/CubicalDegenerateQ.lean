import OAI.AlgebraicTopology.DeRham.Comparison.CubicalDegeneracyOperators
import Mathlib.LinearAlgebra.Finsupp.Defs
import Mathlib.LinearAlgebra.Quotient.Basic
import OAI.AlgebraicTopology.DeRham.Comparison.StokesF

/-! # Cubical Degenerate Q -/

namespace OAI.AlgebraicTopology.DeRham.Comparison.CubicalDegenerateQ

section

/-!
# The submodule of degenerate smooth cubical chains

This is the span of actual coordinate-degenerate smooth cubes in the free
integer module on smooth cubes. Its definition does not presuppose a boundary
operator or a comparison with singular homology.
-/

open OAI.AlgebraicTopology.DeRham.Comparison.StokesF.SingularCubeStokes

variable {n m : ℕ}

/-- The actual submodule generated by all degenerate cubes. -/
noncomputable def degenerateSubmodule (n m : ℕ) :
    Submodule ℤ (StokesF.SingularCubeStokes.SmoothSingularCube n m →₀ ℤ) :=
  Submodule.span ℤ ((fun σ : StokesF.SingularCubeStokes.SmoothSingularCube n m => Finsupp.single σ 1) ''
    {σ | CubicalDegeneracyOperators.IsDegenerateCube σ})

theorem single_mem_degenerateSubmodule (σ : StokesF.SingularCubeStokes.SmoothSingularCube n m)
    (hσ : CubicalDegeneracyOperators.IsDegenerateCube σ) : Finsupp.single σ 1 ∈ degenerateSubmodule n m :=
  Submodule.subset_span ⟨σ, hσ, rfl⟩

theorem single_coeff_mem_degenerateSubmodule (σ : StokesF.SingularCubeStokes.SmoothSingularCube n m)
    (hσ : CubicalDegeneracyOperators.IsDegenerateCube σ) (k : ℤ) :
    Finsupp.single σ k ∈ degenerateSubmodule n m := by
  simpa using (degenerateSubmodule n m).smul_mem k
    (single_mem_degenerateSubmodule σ hσ)

/-- In degree zero there are no degenerate cubes. -/
theorem degenerateSubmodule_zero (m : ℕ) : degenerateSubmodule 0 m = ⊥ := by
  apply le_antisymm _ bot_le
  apply Submodule.span_le.mpr
  rintro _ ⟨σ, hσ, rfl⟩
  exact (CubicalDegeneracyOperators.not_isDegenerate_zero_cube σ hσ).elim

/-- Smooth cubical chains modulo the degenerate submodule. -/
abbrev NormalizedCubicalChain (n m : ℕ) :=
  (StokesF.SingularCubeStokes.SmoothSingularCube n m →₀ ℤ) ⧸ degenerateSubmodule n m

end

section

/-!
# The normalized smooth cubical chain groups

These quotients kill precisely the submodules generated by cubes independent
of at least one coordinate. Such cubes are proved to be actual images of the
coordinate-deletion degeneracy operators. The ordinary cubical boundary
preserves this submodule and therefore descends to the quotient, still with
square zero. Identifying this complex with ordinary singular chains requires
a separate comparison theorem.
-/

open OAI.AlgebraicTopology.DeRham.Comparison.StokesF.SingularCubeStokes

variable {n m : ℕ}

/-- An independent coordinate can be deleted and reinserted without changing
the cube. This constructs the lower-dimensional smooth cube explicitly. -/
theorem cubeDegeneracy_face_eq_of_ignoresCoordinate
    (σ : StokesF.SingularCubeStokes.SmoothSingularCube (n + 1) m) (i : Fin (n + 1))
    (hσ : CubicalDegeneracyOperators.IgnoresCoordinate σ i) :
    CubicalDegeneracyOperators.cubeDegeneracy (StokesF.SingularCubeStokes.singularFace σ i 0) i = σ := by
  ext1
  funext x
  change σ (Fin.insertNth (α := fun _ => ℝ) i 0 (CubicalDegeneracyOperators.forgetCoordinate i x)) = σ x
  have hcoordinates :
      Fin.insertNth (α := fun _ => ℝ) i 0 (CubicalDegeneracyOperators.forgetCoordinate i x) = Function.update x i 0 := by
    funext j
    rcases Fin.eq_self_or_eq_succAbove i j with rfl | ⟨k, rfl⟩
    · simp
    · simp [CubicalDegeneracyOperators.forgetCoordinate_apply, Fin.succAbove_ne]
  exact (congrArg σ hcoordinates).trans (hσ x 0)

/-- Faces perpendicular to an ignored coordinate agree for all face values. -/
theorem singularFace_eq_of_ignoresCoordinate
    (σ : StokesF.SingularCubeStokes.SmoothSingularCube (n + 1) m) (i : Fin (n + 1))
    (hσ : CubicalDegeneracyOperators.IgnoresCoordinate σ i) (ε δ : ℝ) :
    StokesF.SingularCubeStokes.singularFace σ i ε = StokesF.SingularCubeStokes.singularFace σ i δ := by
  ext1
  funext x
  change σ (Fin.insertNth (α := fun _ => ℝ) i ε x) = σ (Fin.insertNth (α := fun _ => ℝ) i δ x)
  calc
    σ (Fin.insertNth (α := fun _ => ℝ) i ε x) =
        σ (Function.update (Fin.insertNth (α := fun _ => ℝ) i δ x) i ε) := by
      apply congrArg σ
      funext j
      rcases Fin.eq_self_or_eq_succAbove i j with rfl | ⟨k, rfl⟩
      · simp
      · simp [Fin.succAbove_ne]
    _ = σ (Fin.insertNth (α := fun _ => ℝ) i δ x) := hσ _ ε

/-- Every other face still ignores the corresponding surviving coordinate. -/
theorem ignoresCoordinate_singularFace
    (σ : StokesF.SingularCubeStokes.SmoothSingularCube (n + 1) m) (i j : Fin (n + 1))
    (k : Fin n) (hk : j.succAbove k = i) (hσ : CubicalDegeneracyOperators.IgnoresCoordinate σ i)
    (ε : ℝ) : CubicalDegeneracyOperators.IgnoresCoordinate (StokesF.SingularCubeStokes.singularFace σ j ε) k := by
  intro x t
  change σ (Fin.insertNth (α := fun _ => ℝ) j ε (Function.update x k t)) =
    σ (Fin.insertNth (α := fun _ => ℝ) j ε x)
  have hcoordinates :
      Fin.insertNth (α := fun _ => ℝ) j ε (Function.update x k t) =
        Function.update (Fin.insertNth (α := fun _ => ℝ) j ε x) i t := by
    funext l
    rcases Fin.eq_self_or_eq_succAbove j l with he | ⟨a, he⟩
    · subst l
      have hji : j ≠ i := by
        intro he
        exact Fin.succAbove_ne j k (hk.trans he.symm)
      simp [hji]
    · subst l
      by_cases hak : a = k
      · subst a
        simp [hk]
      · have hdistinct : j.succAbove a ≠ i := by
          intro he
          exact hak (Fin.succAbove_right_injective (he.trans hk.symm))
        simp [hak, hdistinct]
  exact (congrArg σ hcoordinates).trans (hσ _ t)

/-- The two faces in an ignored direction cancel, and every remaining face
is itself degenerate. -/
theorem boundarySingle_mem_degenerateSubmodule
    (σ : StokesF.SingularCubeStokes.SmoothSingularCube (n + 1) m) (hσ : CubicalDegeneracyOperators.IsDegenerateCube σ) :
    StokesF.SingularCubeStokes.singularBoundarySingle σ ∈ degenerateSubmodule n m := by
  classical
  obtain ⟨i, hi⟩ := hσ
  unfold StokesF.SingularCubeStokes.singularBoundarySingle StokesF.Stokes.boundaryGenerator
  apply Submodule.sum_mem
  intro j _
  by_cases hji : j = i
  · subst j
    have hface : StokesF.Stokes.face σ i 1 = StokesF.Stokes.face σ i 0 :=
      singularFace_eq_of_ignoresCoordinate σ i hi 1 0
    rw [hface]
    simp [pow_succ]
  · obtain ⟨k, hk⟩ := Fin.exists_succAbove_eq (fun h => hji h.symm)
    apply Submodule.add_mem
    · exact single_coeff_mem_degenerateSubmodule _
        ⟨k, ignoresCoordinate_singularFace σ i j k hk hi 1⟩ _
    · exact single_coeff_mem_degenerateSubmodule _
        ⟨k, ignoresCoordinate_singularFace σ i j k hk hi 0⟩ _

/-- The existing cubical boundary, bundled as an integer-linear map. -/
noncomputable def cubicalBoundaryLinear (n m : ℕ) :
    StokesF.SingularCubeStokes.SingularChain (n + 1) m →ₗ[ℤ] StokesF.SingularCubeStokes.SingularChain n m :=
  StokesF.Stokes.boundaryLinear n m

@[simp]
theorem cubicalBoundaryLinear_apply (c : StokesF.SingularCubeStokes.SingularChain (n + 1) m) :
    cubicalBoundaryLinear n m c = StokesF.SingularCubeStokes.singularBoundary c := rfl

/-- Degenerate cubes generate a subcomplex of the actual smooth cubical chains. -/
theorem degenerateSubmodule_le_comap_boundary (n m : ℕ) :
    degenerateSubmodule (n + 1) m ≤
      (degenerateSubmodule n m).comap (cubicalBoundaryLinear n m) := by
  intro c hc
  change cubicalBoundaryLinear n m c ∈ degenerateSubmodule n m
  change c ∈ Submodule.span ℤ _ at hc
  induction hc using Submodule.span_induction with
  | mem c hc =>
      obtain ⟨σ, hσ, rfl⟩ := hc
      change StokesF.SingularCubeStokes.singularBoundary (Finsupp.single σ 1) ∈ degenerateSubmodule n m
      simpa only [StokesF.Stokes.boundary_generator, one_smul] using
        boundarySingle_mem_degenerateSubmodule σ hσ
  | zero =>
      simpa only [map_zero] using (degenerateSubmodule n m).zero_mem
  | add a b ha hb iha ihb =>
      simpa only [map_add] using (degenerateSubmodule n m).add_mem iha ihb
  | smul k a ha iha =>
      simpa only [map_smul] using (degenerateSubmodule n m).smul_mem k iha

/-- The cubical boundary induced on the normalized quotient. -/
noncomputable def normalizedBoundary (n m : ℕ) :
    NormalizedCubicalChain (n + 1) m →ₗ[ℤ] NormalizedCubicalChain n m :=
  (degenerateSubmodule (n + 1) m).mapQ (degenerateSubmodule n m)
    (cubicalBoundaryLinear n m) (degenerateSubmodule_le_comap_boundary n m)

@[simp]
theorem normalizedBoundary_mk (c : StokesF.SingularCubeStokes.SingularChain (n + 1) m) :
    normalizedBoundary n m ((degenerateSubmodule (n + 1) m).mkQ c) =
      (degenerateSubmodule n m).mkQ (StokesF.SingularCubeStokes.singularBoundary c) := rfl

/-- The descended boundary still has square zero. -/
theorem normalizedBoundary_sq_zero (c : NormalizedCubicalChain (n + 2) m) :
    normalizedBoundary n m (normalizedBoundary (n + 1) m c) = 0 := by
  obtain ⟨d, rfl⟩ := (degenerateSubmodule (n + 2) m).mkQ_surjective c
  rw [normalizedBoundary_mk, normalizedBoundary_mk]
  have hzero : StokesF.SingularCubeStokes.singularBoundary (StokesF.SingularCubeStokes.singularBoundary d) = 0 :=
    StokesF.Stokes.boundary_squared d
  exact (congrArg (degenerateSubmodule n m).mkQ hzero).trans (map_zero _)

end

noncomputable section

/-!
# Actual smooth maps on normalized cubical chains

Postcomposition of a smooth cube with a smooth map respects its faces and
coordinate degeneracies. It therefore induces a map of the genuine normalized
cubical chain groups, commuting with the actual boundary.
-/

open OAI.AlgebraicTopology.DeRham.Comparison.StokesF.SingularCubeStokes
open scoped ContDiff

variable {n m l q : ℕ}

/-- Postcompose a genuine smooth cube with an actual smooth map. -/
def cubePostcompose (f : (Fin m → ℝ) → (Fin l → ℝ)) (hf : ContDiff ℝ ∞ f)
    (σ : StokesF.SingularCubeStokes.SmoothSingularCube n m) : StokesF.SingularCubeStokes.SmoothSingularCube n l where
  toFun := f ∘ σ.toFun
  smooth := hf.comp σ.smooth

@[simp]
theorem cubePostcompose_apply (f : (Fin m → ℝ) → (Fin l → ℝ))
    (hf : ContDiff ℝ ∞ f) (σ : StokesF.SingularCubeStokes.SmoothSingularCube n m) (x : Fin n → ℝ) :
    cubePostcompose f hf σ x = f (σ x) := rfl

@[simp]
theorem cubePostcompose_id (σ : StokesF.SingularCubeStokes.SmoothSingularCube n m) :
    cubePostcompose id contDiff_id σ = σ := rfl

theorem cubePostcompose_comp (f : (Fin m → ℝ) → (Fin l → ℝ))
    (hf : ContDiff ℝ ∞ f) (g : (Fin l → ℝ) → (Fin q → ℝ))
    (hg : ContDiff ℝ ∞ g) (σ : StokesF.SingularCubeStokes.SmoothSingularCube n m) :
    cubePostcompose (g ∘ f) (hg.comp hf) σ =
      cubePostcompose g hg (cubePostcompose f hf σ) := rfl

@[simp]
theorem cubePostcompose_face (f : (Fin m → ℝ) → (Fin l → ℝ))
    (hf : ContDiff ℝ ∞ f) (σ : StokesF.SingularCubeStokes.SmoothSingularCube (n + 1) m)
    (i : Fin (n + 1)) (a : ℝ) :
    cubePostcompose f hf (StokesF.SingularCubeStokes.singularFace σ i a) =
      StokesF.SingularCubeStokes.singularFace (cubePostcompose f hf σ) i a := rfl

@[simp]
theorem cubePostcompose_degeneracy (f : (Fin m → ℝ) → (Fin l → ℝ))
    (hf : ContDiff ℝ ∞ f) (σ : StokesF.SingularCubeStokes.SmoothSingularCube n m) (i : Fin (n + 1)) :
    cubePostcompose f hf (CubicalDegeneracyOperators.cubeDegeneracy σ i) =
      CubicalDegeneracyOperators.cubeDegeneracy (cubePostcompose f hf σ) i := rfl

theorem cubePostcompose_isDegenerate (f : (Fin m → ℝ) → (Fin l → ℝ))
    (hf : ContDiff ℝ ∞ f) (σ : StokesF.SingularCubeStokes.SmoothSingularCube n m) (hσ : CubicalDegeneracyOperators.IsDegenerateCube σ) :
    CubicalDegeneracyOperators.IsDegenerateCube (cubePostcompose f hf σ) := by
  obtain ⟨i, hi⟩ := hσ
  exact ⟨i, fun x a => congrArg f (hi x a)⟩

/-- The integer-linear map on actual unnormalized cubical chains. -/
def rawCubeMap (f : (Fin m → ℝ) → (Fin l → ℝ)) (hf : ContDiff ℝ ∞ f) (n : ℕ) :
    StokesF.SingularCubeStokes.SingularChain n m →ₗ[ℤ] StokesF.SingularCubeStokes.SingularChain n l :=
  Finsupp.lmapDomain ℤ ℤ (cubePostcompose f hf)

@[simp]
theorem rawCubeMap_single (f : (Fin m → ℝ) → (Fin l → ℝ)) (hf : ContDiff ℝ ∞ f)
    (σ : StokesF.SingularCubeStokes.SmoothSingularCube n m) (a : ℤ) :
    rawCubeMap f hf n (Finsupp.single σ a) = Finsupp.single (cubePostcompose f hf σ) a := by
  simp [rawCubeMap]

@[simp]
theorem rawCubeMap_id (n m : ℕ) : rawCubeMap (id : (Fin m → ℝ) → _) contDiff_id n =
    LinearMap.id := by
  apply Finsupp.lhom_ext
  intro σ a
  simp

theorem rawCubeMap_comp (f : (Fin m → ℝ) → (Fin l → ℝ)) (hf : ContDiff ℝ ∞ f)
    (g : (Fin l → ℝ) → (Fin q → ℝ)) (hg : ContDiff ℝ ∞ g) (n : ℕ) :
    rawCubeMap (g ∘ f) (hg.comp hf) n = (rawCubeMap g hg n).comp (rawCubeMap f hf n) := by
  apply Finsupp.lhom_ext
  intro σ a
  simp only [LinearMap.comp_apply, rawCubeMap_single]
  rfl

theorem rawCubeMap_boundarySingle (f : (Fin m → ℝ) → (Fin l → ℝ))
    (hf : ContDiff ℝ ∞ f) (σ : StokesF.SingularCubeStokes.SmoothSingularCube (n + 1) m) :
    rawCubeMap f hf n (StokesF.SingularCubeStokes.singularBoundarySingle σ) =
      StokesF.SingularCubeStokes.singularBoundarySingle (cubePostcompose f hf σ) := by
  simp [StokesF.SingularCubeStokes.singularBoundarySingle, StokesF.Stokes.boundaryGenerator]

theorem rawCubeMap_boundary (f : (Fin m → ℝ) → (Fin l → ℝ))
    (hf : ContDiff ℝ ∞ f) (c : StokesF.SingularCubeStokes.SingularChain (n + 1) m) :
    rawCubeMap f hf n (StokesF.SingularCubeStokes.singularBoundary c) =
      StokesF.SingularCubeStokes.singularBoundary (rawCubeMap f hf (n + 1) c) := by
  change rawCubeMap f hf n (Finsupp.linearCombination ℤ StokesF.Stokes.boundaryGenerator c) =
    Finsupp.linearCombination ℤ StokesF.Stokes.boundaryGenerator
      (Finsupp.lmapDomain ℤ ℤ (cubePostcompose f hf) c)
  have h := Finsupp.lmapDomain_linearCombination ℤ
    (v := StokesF.Stokes.boundaryGenerator) (v' := StokesF.Stokes.boundaryGenerator)
    (cubePostcompose f hf) (rawCubeMap f hf n)
    (fun σ => rawCubeMap_boundarySingle f hf σ)
  exact (LinearMap.congr_fun h c).symm

theorem rawCubeMap_preserves_degenerate (f : (Fin m → ℝ) → (Fin l → ℝ))
    (hf : ContDiff ℝ ∞ f) (n : ℕ) :
    degenerateSubmodule n m ≤ (degenerateSubmodule n l).comap (rawCubeMap f hf n) := by
  apply Submodule.span_le.mpr
  rintro _ ⟨σ, hσ, rfl⟩
  change rawCubeMap f hf n (Finsupp.single σ 1) ∈ degenerateSubmodule n l
  rw [rawCubeMap_single]
  exact single_mem_degenerateSubmodule _ (cubePostcompose_isDegenerate f hf σ hσ)

/-- Pushforward on genuine cubical chains modulo actual degeneracies. -/
def normalizedCubeMap (f : (Fin m → ℝ) → (Fin l → ℝ)) (hf : ContDiff ℝ ∞ f) (n : ℕ) :
    NormalizedCubicalChain n m →ₗ[ℤ] NormalizedCubicalChain n l :=
  (degenerateSubmodule n m).mapQ (degenerateSubmodule n l) (rawCubeMap f hf n)
    (rawCubeMap_preserves_degenerate f hf n)

@[simp]
theorem normalizedCubeMap_mkQ (f : (Fin m → ℝ) → (Fin l → ℝ)) (hf : ContDiff ℝ ∞ f)
    (c : StokesF.SingularCubeStokes.SingularChain n m) :
    normalizedCubeMap f hf n ((degenerateSubmodule n m).mkQ c) =
      (degenerateSubmodule n l).mkQ (rawCubeMap f hf n c) := rfl

@[simp]
theorem normalizedCubeMap_id (n m : ℕ) :
    normalizedCubeMap (id : (Fin m → ℝ) → _) contDiff_id n = LinearMap.id := by
  apply LinearMap.ext
  intro c
  obtain ⟨raw, rfl⟩ := (degenerateSubmodule n m).mkQ_surjective c
  change (degenerateSubmodule n m).mkQ (rawCubeMap id contDiff_id n raw) =
    (degenerateSubmodule n m).mkQ raw
  rw [rawCubeMap_id]
  rfl

theorem normalizedCubeMap_comp (f : (Fin m → ℝ) → (Fin l → ℝ)) (hf : ContDiff ℝ ∞ f)
    (g : (Fin l → ℝ) → (Fin q → ℝ)) (hg : ContDiff ℝ ∞ g) (n : ℕ) :
    normalizedCubeMap (g ∘ f) (hg.comp hf) n =
      (normalizedCubeMap g hg n).comp (normalizedCubeMap f hf n) := by
  apply LinearMap.ext
  intro c
  obtain ⟨raw, rfl⟩ := (degenerateSubmodule n m).mkQ_surjective c
  change (degenerateSubmodule n q).mkQ (rawCubeMap (g ∘ f) (hg.comp hf) n raw) =
    (degenerateSubmodule n q).mkQ (rawCubeMap g hg n (rawCubeMap f hf n raw))
  rw [rawCubeMap_comp]
  rfl

theorem normalizedCubeMap_boundary (f : (Fin m → ℝ) → (Fin l → ℝ))
    (hf : ContDiff ℝ ∞ f) (c : NormalizedCubicalChain (n + 1) m) :
    normalizedCubeMap f hf n (normalizedBoundary n m c) =
      normalizedBoundary n l (normalizedCubeMap f hf (n + 1) c) := by
  obtain ⟨raw, rfl⟩ := (degenerateSubmodule (n + 1) m).mkQ_surjective c
  simp only [normalizedBoundary_mk, normalizedCubeMap_mkQ, rawCubeMap_boundary]

end

end OAI.AlgebraicTopology.DeRham.Comparison.CubicalDegenerateQ
