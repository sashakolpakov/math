import OAI.AlgebraicTopology.DeRham.Comparison.CubicalDegenerateQ
import OAI.AlgebraicTopology.DeRham.Comparison.CubicalDegenerateIntegration
import Mathlib.LinearAlgebra.Finsupp.LinearCombination

/-! # Complex Normalized Integration -/

namespace OAI.AlgebraicTopology.DeRham.Comparison.ComplexNormalizedIntegration

noncomputable section

/-!
# Complex integration on normalized smooth cubical chains

These functionals integrate actual smooth cubes and descend through the
submodule generated by actual coordinate-degenerate cubes. Their dependence
on the smooth complex differential form is complex linear.
-/

open OAI.AlgebraicTopology.DeRham.Comparison.StokesF.SingularCubeStokes
open scoped ContDiff

variable {n m : ℕ}

/-- Integrate a complex form over a finite integral chain of smooth cubes. -/
def complexRawCubicalIntegration
    (form : (Fin m → ℝ) → (Fin m → ℝ) [⋀^Fin n]→L[ℝ] ℂ) :
    (StokesF.SingularCubeStokes.SmoothSingularCube n m →₀ ℤ) →ₗ[ℤ] ℂ :=
  Finsupp.linearCombination ℤ (fun σ => ComplexCubeIntegration.complexIntegrateForm σ form)

@[simp]
theorem complexRawCubicalIntegration_single
    (form : (Fin m → ℝ) → (Fin m → ℝ) [⋀^Fin n]→L[ℝ] ℂ)
    (σ : StokesF.SingularCubeStokes.SmoothSingularCube n m) (a : ℤ) :
    complexRawCubicalIntegration form (Finsupp.single σ a) =
      a • ComplexCubeIntegration.complexIntegrateForm σ form :=
  Finsupp.linearCombination_single ℤ a σ

/-- Complex integration vanishes on every coordinate-degenerate cube. -/
theorem complexIntegrateForm_eq_zero_of_degenerate
    (σ : StokesF.SingularCubeStokes.SmoothSingularCube n m) (hσ : CubicalDegeneracyOperators.IsDegenerateCube σ)
    (form : (Fin m → ℝ) → (Fin m → ℝ) [⋀^Fin n]→L[ℝ] ℂ) :
    ComplexCubeIntegration.complexIntegrateForm σ form = 0 := by
  cases n with
  | zero => exact (CubicalDegeneracyOperators.not_isDegenerate_zero_cube σ hσ).elim
  | succ n =>
      obtain ⟨τ, i, rfl⟩ := (CubicalDegeneracyOperators.isDegenerateCube_iff σ).mp hσ
      exact CubicalDegenerateIntegration.complexIntegrateForm_cubeDegeneracy τ i form

/-- The full degenerate-chain submodule lies in the kernel of integration. -/
theorem degenerateSubmodule_le_ker_complexIntegration
    (form : (Fin m → ℝ) → (Fin m → ℝ) [⋀^Fin n]→L[ℝ] ℂ) :
    CubicalDegenerateQ.degenerateSubmodule n m ≤ LinearMap.ker (complexRawCubicalIntegration form) := by
  apply Submodule.span_le.mpr
  rintro _ ⟨σ, hσ, rfl⟩
  change complexRawCubicalIntegration form (Finsupp.single σ 1) = 0
  rw [complexRawCubicalIntegration_single, one_smul]
  exact complexIntegrateForm_eq_zero_of_degenerate σ hσ form

/-- Integrate on the quotient by degenerate smooth cubical chains. -/
def normalizedComplexIntegration
    (form : (Fin m → ℝ) → (Fin m → ℝ) [⋀^Fin n]→L[ℝ] ℂ) :
    CubicalDegenerateQ.NormalizedCubicalChain n m →ₗ[ℤ] ℂ :=
  (CubicalDegenerateQ.degenerateSubmodule n m).liftQ (complexRawCubicalIntegration form)
    (degenerateSubmodule_le_ker_complexIntegration form)

@[simp]
theorem normalizedComplexIntegration_mkQ
    (form : (Fin m → ℝ) → (Fin m → ℝ) [⋀^Fin n]→L[ℝ] ℂ)
    (c : StokesF.SingularCubeStokes.SmoothSingularCube n m →₀ ℤ) :
    normalizedComplexIntegration form ((CubicalDegenerateQ.degenerateSubmodule n m).mkQ c) =
      complexRawCubicalIntegration form c := rfl

@[simp]
theorem normalizedComplexIntegration_single
    (form : (Fin m → ℝ) → (Fin m → ℝ) [⋀^Fin n]→L[ℝ] ℂ)
    (σ : StokesF.SingularCubeStokes.SmoothSingularCube n m) :
    normalizedComplexIntegration form
      ((CubicalDegenerateQ.degenerateSubmodule n m).mkQ (Finsupp.single σ 1)) =
        ComplexCubeIntegration.complexIntegrateForm σ form := by
  rw [normalizedComplexIntegration_mkQ, complexRawCubicalIntegration_single, one_smul]

theorem complexRawCubicalIntegration_add
    (form other : (Fin m → ℝ) → (Fin m → ℝ) [⋀^Fin n]→L[ℝ] ℂ)
    (hform : ContDiff ℝ ∞ form) (hother : ContDiff ℝ ∞ other) :
    complexRawCubicalIntegration (form + other) =
      complexRawCubicalIntegration form + complexRawCubicalIntegration other := by
  apply Finsupp.lhom_ext
  intro σ a
  simp only [complexRawCubicalIntegration_single, LinearMap.add_apply,
    ComplexCubeIntegration.complexIntegrateForm_add σ form other hform hother, smul_add]

theorem complexRawCubicalIntegration_smul (a : ℂ)
    (form : (Fin m → ℝ) → (Fin m → ℝ) [⋀^Fin n]→L[ℝ] ℂ)
    (hform : ContDiff ℝ ∞ form) :
    complexRawCubicalIntegration (a • form) = a • complexRawCubicalIntegration form := by
  apply Finsupp.lhom_ext
  intro σ z
  simp only [complexRawCubicalIntegration_single, LinearMap.smul_apply,
    ComplexCubeIntegration.complexIntegrateForm_smul σ a form hform]
  exact smul_comm z a (ComplexCubeIntegration.complexIntegrateForm σ form)

theorem normalizedComplexIntegration_add
    (form other : (Fin m → ℝ) → (Fin m → ℝ) [⋀^Fin n]→L[ℝ] ℂ)
    (hform : ContDiff ℝ ∞ form) (hother : ContDiff ℝ ∞ other) :
    normalizedComplexIntegration (form + other) =
      normalizedComplexIntegration form + normalizedComplexIntegration other := by
  apply LinearMap.ext
  intro c
  obtain ⟨raw, rfl⟩ := (CubicalDegenerateQ.degenerateSubmodule n m).mkQ_surjective c
  change complexRawCubicalIntegration (form + other) raw =
    (complexRawCubicalIntegration form + complexRawCubicalIntegration other) raw
  exact LinearMap.congr_fun (complexRawCubicalIntegration_add form other hform hother) raw

theorem normalizedComplexIntegration_smul (a : ℂ)
    (form : (Fin m → ℝ) → (Fin m → ℝ) [⋀^Fin n]→L[ℝ] ℂ)
    (hform : ContDiff ℝ ∞ form) :
    normalizedComplexIntegration (a • form) = a • normalizedComplexIntegration form := by
  apply LinearMap.ext
  intro c
  obtain ⟨raw, rfl⟩ := (CubicalDegenerateQ.degenerateSubmodule n m).mkQ_surjective c
  change complexRawCubicalIntegration (a • form) raw =
    (a • complexRawCubicalIntegration form) raw
  exact LinearMap.congr_fun (complexRawCubicalIntegration_smul a form hform) raw

/-- The resulting degreewise complex-linear map from genuine smooth forms to
the complex-valued dual of the actual normalized cubical chain group. -/
def normalizedComplexIntegrationLinearMap :
    Analysis.DifferentialForms.Manifold.Basic.SmoothForm (Fin m → ℝ) n →ₗ[ℂ]
      (CubicalDegenerateQ.NormalizedCubicalChain n m →ₗ[ℤ] ℂ) where
  toFun form := normalizedComplexIntegration form
  map_add' form other :=
    normalizedComplexIntegration_add form other form.smooth other.smooth
  map_smul' a form := normalizedComplexIntegration_smul a form form.smooth

end

end OAI.AlgebraicTopology.DeRham.Comparison.ComplexNormalizedIntegration
