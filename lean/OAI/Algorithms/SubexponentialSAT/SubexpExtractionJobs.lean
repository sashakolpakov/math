import OAI.Algorithms.SubexponentialSAT.LeanCompat
import OAI.Algorithms.SubexponentialSAT.SubexpMomentProgram
import OAI.Algorithms.SubexponentialSAT.SubexpPostfixControl
import OAI.Algorithms.SubexponentialSAT.SubexpSymbolicCost

namespace OAI.Algorithms

/-!
# Finite extraction-job construction

The fixed backend phase processes one requested coefficient per job. Its input
is generated by the retained moment list and the two polynomially sized U,Z
loops. Repeating the postfix source in these jobs does not enumerate any new
assignment combinations.
-/

namespace SubexponentialSAT.SubexpExtractionJobs

open scoped BigOperators

structure Query (D : ℕ) where
  exponent : Fin D → ℕ
  u : ℕ
  z : ℕ

def queries (D : ℕ) : List (Query D) :=
  (List.range D).flatMap fun z =>
    (Algorithm.exponentList D (2 * D + 1)).flatMap fun a =>
      (List.range (D + 1)).map fun u => ⟨a, u, z⟩

def jobs {D : ℕ} {C : Type*} (encode : SymbolicCost.CoeffList D C → List Bool)
    (program : (Fin D → ℕ) → Algorithm.Expr (SymbolicCost.CoeffList D C)) :
    List SubexpMomentProgram.Job :=
  (queries D).map fun q =>
    ⟨List.replicate q.z true, SubexpSymbolicCost.fixedKey (q.exponent, (q.u, q.z)),
      SubexpPostfixControl.serializeCode encode (program q.exponent).compile⟩

theorem queries_length (D : ℕ) :
    (queries D).length = D * ((3 * D + 1).choose D) * (D + 1) := by
  simp only [queries, List.length_flatMap, List.length_map, List.length_range]
  simp only [List.map_const', List.sum_replicate, smul_eq_mul,
    Algorithm.exponentList_length]
  have h : D + (2 * D + 1) = 3 * D + 1 := by omega
  rw [h]
  simp only [List.length_range]
  ring

theorem jobs_length {D : ℕ} {C : Type*}
    (encode : SymbolicCost.CoeffList D C → List Bool)
    (program : (Fin D → ℕ) → Algorithm.Expr (SymbolicCost.CoeffList D C)) :
    (jobs encode program).length = D * ((3 * D + 1).choose D) * (D + 1) := by
  rw [jobs, List.length_map, queries_length]

theorem mem_queries (D : ℕ) (q : Query D) : q ∈ queries D ↔
    q.z < D ∧ q.exponent ∈ Algorithm.exponentList D (2 * D + 1) ∧ q.u < D + 1 := by
  cases q with
  | mk a u z => simp [queries, and_assoc, and_left_comm, and_comm]

private theorem sum_flatMap {α R : Type*} [AddMonoid R]
    (xs : List α) (f : α → List R) :
    (xs.flatMap f).sum = (xs.map fun x => (f x).sum).sum := by
  induction xs with
  | nil => rfl
  | cons x xs ih => simp only [List.flatMap_cons, List.sum_append,
      List.map_cons, List.sum_cons, ih]

theorem sum_queries_at {D : ℕ} {R : Type*} [AddCommMonoid R]
    (f : Query D → R) (r : ℕ) (hr : r < D) :
    ((queries D).map fun q => if q.z = r then f q else 0).sum =
      ((Algorithm.exponentList D (2 * D + 1)).map fun a =>
        ((List.range (D + 1)).map fun u => f ⟨a, u, r⟩).sum).sum := by
  simp only [queries, List.map_flatMap, List.map_map, Function.comp_def, sum_flatMap]
  have h (z : ℕ) :
      ((Algorithm.exponentList D (2 * D + 1)).map fun a =>
        ((List.range (D + 1)).map fun u =>
          if (Query.mk a u z).z = r then f ⟨a, u, z⟩ else 0).sum).sum =
      if z = r then
        ((Algorithm.exponentList D (2 * D + 1)).map fun a =>
          ((List.range (D + 1)).map fun u => f ⟨a, u, r⟩).sum).sum else 0 := by
    by_cases hz : z = r
    · subst z
      simp
    · simp [hz]
  simp_rw [h]
  rw [← List.sum_toFinset _ (List.nodup_range (n := D))]
  simp [hr]

section Semantics

variable {D : ℕ} {R : Type*} [CommSemiring R]

noncomputable def contribution
    (program : (Fin D → ℕ) → Algorithm.Expr (SymbolicCost.CoeffList D R))
    (q : Query D) : R :=
  SymbolicCost.coeff
    (((program q.exponent).map (Algorithm.Dense.ofRaw (Algorithm.retainedSlots D))).eval).coefficients
    (q.exponent, (q.u, q.z))

/-- Summing the jobs assigned to each output cell gives exactly the original
jet algorithm. This justifies the polynomially repeated execution schedule. -/
theorem jobs_sum_eq_rawJet
    (program : (Fin D → ℕ) → Algorithm.Expr (SymbolicCost.CoeffList D R)) :
    (List.range D).map (fun r =>
      ((queries D).map fun q => if q.z = r then contribution program q else 0).sum) =
      Algorithm.executeRawJet program := by
  rw [Algorithm.executeRawJet, Algorithm.executeJet_eq]
  apply List.map_congr_left
  intro r hr
  rw [sum_queries_at _ r (List.mem_range.mp hr)]
  simp only [contribution, Algorithm.collapseU_eq]

end Semantics

end SubexponentialSAT.SubexpExtractionJobs

end OAI.Algorithms
