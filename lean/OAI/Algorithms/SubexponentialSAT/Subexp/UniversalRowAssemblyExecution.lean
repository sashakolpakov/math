import OAI.Algorithms.SubexponentialSAT.LeanCompat
import OAI.Algorithms.SubexponentialSAT.Subexp.UniversalRowAssembly

namespace OAI.Algorithms

/-! Terminal composition of the physical universal-row source producer.
The only supplied arrays are the field caches; the correction coefficients
and mismatch list are generated by the program itself. -/

namespace SubexponentialSAT.Subexp.UniversalRowAssembly

open BitProgram StructuredCalls StackRoutines
open UniversalRowWorkspace (port port_injective)

abbrev Word := List Bool

private def dataOf (s : Fin 288 → Word) : Data := ⟨fun _ => false, s⟩

private theorem outside_high (j : Fin 288) (hj : 128 ≤ j.val) :
    ¬ ∃ k, port k = j := by
  rintro ⟨k, rfl⟩
  have := UniversalRowWorkspace.port_lt_cache k
  omega

private theorem port_ne_high (k : Fin 49) (j : Fin 288) (hj : 128 ≤ j.val) :
    port k ≠ j := fun h => outside_high j hj ⟨k, h⟩

private theorem rearrange_cost_congr (os : List UniversalRowRearrange.Action)
    (a b : Data) (h : a.stacks = b.stacks) :
    UniversalRowRearrange.cost os a = UniversalRowRearrange.cost os b := by
  induction os generalizing a b with
  | nil => rfl
  | cons op os ih =>
      simp only [UniversalRowRearrange.cost]
      have hc : UniversalRowRearrange.actionCost op a =
          UniversalRowRearrange.actionCost op b := by
        cases op <;> simp only [UniversalRowRearrange.actionCost, h]
      have hs : (UniversalRowRearrange.actionResult op a).stacks =
          (UniversalRowRearrange.actionResult op b).stacks := by
        cases op <;> simp only [UniversalRowRearrange.actionResult, h]
      rw [hc, ih _ _ hs]

private theorem rearrange_result_congr (os : List UniversalRowRearrange.Action)
    (a b : Data) (h : a.stacks = b.stacks) :
    (UniversalRowRearrange.result os a).stacks =
      (UniversalRowRearrange.result os b).stacks := by
  induction os generalizing a b with
  | nil => exact h
  | cons op os ih =>
      apply ih
      cases op <;> simp only [UniversalRowRearrange.actionResult, h]

private theorem clear_cost_congr (js : List (Fin 288)) (a b : Data)
    (h : a.stacks = b.stacks) :
    UniversalRowWorkspace.clearCost js a = UniversalRowWorkspace.clearCost js b := by
  induction js generalizing a b with
  | nil => rfl
  | cons j js ih =>
      simp only [UniversalRowWorkspace.clearCost]
      have hs : (UniversalRowWorkspace.cleared a j).stacks =
          (UniversalRowWorkspace.cleared b j).stacks := by
        simp only [UniversalRowWorkspace.cleared, h]
      rw [h, ih (UniversalRowWorkspace.cleared a j) (UniversalRowWorkspace.cleared b j) hs]

variable {r Q Δ : ℕ}
variable (p : ℕ) [Fact p.Prime] (i : Fin Δ)
variable (u y : MulticolorTypes.UniversalType r Q Δ) (xs : List (ZMod p))

def selected : List ℕ := MismatchPlanProgram.selectedPositions y.head (u.slot i)

def deltaWord (a : Data) : Word := if u = y then a.stacks 132 else a.stacks 131

def sourceWord (t : UniversalRowLoop.Tables) (a : Data) : Word :=
  UniversalRowProgram.rowCode (a.stacks 131) (a.stacks 132)
    (a.stacks 131 ++ a.stacks 132)
    (UniversalRowDataProgram.row t (selected i u y) (deltaWord u y a)
      (List.replicate xs.length true))

/-- A proof-side description of the caller frame after setup. The actual
command uses the finite port map and never evaluates `Function.extend`. -/
noncomputable def stagedStacks (a : Data) : Fin 288 → Word :=
  Function.extend port
    (UniversalRowInputSetup.inputStacks a Q r xs.length (MatrixWordEncoding.width p)) a.stacks

noncomputable def beforeData (a : Data) : Data := dataOf <|
  Function.update (Function.update (Function.update (Function.update
    (Function.update (Function.update (stagedStacks (r := r) (Q := Q) p xs a)
      (port 48) (CorrectionVectorProgram.vector p i u y xs 0 Q))
      (port 45) (UniversalRowTermProgram.indices (selected i u y)))
      (port 44) (a.stacks 132)) (port 23) []) (port 24) [])
      (port 18) (deltaWord u y a)

noncomputable def afterData (a : Data) : Data :=
  UniversalRowRearrange.result UniversalRowRearrange.operations (beforeData p i u y xs a)

noncomputable def afterEmit (t : UniversalRowLoop.Tables) (a : Data) : Data := dataOf <|
  Function.update (Function.update (afterData p i u y xs a).stacks (port 18) [])
    (port 31) (sourceWord p i u y xs t a)

noncomputable def afterMove (t : UniversalRowLoop.Tables) (a : Data) : Data := dataOf <|
  Function.update (Function.update (Function.update (afterEmit p i u y xs t a).stacks
    (port 31) []) (port 44) []) 26 (sourceWord p i u y xs t a)

/-- A fully explicit bound, including the source-dependent final clearing
cost. All its data are the original input arrays and the computed row. -/
noncomputable def executionBound (t : UniversalRowLoop.Tables) (a : Data) : ℕ :=
  UniversalRowInputSetup.budget a Q r (MatrixWordEncoding.width p) +
  CorrectionVectorProgram.programBudget p i u y xs +
  (UniversalRowMismatchTypes.extractBudget (r := r) (Q := Q) i +
    UniversalRowMismatchProgram.budget Q r + 8 * (Q * r) + 13) +
  (7 * (a.stacks 132).length + 5) +
  (13 * CollisionProgram.typeWidth r Q Δ + 7 * (deltaWord u y a).length + 28) +
  UniversalRowRearrange.cost UniversalRowRearrange.operations (beforeData p i u y xs a) +
  UniversalRowSourceProgram.bound t (a.stacks 131) (a.stacks 134) (selected i u y)
    (deltaWord u y a) (List.replicate xs.length true) (a.stacks 131) (a.stacks 132) +
  (6 * (sourceWord p i u y xs t a).length + 6 +
    UniversalRowWorkspace.clearCost UniversalRowWorkspace.workPorts (afterMove p i u y xs t a))

omit [Fact (Nat.Prime p)] in
private theorem staged_native (a : Data) (j : Fin 49) :
    stagedStacks (Q := Q) (r := r) p xs a (port j) =
      UniversalRowInputSetup.inputStacks a Q r xs.length (MatrixWordEncoding.width p) j :=
  port_injective.extend_apply _ _ _

omit [Fact (Nat.Prime p)] in
private theorem staged_frame (a : Data) (j : Fin 288) (hj : ¬ ∃ k, port k = j) :
    stagedStacks (Q := Q) (r := r) p xs a j = a.stacks j :=
  Function.extend_apply' _ _ _ hj

private theorem before_frame (a : Data) (j : Fin 288) (hj : ¬ ∃ k, port k = j) :
    (beforeData p i u y xs a).stacks j = a.stacks j := by
  have hn (k : Fin 49) : j ≠ port k := fun h => hj ⟨k, h.symm⟩
  simp only [beforeData, dataOf, Function.update_of_ne (hn _), staged_frame p xs a j hj]

private theorem before_ready (a : Data)
    (hinput : ∀ regs, UniversalRowInputSetup.inputStacks a Q r xs.length (MatrixWordEncoding.width p) =
      (CorrectionVectorProgram.input p i u y xs (a.stacks 133) (a.stacks 131) regs).stacks) :
    UniversalRowRearrange.Ready (beforeData p i u y xs a) := by
  intro j hj
  have hi := congrFun (hinput (fun _ => false)) j
  simp only [beforeData, dataOf, Function.update_apply, port_injective.eq_iff, staged_native]
  rw [hi]
  fin_cases j <;>
    simp +decide [CorrectionVectorProgram.input, CorrectionVectorProgram.state,
      MatrixEntryProgram.typedInput, MatrixEntryProgram.input] at hj ⊢

def emitterWord (t : UniversalRowLoop.Tables) (a : Data) (j : Fin 49) : Word :=
  if j = 3 then a.stacks 131
  else if j = 10 then a.stacks 132
  else if j = 13 then List.replicate xs.length true
  else if j = 18 then deltaWord u y a
  else if j = 24 then t.values.flatten
  else if j = 25 then t.inverses.flatten
  else if j = 26 then t.negatives.flatten
  else if j = 27 then t.rows.flatten
  else if j = 28 then UniversalRowTermProgram.indices (selected i u y)
  else if j = 29 then a.stacks 131
  else if j = 30 then a.stacks 134 else []

private theorem after_native (t : UniversalRowLoop.Tables) (a : Data)
    (hinput : ∀ regs, UniversalRowInputSetup.inputStacks a Q r xs.length (MatrixWordEncoding.width p) =
      (CorrectionVectorProgram.input p i u y xs (a.stacks 133) (a.stacks 131) regs).stacks)
    (hvalues : t.values.flatten = CorrectionVectorProgram.vector p i u y xs 0 Q)
    (hinverses : a.stacks 135 = t.inverses.flatten)
    (hnegatives : a.stacks 136 = t.negatives.flatten)
    (hdifferences : a.stacks 137 = t.rows.flatten) (j : Fin 49) :
    (afterData p i u y xs a).stacks (port j) = emitterWord p i u y xs t a j := by
  rw [afterData, UniversalRowRearrange.result_prepared _ (before_ready p i u y xs a hinput)]
  have hbase (k : Fin 49) := congrFun (hinput (fun _ => false)) k
  have h134 := before_frame p i u y xs a 134 (outside_high _ (by decide))
  have h135 := before_frame p i u y xs a 135 (outside_high _ (by decide))
  have h136 := before_frame p i u y xs a 136 (outside_high _ (by decide))
  have h137 := before_frame p i u y xs a 137 (outside_high _ (by decide))
  fin_cases j <;> simp only [UniversalRowRearrange.preparedWord, emitterWord,
 h134, h135, h136, h137]
  all_goals
    simp +decide [beforeData, dataOf, staged_native,
      hbase, CorrectionVectorProgram.input, CorrectionVectorProgram.state,
      MatrixEntryProgram.typedInput, MatrixEntryProgram.input,
      hvalues, hinverses, hnegatives, hdifferences]

private theorem after_frame (a : Data) (j : Fin 288) (hj : ¬ ∃ k, port k = j) :
    (afterData p i u y xs a).stacks j = a.stacks j := by
  rw [afterData, UniversalRowRearrange.result_frame _ _ j hj]
  exact before_frame p i u y xs a j hj

private theorem emitted_frame (t : UniversalRowLoop.Tables) (a : Data)
    (j : Fin 288) (hj : ¬ ∃ k, port k = j) :
    (afterEmit p i u y xs t a).stacks j = a.stacks j := by
  have hn (k : Fin 49) : j ≠ port k := fun h => hj ⟨k, h.symm⟩
  simp only [afterEmit, dataOf, Function.update_of_ne (hn _)]
  exact after_frame p i u y xs a j hj

/-- Complete execution from raw type metadata and field-cache arrays.
The local input identities below only type the physically copied masters;
the correction vector and selected-index records are generated inside the run. -/
theorem command_eval_from_inputs (h2 : (2 : ZMod p) ≠ 0)
    (t : UniversalRowLoop.Tables) (a : Data)
    (hempty : ∀ j : Fin 49, a.stacks (port j) = []) (hcode : a.stacks 26 = [])
    (hQ : a.stacks 253 = List.replicate Q true)
    (hr : a.stacks 252 = List.replicate r true)
    (hR : a.stacks 243 = List.replicate (xs.length + 1) true)
    (hwidth : (a.stacks 129).length = MatrixWordEncoding.width p)
    (hzero : a.stacks 131 = List.replicate (4 * MatrixWordEncoding.width p) false)
    (hcw : (a.stacks 133).length = MatrixWordEncoding.width p)
    (hcv : BinaryArithmetic.toNat (a.stacks 133) = p - 1)
    (hinput : ∀ regs, UniversalRowInputSetup.inputStacks a Q r xs.length (MatrixWordEncoding.width p) =
      (CorrectionVectorProgram.input p i u y xs (a.stacks 133) (a.stacks 131) regs).stacks)
    (hfirst : ∀ regs (j : Fin 29),
      UniversalRowInputSetup.inputStacks a Q r xs.length (MatrixWordEncoding.width p) (j.castAdd 20) =
        (MatrixInputTypes.input i u y regs).stacks j)
    (hvalues : t.values.flatten = CorrectionVectorProgram.vector p i u y xs 0 Q)
    (hinverses : a.stacks 135 = t.inverses.flatten)
    (hnegatives : a.stacks 136 = t.negatives.flatten)
    (hdifferences : a.stacks 137 = t.rows.flatten)
    (valid : UniversalRowLoop.Valid t (a.stacks 131) (a.stacks 134) (selected i u y)) :
    ∃ n ≤ executionBound p i u y xs t a, ∃ b : Data, Eval command n a b ∧
      b.stacks = Function.update a.stacks 26 (sourceWord p i u y xs t a) := by
  obtain ⟨a1, he1, hn1, hf1⟩ := UniversalRowInputSetup.command_eval a Q r xs.length
    (MatrixWordEncoding.width p) hempty hQ hr hR hwidth hzero
  have h1s : a1.stacks = stagedStacks (Q := Q) (r := r) p xs a := by
    funext j
    by_cases hj : ∃ k, port k = j
    · obtain ⟨k, rfl⟩ := hj
      rw [staged_native]
      exact hn1 k
    · rw [staged_frame p xs a j hj]
      exact hf1 j hj
  have hin1 : projectState nativeRegs port a1 =
      CorrectionVectorProgram.input p i u y xs (a.stacks 133) (a.stacks 131)
        (a1.regs ∘ nativeRegs) := by
    apply congrArg₂ StructuredProgram.State.mk rfl
    funext j
    exact (hn1 j).trans (congrFun (hinput (a1.regs ∘ nativeRegs)) j)
  obtain ⟨n2, hn2, a2, he2, h2s⟩ := vector_eval p h2 i u y xs (a.stacks 133) (a.stacks 131)
    a1 hcw hcv (by simp [hzero]) hin1
  have hn2input : UniversalRowMismatchTypes.InputReady i u y (projectState nativeRegs port a2) := by
    intro j
    change a2.stacks (port (j.castAdd 20)) = _
    have hne : port (j.castAdd 20) ≠ port 48 := by
      intro h
      have hv := congrArg Fin.val (port_injective h)
      change j.val = 48 at hv
      have hj := j.isLt
      omega
    rw [h2s, Function.update_of_ne hne, hn1]
    exact hfirst (fun _ => false) j
  have h45 : a2.stacks (port 45) = [] := by
    rw [h2s]
    simp only [Function.update_apply, port_injective.eq_iff, hn1,
      hinput (fun _ => false)]
    rfl
  obtain ⟨n3, hn3, a3, he3, h3s⟩ := mismatch_eval i u y a2 hn2input h45
  have hn1v (j : Fin 49) : a1.stacks (port j) =
      (CorrectionVectorProgram.input p i u y xs (a.stacks 133) (a.stacks 131)
        (fun _ => false)).stacks j := (hn1 j).trans (congrFun (hinput (fun _ => false)) j)
  have h44 : a3.stacks (port 44) = [] := by
    simp only [h3s, h2s, Function.update_apply, port_injective.eq_iff, hn1v]
    rfl
  have h15 : a3.stacks (port 15) = [] := by
    simp only [h3s, h2s, Function.update_apply, port_injective.eq_iff, hn1v]
    rfl
  have h132 : a3.stacks 132 = a.stacks 132 := by
    rw [h3s, Function.update_of_ne (Ne.symm (port_ne_high 45 132 (by decide))),
      h2s, Function.update_of_ne (Ne.symm (port_ne_high 48 132 (by decide)))]
    exact hf1 132 (outside_high _ (by decide))
  obtain ⟨a4, he4, h4s⟩ := loadOne_eval a3 h44 h15
  rw [h132] at he4 h4s
  have hv23 : a4.stacks (port 23) = CollisionProgram.encodeType u := by
    simp only [h4s, h3s, h2s, Function.update_apply, port_injective.eq_iff, hn1v]
    rfl
  have hv24 : a4.stacks (port 24) = CollisionProgram.encodeType y := by
    simp only [h4s, h3s, h2s, Function.update_apply, port_injective.eq_iff, hn1v]
    rfl
  have hv47 : a4.stacks (port 47) = a.stacks 131 := by
    simp only [h4s, h3s, h2s, Function.update_apply, port_injective.eq_iff, hn1v]
    rfl
  have hv44 : a4.stacks (port 44) = a.stacks 132 := by simp [h4s]
  have hv18 : a4.stacks (port 18) = [] := by
    simp only [h4s, h3s, h2s, Function.update_apply, port_injective.eq_iff, hn1v]
    rfl
  have hv15 : a4.stacks (port 15) = [] := by
    simpa [h4s, Function.update_apply, port_injective.eq_iff] using h15
  obtain ⟨n5, hn5, a5, he5, h5s⟩ := delta_eval u y (a.stacks 131) (a.stacks 132) a4
    hv23 hv24 hv47 hv44 hv18 hv15
  have h5before : a5.stacks = (beforeData p i u y xs a).stacks := by
    rw [h5s, h4s, h3s, h2s, h1s]
    rfl
  have hr5 : UniversalRowRearrange.Ready a5 := by
    intro j hj
    rw [h5before]
    exact before_ready p i u y xs a hinput j hj
  let a6 := UniversalRowRearrange.result UniversalRowRearrange.operations a5
  have he6 := UniversalRowRearrange.command_eval a5 (hr5 15 (by decide))
  have h6s : a6.stacks = (afterData p i u y xs a).stacks :=
    rearrange_result_congr _ a5 _ h5before
  have h6n (j : Fin 49) : a6.stacks (port j) = emitterWord p i u y xs t a j := by
    rw [h6s]
    exact after_native p i u y xs t a hinput hvalues hinverses hnegatives hdifferences j
  have ha6 : UniversalRowLoop.ready t (a.stacks 131) (a.stacks 134) (selected i u y)
      (projectState rowRegs rowPorts a6) := by
    refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
    · change a6.stacks (port 24) = _
      rw [h6n]; rfl
    · change a6.stacks (port 25) = _
      rw [h6n]; rfl
    · change a6.stacks (port 26) = _
      rw [h6n]; rfl
    · change a6.stacks (port 27) = _
      rw [h6n]; rfl
    · change a6.stacks (port 28) = _
      rw [h6n]; rfl
    · change a6.stacks (port 29) = _
      rw [h6n]; rfl
    · change a6.stacks (port 30) = _
      rw [h6n]; rfl
    · change a6.stacks (port 16) = _
      rw [h6n]; rfl
    · intro j hj
      change a6.stacks (port (j.castAdd 17)) = []
      rw [h6n]
      simp only [List.mem_cons, List.not_mem_nil, or_false] at hj
      rcases hj with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl |
        rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
      all_goals rfl
  obtain ⟨n7, hn7, a7, he7, h7s⟩ := emit_eval t (a.stacks 131) (a.stacks 134) (selected i u y)
    valid (deltaWord u y a) (List.replicate xs.length true) (a.stacks 131) (a.stacks 132) a6 ha6
    (by rw [h6n]; rfl) (by rw [h6n]; rfl) (by rw [h6n]; rfl) (by rw [h6n]; rfl)
    (by rw [h6n]; rfl) (by rw [h6n]; rfl) (by rw [h6n]; rfl)
  have h7after : a7.stacks = (afterEmit p i u y xs t a).stacks := by
    rw [h7s, h6s]
    rfl
  have hcode7 : a7.stacks 26 = [] := by
    rw [h7after, emitted_frame p i u y xs t a 26]
    · exact hcode
    · rintro ⟨j, hj⟩
      exact UniversalRowWorkspace.port_ne_code j hj
  have htmp7 : a7.stacks (port 44) = [] := by
    simp only [h7s, Function.update_apply, port_injective.eq_iff, h6n]
    rfl
  have hsource7 : a7.stacks (port 31) = sourceWord p i u y xs t a := by
    simp only [h7s, Function.update_same]
    rfl
  obtain ⟨n8, a8, he8, hempty8, hcode8, hframe8, hcost8⟩ :=
    UniversalRowWorkspace.command_eval a7 (sourceWord p i u y xs t a) hsource7 htmp7 hcode7
  have hcost6 : UniversalRowRearrange.cost UniversalRowRearrange.operations a5 =
      UniversalRowRearrange.cost UniversalRowRearrange.operations (beforeData p i u y xs a) :=
    rearrange_cost_congr _ _ _ h5before
  have hcost8' : n8 = 6 * (sourceWord p i u y xs t a).length + 6 +
      UniversalRowWorkspace.clearCost UniversalRowWorkspace.workPorts (afterMove p i u y xs t a) := by
    let moved : Data := ⟨readRegs (readRegs a7.regs 0 1 none) 0 1 none,
      Function.update (Function.update (Function.update a7.stacks
        (port 31) []) (port 44) []) 26 (sourceWord p i u y xs t a)⟩
    have hs : moved.stacks = (afterMove p i u y xs t a).stacks := by
      dsimp only [moved, afterMove, dataOf]
      rw [h7after]
    have hc := clear_cost_congr UniversalRowWorkspace.workPorts moved
      (afterMove p i u y xs t a) hs
    exact hcost8.trans (congrArg (fun k => 6 * (sourceWord p i u y xs t a).length + 6 + k) hc)
  refine ⟨_, ?_, a8, he1.seq (he2.seq (he3.seq (he4.seq (he5.seq (he6.seq (he7.seq he8)))))), ?_⟩
  · rw [hcost6, hcost8']
    unfold executionBound
    change n5 ≤ 13 * CollisionProgram.typeWidth r Q Δ +
      7 * (deltaWord u y a).length + 28 at hn5
    omega
  · funext j
    by_cases hj26 : j = 26
    · subst j
      simpa using hcode8
    · rw [Function.update_of_ne hj26]
      by_cases hj : ∃ k, port k = j
      · obtain ⟨k, rfl⟩ := hj
        rw [hempty8, hempty]
      · rw [hframe8 j hj26 hj, h7after]
        exact emitted_frame p i u y xs t a j hj

end SubexponentialSAT.Subexp.UniversalRowAssembly

end OAI.Algorithms
