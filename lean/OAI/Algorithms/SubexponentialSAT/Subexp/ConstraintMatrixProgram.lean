import OAI.Algorithms.SubexponentialSAT.LeanCompat
import OAI.Algorithms.SubexponentialSAT.Subexp.ConstraintMatrixSlotExecution
import OAI.Algorithms.SubexponentialSAT.Subexp.ConstraintMatrixFor
import OAI.Algorithms.SubexponentialSAT.Subexp.TypeFiberProgram

namespace OAI.Algorithms

/-! Fixed control for constructing one complete local constraint matrix.
The only type-list input is the actual Side list. Each Joint row list is
generated by the physical fiber filter, then consumed by the scalar-entry
emitter. The counter on55 is incremented by the emitted rows themselves. -/

namespace SubexponentialSAT.Subexp.ConstraintMatrixProgram

open BitProgram StructuredCalls StackRoutines

abbrev Data := State 18 65

def slotRegisters : Fin 16 → Fin 18 := Fin.castAdd 2
def slotPorts : Fin 56 → Fin 65 := Fin.castAdd 9
def fiberRegisters : Fin 8 → Fin 18 := Fin.castAdd 10
def fiberPorts : Fin 16 → Fin 65 :=
  ![53, 0, 1, 2, 3, 4, 5, 6, 7, 8, 51, 21, 37, 62, 26, 63]

theorem slotRegisters_injective : Function.Injective slotRegisters := Fin.castAdd_injective _ _
theorem slotPorts_injective : Function.Injective slotPorts := Fin.castAdd_injective _ _
theorem fiberRegisters_injective : Function.Injective fiberRegisters := Fin.castAdd_injective _ _
theorem fiberPorts_injective : Function.Injective fiberPorts := by decide

abbrev jointFilter : Cmd 18 65 := .call
  (ProgramLinking.liftProgram (TypeFiberProgram.program true) fiberRegisters fiberPorts)

abbrev emitSlot : Cmd 18 65 := .call
  (ProgramLinking.liftProgram ConstraintMatrixSlot.program slotRegisters slotPorts)

abbrev advance : Cmd 18 65 := .seq (TupleProgram.pushConst 25 0 true)
  (TupleProgram.pushConst 63 0 true)

abbrev body : Cmd 18 65 := .seq jointFilter (.seq emitSlot advance)

def loopPorts : UnaryForPrograms.Ports 18 65 := ⟨64, 16, 17⟩

abbrev command : Cmd 18 65 := .seq (TupleProgram.pushConst 25 0 true)
  (.seq (UnaryForPrograms.forCmd loopPorts body) (.call (transferProgram 50 0 16 17)))

def program := compiled command 53 0

/-- Physical inputs for one Side. Matrix entries, Joint lists, row count,
and the matrix itself are not supplied as inputs. -/
def input (p : ℕ) [Fact p.Prime] (r Q Δ t g : ℕ) (coefficients : List (ZMod p))
    (sideBytes : List (List Bool)) (regs : Fin 18 → Bool) : Data :=
  ⟨regs, fun j =>
    if j = 21 then List.replicate r true else
    if j = 22 then List.replicate Q true else
    if j = 26 then List.replicate (Q * r) true else
    if j = 29 then MatrixWordEncoding.modulus p else
    if j = 30 then MatrixWordEncoding.word p 0 else
    if j = 31 then CoefficientPascalProgram.valueWords p coefficients else
    if j = 32 then List.replicate coefficients.length true else
    if j = 37 then List.replicate t true else
    if j = 53 then ProgramEncoding.encodeRecords sideBytes else
    if j = 62 then List.replicate g true else
    if j = 64 then List.replicate Δ true else []⟩

end SubexponentialSAT.Subexp.ConstraintMatrixProgram

end OAI.Algorithms
