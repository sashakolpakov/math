import OAI.Algorithms.SubexponentialSAT.LeanCompat
import OAI.Algorithms.SubexponentialSAT.SubexpMainNodeSetup
import OAI.Algorithms.SubexponentialSAT.SubexpMainNodeScratch
import OAI.Algorithms.SubexponentialSAT.SubexpMainLayoutWordBounds
import OAI.Algorithms.SubexponentialSAT.SubexpWeightLiteralBase

namespace OAI.Algorithms

/-!
# Cost of the actual layout-to-node initialization

The finite clear/copy prefix uses only the selected layout words. The large
moment and retained-slot arrays are generated by the actual exponent and
slot programs; their binomial enumeration factor remains in the bound.
The slot output length follows from its instruction trace, rather than an
assumed size of a generated array. No pending leaf stream is selected.
-/

namespace SubexponentialSAT.SubexpMainNodeSetupBounds

open BitProgram StructuredCalls SubexpMainProgram
open SubexpLayoutPorts (Allocation ordinary master)
open SubexpMainLayoutWordBounds
open scoped BigOperators

attribute [local simp] Fin.coe_ofNat_eq_mod

noncomputable section

private theorem cache_relevant {es : ℕ} (j : Fin 32)
    (hj : SubexpMainInvariant.CachePort j) : RelevantPort es (persistent es j) :=
  Or.inr ⟨j, rfl, Or.inr (Or.inl hj)⟩

theorem preclear_words {er es W : ℕ} (alloc : Allocation es) (a : MainState er es)
    (h : RelevantWordBound W a) :
    RelevantWordBound W (SubexpMainNodePreclear.result alloc a) := by
  intro i hi
  rw [SubexpMainNodePreclear.result_stack]
  split_ifs
  · simp
  · exact h i hi

theorem preclear_cost {er es W : ℕ} (alloc : Allocation es) (a : MainState er es)
    (h : RelevantWordBound W a) :
    SubexpMainNodePreclear.runtimeBound alloc a ≤ 614 * W + 922 := by
  have hs := list_lengths h
    (SubexpMainNodePreclear.ports.map (SubexpMainNodePreclear.stackMap alloc)) (by
      intro i hi
      obtain ⟨j, _, rfl⟩ := List.mem_map.mp hi
      exact Or.inl (by change j.val < 672; omega))
  simp only [List.map_map, List.length_map, SubexpMainNodePreclear.ports_length,
    Function.comp_def] at hs
  unfold SubexpMainNodePreclear.runtimeBound SubexpMainNodePreclear.selectedBits
  omega

private theorem header_source_relevant {es : ℕ} (alloc : Allocation es) (i : Fin 4) :
    RelevantPort es (SubexpMainNodeHeader.sourcePort alloc i) := by
  fin_cases i
  · exact cache_relevant 28 (by unfold SubexpMainInvariant.CachePort; decide)
  · exact cache_relevant 30 (by unfold SubexpMainInvariant.CachePort; decide)
  · exact cache_relevant 31 (by unfold SubexpMainInvariant.CachePort; decide)
  · exact Or.inl (by norm_num [SubexpMainNodeHeader.sourcePort, SubexpLayoutPorts.ordinary])

private theorem header_temporary {er es : ℕ} (alloc : Allocation es)
    (a : MainState er es) :
    (SubexpMainNodeHeader.installed alloc a).stacks (ordinary alloc 319) = [] := by
  exact (embedState_stack (SubexpMainNodeHeader.procedure er alloc).registerMap
    (SubexpMainNodeHeader.procedure er alloc).stack a
    (SubexpMainNodeHeader.result ((SubexpMainNodeHeader.procedure er alloc).project a))
    (SubexpMainNodeHeader.procedure er alloc).stack.injective (8 : Fin 9)).trans
      (SubexpMainNodeHeader.result_temporary _)

theorem header_words {er es W : ℕ} (alloc : Allocation es) (a : MainState er es)
    (h : RelevantWordBound W a) :
    RelevantWordBound W (SubexpMainNodeHeader.installed alloc a) := by
  intro i hi
  by_cases ht : ∃ j, SubexpMainNodeHeader.targetPort alloc j = i
  · obtain ⟨j, rfl⟩ := ht
    rw [SubexpMainNodeHeader.installed_target]
    exact h _ (header_source_relevant alloc j)
  · by_cases he : ordinary alloc 319 = i
    · rw [← he, header_temporary]
      simp
    · rw [SubexpMainNodeHeader.installed_frame alloc a i (by simpa using ht) he]
      exact h i hi

theorem header_cost {er es W : ℕ} (alloc : Allocation es) (a : MainState er es)
    (h : RelevantWordBound W a) :
    SubexpMainNodeHeader.runtimeBound alloc a ≤ 900 * W + 101 := by
  have hs := sum_lengths h (SubexpMainNodeHeader.stackMap alloc) (by
    intro i
    fin_cases i
    · exact cache_relevant 28 (by unfold SubexpMainInvariant.CachePort; decide)
    · exact cache_relevant 30 (by unfold SubexpMainInvariant.CachePort; decide)
    · exact cache_relevant 31 (by unfold SubexpMainInvariant.CachePort; decide)
    all_goals exact Or.inl (by norm_num [SubexpMainNodeHeader.stackMap, SubexpLayoutPorts.ordinary]))
  change 100 * ((∑ i : Fin 9,
    (a.stacks (SubexpMainNodeHeader.stackMap alloc i)).length) + 1) + 1 ≤ _
  omega

theorem reduction_words {er es W : ℕ} (alloc : Allocation es) (a : MainState er es)
    (h : RelevantWordBound W a) :
    RelevantWordBound W (SubexpMainNodeReduction.installed alloc a) := by
  intro i hi
  by_cases h91 : i = ordinary alloc 91
  · rw [h91, SubexpMainNodeReduction.installed_target]
    exact h _ (cache_relevant 14 (by unfold SubexpMainInvariant.CachePort; decide))
  · by_cases h319 : i = ordinary alloc 319
    · rw [h319, SubexpMainNodeReduction.installed_temporary]
      simp
    · rw [SubexpMainNodeReduction.installed_frame alloc a i h91 h319]
      exact h i hi

theorem reduction_cost {er es W : ℕ} (alloc : Allocation es) (a : MainState er es)
    (h : RelevantWordBound W a) :
    SubexpMainNodeReduction.runtimeBound alloc a ≤ 11 * W + 28 := by
  have hm := h _ (cache_relevant 14 (by unfold SubexpMainInvariant.CachePort; decide))
  have h91 := ordinary h alloc 91
  have h319 := ordinary h alloc 319
  unfold SubexpMainNodeReduction.runtimeBound
  omega

theorem prepared_words {er es W : ℕ} (alloc : Allocation es) (a : MainState er es)
    (h : RelevantWordBound W a) :
    RelevantWordBound W (SubexpMainNodeSetup.prepared alloc a) :=
  reduction_words alloc _ (header_words alloc _ (preclear_words alloc a h))

theorem projected_words {er es W : ℕ} (alloc : Allocation es) (a : MainState er es)
    (h : RelevantWordBound W a) (i : Fin 352) :
    ((SubexpMainNodeInitialization.projected alloc a).stacks i).length ≤ W := by
  change (a.stacks (SubexpMainMomentPorts.stackMap alloc i)).length ≤ W
  apply h
  unfold SubexpMainMomentPorts.stackMap
  split_ifs
  · exact cache_relevant 12 (by unfold SubexpMainInvariant.CachePort; decide)
  · exact cache_relevant 13 (by unfold SubexpMainInvariant.CachePort; decide)
  · exact Or.inl (SubexpMainMomentPorts.baseMap_below alloc i)

/-- The real generator starts with an empty output stack. Its instruction
trace bounds the size of the generated retained-slot master. -/
theorem slot_output_length (D : ℕ) :
    (SubexpSlotSetup.output D).length ≤ SubexpCompleteSlotSetup.bound D := by
  let d : SubexpCompleteSlotSetup.Data :=
    ⟨fun _ => false, fun i => if i = 2 then List.replicate D true else []⟩
  obtain ⟨e, he, hs⟩ := SubexpCompleteSlotSetup.program_runs D d
    (by simp [d]) (by simp [d]) (by simp [d]) (by
      intro i hi
      have hn : i ≠ 2 := by
        rintro rfl
        exact (by decide : (2 : Fin 128) ∉ SubexpSlotSetup.work) hi
      simp [d, hn])
  have hb := runsIn_selectedStackBits SubexpCompleteSlotSetup.program {14} he
  simpa [selectedStackBits, StructuredProgram.State.withPC, hs, d] using hb

theorem slot_cost (D : ℕ) :
    SubexpCompleteSlotSetup.bound D ≤
      2000 * (D + 1)^4 * (3 * D + 1).choose D := by
  have hm : 1 ≤ (3 * D + 1).choose D := Nat.choose_pos (by omega)
  have hc : SubexpSlotSetup.callbackBound D ≤ 1000 * (D + 1)^4 := by
    unfold SubexpSlotSetup.callbackBound SubexpSymbolicCost.indexBits
    ring_nf
    omega
  have ht : 100 * (D + 1)^2 + 2 + 17 * D + 29 ≤ 200 * (D + 1)^4 := by
    ring_nf
    omega
  have hp : 25 * (3 * D + 2) + 1000 * (D + 1)^4 + 18 * D + 13 ≤
      1200 * (D + 1)^4 := by
    ring_nf
    omega
  have hs := SubexpCompleteSlotSetup.bound_le D
  have hmc := Nat.mul_le_mul_left ((3 * D + 1).choose D) hc
  have hmp := Nat.mul_le_mul_left ((3 * D + 1).choose D) hp
  have hmt := Nat.mul_le_mul_left (200 * (D + 1)^4) hm
  nlinarith only [hs, hmc, hmp, ht, hmt]

private theorem constants_cost (d : SubexpNodeLocalSetup.Data) (W D : ℕ)
    (h : ∀ i, (d.stacks i).length ≤ W) :
    SubexpNodeConstantInit.cost d D ≤
      81 * W + 42 * D + 65 * SubexpSymbolicCost.indexBits D + 291 := by
  have hc := SubexpArgumentEmitLoop.constantCost_le D
    (SubexpSymbolicCost.indexBits D) false (d.stacks 120)
  have h120 := h 120
  have h10 := h 10
  unfold SubexpNodeConstantInit.cost SubexpNodeConstantInit.rawCost
  rw [SubexpWeightLiteralProgram.rawLiteral_length]
  omega

private theorem local_cost (d : SubexpNodeLocalSetup.Data) (W D : ℕ)
    (h : ∀ i, (d.stacks i).length ≤ W) :
    SubexpNodeLocalSetup.budget d D ≤
      85 * W + 100 * (D + 1)^2 + 25 * (3 * D + 2) * (3 * D + 1).choose D +
      59 * D + 65 * SubexpSymbolicCost.indexBits D + 319 := by
  have hc := constants_cost d W D h
  have h92 := h 92
  have h127 := h 127
  unfold SubexpNodeLocalSetup.budget SubexpNodeNumericSetup.budget
    SubexpNodeNumericSetup.widthBudget SubexpNodeExponentMaster.budget
    SubexpNodeExponentMaster.sourceBound SubexpIndexWidthProgram.runtimeBound
  omega

theorem initialization_cost (d : SubexpNodeWideSetup.Data) (W D : ℕ)
    (h : ∀ i, (d.stacks i).length ≤ W) :
    SubexpNodeWideInitialization.budget d D + 1 ≤
      20000 * (W + D + 1)^4 * (3 * D + 1).choose D := by
  have hd : ∀ i, ((SubexpNodeWideInitialization.dimensionResult d).stacks i).length ≤ W := by
    intro i
    by_cases hi : i = 109
    · simp [SubexpNodeWideInitialization.dimensionResult, hi, h 264]
    · simpa [SubexpNodeWideInitialization.dimensionResult, hi] using h i
  have hl := local_cost
    (SubexpNodeWideSetup.lowState (SubexpNodeWideInitialization.dimensionResult d)) W D
    (fun i => hd (SubexpNodeWideSetup.lowPorts i))
  have h109 := h 109
  have h264 := h 264
  have h25 := h 25
  have h125 := hd 125
  have h332 := hd 332
  have hs := slot_output_length D
  have hc := slot_cost D
  have hi : SubexpNodeWideInitialization.budget d D + 1 ≤
      120 * W + 100 * (D + 1)^2 + 25 * (3 * D + 2) * (3 * D + 1).choose D +
      80 * D + 80 * SubexpSymbolicCost.indexBits D + 500 +
      7 * SubexpCompleteSlotSetup.bound D := by
    unfold SubexpNodeWideInitialization.budget SubexpNodeWideInitialization.dimensionCost
      SubexpNodeWideInitialization.slotBound SubexpNodeWideSetup.budget
      SubexpNodeWideSetup.localBudget SubexpNodeWideSetup.indexCost
    omega
  let S := W + D + 1
  let M := (3 * D + 1).choose D
  have hS : 1 ≤ S := by dsimp [S]; omega
  have hM : 1 ≤ M := Nat.choose_pos (by omega)
  have hDP : (D + 1)^4 ≤ S^4 := Nat.pow_le_pow_left (by dsimp [S]; omega) 4
  have hSP : S ≤ S^4 := by simpa using Nat.pow_le_pow_right hS (show 1 ≤ 4 by decide)
  have hW : W ≤ S^4 := le_trans (by dsimp [S]; omega) hSP
  have hD : D ≤ S^4 := le_trans (by dsimp [S]; omega) hSP
  have h1 : 1 ≤ S^4 := Nat.one_le_pow 4 S hS
  have hD2 : (D + 1)^2 ≤ S^4 :=
    (Nat.pow_le_pow_left (by dsimp [S]; omega) 2).trans
      (Nat.pow_le_pow_right hS (by decide))
  have hI : SubexpSymbolicCost.indexBits D ≤ 4 * S^4 := by
    have hj : SubexpSymbolicCost.indexBits D ≤ 4 * (D + 1)^2 := by
      unfold SubexpSymbolicCost.indexBits
      nlinarith
    omega
  have hbase : 120 * W + 100 * (D + 1)^2 + 80 * D +
      80 * SubexpSymbolicCost.indexBits D + 500 ≤ 1120 * S^4 := by omega
  have hterm : 25 * (3 * D + 2) * M ≤ 125 * S^4 * M := by
    exact Nat.mul_le_mul_right M (by omega)
  have hslots : 7 * SubexpCompleteSlotSetup.bound D ≤ 14000 * S^4 * M := by
    have hm := Nat.mul_le_mul_right M (Nat.mul_le_mul_left 2000 hDP)
    change SubexpCompleteSlotSetup.bound D ≤ 2000 * (D + 1)^4 * M at hc
    nlinarith only [hc, hm]
  have hscale := Nat.mul_le_mul_left (1120 * S^4) hM
  change SubexpNodeWideInitialization.budget d D + 1 ≤ 20000 * S^4 * M
  change SubexpNodeWideInitialization.budget d D + 1 ≤
    120 * W + 100 * (D + 1)^2 + 25 * (3 * D + 2) * M +
    80 * D + 80 * SubexpSymbolicCost.indexBits D + 500 +
    7 * SubexpCompleteSlotSetup.bound D at hi
  nlinarith only [hi, hbase, hterm, hslots, hscale]

/-- The radius counter survives the setup prefix and initializer. Its
subsequent physical clear therefore costs only its original stored length. -/
theorem initialized_counter {er es D : ℕ} (alloc : Allocation es)
    (a b : MainState er es)
    (hi : SubexpMainNodeInitialization.Result alloc (SubexpMainNodeSetup.prepared alloc a) b D) :
    b.stacks (ordinary alloc 243) = a.stacks (ordinary alloc 243) := by
  have hs := hi.words 243
  change b.stacks (ordinary alloc 243) = _ at hs
  have hprep : (SubexpMainNodeSetup.prepared alloc a).stacks (ordinary alloc 243) =
      a.stacks (ordinary alloc 243) := by
    rw [SubexpMainNodeSetup.prepared_frame alloc a _ (by
      intro he; have hv := congrArg Fin.val he; change 243 = 91 at hv; omega) (by
      intro he; have hv := congrArg Fin.val he; change 243 = 319 at hv; omega) (by
      intro i he
      have hv := congrArg Fin.val he
      fin_cases i <;> norm_num [SubexpMainNodeHeader.targetPort, SubexpLayoutPorts.ordinary] at hv)]
    exact SubexpMainNodePreclear.result_counter alloc a
  have hstack : (SubexpMainNodeInitialization.procedure er alloc).stack (243 : Fin 352) =
      ordinary alloc 243 := by
    change SubexpMainMomentPorts.stackMap alloc 243 = ordinary alloc 243
    rfl
  have hs' : b.stacks (ordinary alloc 243) =
      (SubexpMainNodeSetup.prepared alloc a).stacks
        ((SubexpMainNodeInitialization.procedure er alloc).stack (243 : Fin 352)) := by
    simpa [SubexpNodeWideInitialization.resultStacks, SubexpNodeWideSetup.resultStacks,
      SubexpNodeWideSetup.localResult, SubexpNodeWideInitialization.dimensionResult,
      SubexpMainNodeInitialization.projected, SubexpMainNodeInitialization.procedure,
      Procedure.project, projectState] using hs
  exact hs'.trans ((congrArg (SubexpMainNodeSetup.prepared alloc a).stacks hstack).trans hprep)

def setupBound (W D : ℕ) : ℕ :=
  100000 * (W + D + 1)^4 * (3 * D + 1).choose D

theorem setup_scratch_le {er es W D : ℕ} (alloc : Allocation es)
    (a b : MainState er es) (h : RelevantWordBound W a)
    (hi : SubexpMainNodeInitialization.Result alloc (SubexpMainNodeSetup.prepared alloc a) b D) :
    SubexpMainNodeSetup.runtimeBound alloc a D +
      SubexpMainNodeScratch.runtimeBound alloc b + 2 ≤ setupBound W D := by
  have hp := preclear_cost alloc a h
  have hh := header_cost alloc _ (preclear_words alloc a h)
  have hr := reduction_cost alloc _ (header_words alloc _ (preclear_words alloc a h))
  have hn := initialization_cost
    (SubexpMainNodeInitialization.projected alloc (SubexpMainNodeSetup.prepared alloc a)) W D
    (projected_words alloc _ (prepared_words alloc a h))
  have hs : SubexpMainNodeScratch.runtimeBound alloc b ≤ 2 * W + 3 := by
    have hc := ordinary h alloc 243
    unfold SubexpMainNodeScratch.runtimeBound
    rw [initialized_counter alloc a b hi]
    omega
  have hS : 1 ≤ W + D + 1 := by omega
  have hW : W ≤ (W + D + 1)^4 :=
    le_trans (show W ≤ W + D + 1 by omega)
      (by simpa using Nat.pow_le_pow_right hS (show 1 ≤ 4 by decide))
  have h1 : 1 ≤ (W + D + 1)^4 := Nat.one_le_pow 4 _ hS
  have hm : 1 ≤ (3 * D + 1).choose D := Nat.choose_pos (by omega)
  have hmul := Nat.mul_le_mul_left ((W + D + 1)^4) hm
  unfold SubexpMainNodeSetup.runtimeBound SubexpMainNodeInitialization.runtimeBound setupBound
  change SubexpMainNodeHeader.runtimeBound alloc (SubexpMainNodeSetup.cleared alloc a) ≤ _ at hh
  change SubexpMainNodeReduction.runtimeBound alloc (SubexpMainNodeSetup.headed alloc a) ≤ _ at hr
  nlinarith only [hp, hh, hr, hn, hs, hW, h1, hmul]

/-- A convenient explicit exponential envelope for the generated arrays. -/
theorem setup_scratch_le_two_pow {er es W D : ℕ} (alloc : Allocation es)
    (a b : MainState er es) (h : RelevantWordBound W a)
    (hi : SubexpMainNodeInitialization.Result alloc (SubexpMainNodeSetup.prepared alloc a) b D) :
    SubexpMainNodeSetup.runtimeBound alloc a D +
      SubexpMainNodeScratch.runtimeBound alloc b + 2 ≤
      100000 * (W + D + 1)^4 * 2^(3 * D + 1) :=
  (setup_scratch_le alloc a b h hi).trans
    (Nat.mul_le_mul_left _ (Nat.choose_le_two_pow _ _))

/-- The same bound attached to the actual fixed setup program. -/
theorem execution_bounded {er es W D : ℕ} (alloc : Allocation es)
    (a : MainState er es) (h : RelevantWordBound W a)
    (hwidth : 0 < (a.stacks (persistent es 13)).length)
    (hD : a.stacks (master alloc 8) = List.replicate D true) :
    ∃ n b, Eval (SubexpMainNodeSetup.procedure er alloc).invoke n a b ∧
      SubexpMainNodeInitialization.Result alloc (SubexpMainNodeSetup.prepared alloc a) b D ∧
      n + SubexpMainNodeScratch.runtimeBound alloc b + 2 ≤ setupBound W D := by
  obtain ⟨n, hn, b, he, hi⟩ := SubexpMainNodeSetup.execution alloc a D hwidth hD
  exact ⟨n, b, he, hi, le_trans (by omega) (setup_scratch_le alloc a b h hi)⟩

end

end SubexponentialSAT.SubexpMainNodeSetupBounds

