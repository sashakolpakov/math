import OAI.Algorithms.SubexponentialSAT.LeanCompat
import OAI.Algorithms.SubexponentialSAT.SubexpCountExecution
import OAI.Algorithms.SubexponentialSAT.SubexpTaylorExecution

namespace OAI.Algorithms

/-!
# Compile source rows into the represented counting input

The input records contain finite polynomial syntax for each row.  The
constructor below executes the represented compiler and Taylor shift to
produce every factor record.  No Taylor-array correctness premise is needed.
Scalar conversions remain parameters so concrete word encodings can supply
them without duplicating the source-data record.
-/

namespace SubexponentialSAT.SubexpCountSource

open SubexpLayoutSpec

variable {D p k Δ r : ℕ} {tau : ℚ} [Fact p.Prime]
  {F CK C : Type*} [Fintype F] [DecidableEq F]
  (S : Factor.System (Fin D) F (ZMod p))
  {c : Parameters p k Δ r tau}
  (L : Layout (E := SubexpActualRing.E p) S.toPattern c)
  (kops : SubexpSymbolicCost.RepresentedRing CK (SubexpActualRing.E p))
  (ops : SubexpSymbolicCost.RepresentedRing C (SubexpActualRing.Ring p (D + 1)))

local notation "A" => SubexpCounting.selectedLiftedLayout S L (D + 1) (Nat.succ_pos D)
local notation "coord" => SubexpActualRing.coordinateLift p (D + 1)
local notation "coordUnits" => SubexpActualRing.coordinateLift_unitDifferences p (D + 1)
local notation "sectionLift" => SubexpActualRing.residueSection p (D + 1) (Nat.succ_pos D)
local notation "baseMap" => LiftRing.of (SubexpActualRing.F p (D + 1))
local notation "labels" =>
  (fun i : Fin p => ops.decode (List.Vector.get
    (Prod.fst (SubexpTableExecution.labelsProgram ops.program p)) i))
local notation "labelUnits" => SubexpTableExecution.encodedIntegerUnits ops (D + 1)
  (Fact.out : p.Prime) baseMap _ (SubexpTableExecution.labelsProgram_correct ops p)

/-- Finite source data and local representation identities.  This record
contains neither precomputed Taylor arrays nor any counting-result premise. -/
structure SourceInput where
  node : Fin c.Q → C
  node_decode : ∀ t, ops.decode (node t) = (A).theta t
  enumeration : ∀ t, EnumerationData L t
  supports : Fin c.Q → Fin r → List (Fin D)
  supports_eq : supports = SubexpEnumerationCode.supportLists L
  outside : Fin c.Q → List (Fin D)
  outside_eq : outside = SubexpEnumerationCode.outsideList L
  bases : Fin c.Q → List (Fin D → ZMod p)
  bases_eq : bases = fun t => SubexpEnumerationCode.outerBases (enumeration t)
  increments : Fin c.Q → Fin r → List (Fin D → ZMod p)
  increments_eq : increments = fun t => SubexpEnumerationCode.innerIncrements (enumeration t)
  factors : List F
  factors_nodup : factors.Nodup
  factors_complete : ∀ e, e ∈ factors
  source : Fin c.Q → F → SubexpFactorCode.FactorSource D p r CK C
  scopeIndex : ∀ t e, Fin (source t e).arity ≃ {v // v ∈ S.scope e}
  color_eq : ∀ t e, (source t e).color = L.color e t
  table_eq : ∀ t e, SubexpTableInterpolation.tablePolynomial labels labelUnits
    ((source t e).table.map (SubexpRepresentedBuilder.mapRow ops.decode)) =
      MvPolynomial.rename (scopeIndex t e).symm
        (GlobalPolynomial.interpolatedTable S coord coordUnits e)
  origin_eq : ∀ t e i w, kops.decode ((source t e).origin i w) =
    (L.row e (scopeIndex t e i) w).eval (L.node t)
  row_eq : ∀ t e i w,
    (SubexpTaylorExecution.mapCode ops.decode ((source t e).rows i w)).denote =
      (A).row e (scopeIndex t e i) w

namespace SourceInput

variable (input : SourceInput S L kops ops)
  (embed : ZMod p → CK) (betaLift : CK → C) (weightLift : ZMod p → C)
  (hembed : ∀ z, kops.decode (embed z) = algebraMap (ZMod p) (SubexpActualRing.E p) z)
  (hbeta : ∀ x, ops.decode (betaLift x) = (sectionLift).lift (kops.decode x))
  (hweight : ∀ z, ops.decode (weightLift z) = coord z)

/-- The factor data are generated by the decoder-free represented Taylor
compiler.  All required Taylor identities follow from the source row syntax. -/
noncomputable def toSelectedInput (input : SourceInput S L kops ops)
    (embed : ZMod p → CK) (betaLift : CK → C) (weightLift : ZMod p → C)
    (hembed : ∀ z, kops.decode (embed z) = algebraMap (ZMod p) (SubexpActualRing.E p) z)
    (hbeta : ∀ x, ops.decode (betaLift x) = (sectionLift).lift (kops.decode x))
    (hweight : ∀ z, ops.decode (weightLift z) = coord z) :
    SubexpCountExecution.SelectedInput S L kops ops where
  node := input.node
  node_decode := input.node_decode
  embed := embed
  embed_decode := hembed
  betaLift := betaLift
  beta_decode := hbeta
  weightLift := weightLift
  weight_decode := hweight
  enumeration := input.enumeration
  supports := input.supports
  supports_eq := input.supports_eq
  outside := input.outside
  outside_eq := input.outside_eq
  bases := input.bases
  bases_eq := input.bases_eq
  increments := input.increments
  increments_eq := input.increments_eq
  factors := input.factors
  factors_nodup := input.factors_nodup
  factors_complete := input.factors_complete
  data t e := (SubexpTaylorExecution.buildFactorProgram ops.program (input.node t) c.R
    (input.source t e)).data
  scopeIndex := input.scopeIndex
  color_eq := input.color_eq
  table_eq := input.table_eq
  origin_eq := input.origin_eq
  taylor_eq := by
    intro t e i j w
    rw [← input.node_decode t]
    exact SubexpTaylorExecution.buildFactorProgram_taylor_eq ops (input.node t) c.R
      (input.source t e) (fun i w => (A).row e (input.scopeIndex t e i) w)
      (input.row_eq t e) i j w

/-- Source compilation, moment execution, and CRT recover the true global
polynomial from the local source identities. -/
theorem run_denote (input : SourceInput S L kops ops)
    (embed : ZMod p → CK) (betaLift : CK → C) (weightLift : ZMod p → C)
    (hembed : ∀ z, kops.decode (embed z) = algebraMap (ZMod p) (SubexpActualRing.E p) z)
    (hbeta : ∀ x, ops.decode (betaLift x) = (sectionLift).lift (kops.decode x))
    (hweight : ∀ z, ops.decode (weightLift z) = coord z) (hD : 0 < D) :
    PolynomialAlgorithm.denote
      ((SubexpCountExecution.runSelected S L kops ops
        (toSelectedInput S L kops ops input embed betaLift weightLift
          hembed hbeta hweight)).1.map ops.decode) =
      GlobalPolynomial.interpolatedGlobalPolynomial S coord coordUnits (A).row :=
  SubexpCountExecution.runSelected_denote S L kops ops _ hD

/-- The constant coefficient obtained from compiled source rows is the
whole natural count represented in the selected prime-power ring. -/
theorem run_coeff_zero (input : SourceInput S L kops ops)
    (embed : ZMod p → CK) (betaLift : CK → C) (weightLift : ZMod p → C)
    (hembed : ∀ z, kops.decode (embed z) = algebraMap (ZMod p) (SubexpActualRing.E p) z)
    (hbeta : ∀ x, ops.decode (betaLift x) = (sectionLift).lift (kops.decode x))
    (hweight : ∀ z, ops.decode (weightLift z) = coord z) (hD : 0 < D) :
    (PolynomialAlgorithm.denote
      ((SubexpCountExecution.runSelected S L kops ops
        (toSelectedInput S L kops ops input embed betaLift weightLift
          hembed hbeta hweight)).1.map ops.decode)).coeff 0 =
      (Factor.count S : SubexpActualRing.Ring p (D + 1)) :=
  SubexpCountExecution.runSelected_coeff_zero S L kops ops _ hD

end SourceInput

end SubexponentialSAT.SubexpCountSource

end OAI.Algorithms
