import OAI.Algorithms.SubexponentialSAT.LeanCompat
import OAI.Algorithms.SubexponentialSAT.SqrtLog.LeafRingSetupProgramPorts
import OAI.Algorithms.SubexponentialSAT.Subexp.TupleProgram
import OAI.Algorithms.SubexponentialSAT.SqrtLog.LeafParametersProgramSerializationUnary

namespace OAI.Algorithms

/-! Paid word movement and binary-to-unary conversion used by ring setup.
The helpers update actual tapes; a state equality is never used as a free
copy, clear, or counter conversion. -/
namespace SubexponentialSAT.SqrtLog.LeafRingSetupProgram

open BitProgram StructuredCalls StackRoutines

abbrev clear (dst : Fin 640) : Cmd 32 640 :=
  .call (clearProgram dst 30 31)

abbrev copy (src dst : Fin 640) : Cmd 32 640 :=
  .call (copyProgram src dst 639 30 31)

theorem clear_eval (dst : Fin 640) (a : Data) :
    Eval (clear dst) (2*(a.stacks dst).length+3) a
      ⟨readRegs a.regs 30 31 none, Function.update a.stacks dst []⟩ :=
  Subexp.TupleProgram.clear_eval dst 30 31 a

theorem copy_eval (src dst : Fin 640) (a : Data)
    (hsd : src ≠ dst) (hs : src ≠ 639) (hd : (639 : Fin 640) ≠ dst)
    (hw : a.stacks 639 = []) :
    Eval (copy src dst) (7*(a.stacks src).length+5) a
      ⟨readRegs a.regs 30 31 none,
        Function.update a.stacks dst (a.stacks src ++ a.stacks dst)⟩ :=
  Subexp.TupleProgram.copy_eval src dst 639 30 31 hsd hs hd (by decide) a hw

abbrev overwrite (src dst : Fin 640) : Cmd 32 640 :=
  .seq (clear dst) (copy src dst)

/-- Clear the destination before copying.  This supports reuse of physical
scratch without requiring its previous value to vanish for free. -/
theorem overwrite_eval (src dst : Fin 640) (a : Data)
    (hsd : src ≠ dst) (hs : src ≠ 639) (hd : (639 : Fin 640) ≠ dst)
    (hw : a.stacks 639 = []) :
    Eval (overwrite src dst) (2*(a.stacks dst).length+7*(a.stacks src).length+8) a
      ⟨readRegs a.regs 30 31 none, Function.update a.stacks dst (a.stacks src)⟩ := by
  let b : Data := ⟨readRegs a.regs 30 31 none, Function.update a.stacks dst []⟩
  have hc := clear_eval dst a
  have hp := copy_eval src dst b hsd hs hd (by simpa [b, hd] using hw)
  convert hc.seq hp using 1 <;>
    simp [ b, hsd, readRegs_reset] ; omega

def unaryRegisters : Fin 3 → Fin 32 := ![29,30,31]

def unaryPorts (src dst : Fin 640) (i : Fin 14) : Fin 640 :=
  if i = 0 then src else if i = 1 then dst else ⟨625+i.val, by omega⟩

theorem unaryRegisters_injective : Function.Injective unaryRegisters := by decide

theorem unaryPorts_injective (src dst : Fin 640) (hs : src.val < 625)
    (hd : dst.val < 625) (hne : src ≠ dst) :
    Function.Injective (unaryPorts src dst) := by
  intro i j hij
  by_cases hi0 : i = 0
  · subst i
    by_cases hj0 : j = 0
    · exact hj0.symm
    by_cases hj1 : j = 1
    · subst j
      exfalso
      apply hne
      simpa [unaryPorts] using hij
    · have hh := congrArg Fin.val hij
      simp [unaryPorts, hj0, hj1] at hh
      omega
  by_cases hi1 : i = 1
  · subst i
    by_cases hj0 : j = 0
    · subst j; simp [unaryPorts, Ne.symm hne] at hij
    by_cases hj1 : j = 1
    · exact hj1.symm
    · have hh := congrArg Fin.val hij
      simp [unaryPorts, hj0, hj1] at hh
      omega
  by_cases hj0 : j = 0
  · subst j
    have hh := congrArg Fin.val hij
    simp [unaryPorts, hi0, hi1] at hh
    omega
  by_cases hj1 : j = 1
  · subst j
    have hh := congrArg Fin.val hij
    simp [unaryPorts, hi0, hi1] at hh
    omega
  apply Fin.ext
  have hh := congrArg Fin.val hij
  simp [unaryPorts, hi0, hi1, hj0, hj1] at hh
  omega

abbrev unary (src dst : Fin 640) : Cmd 32 640 :=
  liftCommand (LeafParametersProgram.Serialization.unaryCopy 0 1) 0 1
    unaryRegisters (unaryPorts src dst)

/-- The unary counter is generated by the actual bounded conversion loop.
The only cleared inputs required here are its destination and three local
scratch tapes; callers pay to establish those using `clear_eval`. -/
theorem unary_eval (src dst : Fin 640) (a : Data)
    (hs : src.val < 625) (hd : dst.val < 625) (hne : src ≠ dst)
    (h1 : a.stacks dst = []) (h11 : a.stacks 636 = [])
    (h12 : a.stacks 637 = []) (h13 : a.stacks 638 = []) :
    ∃ n ≤ LeafParametersProgram.Serialization.unaryCopyBound (a.stacks src)+1,
      Eval (unary src dst) n a
        (embedState unaryRegisters (unaryPorts src dst) a
          (SubexpClauseMastersProgram.write
            (projectState unaryRegisters (unaryPorts src dst) a) 1
            (List.replicate (BinaryArithmetic.toNat (a.stacks src)) true))) := by
  let d := projectState unaryRegisters (unaryPorts src dst) a
  obtain ⟨n, hn, he⟩ := LeafParametersProgram.Serialization.unaryCopy_eval 0 1 d
    (by decide) (by decide) (by decide) (by decide)
    (by simpa [d, projectState, unaryPorts] using h1)
    (by simpa [d, projectState, unaryPorts] using h11)
    (by simpa [d, projectState, unaryPorts] using h12)
    (by simpa [d, projectState, unaryPorts] using h13)
  refine ⟨n+1, ?_, ?_⟩
  · simpa [d, projectState, unaryPorts] using Nat.add_le_add_right hn 1
  · simpa [unary, d, projectState, unaryPorts] using
      eval_liftCommand_from_state (LeafParametersProgram.Serialization.unaryCopy 0 1)
        0 1 unaryRegisters (unaryPorts src dst) a unaryRegisters_injective
        (unaryPorts_injective src dst hs hd hne) he

def clearPorts : List (Fin 640) → Cmd 32 640
  | [] => .base .skip
  | p :: ps => .seq (clear p) (clearPorts ps)

def clearResult (a : Data) (p : Fin 640) : Data :=
  ⟨readRegs a.regs 30 31 none, Function.update a.stacks p []⟩

def clearedPorts : List (Fin 640) → Data → Data
  | [], a => a
  | p :: ps, a => clearedPorts ps (clearResult a p)

def clearPortsCost : List (Fin 640) → Data → ℕ
  | [], _ => 0
  | p :: ps, a => 2*(a.stacks p).length+3+clearPortsCost ps (clearResult a p)

theorem clearPorts_eval (ps : List (Fin 640)) (a : Data) :
    Eval (clearPorts ps) (clearPortsCost ps a) a (clearedPorts ps a) := by
  induction ps generalizing a with
  | nil => exact .base (.skip _)
  | cons p ps ih => exact (clear_eval p a).seq (ih _)

theorem clearedPorts_stacks (ps : List (Fin 640)) (a : Data) (i : Fin 640) :
    (clearedPorts ps a).stacks i = if i ∈ ps then [] else a.stacks i := by
  induction ps generalizing a with
  | nil => simp [clearedPorts]
  | cons p ps ih =>
    simp only [clearedPorts, ih, List.mem_cons, clearResult]
    by_cases hi : i=p
    · subst i
      simp
    · by_cases hm : i ∈ ps <;> simp [hi,hm]

theorem clearPortsCost_bound (ps : List (Fin 640)) (a : Data) (W : ℕ)
    (hw : ∀ p ∈ ps, (a.stacks p).length ≤ W) :
    clearPortsCost ps a ≤ ps.length*(2*W+3) := by
  induction ps generalizing a with
  | nil => simp [clearPortsCost]
  | cons p ps ih =>
    have hp := hw p (by simp)
    have htail : ∀ q ∈ ps, ((clearResult a p).stacks q).length ≤ W := by
      intro q hq
      by_cases h : q=p
      · simp [clearResult,h]
      · simpa [clearResult,h] using hw q (by simp [hq])
    have ht := ih (clearResult a p) htail
    simp only [clearPortsCost, List.length_cons]
    nlinarith

end SubexponentialSAT.SqrtLog.LeafRingSetupProgram

end OAI.Algorithms
