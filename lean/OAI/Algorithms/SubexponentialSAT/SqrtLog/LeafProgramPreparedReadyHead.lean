import OAI.Algorithms.SubexponentialSAT.LeanCompat
import OAI.Algorithms.SubexponentialSAT.SqrtLog.LeafProgramNodeNativeWords
import OAI.Algorithms.SubexponentialSAT.SqrtLog.LayoutProgramSourceParametersBytes

namespace OAI.Algorithms

/-! Exact source words generated by the physical head preparation. -/
namespace SubexponentialSAT.SqrtLog.LeafProgram.PreparedReady
open SubexponentialSAT BitProgram StructuredCalls LeafHeadSetupProgram
open NodeNative LayoutProgram
attribute [local simp] Fin.coe_ofNat_eq_mod

private theorem cleanupPorts_710 : (710 : Fin 768) ∈ Node.cleanupPorts := by
  exact (Node.mem_cleanup _).mpr (by norm_num)
private theorem cleanupPorts_711 : (711 : Fin 768) ∈ Node.cleanupPorts := by
  exact (Node.mem_cleanup _).mpr (by norm_num)
private theorem cleanupPorts_712 : (712 : Fin 768) ∈ Node.cleanupPorts := by
  exact (Node.mem_cleanup _).mpr (by norm_num)

variable {s : HeadInputs} {a b : NodeNative.Data}
    (pr : Preparation s a b) (ha : NodeNative.Ready s a)

include pr ha

theorem generated_positive : b.stacks 710=pr.head.words.flatten := by
  rw [pr.support_frame 710 (by decide),pr.cached_words,
    LeafNodeCacheProgram.cache_frame _ 710 (by decide)]
  change pr.headEnd.stacks 710=_
  rw [pr.head.positive,pr.loaded_words]
  have he := LayoutMasters.loaded_frame (LayoutMasters.project a) 710
    (NodeNative.not_low_of_ge (by decide))
  change (loadedState a).stacks 710=a.stacks 710 at he
  rw [he,ha.blank 710 cleanupPorts_710 (by decide),List.append_nil]

theorem generated_negative : b.stacks 711=List.replicate (s.R*s.width.length) false := by
  rw [pr.support_frame 711 (by decide),pr.cached_words,
    LeafNodeCacheProgram.cache_frame _ 711 (by decide)]
  change pr.headEnd.stacks 711=_
  rw [pr.head.negative,pr.loaded_words]
  have he := LayoutMasters.loaded_frame (LayoutMasters.project a) 711
    (NodeNative.not_low_of_ge (by decide))
  change (loadedState a).stacks 711=a.stacks 711 at he
  rw [he,ha.blank 711 cleanupPorts_711 (by decide),List.append_nil]

theorem generated_power : b.stacks 712=s.power.1 := by
  rw [pr.support_frame 712 (by decide),pr.cached_words,
    LeafNodeCacheProgram.cache_frame _ 712 (by decide)]
  change pr.headEnd.stacks 712=_
  rw [pr.head.denominator,pr.loaded_words]
  have he := LayoutMasters.loaded_frame (LayoutMasters.project a) 712
    (NodeNative.not_low_of_ge (by decide))
  change (loadedState a).stacks 712=a.stacks 712 at he
  rw [he,ha.blank 712 cleanupPorts_712 (by decide),List.append_nil]

theorem loaded_layout :
    b.stacks 128=unary s.n ∧ b.stacks 130=unary s.r ∧
    b.stacks 131=unary s.Q ∧ b.stacks 132=unary (s.Q*s.r) ∧
    b.stacks 135=s.metadata ∧ b.stacks 136=LayoutOwnerFiberProgram.stream s.plans ∧
    b.stacks 138=unary s.R ∧ b.stacks 139=s.height ∧ b.stacks 140=s.width := by
  exact ⟨(pr.loaded_word 0).trans ha.heads.ambient,
    (pr.loaded_word 2).trans ha.heads.colors,(pr.loaded_word 3).trans ha.heads.nodes,
    (pr.loaded_word 4).trans ha.heads.wordWidth,(pr.loaded_word 7).trans ha.heads.metadata,
    (pr.loaded_word 8).trans ha.heads.plans,(pr.loaded_word 10).trans ha.heads.order,
    (pr.loaded_word 11).trans ha.heads.height,(pr.loaded_word 12).trans ha.heads.width⟩

end SubexponentialSAT.SqrtLog.LeafProgram.PreparedReady

end OAI.Algorithms
