import OAI.Algorithms.SubexponentialSAT.LeanCompat
import OAI.Algorithms.SubexponentialSAT.SqrtLog.LeafProgramQueryPackingEmpty
import OAI.Algorithms.SubexponentialSAT.SqrtLog.LeafProgramQueryBank
import OAI.Algorithms.SubexponentialSAT.SqrtLog.LeafProgramQueryBranches
import OAI.Algorithms.SubexponentialSAT.SqrtLog.PackingCallerProgramOutput

namespace OAI.Algorithms

/-! The native packing service is invoked using physically measured query
statistics. Its complete word alphabet is generated by the service, and the
live arithmetic-parameter bank survives beside its private workspace. -/
namespace SubexponentialSAT.SqrtLog.LeafProgram.Query
open SubexponentialSAT BitProgram StructuredCalls LeafParametersProgram MulticolorTypes Subexp

 theorem packing_run (q : LeafQueryFrontend.Query) (k : ℕ) (a : Data)
    (hg : Guard (q.input k)) (l : Fin 8 → ℕ) (bw : Bank.Words) (br : Bank.Regs)
    (hex : LeafQueryFrontend.Exported (Execute.guardedModel (q.input k) l) a)
    (hscopes : a.stacks 718=LeafStatisticsProgram.scopeBits q.scopeRows)
    (hmask : a.stacks 719=q.forward) (hambient : a.stacks 709=q.ambient)
    (hz : LeafQueryFrontend.emptyRange a 417 680) (hspare : PackingSpare a)
    (hbank : projectState Exports.bankRegs Exports.bank a=Bank.state br bw)
    (W : ℕ) (hwidth : ∀i,(a.stacks i).length ≤ W) :
    let p := packingProblem q k hg
    ∃ w : Word p.r p.Q, ∃ tail : List (Word p.r p.Q), ∃ n b,
      (w::tail).Nodup ∧ (∀z,z∈w::tail) ∧
      n+1 ≤ PackingCallerProgram.budget a p w tail ∧
      Eval PackingCallerProgram.command n a b ∧
      b.stacks=(PackingCallerProgram.result a p w tail).stacks ∧
      projectState (LeafRingSetupProgram.registers 8 (by decide)) LeafRingSetupProgram.parameters
        (projectState LeafRingSetupProgram.wideRegisters LeafRingSetupProgram.wideStacks b)=
        Bank.state (b.regs ∘ Exports.bankRegs) bw ∧
      (∀i : Fin 768,(i.val < 417 ∨ 481 ≤ i.val) →
        (i.val < 128 ∨ 142 ≤ i.val) → (i.val < 730 ∨ 744 ≤ i.val) → b.stacks i=a.stacks i) ∧
      (∀i : Fin 40,16 ≤ i.val → b.regs i=a.regs i) ∧
      (∀i,(b.stacks i).length ≤ W+PackingCallerProgram.budget a p w tail) ∧
      (w::tail).map ReadPlan.encodeWord=AssignmentAlphabetSemantics.wordBytes p.r p.Q := by
  dsimp only
  let p := packingProblem q k hg
  have hs := packing_sources q k a hg l hex hscopes hmask hambient
  have he := packing_empty a hz hspare
  obtain ⟨w,tail,hrows,hn,hall⟩ := AssignmentAlphabetSemantics.wordBytes_order p.hr p.Q
  obtain ⟨n,b,hcost,hrun,hstacks,hregs⟩ := PackingCallerProgram.command_eval a p hs he w tail hrows hn hall
  have hf (i : Fin 768) (hb : i.val < 417 ∨ 481 ≤ i.val)
      (hl : i.val < 128 ∨ 142 ≤ i.val) (hh : i.val < 730 ∨ 744 ≤ i.val) :
      b.stacks i=a.stacks i := by
    rw [hstacks]
    exact PackingCallerProgram.result_frame a p w tail i hb hl hh
  refine ⟨w,tail,n,b,hn,hall,hcost,hrun,hstacks,?_,hf,hregs,?_,hrows⟩
  · apply ring_bank_of_frame a b bw br hbank
    intro i hlo hhi
    exact hf i (Or.inl hhi) (Or.inr (by omega)) (Or.inl (by omega))
  · intro i
    change (b.stacks i).length ≤ W+PackingCallerProgram.budget a p w tail
    exact (eval_width hrun W hwidth i).trans (Nat.add_le_add_left (by omega) W)

end SubexponentialSAT.SqrtLog.LeafProgram.Query

end OAI.Algorithms
