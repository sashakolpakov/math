import OAI.Algorithms.SubexponentialSAT.LeanCompat
import OAI.Algorithms.SubexponentialSAT.SqrtLog.IdempotentPreparationProgramMetadata

namespace OAI.Algorithms

/-! Real allocation of the padded Newton arrays. Prefix coefficient words are
computed scalar cache entries; the zero suffix is generated by native copying
from one zero word and a runtime unary dimension. -/
namespace SubexponentialSAT.SqrtLog.IdempotentPreparationProgram

open BitProgram StructuredCalls SubexpScanPrimitives

abbrev popCount : Cmd 8 41 := .base (.atom (.pop 1 0 1))

def popCounts : ℕ → Cmd 8 41
  | 0 => .base .skip
  | n+1 => .seq popCount (popCounts n)

theorem popCounts_eval (drop n : ℕ) (d : Data)
    (hc : d.stacks 1 = List.replicate (n+drop) true) :
    ∃ rf, Eval (popCounts drop) drop d
      ⟨rf, Function.update d.stacks 1 (List.replicate n true)⟩ := by
  induction drop generalizing d with
  | zero =>
      simp only [Nat.add_zero] at hc
      refine ⟨d.regs, ?_⟩
      simpa [popCounts,←hc] using (Eval.base (StructuredProgram.Eval.skip d))
  | succ drop ih =>
      let a : Data := ⟨readRegs d.regs 0 1 (some true),
        Function.update d.stacks 1 (List.replicate (n+drop) true)⟩
      have hp : Eval popCount 1 d a := by
        have hh : d.stacks 1 = true :: List.replicate (n+drop) true := by
          simpa only [Nat.add_succ,List.replicate_succ] using hc
        have h := Eval.base (StructuredProgram.Eval.atom
          (StructuredProgram.Atom.pop (r:=8) (s:=41) 1 0 1) d)
        change Eval popCount 1 d ⟨readRegs d.regs 0 1 (d.stacks 1).head?,
          Function.update d.stacks 1 (d.stacks 1).tail⟩ at h
        simpa only [hh,List.head?_cons,List.tail_cons] using h
      obtain ⟨rf,hr⟩ := ih a (by simp [a])
      refine ⟨rf,?_⟩
      simpa [popCounts,a,Function.update_idem,Nat.add_comm] using hp.seq hr

abbrev paddedZeros (target : Fin 41) (drop : ℕ) : Cmd 8 41 :=
  .seq (.call (StackRoutines.copyProgram 37 1 2 (0 : Fin 8) 1))
    (.seq (popCounts drop) (repeatAt 17 target 2 1))

theorem paddedZeros_eval (d : Data) (target : Fin 41) (drop n : ℕ)
    (hd : d.stacks 37 = List.replicate (n+drop) true)
    (h1 : d.stacks 1 = []) (h2 : d.stacks 2 = [])
    (ht1 : target ≠ 1) (ht2 : target ≠ 2) (ht17 : target ≠ 17) :
    ∃ rf, Eval (paddedZeros target drop)
      (7*(n+drop)+5+drop+(n*(7*(d.stacks 17).length+7)+6)) d
      ⟨rf, Function.update d.stacks target
        (Subexp.BlockCopyProgram.copies n (d.stacks 17) ++ d.stacks target)⟩ := by
  let a := afterCopy d 37 1 0 1
  have hc := copy_eval d 37 1 2 0 1 (by decide) (by decide) (by decide) (by decide) h2
  obtain ⟨rf,hp⟩ := popCounts_eval drop n a
    (by simp [a,afterCopy,StackRoutines.copyStacks,hd,h1])
  let b : Data := ⟨rf,Function.update a.stacks 1 (List.replicate n true)⟩
  have hbs : b.stacks = Function.update d.stacks 1 (List.replicate n true) := by
    simp [b,a,afterCopy,StackRoutines.copyStacks,Function.update_idem]
  have hr := repeatAt_eval b 17 target 2 1 (by
    intro i j hij
    fin_cases i <;> fin_cases j <;>
      simp_all [repeatPorts,Ne.symm ht1,Ne.symm ht2,Ne.symm ht17])
    n (by simp [hbs]) (by simp [hbs,h2])
  have he := hc.seq (hp.seq hr)
  let final := repeated b target 1 n (b.stacks 17)
  have hs : final.stacks = Function.update d.stacks target
      (Subexp.BlockCopyProgram.copies n (d.stacks 17) ++ d.stacks target) := by
    simp [final,repeated,hbs,ht1,Function.update_idem,←h1]
  refine ⟨final.regs,?_⟩
  have hf : final = ⟨final.regs,Function.update d.stacks target
      (Subexp.BlockCopyProgram.copies n (d.stacks 17) ++ d.stacks target)⟩ := state_ext rfl hs
  change Eval _ _ _ final at he
  rw [hf] at he
  convert he using 1 ; simp [hd,hbs] ; omega

def copySources (target : Fin 41) : List (Fin 41) → Cmd 8 41
  | [] => .base .skip
  | source :: rest => .seq
      (.call (StackRoutines.copyProgram source target 2 (0 : Fin 8) 1))
      (copySources target rest)

def copiedSources (target : Fin 41) : List (Fin 41) → Data → Data
  | [], d => d
  | source :: rest, d => copiedSources target rest (afterCopy d source target 0 1)

def copiedSourcesCost (target : Fin 41) : List (Fin 41) → Data → ℕ
  | [], _ => 0
  | source :: rest, d => 7*(d.stacks source).length+5+
      copiedSourcesCost target rest (afterCopy d source target 0 1)

theorem copySources_eval (target : Fin 41) (sources : List (Fin 41)) (d : Data)
    (ht : (2 : Fin 41) ≠ target) (hs : d.stacks 2 = [])
    (hd : ∀ source ∈ sources, source ≠ target ∧ source ≠ 2) :
    Eval (copySources target sources) (copiedSourcesCost target sources d) d
      (copiedSources target sources d) := by
  induction sources generalizing d with
  | nil => exact .base (.skip _)
  | cons source rest ih =>
      have hsource := hd source (by simp)
      have hc := copy_eval d source target 2 0 1 hsource.1 hsource.2 ht (by decide) hs
      have hr := ih (afterCopy d source target 0 1)
        (by simp [afterCopy,StackRoutines.copyStacks,ht,hs])
        (by intro i hi; exact hd i (by simp [hi]))
      exact hc.seq hr

/-- The first array stores `(2u,-3u,u,0,...)`; the three cache source words
are prepended in reverse order to the freshly allocated zero suffix. -/
abbrev initialArray : Cmd 8 41 :=
  .seq (paddedZeros 32 3) (copySources 32 [27,31,30])

abbrev negativeOneArray : Cmd 8 41 :=
  .seq (paddedZeros 36 1)
    (.call (StackRoutines.copyProgram 28 36 2 (0 : Fin 8) 1))

abbrev cloneInitial : Cmd 8 41 :=
  .seq (.call (StackRoutines.copyProgram 32 33 2 (0 : Fin 8) 1)) <|
  .seq (.call (StackRoutines.copyProgram 32 34 2 (0 : Fin 8) 1))
    (.call (StackRoutines.copyProgram 32 35 2 (0 : Fin 8) 1))

def initialBits (d : Data) (n : ℕ) : List Bool :=
  d.stacks 30 ++ d.stacks 31 ++ d.stacks 27 ++
    Subexp.BlockCopyProgram.copies n (d.stacks 17)

theorem initialArray_eval (d : Data) (n : ℕ)
    (hd : d.stacks 37 = List.replicate (n+3) true)
    (h1 : d.stacks 1 = []) (h2 : d.stacks 2 = []) (h32 : d.stacks 32 = []) :
    ∃ cost rf, cost = 7*(n+3)+5+3+(n*(7*(d.stacks 17).length+7)+6) +
      (7*(d.stacks 27).length+5+(7*(d.stacks 31).length+5+
        (7*(d.stacks 30).length+5))) ∧
      Eval initialArray cost d ⟨rf,Function.update d.stacks 32 (initialBits d n)⟩ := by
  obtain ⟨ra,ha⟩ := paddedZeros_eval d 32 3 n hd h1 h2 (by decide) (by decide) (by decide)
  let a : Data := ⟨ra,Function.update d.stacks 32
    (Subexp.BlockCopyProgram.copies n (d.stacks 17))⟩
  have ha' : Eval (paddedZeros 32 3)
      (7*(n+3)+5+3+(n*(7*(d.stacks 17).length+7)+6)) d a := by
    simpa [a,h32] using ha
  have hb := copySources_eval 32 [27,31,30] a (by decide)
    (by simp [a,h2]) (by simp)
  have hs : (copiedSources 32 [27,31,30] a).stacks =
      Function.update d.stacks 32 (initialBits d n) := by
    simp [copiedSources,afterCopy,StackRoutines.copyStacks,a,initialBits,
      Function.update_idem,List.append_assoc]
  have hf : copiedSources 32 [27,31,30] a =
      ⟨(copiedSources 32 [27,31,30] a).regs,Function.update d.stacks 32 (initialBits d n)⟩ :=
    state_ext rfl hs
  have he := ha'.seq hb
  rw [hf] at he
  refine ⟨_,(copiedSources 32 [27,31,30] a).regs,rfl,?_⟩
  simpa [initialArray,copiedSourcesCost,afterCopy,StackRoutines.copyStacks,a] using he

theorem negativeOneArray_eval (d : Data) (n : ℕ)
    (hd : d.stacks 37 = List.replicate (n+1) true)
    (h1 : d.stacks 1 = []) (h2 : d.stacks 2 = []) (h36 : d.stacks 36 = []) :
    ∃ rf, Eval negativeOneArray
      (7*(n+1)+5+1+(n*(7*(d.stacks 17).length+7)+6)+(7*(d.stacks 28).length+5)) d
      ⟨rf,Function.update d.stacks 36
        (d.stacks 28 ++ Subexp.BlockCopyProgram.copies n (d.stacks 17))⟩ := by
  obtain ⟨ra,ha⟩ := paddedZeros_eval d 36 1 n hd h1 h2 (by decide) (by decide) (by decide)
  let a : Data := ⟨ra,Function.update d.stacks 36
    (Subexp.BlockCopyProgram.copies n (d.stacks 17))⟩
  have ha' : Eval (paddedZeros 36 1)
      (7*(n+1)+5+1+(n*(7*(d.stacks 17).length+7)+6)) d a := by
    simpa [a,h36] using ha
  have hb := copy_eval a 28 36 2 0 1 (by decide) (by decide) (by decide)
    (by decide) (by simp [a,h2])
  have he := ha'.seq hb
  refine ⟨(afterCopy a 28 36 0 1).regs,?_⟩
  simpa [negativeOneArray,a,afterCopy,StackRoutines.copyStacks,Function.update_idem] using he

theorem cloneInitial_eval (d : Data) (h2 : d.stacks 2 = [])
    (h33 : d.stacks 33 = []) (h34 : d.stacks 34 = []) (h35 : d.stacks 35 = []) :
    ∃ rf, Eval cloneInitial (21*(d.stacks 32).length+15) d
      ⟨rf,Function.update (Function.update (Function.update d.stacks
        33 (d.stacks 32)) 34 (d.stacks 32)) 35 (d.stacks 32)⟩ := by
  let a := afterCopy d 32 33 0 1
  let b := afterCopy a 32 34 0 1
  have ha := copy_eval d 32 33 2 0 1 (by decide) (by decide) (by decide) (by decide) h2
  have hb := copy_eval a 32 34 2 0 1 (by decide) (by decide) (by decide) (by decide)
    (by simp [a,afterCopy,StackRoutines.copyStacks,h2])
  have hc := copy_eval b 32 35 2 0 1 (by decide) (by decide) (by decide) (by decide)
    (by simp [b,a,afterCopy,StackRoutines.copyStacks,h2])
  have he := ha.seq (hb.seq hc)
  refine ⟨(afterCopy b 32 35 0 1).regs,?_⟩
  convert he using 1 <;>
    simp [b,a,afterCopy,StackRoutines.copyStacks,h33,h34,h35] ; ring

end SubexponentialSAT.SqrtLog.IdempotentPreparationProgram

end OAI.Algorithms
