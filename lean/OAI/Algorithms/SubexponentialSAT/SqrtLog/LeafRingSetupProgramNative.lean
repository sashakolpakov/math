/-- An actual prefix of the complete setup: generated numeric metadata is
serialized and then used by the scalar/extension-ring construction. -/
abbrev coreFromBankCommand : Cmd 32 640 := .seq numberPhase coreCommand

theorem coreFromBankCommand_eval (a : Data) (m : Circuit.Model)
    (w : Bank.Words) (r : Bank.Regs) (hs : Circuit.Shape m w)
    (ha : projectState (registers 8 (by decide)) parameters a=Bank.state r w)
    (initialWidth V W : ℕ)
    (hinit : ∀ i∈workPorts++outputPorts, (a.stacks i).length ≤ initialWidth)
    (hv : ∀ i, (Circuit.result Serialization.code m).val i ≤ V)
    (hw : ∀ i, (Circuit.result Serialization.code m).len i ≤ W)
    (ht : 0 < m.val 33) (hd : 0 < m.val 34) :
    ∃ n ≤ numberBudget m initialWidth V W+coreBudget (m.val 33) (m.val 34) W,
      ∃ e : Data, ∃ (M : SubexpPreparedQuartic.Modulus 3 (m.val 33))
        (cache : RingProgram.ScalarCache 3 (m.val 33))
        (u : RingProgram.ScalarCode 3 (m.val 33)),
      Eval coreFromBankCommand n a e ∧
      CoreOutput (m.val 33) (m.val 34) (IrreducibleSearch.data hd) M cache u e := by
  obtain ⟨nn,hnn,b,w',hnum,hshape,hci,h191,h209,h243,h296,hbank,hcollector⟩ :=
    numberPhase_eval a m w r hs ha initialWidth V W hinit hv hw
  have htval : BinaryArithmetic.toNat (w' 33)=m.val 33 :=
    (hshape.1 33).trans (Serialization.frame m 33 (by decide) (by decide))
  have hdval : BinaryArithmetic.toNat (w' 34)=m.val 34 :=
    (hshape.1 34).trans (Serialization.frame m 34 (by decide) (by decide))
  let depth := List.replicate (BinaryArithmetic.toNat (w' 34)) true
  have hdepth : depth.length=m.val 34 := by simp [depth,hdval]
  have hdp : 0 < depth.length := hdepth.symm ▸ hd
  have hbit : CounterPrograms.value (w' 33)=m.val 33 := by
    simpa only [CounterPrograms.value_eq_toNat] using htval
  obtain ⟨nc,hnc,e,M,cache,u,hcore,hout,hframe⟩ :=
    coreCommand_eval b (w' 33) depth (m.val 33) ht hdp hbit hci
  have hlen : (w' 33).length ≤ W := (hshape.2 33).trans (hw 33)
  have hb : coreBudget (m.val 33) depth.length (w' 33).length ≤
      coreBudget (m.val 33) (m.val 34) W := by
    rw [hdepth]
    unfold coreBudget scalarBudget
    gcongr
  exact ⟨nn+nc,Nat.add_le_add hnn (hnc.trans hb),e,M,cache,u,hnum.seq hcore,
    hout.reindex hdepth hdp hd⟩

end SubexponentialSAT.SqrtLog.LeafRingSetupProgram

