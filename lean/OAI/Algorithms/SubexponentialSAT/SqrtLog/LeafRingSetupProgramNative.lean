open BitProgram StructuredCalls

/-- A convenient stack-only form of the paid unary-conversion theorem. -/
theorem unary_eval_stacks (src dst : Fin 640) (a : Data)
    (hs : src.val < 625) (hd : dst.val < 625) (hne : src ≠ dst)
    (h1 : a.stacks dst = []) (h11 : a.stacks 636 = [])
    (h12 : a.stacks 637 = []) (h13 : a.stacks 638 = []) :
    ∃ n ≤ LeafParametersProgram.Serialization.unaryCopyBound (a.stacks src)+1,
      ∃ e : Data, Eval (unary src dst) n a e ∧
        e.stacks=Function.update a.stacks dst
          (List.replicate (BinaryArithmetic.toNat (a.stacks src)) true) := by
  obtain ⟨n,hn,he⟩ := unary_eval src dst a hs hd hne h1 h11 h12 h13
  refine ⟨n,hn,_,he,?_⟩
  change Function.extend (unaryPorts src dst)
    (Function.update (projectState unaryRegisters (unaryPorts src dst) a).stacks 1
      (List.replicate (BinaryArithmetic.toNat (a.stacks src)) true)) a.stacks = _
  rw [ProgramLinking.extend_update (unaryPorts_injective src dst hs hd hne)]
  have hb := congrArg StructuredProgram.State.stacks
    (embedState_project unaryRegisters (unaryPorts src dst) a
      unaryRegisters_injective (unaryPorts_injective src dst hs hd hne))
  change Function.extend (unaryPorts src dst)
    (projectState unaryRegisters (unaryPorts src dst) a).stacks a.stacks=a.stacks at hb
  rw [hb]
  rfl

def unaryPlan : List (Fin 640 × Fin 640) → Cmd 32 640
  | [] => .base .skip
  | p::ps => .seq (unary p.1 p.2) (unaryPlan ps)

def counterStack (s : Fin 640 → List Bool) (p : Fin 640 × Fin 640) : Fin 640 → List Bool :=
  Function.update s p.2 (List.replicate (BinaryArithmetic.toNat (s p.1)) true)

def counterStacks : List (Fin 640 × Fin 640) → (Fin 640 → List Bool) → (Fin 640 → List Bool)
  | [],s => s
  | p::ps,s => counterStacks ps (counterStack s p)

def counterCost : List (Fin 640 × Fin 640) → (Fin 640 → List Bool) → ℕ
  | [],_ => 0
  | p::ps,s => LeafParametersProgram.Serialization.unaryCopyBound (s p.1)+1+
      counterCost ps (counterStack s p)

/-- A finite list of counter conversions is one measured program.  Its
conclusion identifies every stack, including preserved parameter words. -/
theorem unaryPlan_eval (ps : List (Fin 640 × Fin 640)) (a : Data)
    (hports : ∀ p ∈ ps, p.1.val < 625 ∧ p.2.val < 625 ∧ p.1≠p.2)
    (hnd : (ps.map Prod.snd).Nodup)
    (hempty : ∀ p ∈ ps, a.stacks p.2=[])
    (h11 : a.stacks 636=[]) (h12 : a.stacks 637=[]) (h13 : a.stacks 638=[]) :
    ∃ n ≤ counterCost ps a.stacks, ∃ e : Data,
      Eval (unaryPlan ps) n a e ∧ e.stacks=counterStacks ps a.stacks := by
  induction ps generalizing a with
  | nil => exact ⟨0,le_rfl,a,.base (.skip _),rfl⟩
  | cons p ps ih =>
    have hp := hports p (by simp)
    have hnd' : p.2 ∉ ps.map Prod.snd ∧ (ps.map Prod.snd).Nodup := by
      simpa using hnd
    obtain ⟨n,hn,e,he,hs⟩ := unary_eval_stacks p.1 p.2 a hp.1 hp.2.1 hp.2.2
      (hempty p (by simp)) h11 h12 h13
    have htail : ∀ q ∈ ps, e.stacks q.2=[] := by
      intro q hq
      have hne : q.2≠p.2 := by
        intro hh
        exact hnd'.1 (hh ▸ List.mem_map_of_mem hq)
      rw [hs,Function.update_of_ne hne]
      exact hempty q (by simp [hq])
    have h636 : (636 : Fin 640)≠p.2 := by intro h; have:=congrArg Fin.val h; omega
    have h637 : (637 : Fin 640)≠p.2 := by intro h; have:=congrArg Fin.val h; omega
    have h638 : (638 : Fin 640)≠p.2 := by intro h; have:=congrArg Fin.val h; omega
    obtain ⟨m,hm,f,hf,hfs⟩ := ih e (fun q hq => hports q (by simp [hq])) hnd'.2
      htail (by simpa [hs,h636] using h11) (by simpa [hs,h637] using h12)
      (by simpa [hs,h638] using h13)
    refine ⟨n+m,?_,f,he.seq hf,?_⟩
    · change n+m ≤ LeafParametersProgram.Serialization.unaryCopyBound (a.stacks p.1)+1+counterCost ps (counterStack a.stacks p)
      have hs' : e.stacks=counterStack a.stacks p := hs
      rw [←hs']
      exact Nat.add_le_add hn hm
    · change f.stacks=counterStacks ps (counterStack a.stacks p)
      have hs' : e.stacks=counterStack a.stacks p := hs
      rw [←hs']
      exact hfs

def numericPlan : List (Fin 640 × Fin 640) :=
  [(374,204),(384,209),(382,243),(340,191),(361,296)]

theorem numericPlan_eval (a : Data)
    (hempty : ∀ p ∈ numericPlan, a.stacks p.2=[])
    (h11 : a.stacks 636=[]) (h12 : a.stacks 637=[]) (h13 : a.stacks 638=[]) :
    ∃ n ≤ counterCost numericPlan a.stacks, ∃ e : Data,
      Eval (unaryPlan numericPlan) n a e ∧ e.stacks=counterStacks numericPlan a.stacks :=
  unaryPlan_eval numericPlan a (by
    intro p hp
    simp only [numericPlan,List.mem_cons,List.not_mem_nil,or_false] at hp
    rcases hp with rfl|rfl|rfl|rfl|rfl <;> decide) (by decide) hempty h11 h12 h13

end SubexponentialSAT.SqrtLog.LeafRingSetupProgram

namespace SubexponentialSAT.SqrtLog.LeafRingSetupProgram
open BitProgram StructuredCalls SubexpLiftRing StackRoutines

abbrev searchAndPad : Cmd 32 640 :=
  .seq searchCall (.seq (overwrite 202 432) paddingCall)

/-- The field polynomial and its lifted bytes are produced by one real
search/copy/padding execution.  The clearing cost of the search's old width
scratch is bounded by the actual search trace. -/
theorem searchAndPad_eval (a : Data) (depth : List Bool) (hd : 0 < depth.length)
    (t : ℕ) (ht : 0 < t)
    (ha : projectState (registers 22 (by decide)) search a =
      IrreducibleSearchBootstrap.input depth)
    (hw : (a.stacks 202).length=baseWidth 3 t) (h639 : a.stacks 639=[]) :
    ∃ n ≤ 3*IrreducibleSearchBootstrap.totalCost depth.length +
        7*baseWidth 3 t+depth.length*(28*t+14)+15,
      ∃ e : Data, Eval searchAndPad n a e ∧
        e.stacks 441=RingProgram.flat (RingProgram.liftCoefficientsRun t
          (IrreducibleSearch.data hd).coefficients).1 ∧
        e.stacks 195=[] ∧ e.stacks 204=depth ∧
        (∀ i, (¬ ∃ j, search j=i) → e.stacks i=a.stacks i) := by
  obtain ⟨n,hn,raw,hsearch,hraw,hready,h25,hwidth⟩ := searchCall_eval a depth hd ha
  let a1 := embedState (registers 22 (by decide)) search a raw
  have h202 : a1.stacks 202=a.stacks 202 := by
    exact embedState_stack_frame _ _ _ _ _ (by decide)
  have hs639 : a1.stacks 639=[] := by
    rw [show a1.stacks 639=a.stacks 639 from
      embedState_stack_frame _ _ _ _ _ (by decide)]
    exact h639
  have h432 : a1.stacks 432=raw.stacks 12 :=
    embedState_stack _ _ _ _ search_injective 12
  let a2 : Data := ⟨readRegs a1.regs 30 31 none,
    Function.update a1.stacks 432 (a1.stacks 202)⟩
  have hc : Eval (overwrite 202 432)
      (2*(a1.stacks 432).length+7*(a1.stacks 202).length+8) a1 a2 :=
    overwrite_eval 202 432 a1 (by decide) (by decide) (by decide) hs639
  have hlocal : (projectState (registers 22 (by decide)) search a2).stacks =
      Function.update raw.stacks 12 (a.stacks 202) := by
    funext i
    change Function.update a1.stacks 432 (a1.stacks 202) (search i)=_
    by_cases hi : i=12
    · subst i
      simpa [search] using h202
    · have hne : search i≠432 := by
        intro h
        exact hi (search_injective h)
      rw [Function.update_of_ne hne,Function.update_of_ne hi]
      exact embedState_stack _ _ _ _ search_injective i
  have hlocalState : projectState (registers 22 (by decide)) search a2 =
      ⟨(projectState (registers 22 (by decide)) search a2).regs,
        Function.update raw.stacks 12 (a.stacks 202)⟩ := by
    apply congrArg₂ StructuredProgram.State.mk rfl hlocal
  have hr : RingCoefficientLiftProgram.SearchReady
      (projectState (registers 22 (by decide)) search a2) := by
    rw [hlocalState]
    exact search_padding_ready depth raw hready h25 _ _
  have hi : a2.stacks 195=IrreducibleSearchProgram.coefficientArray
      (List.ofFn (IrreducibleSearch.data hd).coefficients) := by
    have hh := congrFun hlocal (13 : Fin 28)
    simpa [projectState,search,hraw] using hh
  have hw2 : (a2.stacks 432).length=baseWidth 3 t := by
    simpa [a2,h202] using hw
  obtain ⟨e,hpad,he⟩ := paddingCall_eval a2 t ht depth.length hd hr hi hw2
  refine ⟨n+(2*(a1.stacks 432).length+7*(a1.stacks 202).length+8)+
    (depth.length*(28*t+14)+7),?_,e,?_,?_,?_,?_,?_⟩
  · rw [h432,h202,hw]
    omega
  · simpa only [searchAndPad,Nat.add_assoc] using hsearch.seq (hc.seq hpad)
  · simp only [he,Function.update_same]
  · simp [he]
  · have h204 : a1.stacks 204=raw.stacks 14 :=
      embedState_stack _ _ _ _ search_injective 14
    simpa [he,a2,h204] using hready.controls.1
  · intro i hi
    have hi195 : i≠195 := by intro h; subst i; exact hi ⟨13,rfl⟩
    have hi441 : i≠441 := by intro h; subst i; exact hi ⟨21,rfl⟩
    have hi432 : i≠432 := by intro h; subst i; exact hi ⟨12,rfl⟩
    simp only [he,Function.update_of_ne hi441,Function.update_of_ne hi195,a2,
      Function.update_of_ne hi432]
    exact embedState_stack_frame _ _ _ _ _ hi

end SubexponentialSAT.SqrtLog.LeafRingSetupProgram



namespace SubexponentialSAT.SqrtLog.LeafRingSetupProgram
open StructuredCalls

/-- An explicit finite-tape form of a framed call's output. This is a proof
normal form; executable code remains the actual relocated program. -/
def installIndexed {s S : ℕ} (σ : Fin s → Fin S) (value : Fin s → List Bool) :
    List (Fin s) → (Fin S → List Bool) → (Fin S → List Bool)
  | [],base => base
  | i::is,base => Function.update (installIndexed σ value is base) (σ i) (value i)

theorem installIndexed_hit {s S : ℕ} (σ : Fin s → Fin S)
    (hs : Function.Injective σ) (value : Fin s → List Bool)
    (is : List (Fin s)) (base : Fin S → List Bool) (i : Fin s) (hi : i∈is) :
    installIndexed σ value is base (σ i)=value i := by
  induction is with
  | nil => simp at hi
  | cons j js ih =>
    by_cases hij : i=j
    · subst i; simp [installIndexed]
    · have hσ : σ i≠σ j := fun h => hij (hs h)
      simp only [installIndexed,Function.update_of_ne hσ]
      apply ih
      rcases List.mem_cons.mp hi with he | hm
      · exact (hij he).elim
      · exact hm

theorem installIndexed_frame {s S : ℕ} (σ : Fin s → Fin S)
    (value : Fin s → List Bool) (is : List (Fin s)) (base : Fin S → List Bool)
    (j : Fin S) (hj : ∀ i∈is, σ i≠j) :
    installIndexed σ value is base j=base j := by
  induction is with
  | nil => rfl
  | cons i is ih =>
    rw [installIndexed,Function.update_of_ne (Ne.symm (hj i (by simp)))]
    exact ih (fun k hk => hj k (by simp [hk]))

theorem embedState_stacks_finite {r s R S : ℕ} (ρ : Fin r → Fin R)
    (σ : Fin s → Fin S) (hs : Function.Injective σ)
    (frame : StructuredProgram.State R S) (localState : StructuredProgram.State r s) :
    (embedState ρ σ frame localState).stacks=
      installIndexed σ localState.stacks (List.finRange s) frame.stacks := by
  funext j
  by_cases hj : ∃ i, σ i=j
  · obtain ⟨i,rfl⟩ := hj
    rw [embedState_stack ρ σ frame localState hs i,
      installIndexed_hit σ hs localState.stacks (List.finRange s) frame.stacks i (by simp)]
  · rw [embedState_stack_frame ρ σ frame localState j hj,
      installIndexed_frame σ localState.stacks (List.finRange s) frame.stacks j
        (by intro i hi he; exact hj ⟨i,he⟩)]

end SubexponentialSAT.SqrtLog.LeafRingSetupProgram

namespace SubexponentialSAT.SqrtLog.LeafRingSetupProgram
open BitProgram StructuredCalls

@[simp] theorem mem_workPorts (i : Fin 640) : i∈workPorts ↔ 417 ≤ i.val := by
  constructor
  · intro hi
    obtain ⟨j,hj,rfl⟩ := List.mem_map.mp hi
    change 417 ≤ 417+j.val
    omega
  · intro hi
    let j : Fin 223 := ⟨i.val-417,by omega⟩
    apply List.mem_map.mpr
    exact ⟨j,by simp,Fin.ext (by dsimp [j]; omega)⟩

@[simp] theorem mem_privatePorts (i : Fin 640) : i∈privatePorts ↔ 340 ≤ i.val := by
  constructor
  · intro hi
    obtain ⟨j,hj,rfl⟩ := List.mem_map.mp hi
    change 340 ≤ 340+j.val
    omega
  · intro hi
    let j : Fin 300 := ⟨i.val-340,by omega⟩
    apply List.mem_map.mpr
    exact ⟨j,by simp,Fin.ext (by dsimp [j]; omega)⟩

theorem initial_clear_preserves_parameter (i : Fin 77) :
    parameters i ∉ workPorts++outputPorts := by
  have ho : ∀ j∈outputPorts, j.val < 340 := by
    intro j hj
    simp [outputPorts] at hj
    omega
  intro hm
  rcases List.mem_append.mp hm with h | h
  · have h' := (mem_workPorts (parameters i)).mp h
    simp only [parameters] at h'
    omega
  · have h' := ho _ h
    simp only [parameters] at h'
    omega

theorem clearedPorts_register_frame (ps : List (Fin 640)) (a : Data)
    (i : Fin 32) (h30 : i≠30) (h31 : i≠31) :
    (clearedPorts ps a).regs i=a.regs i := by
  induction ps generalizing a with
  | nil => rfl
  | cons p ps ih =>
    rw [clearedPorts,ih]
    simp [clearResult,readRegs,h30,h31]

/-- The first paid cleanup preserves the complete generated numeric bank. -/
theorem initial_clear_parameter_projection (a : Data) :
    projectState (registers 8 (by decide)) parameters
      (clearedPorts (workPorts++outputPorts) a) =
    projectState (registers 8 (by decide)) parameters a := by
  apply congrArg₂ StructuredProgram.State.mk
  · funext i
    apply clearedPorts_register_frame
    · intro h; have hh:=congrArg Fin.val h; simp only [registers] at hh; omega
    · intro h; have hh:=congrArg Fin.val h; simp only [registers] at hh; omega
  · funext i
    exact (clearedPorts_stacks _ _ _).trans
      (ite_eq_right (initial_clear_preserves_parameter i))

/-- Final cleanup restores every setup-private tape, independently of the
large temporary words that its generators may have produced. -/
theorem final_clear_private (a : Data) (i : Fin 640) (hi : 340 ≤ i.val) :
    (clearedPorts ((195::privatePorts)++arithmeticCleanPorts) a).stacks i=[] := by
  rw [clearedPorts_stacks]
  apply ite_eq_left
  exact List.mem_append_left _ (List.mem_cons_of_mem _ ((mem_privatePorts i).mpr hi))

end SubexponentialSAT.SqrtLog.LeafRingSetupProgram



namespace SubexponentialSAT.SqrtLog.LeafRingSetupProgram
open BitProgram StructuredCalls SubexpLiftRing SubexpQuarticRing StackRoutines
local instance : Fact (Nat.Prime 3) := ⟨by decide⟩

/-- The arithmetic core uses the generated scalar cache, searches for the
extension polynomial, and constructs its multiplication table. -/
abbrev coreCommand : Cmd 32 640 :=
  .seq scalarCall (.seq (overwrite 507 253) (.seq RegisterResetProgram.all
    (.seq searchAndPad (.seq (overwrite 498 538) tableCall))))

def coreWritePorts : List (Fin 640) :=
  [253,538] ++ (List.finRange 41).map scalar ++
    (List.finRange 28).map search ++ (List.finRange 42).map LeafRingSetupProgram.table

def coreBudget (t d bitWidth : ℕ) : ℕ :=
  scalarBudget t bitWidth+1 + (7*baseWidth 3 t+8) +32 +
  (3*IrreducibleSearchBootstrap.totalCost d+7*baseWidth 3 t+d*(28*t+14)+15) +
  (7*baseWidth 3 t+8) +208000*(d+1)^5*(t+1)^2

/-- These are input tape conditions, not supplied mathematical ring data.
The only numerical words needed by this phase are binary precision and
unary dimension.  The outer setup establishes the empty tapes by clearing. -/
structure CoreInput (bits depth : List Bool) (a : Data) : Prop where
  scalarInput : projectState (registers 8 (by decide)) scalar a =
    IdempotentPreparationProgram.inputData bits
  degree : a.stacks 204=depth
  searchClean : ∀ j : Fin 28, j≠14 → a.stacks (search j)=[]
  tableClean : ∀ j : Fin 42, j∉([5,12,17,21,22,24] : List (Fin 42)) →
    a.stacks (LeafRingSetupProgram.table j)=[]
  halfEmpty : a.stacks 253=[]
  copyEmpty : a.stacks 639=[]

structure CoreOutput (t d : ℕ) (model : RingModel.Data d)
    (M : SubexpPreparedQuartic.Modulus 3 t) (cache : RingProgram.ScalarCache 3 t)
    (u : RingProgram.ScalarCode 3 t) (a : Data) : Prop where
  modulus : a.stacks 194=M.bits
  width : (a.stacks 202).length=baseWidth 3 t
  degree : (a.stacks 204).length=d
  zero : a.stacks 203=cache.zero.val
  one : a.stacks 498=cache.one.val
  minusOne : a.stacks 508=cache.minusOne.val
  half : a.stacks 253=u.val
  precision : a.stacks 212=List.replicate t true
  inverse : (2 : ZMod (3^t))*wordValue 3 t u=1
  zeroCanonical : BinaryArithmetic.toNat cache.zero.val < 3^t
  oneCanonical : BinaryArithmetic.toNat cache.one.val < 3^t
  table : a.stacks 201=RingProgramTable.modelTable t model M cache

/-- This core result has no modulus, irreducible polynomial, scalar cache,
or table premise.  All four objects are generated by the executed code. -/
theorem CoreOutput.reindex {t d D : ℕ} (heq : d=D) (hd : 0 < d) (hD : 0 < D)
    {M : SubexpPreparedQuartic.Modulus 3 t} {cache : RingProgram.ScalarCache 3 t}
    {u : RingProgram.ScalarCode 3 t} {a : Data}
    (h : CoreOutput t d (IrreducibleSearch.data hd) M cache u a) :
    CoreOutput t D (IrreducibleSearch.data hD) M cache u a := by
  cases heq
  exact h

theorem coreCommand_eval (a : Data) (bits depth : List Bool) (t : ℕ)
    (ht : 0 < t) (hd : 0 < depth.length)
    (hv : CounterPrograms.value bits=t) (h : CoreInput bits depth a) :
    ∃ n ≤ coreBudget t depth.length bits.length, ∃ e : Data,
      ∃ (M : SubexpPreparedQuartic.Modulus 3 t) (cache : RingProgram.ScalarCache 3 t)
        (u : RingProgram.ScalarCode 3 t),
      Eval coreCommand n a e ∧
      CoreOutput t depth.length (IrreducibleSearch.data hd) M cache u e ∧
      (∀ i, i∉coreWritePorts → e.stacks i=a.stacks i) := by
  obtain ⟨ns,raw,M,cache,u,lg,hs,ho,hns⟩ := scalarCall_eval a bits t hv ht h.scalarInput
  let a1 := embedState (registers 8 (by decide)) scalar a raw
  have hp (j : Fin 41) : a1.stacks (scalar j)=raw.stacks j :=
    embedState_stack _ _ _ _ scalar_injective j
  have hf (i : Fin 640) (hi : ¬∃ j,scalar j=i) : a1.stacks i=a.stacks i :=
    embedState_stack_frame _ _ _ _ _ hi
  have hm : a1.stacks 194=M.bits := by
    simpa [scalar,IdempotentPreparationProgram.Scalar.low] using
      (hp 5).trans (ho.prepared.rest.1 5)
  have hw : (a1.stacks 202).length=baseWidth 3 t := by
    have hb := ho.unchanged 12 (by decide)
    simpa [scalar,IdempotentPreparationProgram.bootStacks,RingProgram.ternary_baseWidth]
      using congrArg List.length ((hp 12).trans hb)
  have hz : a1.stacks 203=cache.zero.val := (hp 17).trans ho.prepared.zero
  have h1 : a1.stacks 498=cache.one.val := (hp 18).trans ho.prepared.one
  have hm1 : a1.stacks 508=cache.minusOne.val := (hp 28).trans ho.prepared.minusOne
  have hu : a1.stacks 507=u.val := (hp 27).trans ho.prepared.half
  have hprec : a1.stacks 212=List.replicate t true := by
    have hh := (hp 29).trans (ho.unchanged 29 (by decide))
    simpa [scalar,IdempotentPreparationProgram.bootStacks] using hh
  have he253 : a1.stacks 253=[] := (hf 253 (by decide)).trans h.halfEmpty
  have he639 : a1.stacks 639=[] := (hf 639 (by decide)).trans h.copyEmpty
  let a2 : Data := ⟨readRegs a1.regs 30 31 none,Function.update a1.stacks 253 (a1.stacks 507)⟩
  have hcopy : Eval (overwrite 507 253) (7*baseWidth 3 t+8) a1 a2 := by
    simpa [a2,he253,hu,u.property] using overwrite_eval 507 253 a1
      (by decide) (by decide) (by decide) he639
  let a3 := RegisterResetProgram.zeroed a2
  have hreset : Eval RegisterResetProgram.all 32 a2 a3 := RegisterResetProgram.all_eval a2
  have hsearch : projectState (registers 22 (by decide)) search a3 =
      IrreducibleSearchBootstrap.input depth := by
    apply congrArg₂ StructuredProgram.State.mk
    · rfl
    · funext j
      have hdis : ¬∃ i,scalar i=search j := by
        fin_cases j <;> decide
      have hn : search j≠253 := by fin_cases j <;> decide
      simp only [a3,a2,Function.comp_apply,Function.update_of_ne hn]
      rw [hf _ hdis]
      by_cases hj : j=14
      · subst j
        simpa [IrreducibleSearchBootstrap.input,StructuredProgram.ioState,search] using h.degree
      · simpa [IrreducibleSearchBootstrap.input,StructuredProgram.ioState,hj]
          using h.searchClean j hj
  obtain ⟨np,hnp,a4,hpad,hcoeff,hraw,hdepth,hpf⟩ := searchAndPad_eval a3 depth hd t ht
    hsearch (by simpa [a3,a2,RegisterResetProgram.zeroed] using hw)
    (by simpa [a3,a2,RegisterResetProgram.zeroed] using he639)
  have hcarry (i : Fin 640) (hs' : ¬∃ j,search j=i) (hi : i≠253) :
      a4.stacks i=a1.stacks i := by
    rw [hpf i hs']
    simp [a3,a2,hi]
  have hhalf : a4.stacks 253=u.val := by
    rw [hpf 253 (by decide)]
    simp [a3,a2,hu]
  have hseed0 : a4.stacks 538=[] := by
    rw [hcarry 538 (by decide) (by decide),hf 538 (by decide)]
    exact h.tableClean 0 (by decide)
  have hseed1 : a4.stacks 498=cache.one.val :=
    (hcarry 498 (by decide) (by decide)).trans h1
  have hcopy0 : a4.stacks 639=[] :=
    (hcarry 639 (by decide) (by decide)).trans he639
  let a5 : Data := ⟨readRegs a4.regs 30 31 none,Function.update a4.stacks 538 (a4.stacks 498)⟩
  have hload : Eval (overwrite 498 538) (7*baseWidth 3 t+8) a4 a5 := by
    simpa [a5,hseed0,hseed1,cache.one.property] using overwrite_eval 498 538 a4
      (by decide) (by decide) (by decide) hcopy0
  have ti : TableInput t depth.length (IrreducibleSearch.data hd) M cache a5 := by
    refine ⟨?_,?_,?_,?_,?_,?_,?_,?_⟩
    · simpa [a5] using (hcarry 194 (by decide) (by decide)).trans hm
    · simpa [a5] using (congrArg List.length (hcarry 202 (by decide) (by decide))).trans hw
    · simp [a5,hdepth]
    · simp [a5,hseed1]
    · simpa [a5] using (hcarry 203 (by decide) (by decide)).trans hz
    · simpa [a5] using (hcarry 508 (by decide) (by decide)).trans hm1
    · change a5.stacks 441 = RingProgramTable.wordBits
        (List.Vector.ofFn (RingProgram.liftCoefficientsRun t
          (IrreducibleSearch.data hd).coefficients).1).val
      rw [RingCoefficientLiftProgram.modelCoefficientBits]
      exact hcoeff
    · intro j hj
      have hj538 : LeafRingSetupProgram.table j≠538 := by
        fin_cases j <;> first | exact (hj (by decide)).elim | decide
      have hj253 : LeafRingSetupProgram.table j≠253 := by fin_cases j <;> decide
      have hd1 : ¬∃ i,search i=LeafRingSetupProgram.table j := by
        fin_cases j <;> first | exact (hj (by decide)).elim | decide
      have hd2 : ¬∃ i,scalar i=LeafRingSetupProgram.table j := by
        fin_cases j <;> first | exact (hj (by decide)).elim | decide
      simp only [a5,Function.update_of_ne hj538]
      rw [hcarry _ hd1 hj253,hf _ hd2]
      exact h.tableClean j (fun hj' => hj (List.mem_cons_of_mem 0 hj'))
  obtain ⟨nt,hnt,e,htable,het,hem,hew,hez,hed,heminus,hef⟩ := tableCall_produces t hd
    (IrreducibleSearch.data hd) M cache ho.prepared.zeroCanonical ho.prepared.oneCanonical a5 ti
  refine ⟨ns+(7*baseWidth 3 t+8)+(32+(np+((7*baseWidth 3 t+8)+nt))),?_,e,M,cache,u,?_,?_,?_⟩
  · unfold coreBudget
    omega
  · simpa only [coreCommand,Nat.add_assoc] using hs.seq (hcopy.seq (hreset.seq (hpad.seq (hload.seq htable))))
  · refine ⟨hem.trans ti.modulus,?_,?_,hez,?_,?_,?_,?_,ho.prepared.inverse,
      ho.prepared.zeroCanonical,ho.prepared.oneCanonical,het⟩
    · exact (congrArg List.length hew).trans ti.width
    · exact (congrArg List.length hed).trans ti.degree
    · rw [hef 498 (by decide)]
      simpa [a5] using hseed1
    · exact heminus
    · rw [hef 253 (by decide)]
      simpa [a5] using hhalf
    · rw [hef 212 (by decide)]
      simpa [a5] using (hcarry 212 (by decide) (by decide)).trans hprec
  · intro i hi
    have hn253 : i≠253 := by
      intro he; subst i; exact hi (by simp [coreWritePorts])
    have hn538 : i≠538 := by
      intro he; subst i; exact hi (by simp [coreWritePorts])
    have hns : ¬∃ j,scalar j=i := by
      rintro ⟨j,rfl⟩; exact hi (by simp [coreWritePorts])
    have hnp : ¬∃ j,search j=i := by
      rintro ⟨j,rfl⟩; exact hi (by simp [coreWritePorts])
    have hnt : ¬∃ j,LeafRingSetupProgram.table j=i := by
      rintro ⟨j,rfl⟩; exact hi (by simp [coreWritePorts])
    rw [hef i hnt]
    change Function.update a4.stacks 538 (a4.stacks 498) i=a.stacks i
    rw [Function.update_of_ne hn538,hcarry i hnp hn253,hf i hns]

end SubexponentialSAT.SqrtLog.LeafRingSetupProgram

namespace SubexponentialSAT.SqrtLog.LeafRingSetupProgram
open BitProgram StructuredCalls
