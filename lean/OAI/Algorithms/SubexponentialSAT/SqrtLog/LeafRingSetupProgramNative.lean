/-- The seed is copied from a retained scalar master before the actual
literal-vector constructor consumes it. -/
abbrev buildConstant (src out : Fin 640) : Cmd 32 640 :=
  .seq (overwrite src 538) (constantCall out)

theorem buildConstant_eval (a : Data) (src out : Fin 640)
    (hi : Function.Injective (constant out))
    (hs538 : src≠538) (hs639 : src≠639)
    {B : ℕ} (seed zeroWord : Word B)
    (hseed : a.stacks src=seed.val) (hzero : a.stacks 203=zeroWord.val)
    (h538 : a.stacks 538=[]) (h639 : a.stacks 639=[])
    (hc : ∀ i∈constantScratch, a.stacks (constant out i)=[]) :
    ∃ n ≤ 7*B+8+(LeafProgram.Constants.budget B (a.stacks 204).length+1),
      ∃ e : Data, Eval (buildConstant src out) n a e ∧
      e.stacks=Function.update (Function.update a.stacks 538 []) out
        (RingProgramTable.literalBits (a.stacks 204).length seed zeroWord) := by
  let b : Data := ⟨readRegs a.regs 30 31 none,Function.update a.stacks 538 (a.stacks src)⟩
  have hp : Eval (overwrite src 538) (7*B+8) a b := by
    simpa [b,h538,hseed,seed.property] using overwrite_eval src 538 a hs538 hs639 (by decide) h639
  have hclean : ∀ i∈constantScratch, b.stacks (constant out i)=[] := by
    intro i himem
    have hn : constant out i≠538 := by
      intro he
      have he' : constant out i=constant out 0 := he
      have hz := hi he'
      subst i
      simp [constantScratch] at himem
    simpa [b,hn] using hc i himem
  obtain ⟨nc,hnc,e,he,hout⟩ := constantCall_produces b out hi seed zeroWord
    (by simpa [b] using hseed) (by simpa [b] using hzero) hclean
  refine ⟨7*B+8+nc,?_,e,hp.seq he,?_⟩
  · simpa [b] using Nat.add_le_add_left hnc (7*B+8)
  · simpa [b,Function.update_idem] using hout

end SubexponentialSAT.SqrtLog.LeafRingSetupProgram

namespace SubexponentialSAT.SqrtLog.LeafRingSetupProgram
open BitProgram StructuredCalls SubexpQuarticRing

/-- Generate the three dynamic-dimension constant vectors on their native
consumer ports.  Each scalar master remains available throughout. -/
abbrev constantBatch : Cmd 32 640 :=
  .seq (buildConstant 498 207) (.seq (buildConstant 508 211) (buildConstant 203 280))

def constantBatchStacks {B : ℕ} (a : Data) (one minusOne zero : Word B) :
    Fin 640 → List Bool :=
  Function.update (Function.update (Function.update (Function.update a.stacks 538 [])
    207 (RingProgramTable.literalBits (a.stacks 204).length one zero))
    211 (RingProgramTable.literalBits (a.stacks 204).length minusOne zero))
    280 (RingProgramTable.literalBits (a.stacks 204).length zero zero)

theorem constantBatch_eval (a : Data) {B : ℕ} (one minusOne zero : Word B)
    (h1 : a.stacks 498=one.val) (hm : a.stacks 508=minusOne.val)
    (hz : a.stacks 203=zero.val) (h538 : a.stacks 538=[]) (h639 : a.stacks 639=[])
    (hc : ∀ out∈([207,211,280] : List (Fin 640)),
      ∀ i∈constantScratch,a.stacks (constant out i)=[]) :
    ∃ n ≤ 3*(7*B+8+(LeafProgram.Constants.budget B (a.stacks 204).length+1)),
      ∃ e : Data, Eval constantBatch n a e ∧ e.stacks=constantBatchStacks a one minusOne zero := by
  obtain ⟨n1,hn1,a1,he1,hs1⟩ := buildConstant_eval a 498 207 constant_one_injective
    (by decide) (by decide) one zero h1 hz h538 h639 (hc _ (by simp))
  have hc2 : ∀ i∈constantScratch, a1.stacks (constant 211 i)=[] := by
    intro i hi
    rw [hs1]
    have hbase := hc 211 (by simp) i hi
    have h538' : constant 211 i≠538 := by
      intro hh
      have hh' : i=0 := constant_minusOne_injective hh
      subst i
      simp [constantScratch] at hi
    have h207 : constant 211 i≠207 := by fin_cases i <;> decide
    rw [Function.update_of_ne h207,Function.update_of_ne h538']
    exact hbase
  obtain ⟨n2,hn2,a2,he2,hs2⟩ := buildConstant_eval a1 508 211 constant_minusOne_injective
    (by decide) (by decide) minusOne zero (by simpa [hs1] using hm)
    (by simpa [hs1] using hz) (by simp [hs1]) (by simpa [hs1] using h639) hc2
  have hc3 : ∀ i∈constantScratch, a2.stacks (constant 280 i)=[] := by
    intro i hi
    rw [hs2,hs1]
    have hbase := hc 280 (by simp) i hi
    have h538' : constant 280 i≠538 := by
      intro hh
      have hh' : i=0 := constant_zero_injective hh
      subst i
      simp [constantScratch] at hi
    have h207 : constant 280 i≠207 := by fin_cases i <;> decide
    have h211 : constant 280 i≠211 := by fin_cases i <;> decide
    simp only [Function.update_of_ne h207,Function.update_of_ne h211,Function.update_of_ne h538']
    exact hbase
  obtain ⟨n3,hn3,e,he3,hs3⟩ := buildConstant_eval a2 203 280 constant_zero_injective
    (by decide) (by decide) zero zero (by simpa [hs2,hs1] using hz)
    (by simpa [hs2,hs1] using hz) (by simp [hs2]) (by simpa [hs2,hs1] using h639) hc3
  refine ⟨n1+(n2+n3),?_,e,he1.seq (he2.seq he3),?_⟩
  · simp only [hs1,hs2,Function.update_of_ne (by decide : (204 : Fin 640)≠211),
      Function.update_of_ne (by decide : (204 : Fin 640)≠207),
      Function.update_of_ne (by decide : (204 : Fin 640)≠538)] at hn2 hn3
    omega
  · funext i
    simp only [hs3,hs2,hs1,constantBatchStacks]
    by_cases h538' : i=538 <;> by_cases h207 : i=207 <;>
      by_cases h211 : i=211 <;> by_cases h280 : i=280 <;>
      simp_all only [Function.update_apply,Fin.reduceEq,ite_true,ite_false,not_false_eq_true]

end SubexponentialSAT.SqrtLog.LeafRingSetupProgram

namespace SubexponentialSAT.SqrtLog.LeafRingSetupProgram
open BitProgram StructuredCalls StackRoutines

/-- Finite staged cache copies; this is executable code, including clearing
reused destinations and the preserving copy loops. -/
def copyPlan : List (Fin 640 × Fin 640) → Cmd 32 640
  | [] => .base .skip
  | p::ps => .seq (overwrite p.1 p.2) (copyPlan ps)

def copied (p : Fin 640 × Fin 640) (a : Data) : Data :=
  ⟨readRegs a.regs 30 31 none,Function.update a.stacks p.2 (a.stacks p.1)⟩

def copiedPlan : List (Fin 640 × Fin 640) → Data → Data
  | [],a => a
  | p::ps,a => copiedPlan ps (copied p a)

def copyPlanCost : List (Fin 640 × Fin 640) → Data → ℕ
  | [],_ => 0
  | p::ps,a => 2*(a.stacks p.2).length+7*(a.stacks p.1).length+8+
      copyPlanCost ps (copied p a)

theorem copyPlan_eval (ps : List (Fin 640 × Fin 640)) (a : Data)
    (hports : ∀ p∈ps,p.1≠p.2 ∧ p.1≠639 ∧ p.2≠639)
    (hwork : a.stacks 639=[]) :
    Eval (copyPlan ps) (copyPlanCost ps a) a (copiedPlan ps a) := by
  induction ps generalizing a with
  | nil => exact .base (.skip _)
  | cons p ps ih =>
    have hp := hports p (by simp)
    have he := overwrite_eval p.1 p.2 a hp.1 hp.2.1 (Ne.symm hp.2.2) hwork
    have ht := ih (copied p a) (fun q hq => hports q (by simp [hq]))
      (by simpa [copied,hp.2.2,Ne.symm hp.2.2] using hwork)
    exact he.seq ht

theorem copyPlanCost_bound (ps : List (Fin 640 × Fin 640)) (a : Data) (W : ℕ)
    (hw : ∀ i,(a.stacks i).length ≤ W) :
    copyPlanCost ps a ≤ ps.length*(9*W+8) := by
  induction ps generalizing a with
  | nil => simp [copyPlanCost]
  | cons p ps ih =>
    have hb : ∀ i,((copied p a).stacks i).length ≤ W := by
      intro i
      by_cases hi : i=p.2
      · simpa [copied,hi] using hw p.1
      · simpa [copied,hi] using hw i
    have ht := ih (copied p a) hb
    have hs := hw p.1
    have hd := hw p.2
    simp only [copyPlanCost,List.length_cons]
    nlinarith

theorem copiedPlan_frame (ps : List (Fin 640 × Fin 640)) (a : Data) (i : Fin 640)
    (hi : ∀ p∈ps,i≠p.2) : (copiedPlan ps a).stacks i=a.stacks i := by
  induction ps generalizing a with
  | nil => rfl
  | cons p ps ih =>
    rw [copiedPlan,ih (copied p a) (fun q hq => hi q (by simp [hq]))]
    simp [copied,hi p (by simp)]

end SubexponentialSAT.SqrtLog.LeafRingSetupProgram

namespace SubexponentialSAT.SqrtLog.LeafRingSetupProgram
open BitProgram StructuredCalls SubexpLiftRing

structure NodesInput (t : ℕ) (a : Data) : Prop where
  zero : a.stacks 617=List.replicate (baseWidth 3 t) false
  clean : ∀ i : Fin 15, i∉([5,13,14] : List (Fin 15)) → a.stacks (nodes i)=[]

/-- The node generator reads only its scalar-width zero word, binary count,
and unary dimension.  All other global metadata remains framed. -/
theorem nodesCall_produces (t : ℕ) (ht : 0 < t) (a : Data) (h : NodesInput t a) :
    ∃ n ≤ RingNodeProgram.budget (baseWidth 3 t) (a.stacks 625).length
        (a.stacks 204).length (BinaryArithmetic.toNat (a.stacks 625))+5,
      ∃ e : Data, Eval nodesCall n a e ∧
        e.stacks 256=((nodeWords t (a.stacks 204).length
          (BinaryArithmetic.toNat (a.stacks 625))).map RingProgram.flat).flatten ∧
        e.stacks 204=a.stacks 204 ∧
        (∀ i, (¬∃ j,nodes j=i) → e.stacks i=a.stacks i) := by
  let r := a.regs ∘ registers 8 (by decide)
  have hi : projectState (registers 8 (by decide)) nodes a =
      SubexpFieldRowPreparation.data r (List.replicate (baseWidth 3 t) false)
        (a.stacks 625) (a.stacks 204) [] [] [] := by
    apply congrArg₂ StructuredProgram.State.mk rfl
    funext i
    fin_cases i
    · exact h.clean 0 (by decide)
    · exact h.clean 1 (by decide)
    · exact h.clean 2 (by decide)
    · exact h.clean 3 (by decide)
    · exact h.clean 4 (by decide)
    · exact h.zero
    · exact h.clean 6 (by decide)
    · exact h.clean 7 (by decide)
    · exact h.clean 8 (by decide)
    · exact h.clean 9 (by decide)
    · exact h.clean 10 (by decide)
    · exact h.clean 11 (by decide)
    · exact h.clean 12 (by decide)
    · rfl
    · rfl
  obtain ⟨n,hn,rf,last,he,hv,hl⟩ := nodesCall_eval a r t ht (a.stacks 625) (a.stacks 204) hi
  refine ⟨n,hn,_,he,?_,?_,?_⟩
  · exact embedState_stack _ _ _ _ nodes_injective 12
  · exact embedState_stack _ _ _ _ nodes_injective 14
  · intro i hi
    exact embedState_stack_frame _ _ _ _ _ hi

/-- The length used by all node-stream copies follows from the actually
constructed fixed-width words. -/
theorem nodeWords_flat_length (t d Q : ℕ) :
    (((nodeWords t d Q).map RingProgram.flat).flatten).length=Q*(d*baseWidth 3 t) := by
  rw [LeafProgram.NodeFrames.flatten_length (d*baseWidth 3 t)
    ((nodeWords t d Q).map RingProgram.flat) (by
      intro word hw
      obtain ⟨code,hcode,rfl⟩ := List.mem_map.mp hw
      exact RingProgram.flat_length code)]
  simp

end SubexponentialSAT.SqrtLog.LeafRingSetupProgram

namespace SubexponentialSAT.SqrtLog.LeafRingSetupProgram
open BitProgram StructuredCalls SubexpQuarticRing SubexpLiftRing

/-- A bound on actual tape lengths follows from the compiled instruction
trace; it is not a cost annotation on an abstract computation. -/
theorem eval_stack_length_le {c : Cmd 32 640} {n : ℕ} {a e : Data}
    (he : Eval c n a e) (i : Fin 640) :
    (e.stacks i).length ≤ (a.stacks i).length+n+1 := by
  have h := Subexp.SequentialProgram.trace_stack_length_le
    (compiled_halt_trace he 0 0) i
  simpa only [StructuredProgram.State.withPC,Nat.add_assoc] using h

theorem eval_width_le {c : Cmd 32 640} {n W : ℕ} {a e : Data}
    (he : Eval c n a e) (hw : ∀ i,(a.stacks i).length ≤ W) :
    ∀ i,(e.stacks i).length ≤ W+n+1 := by
  intro i
  have hwi := hw i
  exact (eval_stack_length_le he i).trans (by omega)

/-- Explicit clearing makes the constant constructor independent of the
search/table producers' discarded work tapes. -/
def constantStartPorts : List (Fin 640) :=
  [538,639] ++ ([207,211,280] : List (Fin 640)).flatMap
    (fun out => constantScratch.map (constant out))

def constantAliases : List (Fin 640 × Fin 640) :=
  [(280,190),(280,249),(207,250),(211,251)]

abbrev constantsPhase : Cmd 32 640 :=
  .seq (clearPorts constantStartPorts) (.seq constantBatch (copyPlan constantAliases))

def constantsBudget (W B d : ℕ) : ℕ :=
  let b := constantStartPorts.length*(2*W+3)+
    3*(7*B+8+(LeafProgram.Constants.budget B d+1))
  b+constantAliases.length*(9*(W+b+2)+8)

def constantResultStacks {B : ℕ} (a : Data) (one minusOne zero : Word B) :
    Fin 640 → List Bool :=
  let a0 := clearedPorts constantStartPorts a
  (copiedPlan constantAliases
    ⟨a0.regs,constantBatchStacks a0 one minusOne zero⟩).stacks

theorem constantsPhase_eval (a : Data) {B : ℕ} (one minusOne zero : Word B)
    (W : ℕ) (hw : ∀ i,(a.stacks i).length ≤ W)
    (h1 : a.stacks 498=one.val) (hm : a.stacks 508=minusOne.val)
    (hz : a.stacks 203=zero.val) :
    ∃ n ≤ constantsBudget W B (a.stacks 204).length, ∃ e : Data,
      Eval constantsPhase n a e ∧ e.stacks=constantResultStacks a one minusOne zero := by
  let a0 := clearedPorts constantStartPorts a
  have hc := clearPorts_eval constantStartPorts a
  have hframe (i : Fin 640) (hi : i∉constantStartPorts) : a0.stacks i=a.stacks i := by
    simp only [a0,clearedPorts_stacks,hi,ite_false]
  obtain ⟨nb,hnb,a1,hb,hsb⟩ := constantBatch_eval a0 one minusOne zero
    (by simpa only [hframe 498 (by decide)] using h1)
    (by simpa only [hframe 508 (by decide)] using hm)
    (by simpa only [hframe 203 (by decide)] using hz)
    (by simp [a0,clearedPorts_stacks,constantStartPorts])
    (by simp [a0,clearedPorts_stacks,constantStartPorts])
    (by
      intro out hout i hi
      simp only [a0,clearedPorts_stacks]
      have hm' : constant out i∈constantStartPorts := by
        simp only [constantStartPorts,List.mem_append,List.mem_flatMap]
        exact Or.inr ⟨out,hout,List.mem_map_of_mem hi⟩
      simp [hm'])
  have h639 : a1.stacks 639=[] := by
    rw [hsb]
    simp [constantBatchStacks,a0,clearedPorts_stacks,constantStartPorts]
  have hp := copyPlan_eval constantAliases a1 (by
    intro p hp
    simp only [constantAliases,List.mem_cons,List.not_mem_nil,or_false] at hp
    rcases hp with rfl|rfl|rfl|rfl <;> decide) h639
  let cb := constantStartPorts.length*(2*W+3)
  let bb := 3*(7*B+8+(LeafProgram.Constants.budget B (a.stacks 204).length+1))
  have hnc : clearPortsCost constantStartPorts a ≤ cb :=
    clearPortsCost_bound constantStartPorts a W (fun i _ => hw i)
  have hnb' : nb ≤ bb := by simpa [bb,hframe 204 (by decide)] using hnb
  have hwidth : ∀ i,(a1.stacks i).length ≤ W+(cb+bb)+2 := by
    intro i
    have h := eval_width_le (hc.seq hb) hw i
    omega
  have hpc := copyPlanCost_bound constantAliases a1 (W+(cb+bb)+2) hwidth
  refine ⟨clearPortsCost constantStartPorts a+nb+copyPlanCost constantAliases a1,
    ?_,copiedPlan constantAliases a1,?_,?_⟩
  · change _ ≤ cb+bb+constantAliases.length*(9*(W+(cb+bb)+2)+8)
    omega
  · simpa only [constantsPhase,Nat.add_assoc] using hc.seq (hb.seq hp)
  · simp only [constantResultStacks]
    have hst : a1.stacks=(⟨a0.regs,constantBatchStacks a0 one minusOne zero⟩ : Data).stacks := hsb
    simp only [constantAliases,copiedPlan,copied,hst,a0]

end SubexponentialSAT.SqrtLog.LeafRingSetupProgram

namespace SubexponentialSAT.SqrtLog.LeafRingSetupProgram
open BitProgram StructuredCalls SubexpQuarticRing SubexpLiftRing StackRoutines
local instance : Fact (Nat.Prime 3) := ⟨by decide⟩

def idempotentStartPorts : List (Fin 640) := 281::639::idempotentPorts

abbrev idempotentPhase : Cmd 32 640 :=
  .seq (clearPorts idempotentStartPorts) (.seq (overwrite 373 511)
    (.seq RegisterResetProgram.all (.seq idempotentCall (overwrite 512 281))))

def idempotentBudget (t W : ℕ) : ℕ :=
  idempotentStartPorts.length*(2*W+3)+(7*W+8)+32+
    IdempotentProgram.completeBudget t W+(7*(6*t^2)+8)

/-- A fresh private Newton execution produces the persistent coefficient
master.  Its modulus/cache witnesses are generated, not supplied inputs. -/
theorem idempotentPhase_eval (a : Data) (t W : ℕ) (ht : 0 < t)
    (hv : CounterPrograms.value (a.stacks 373)=t)
    (hw : ∀ i,(a.stacks i).length ≤ W) :
    ∃ n ≤ idempotentBudget t W, ∃ e : Data,
      ∃ (M : SubexpPreparedQuartic.Modulus 3 t) (cache : RingProgram.ScalarCache 3 t)
        (u : RingProgram.ScalarCode 3 t),
      Eval idempotentPhase n a e ∧
      e.stacks 281=RingProgram.flat (IdempotentProgram.binaryLiftWords t M cache u) ∧
      (2 : ZMod (3^t))*wordValue 3 t u=1 ∧
      (∀ i, i∉idempotentStartPorts → e.stacks i=a.stacks i) := by
  let a0 := clearedPorts idempotentStartPorts a
  have hc := clearPorts_eval idempotentStartPorts a
  have h373 : a0.stacks 373=a.stacks 373 := by
    have hnot : (373 : Fin 640)∉idempotentStartPorts := by decide
    simp [a0,clearedPorts_stacks,hnot]
  have h511 : a0.stacks 511=[] := by
    simp only [a0,clearedPorts_stacks]
    have hm : (511 : Fin 640)∈idempotentStartPorts := by decide
    simp [hm]
  have h639 : a0.stacks 639=[] := by
    simp [a0,clearedPorts_stacks,idempotentStartPorts]
  let a1 : Data := ⟨readRegs a0.regs 30 31 none,
    Function.update a0.stacks 511 (a0.stacks 373)⟩
  have hcopy : Eval (overwrite 373 511) (7*(a.stacks 373).length+8) a0 a1 := by
    simpa [a1,h511,h373] using overwrite_eval 373 511 a0 (by decide) (by decide) (by decide) h639
  let a2 := RegisterResetProgram.zeroed a1
  have hr := RegisterResetProgram.all_eval a1
  have hin : projectState (registers 8 (by decide)) idempotent a2=
      IdempotentPreparationProgram.inputData (a.stacks 373) := by
    apply congrArg₂ StructuredProgram.State.mk
    · rfl
    · funext j
      change Function.update a0.stacks 511 (a0.stacks 373) (idempotent j)=_
      by_cases hj : j=31
      · subst j
        change Function.update a0.stacks 511 (a0.stacks 373) 511=a.stacks 373
        simp [h373]
      · have hn : idempotent j≠511 := by
          intro he
          exact hj (idempotent_injective he)
        have hm : idempotent j∈idempotentStartPorts := by
          simp [idempotentStartPorts,idempotentPorts]
        simp [hn,a0,clearedPorts_stacks,hm,hj]
  obtain ⟨ni,hni,raw,M,cache,u,hi,ho,hu⟩ := idempotentCall_eval a2 (a.stacks 373) t hv ht hin
  let a3 := embedState (registers 8 (by decide)) idempotent a2 raw
  have h512 : a3.stacks 512=RingProgram.flat (IdempotentProgram.binaryLiftWords t M cache u) :=
    (embedState_stack _ _ _ _ idempotent_injective 32).trans ho
  have h281 : a3.stacks 281=[] := by
    rw [show a3.stacks 281=a2.stacks 281 from embedState_stack_frame _ _ _ _ _ (by decide)]
    simp [a2,a1,a0,clearedPorts_stacks,idempotentStartPorts]
  have h639' : a3.stacks 639=[] := by
    rw [show a3.stacks 639=a2.stacks 639 from embedState_stack_frame _ _ _ _ _ (by decide)]
    simpa [a2,a1,RegisterResetProgram.zeroed] using h639
  let e : Data := ⟨readRegs a3.regs 30 31 none,
    Function.update a3.stacks 281 (a3.stacks 512)⟩
  have hp : Eval (overwrite 512 281) (7*(6*t^2)+8) a3 e := by
    simpa only [e,h281,List.length_nil,Nat.mul_zero,Nat.zero_add,h512,IdempotentProgram.completeProgram_output_length] using
      overwrite_eval 512 281 a3 (by decide) (by decide) (by decide) h639'
  have hnc := clearPortsCost_bound idempotentStartPorts a W (fun i _ => hw i)
  have hmono : IdempotentProgram.completeBudget t (a.stacks 373).length ≤
      IdempotentProgram.completeBudget t W := by
    unfold IdempotentProgram.completeBudget IdempotentPreparationProgram.preparationBudget
      IdempotentPreparationProgram.finishBudget IdempotentPreparationProgram.Scan.tableBudget
      IdempotentPreparationProgram.Scan.scanBudget IdempotentProgram.nativeLiftBudget
    gcongr
    all_goals exact hw 373
  refine ⟨clearPortsCost idempotentStartPorts a+(7*(a.stacks 373).length+8)+32+ni+(7*(6*t^2)+8),
    ?_,e,M,cache,u,?_,?_,hu,?_⟩
  · have hn := hni.trans hmono
    have hb := hw 373
    unfold idempotentBudget
    omega
  · simpa only [idempotentPhase,Nat.add_assoc] using hc.seq (hcopy.seq (hr.seq (hi.seq hp)))
  · simpa [e] using h512
  · intro i hi'
    have hn281 : i≠281 := by intro he; subst i; exact hi' (by simp [idempotentStartPorts])
    have hn511 : i≠511 := by intro he; subst i; exact hi' (by decide)
    have hn : ¬∃ j,idempotent j=i := by
      rintro ⟨j,rfl⟩
      exact hi' (by simp [idempotentStartPorts,idempotentPorts])
    simp only [e,Function.update_of_ne hn281]
    rw [show a3.stacks i=a2.stacks i from embedState_stack_frame _ _ _ _ _ hn]
    simp [a2,a1,hn511,a0,clearedPorts_stacks,hi']

end SubexponentialSAT.SqrtLog.LeafRingSetupProgram

namespace SubexponentialSAT.SqrtLog.LeafRingSetupProgram
open BitProgram StructuredCalls SubexpQuarticRing SubexpLiftRing StackRoutines

def nodesStartPorts : List (Fin 640) :=
  [256,612,613,614,615,616,617,618,619,620,621,622,623,625,628,639,
   295,297,298,299,306,300]

def nodeInputs : List (Fin 640 × Fin 640) := [(203,617),(361,625)]

abbrev nodesPhase : Cmd 32 640 :=
  .seq (clearPorts nodesStartPorts) (.seq (copyPlan nodeInputs) (.seq nodesCall
    (.seq (overwrite 256 628) (.seq nodeFramesCall (overwrite 628 256)))))

def nodesBudget (W t d Q : ℕ) : ℕ :=
  nodesStartPorts.length*(2*W+3)+2*(9*W+8)+
    (RingNodeProgram.budget (baseWidth 3 t) W d Q+5)+
    2*(7*(Q*(d*baseWidth 3 t))+8)+(Q*(28*(d*baseWidth 3 t)+33)+11)

/-- Both flat nodes and their framed master are produced and retained. The
flat list is copied before framing consumes it, and restored afterwards. -/
theorem nodesPhase_eval (a : Data) (t d Q W : ℕ) (ht : 0 < t)
    (hw : ∀ i,(a.stacks i).length ≤ W)
    (hzero : a.stacks 203=List.replicate (baseWidth 3 t) false)
    (hd : (a.stacks 204).length=d)
    (hq : BinaryArithmetic.toNat (a.stacks 361)=Q)
    (hcount : a.stacks 296=List.replicate Q true)
    (hwidth : (a.stacks 280).length=d*baseWidth 3 t) :
    ∃ n ≤ nodesBudget W t d Q, ∃ e : Data,
      Eval nodesPhase n a e ∧
      e.stacks 256=((nodeWords t d Q).map RingProgram.flat).flatten ∧
      e.stacks 300=Encoding.encodeList id ((nodeWords t d Q).map RingProgram.flat) ∧
      (∀ i, i∉296::nodesStartPorts → e.stacks i=a.stacks i) := by
  let a0 := clearedPorts nodesStartPorts a
  let a1 := copiedPlan nodeInputs a0
  have hc := clearPorts_eval nodesStartPorts a
  have h639 : a0.stacks 639=[] := by simp [a0,clearedPorts_stacks,nodesStartPorts]
  have hcopy := copyPlan_eval nodeInputs a0 (by
    intro p hp
    simp only [nodeInputs,List.mem_cons,List.not_mem_nil,or_false] at hp
    rcases hp with rfl|rfl <;> decide) h639
  have ha1 (i : Fin 640) : a1.stacks i=
      Function.update (Function.update a0.stacks 617 (a0.stacks 203)) 625 (a0.stacks 361) i := by
    simp [a1,nodeInputs,copiedPlan,copied]
  have hin : NodesInput t a1 := by
    constructor
    · simpa [ha1,a0,clearedPorts_stacks,nodesStartPorts] using hzero
    · intro i hi
      fin_cases i <;> simp_all [a0,clearedPorts_stacks,nodesStartPorts,nodes]
  have hd1 : (a1.stacks 204).length=d := by
    simpa [ha1,a0,clearedPorts_stacks,nodesStartPorts] using hd
  have hq1 : BinaryArithmetic.toNat (a1.stacks 625)=Q := by
    simpa [ha1,a0,clearedPorts_stacks,nodesStartPorts] using hq
  have hl1 : (a1.stacks 625).length ≤ W := by
    simpa [ha1,a0,clearedPorts_stacks,nodesStartPorts] using hw 361
  obtain ⟨nn,hnn,a2,hnodes,hflat,hdeg,hframe⟩ := nodesCall_produces t ht a1 hin
  have hflat' : a2.stacks 256=((nodeWords t d Q).map RingProgram.flat).flatten := by
    cases hd1
    simpa only [hq1] using hflat
  have hlen : (a2.stacks 256).length=Q*(d*baseWidth 3 t) := by
    rw [hflat',nodeWords_flat_length]
  have h2frame (i : Fin 640) (hi : ¬∃ j,nodes j=i) :
      a2.stacks i=Function.update (Function.update a0.stacks 617 (a0.stacks 203))
        625 (a0.stacks 361) i := (hframe i hi).trans (ha1 i)
  have h628 : a2.stacks 628=[] := by
    rw [h2frame 628 (by decide)]
    simp [a0,clearedPorts_stacks,nodesStartPorts]
  have h2639 : a2.stacks 639=[] := by
    rw [h2frame 639 (by decide)]
    simp [a0,clearedPorts_stacks,nodesStartPorts]
  let a3 : Data := ⟨readRegs a2.regs 30 31 none,
    Function.update a2.stacks 628 (a2.stacks 256)⟩
  have hsave : Eval (overwrite 256 628) (7*(Q*(d*baseWidth 3 t))+8) a2 a3 := by
    simpa [a3,h628,hlen] using overwrite_eval 256 628 a2 (by decide) (by decide) (by decide) h2639
  have h3width : a3.stacks 280=a.stacks 280 := by
    simp only [a3,Function.update_of_ne (by decide : (280 : Fin 640)≠628)]
    rw [h2frame 280 (by decide)]
    simp [a0,clearedPorts_stacks,nodesStartPorts]
  have hf295 : a2.stacks 295=[] := by
    rw [h2frame 295 (by decide)]
    simp [a0,clearedPorts_stacks,nodesStartPorts]
  have hf297 : a2.stacks 297=[] := by
    rw [h2frame 297 (by decide)]
    simp [a0,clearedPorts_stacks,nodesStartPorts]
  have hf298 : a2.stacks 298=[] := by
    rw [h2frame 298 (by decide)]
    simp [a0,clearedPorts_stacks,nodesStartPorts]
  have hf299 : a2.stacks 299=[] := by
    rw [h2frame 299 (by decide)]
    simp [a0,clearedPorts_stacks,nodesStartPorts]
  have hf306 : a2.stacks 306=[] := by
    rw [h2frame 306 (by decide)]
    simp [a0,clearedPorts_stacks,nodesStartPorts]
  have hf300 : a2.stacks 300=[] := by
    rw [h2frame 300 (by decide)]
    simp [a0,clearedPorts_stacks,nodesStartPorts]
  have hf296 : a2.stacks 296=List.replicate Q true := by
    rw [h2frame 296 (by decide)]
    simpa [a0,clearedPorts_stacks,nodesStartPorts] using hcount
  have hfinput : projectState (registers 5 (by decide)) nodeFramePorts a3=
      SubexpTaylorFrames.state (a3.regs ∘ registers 5 (by decide))
        (SubexpTaylorFrames.data (a.stacks 280) Q
          (((nodeWords t d Q).map RingProgram.flat).flatten) []) := by
    apply congrArg₂ StructuredProgram.State.mk rfl
    funext i
    fin_cases i
    · change a3.stacks 256 = _
      simpa [SubexpTaylorFrames.store, SubexpTaylorFrames.data, a3,
        Function.update_of_ne (by decide : (256 : Fin 640)≠628)] using hflat'
    · exact h3width
    · change a3.stacks 295 = _
      simpa [SubexpTaylorFrames.store, SubexpTaylorFrames.data, a3,
        Function.update_of_ne (by decide : (295 : Fin 640)≠628)] using hf295
    · change a3.stacks 296 = _
      simpa [SubexpTaylorFrames.store, SubexpTaylorFrames.data, a3,
        Function.update_of_ne (by decide : (296 : Fin 640)≠628)] using hf296
    · change a3.stacks 297 = _
      simpa [SubexpTaylorFrames.store, SubexpTaylorFrames.data, a3,
        Function.update_of_ne (by decide : (297 : Fin 640)≠628)] using hf297
    · change a3.stacks 298 = _
      simpa [SubexpTaylorFrames.store, SubexpTaylorFrames.data, a3,
        Function.update_of_ne (by decide : (298 : Fin 640)≠628)] using hf298
    · change a3.stacks 299 = _
      simpa [SubexpTaylorFrames.store, SubexpTaylorFrames.data, a3,
        Function.update_of_ne (by decide : (299 : Fin 640)≠628)] using hf299
    · change a3.stacks 306 = _
      simpa [SubexpTaylorFrames.store, SubexpTaylorFrames.data, a3,
        Function.update_of_ne (by decide : (306 : Fin 640)≠628)] using hf306
    · change a3.stacks 300 = _
      simpa [SubexpTaylorFrames.store, SubexpTaylorFrames.data, a3,
        Function.update_of_ne (by decide : (300 : Fin 640)≠628)] using hf300
  obtain ⟨rf,hfr⟩ := nodeFramesCall_eval a3 (a3.regs ∘ registers 5 (by decide))
    t d Q (a.stacks 280) hwidth hfinput
  let a4 := embedState (registers 5 (by decide)) nodeFramePorts a3
    (SubexpTaylorFrames.state rf
      {SubexpTaylorFrames.data (a.stacks 280) 0 [] [] with
        output:=Encoding.encodeList id ((nodeWords t d Q).map RingProgram.flat)})
  have h4256 : a4.stacks 256=[] := embedState_stack _ _ _ _ nodeFramePorts_injective 0
  have h4300 : a4.stacks 300=Encoding.encodeList id ((nodeWords t d Q).map RingProgram.flat) :=
    embedState_stack _ _ _ _ nodeFramePorts_injective 8
  have h4628 : a4.stacks 628=a2.stacks 256 := by
    rw [show a4.stacks 628=a3.stacks 628 from embedState_stack_frame _ _ _ _ _ (by decide)]
    simp [a3]
  have h4639 : a4.stacks 639=[] := by
    rw [show a4.stacks 639=a3.stacks 639 from embedState_stack_frame _ _ _ _ _ (by decide)]
    simpa [a3] using h2639
  let e : Data := ⟨readRegs a4.regs 30 31 none,Function.update a4.stacks 256 (a4.stacks 628)⟩
  have hrestore : Eval (overwrite 628 256) (7*(Q*(d*baseWidth 3 t))+8) a4 e := by
    simpa [e,h4256,h4628,hlen] using overwrite_eval 628 256 a4 (by decide) (by decide) (by decide) h4639
  have hcb := clearPortsCost_bound nodesStartPorts a W (fun i _ => hw i)
  have h0w : ∀ i,(a0.stacks i).length ≤ W := by
    intro i
    simp only [a0,clearedPorts_stacks]
    split_ifs <;> simp_all [hw i]
  have hpb := copyPlanCost_bound nodeInputs a0 W h0w
  have hnb : nn ≤ RingNodeProgram.budget (baseWidth 3 t) W d Q+5 := by
    rw [hd1,hq1] at hnn
    apply hnn.trans
    unfold RingNodeProgram.budget RingNodeProgram.stepBudget
    gcongr
  refine ⟨clearPortsCost nodesStartPorts a+copyPlanCost nodeInputs a0+nn+
      (7*(Q*(d*baseWidth 3 t))+8)+(Q*(28*(a.stacks 280).length+33)+11)+
      (7*(Q*(d*baseWidth 3 t))+8),?_,e,?_,?_,?_,?_⟩
  · unfold nodesBudget
    rw [hwidth]
    change copyPlanCost nodeInputs a0 ≤ 2*(9*W+8) at hpb
    omega
  · simpa only [nodesPhase,Nat.add_assoc] using
      hc.seq (hcopy.seq (hnodes.seq (hsave.seq (hfr.seq hrestore))))
  · simpa [e,h4628] using hflat'
  · simpa [e] using h4300
  · intro i hi
    by_cases hi280 : i=280
    · subst i
      have hp280 : a4.stacks 280=a.stacks 280 :=
        embedState_stack _ _ _ _ nodeFramePorts_injective 1
      simpa [e] using hp280
    have hni : i≠256 ∧ i≠628 ∧ i≠617 ∧ i≠625 := by
      refine ⟨?_,?_,?_,?_⟩ <;> intro he <;> subst i <;> exact hi (by decide)
    have hnf : ¬∃ j,nodeFramePorts j=i := by
      rintro ⟨j,rfl⟩
      fin_cases j
      all_goals simp [nodeFramePorts, nodesStartPorts] at hi hi280
    by_cases hi204 : i=204
    · subst i
      simp only [e,Function.update_of_ne (by decide : (204 : Fin 640)≠256)]
      rw [show a4.stacks 204=a3.stacks 204 from embedState_stack_frame _ _ _ _ _ (by decide)]
      simpa [a3,ha1,a0,clearedPorts_stacks,nodesStartPorts] using hdeg
    · have hnn' : ¬∃ j,nodes j=i := by
        rintro ⟨j,hj⟩
        by_cases hj14 : j=14
        · subst j
          exact hi204 hj.symm
        · have hm : nodes j∈296::nodesStartPorts := by
            fin_cases j
            all_goals simp [nodes, nodesStartPorts] at hj14 ⊢
          exact hi (hj ▸ hm)
      simp only [e,Function.update_of_ne hni.1]
      have ha4frame : a4.stacks i=a3.stacks i :=
        embedState_stack_frame _ _ _ _ _ hnf
      rw [ha4frame]
      simp only [a3,Function.update_of_ne hni.2.1]
      rw [h2frame i hnn']
      simp [hni.2.2.1,hni.2.2.2,a0,clearedPorts_stacks,
        show i∉nodesStartPorts from fun hh => hi (List.mem_cons_of_mem _ hh)]

end SubexponentialSAT.SqrtLog.LeafRingSetupProgram

namespace SubexponentialSAT.SqrtLog.LeafRingSetupProgram
open BitProgram StructuredCalls SubexpQuarticRing SubexpLiftRing
local instance : Fact (Nat.Prime 3) := ⟨by decide⟩

/-- Persistent ring data. The private scalar masters are deliberately not
part of this contract: later private Newton preparation may reuse them. -/
structure RingCaches (t d : ℕ) (model : RingModel.Data d)
    (M : SubexpPreparedQuartic.Modulus 3 t) (cache : RingProgram.ScalarCache 3 t)
    (u : RingProgram.ScalarCode 3 t) (a : Data) : Prop where
  modulus : a.stacks 194=M.bits
  width : (a.stacks 202).length=baseWidth 3 t
  degree : (a.stacks 204).length=d
  scalarZero : a.stacks 203=cache.zero.val
  table : a.stacks 201=RingProgramTable.modelTable t model M cache
  precision : a.stacks 212=List.replicate t true
  half : a.stacks 253=u.val
  inverse : (2 : ZMod (3^t))*wordValue 3 t u=1
  canonical : BinaryArithmetic.toNat cache.zero.val < 3^t
  fullZero : a.stacks 280=RingProgramTable.literalBits d cache.zero cache.zero
  fullOne : a.stacks 207=RingProgramTable.literalBits d cache.one cache.zero
  fullMinusOne : a.stacks 211=RingProgramTable.literalBits d cache.minusOne cache.zero
  readoutZero : a.stacks 190=a.stacks 280
  aliasZero : a.stacks 249=a.stacks 280
  aliasOne : a.stacks 250=a.stacks 207
  aliasMinusOne : a.stacks 251=a.stacks 211

def ringCachePorts : List (Fin 640) :=
  [194,202,204,203,201,212,253,280,207,211,190,249,250,251]

/-- The generated canonical scalar zero has the literal bytes required by
the native CRT/readback interface. No additional cache premise is needed. -/
theorem RingCaches.zero_bytes {t d : ℕ} {model : RingModel.Data d}
    {M : SubexpPreparedQuartic.Modulus 3 t} {cache : RingProgram.ScalarCache 3 t}
    {u : RingProgram.ScalarCode 3 t} {a : Data}
    (h : RingCaches t d model M cache u a) :
    cache.zero.val=List.replicate (baseWidth 3 t) false :=
  IdempotentPreparationProgram.Scalar.canonical_zero_bytes t cache h.canonical

/-- The dynamic constant constructor emits the model's exact zero code. -/
theorem RingCaches.fullZero_model {t d : ℕ} {model : RingModel.Data d}
    {M : SubexpPreparedQuartic.Modulus 3 t} {cache : RingProgram.ScalarCache 3 t}
    {u : RingProgram.ScalarCode 3 t} {a : Data}
    (h : RingCaches t d model M cache u a) :
    a.stacks 280=RingProgram.flat (RingProgram.modelProgram t model M cache).zeroRun.1 := by
  rw [h.fullZero,←LeafProgram.Constants.constantCode_flat]
  congr 1
  funext i
  simp [LeafProgram.Constants.constantCode,RingProgram.modelProgram,RingProgram.quotientProgram,
    RingProgram.program,RingProgram.zeroVector,RingProgram.scalarProgram]

/-- The dynamic constant constructor also emits the exact model one code. -/
theorem RingCaches.fullOne_model {t d : ℕ} {model : RingModel.Data d}
    {M : SubexpPreparedQuartic.Modulus 3 t} {cache : RingProgram.ScalarCache 3 t}
    {u : RingProgram.ScalarCode 3 t} {a : Data}
    (h : RingCaches t d model M cache u a) :
    a.stacks 207=RingProgram.flat (RingProgram.modelProgram t model M cache).oneRun.1 := by
  rw [h.fullOne,←LeafProgram.Constants.constantCode_flat]
  congr 1
  funext i
  simp [LeafProgram.Constants.constantCode,RingProgram.modelProgram,RingProgram.quotientProgram,
    RingProgram.program,RingProgram.oneVectorRun,RingProgram.tabulateRun_eq,RingProgram.scalarProgram]
  split_ifs <;> rfl

theorem RingCaches.frame {t d : ℕ} {model : RingModel.Data d}
    {M : SubexpPreparedQuartic.Modulus 3 t} {cache : RingProgram.ScalarCache 3 t}
    {u : RingProgram.ScalarCode 3 t} {a e : Data}
    (h : RingCaches t d model M cache u a)
    (hf : ∀ i∈ringCachePorts,e.stacks i=a.stacks i) : RingCaches t d model M cache u e := by
  constructor
  · simpa only [hf 194 (by decide)] using h.modulus
  · simpa only [hf 202 (by decide)] using h.width
  · simpa only [hf 204 (by decide)] using h.degree
  · simpa only [hf 203 (by decide)] using h.scalarZero
  · simpa only [hf 201 (by decide)] using h.table
  · simpa only [hf 212 (by decide)] using h.precision
  · simpa only [hf 253 (by decide)] using h.half
  · exact h.inverse
  · exact h.canonical
  · simpa only [hf 280 (by decide)] using h.fullZero
  · simpa only [hf 207 (by decide)] using h.fullOne
  · simpa only [hf 211 (by decide)] using h.fullMinusOne
  · simpa only [hf 190 (by decide), hf 280 (by decide)] using h.readoutZero
  · simpa only [hf 249 (by decide), hf 280 (by decide)] using h.aliasZero
  · simpa only [hf 250 (by decide), hf 207 (by decide)] using h.aliasOne
  · simpa only [hf 251 (by decide), hf 211 (by decide)] using h.aliasMinusOne

theorem constantsPhase_produces {t d : ℕ} {model : RingModel.Data d}
    {M : SubexpPreparedQuartic.Modulus 3 t} {cache : RingProgram.ScalarCache 3 t}
    {u : RingProgram.ScalarCode 3 t} (a : Data) (h : CoreOutput t d model M cache u a)
    (W : ℕ) (hw : ∀ i,(a.stacks i).length ≤ W) :
    ∃ n ≤ constantsBudget W (baseWidth 3 t) d, ∃ e : Data,
      Eval constantsPhase n a e ∧ RingCaches t d model M cache u e ∧
      (∀ i, i∉constantStartPorts ∧ i∉([190,249,250,251] : List (Fin 640)) →
        e.stacks i=a.stacks i) := by
  obtain ⟨n,hn,e,he,hs⟩ := constantsPhase_eval a cache.one cache.minusOne cache.zero W hw
    h.one h.minusOne h.zero
  have hcalc (i : Fin 640) : e.stacks i=constantResultStacks a cache.one cache.minusOne cache.zero i :=
    congrFun hs i
  have hf (i : Fin 640) (hi : i∉constantStartPorts)
      (hj : i∉([190,249,250,251] : List (Fin 640))) : e.stacks i=a.stacks i := by
    rw [hcalc]
    unfold constantResultStacks
    rw [copiedPlan_frame]
    · have h207 : i≠207 := by intro hh; subst i; exact hi (by decide)
      have h211 : i≠211 := by intro hh; subst i; exact hi (by decide)
      have h280 : i≠280 := by intro hh; subst i; exact hi (by decide)
      have h538 : i≠538 := by intro hh; subst i; exact hi (by decide)
      simp [constantBatchStacks,h207,h211,h280,h538,clearedPorts_stacks,hi]
    · intro p hp
      simp only [constantAliases,List.mem_cons,List.not_mem_nil,or_false] at hp
      rcases hp with rfl|rfl|rfl|rfl <;> intro hh <;> subst i <;> exact hj (by simp)
  have hspecial (i : Fin 640) := congrFun hs i
  have h204 : (clearedPorts constantStartPorts a).stacks 204=a.stacks 204 := by
    rw [clearedPorts_stacks,ite_eq_right (by decide)]
  refine ⟨n,by simpa [h.degree] using hn,e,he,?_,fun i hi => hf i hi.1 hi.2⟩
  constructor
  · simpa only [hf 194 (by decide) (by decide)] using h.modulus
  · simpa only [hf 202 (by decide) (by decide)] using h.width
  · simpa only [hf 204 (by decide) (by decide)] using h.degree
  · simpa only [hf 203 (by decide) (by decide)] using h.zero
  · simpa only [hf 201 (by decide) (by decide)] using h.table
  · simpa only [hf 212 (by decide) (by decide)] using h.precision
  · simpa only [hf 253 (by decide) (by decide)] using h.half
  · exact h.inverse
  · exact h.zeroCanonical
  all_goals simp [hcalc,constantResultStacks,constantAliases,copiedPlan,copied,
    constantBatchStacks,h204,h.degree]

/-- The final cleanup produces the exact shared scalar and polynomial
contexts consumed by the existing native arithmetic programs. -/
def finalDiscard : List (Fin 640) := (195::privatePorts)++arithmeticCleanPorts

abbrev finalCleanup : Cmd 32 640 := .seq (clearPorts finalDiscard) RegisterResetProgram.all

theorem finalCleanup_produces {t d : ℕ} {model : RingModel.Data d}
    {M : SubexpPreparedQuartic.Modulus 3 t} {cache : RingProgram.ScalarCache 3 t}
    {u : RingProgram.ScalarCode 3 t} (a : Data) (h : RingCaches t d model M cache u a) :
    ∃ e : Data, Eval finalCleanup (clearPortsCost finalDiscard a+32) a e ∧
      RingCaches t d model M cache u e ∧ NativeBytes t d model M cache e ∧
      (∀ i∈privatePorts,e.stacks i=[]) ∧
      (∀ i, i∉finalDiscard → e.stacks i=a.stacks i) := by
  let a0 := clearedPorts finalDiscard a
  let e := RegisterResetProgram.zeroed a0
  have hf (i : Fin 640) (hi : i∉finalDiscard) : e.stacks i=a.stacks i := by
    simp [e,a0,clearedPorts_stacks,hi]
  have hr : RingCaches t d model M cache u e := h.frame (by
    intro i hi
    apply hf
    simp only [ringCachePorts,List.mem_cons,List.not_mem_nil,or_false] at hi
    rcases hi with rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl <;> decide)
  refine ⟨e,(clearPorts_eval finalDiscard a).seq (RegisterResetProgram.all_eval a0),hr,?_,?_,hf⟩
  · refine ⟨hr.modulus,hr.width,hr.scalarZero,hr.table,hr.degree,?_,?_⟩
    · rw [hr.fullZero,←LeafProgram.Constants.constantCode_flat,RingProgram.flat_length]
    · intro i hi
      have hm : i.castLE (by decide)∈finalDiscard := by
        apply List.mem_append_right
        apply List.mem_map.mpr
        exact ⟨i,List.mem_append_left _ hi,rfl⟩
      simp [e,a0,clearedPorts_stacks,hm]
  · intro i hi
    have hm : i∈finalDiscard := List.mem_append_left _ (List.mem_cons_of_mem _ hi)
    simp [e,a0,clearedPorts_stacks,hm]

end SubexponentialSAT.SqrtLog.LeafRingSetupProgram

namespace SubexponentialSAT.SqrtLog.LeafRingSetupProgram
open BitProgram StructuredCalls LeafParametersProgram SubexpQuarticRing SubexpLiftRing
local instance : Fact (Nat.Prime 3) := ⟨by decide⟩

/-- All collector tapes lie outside every setup write set. -/
theorem collector_not_touched (i : Fin 640) (hlo : 320 ≤ i.val) (hhi : i.val < 340) :
    i∉finalDiscard ∧ i∉idempotentStartPorts ∧ i∉296::nodesStartPorts ∧
    i∉constantStartPorts ∧ i∉([190,249,250,251] : List (Fin 640)) ∧ i∉coreWritePorts := by
  have hall (j : Fin 20) :
      let x : Fin 640 := ⟨320+j.val,by omega⟩
      x∉finalDiscard ∧ x∉idempotentStartPorts ∧ x∉296::nodesStartPorts ∧
      x∉constantStartPorts ∧ x∉([190,249,250,251] : List (Fin 640)) ∧ x∉coreWritePorts := by
    fin_cases j <;> exact of_decide_eq_true rfl
  let j : Fin 20 := ⟨i.val-320,by omega⟩
  have hi : (⟨320+j.val,by omega⟩ : Fin 640)=i := by
    apply Fin.ext
    dsimp [j]
    omega
  simpa only [hi] using hall j

/-- The assembled producer uses the proved clearing boundaries between
services, rather than depending on unused values in prior work tapes. -/
abbrev producerCommand : Cmd 32 640 := .seq numberPhase (.seq coreCommand
  (.seq constantsPhase (.seq nodesPhase (.seq idempotentPhase finalCleanup))))

def producerProgram := compiled producerCommand (parameters 0) 300

abbrev producerWideCall : Cmd 40 768 :=
  .call (ProgramLinking.liftProgram producerProgram wideRegisters wideStacks)

/-- Stage costs are composed with actual tape growth. All stage counts are
fixed polynomials except the explicit, independently bounded search and
Newton budgets. -/
def producerBudget (m : Circuit.Model) (initialWidth V bankWidth : ℕ) : ℕ :=
  let b0 := numberBudget m initialWidth V bankWidth
  let b1 := coreBudget (m.val 33) (m.val 34) bankWidth
  let w1 := initialWidth+b0+b1+1
  let b2 := constantsBudget w1 (baseWidth 3 (m.val 33)) (m.val 34)
  let w2 := w1+b2+1
  let b3 := nodesBudget w2 (m.val 33) (m.val 34) (m.val 21)
  let w3 := w2+b3+1
  let b4 := idempotentBudget (m.val 33) w3
  let w4 := w3+b4+1
  b0+b1+b2+b3+b4+finalDiscard.length*(2*w4+3)+32

structure Produced (m : Circuit.Model) (hd : 0 < m.val 34)
    (M : SubexpPreparedQuartic.Modulus 3 (m.val 33))
    (cache : RingProgram.ScalarCache 3 (m.val 33))
    (u : RingProgram.ScalarCode 3 (m.val 33)) (a : Data) : Prop where
  caches : RingCaches (m.val 33) (m.val 34) (IrreducibleSearch.data hd) M cache u a
  native : NativeBytes (m.val 33) (m.val 34) (IrreducibleSearch.data hd) M cache a
  ambient : a.stacks 191=List.replicate (m.val 0) true
  exponent : a.stacks 209=List.replicate ((Circuit.result Serialization.code m).val 44) true
  jetOrder : a.stacks 243=List.replicate (m.val 42) true
  flatNodes : a.stacks 256=((nodeWords (m.val 33) (m.val 34) (m.val 21)).map RingProgram.flat).flatten
  framedNodes : a.stacks 300=Encoding.encodeList id
    ((nodeWords (m.val 33) (m.val 34) (m.val 21)).map RingProgram.flat)
  idempotent : ∃ (M' : SubexpPreparedQuartic.Modulus 3 (m.val 33))
      (cache' : RingProgram.ScalarCache 3 (m.val 33))
      (u' : RingProgram.ScalarCode 3 (m.val 33)),
    a.stacks 281=RingProgram.flat (IdempotentProgram.binaryLiftWords (m.val 33) M' cache' u') ∧
      (2 : ZMod (3^(m.val 33)))*wordValue 3 (m.val 33) u'=1
  privateClean : ∀ i∈privatePorts,a.stacks i=[]

theorem Produced.zero_bytes {m : Circuit.Model} {hd : 0 < m.val 34}
    {M : SubexpPreparedQuartic.Modulus 3 (m.val 33)}
    {cache : RingProgram.ScalarCache 3 (m.val 33)}
    {u : RingProgram.ScalarCode 3 (m.val 33)} {a : Data}
    (h : Produced m hd M cache u a) :
    cache.zero.val=List.replicate (baseWidth 3 (m.val 33)) false :=
  h.caches.zero_bytes

/-- Complete actual preparation from the physically present finite numeric
bank. No modulus, polynomial, table, scalar cache, node list, idempotent
array, or arithmetic readiness predicate occurs among the premises. -/
theorem producerCommand_eval (a : Data) (m : Circuit.Model)
    (w : Bank.Words) (r : Bank.Regs) (hs : Circuit.Shape m w)
    (ha : projectState (registers 8 (by decide)) parameters a=Bank.state r w)
    (initialWidth V bankWidth : ℕ)
    (hinit : ∀ i,(a.stacks i).length ≤ initialWidth)
    (hv : ∀ i,(Circuit.result Serialization.code m).val i ≤ V)
    (hw : ∀ i,(Circuit.result Serialization.code m).len i ≤ bankWidth)
    (ht : 0 < m.val 33) (hd : 0 < m.val 34) :
    ∃ n ≤ producerBudget m initialWidth V bankWidth, ∃ e : Data,
      ∃ (M : SubexpPreparedQuartic.Modulus 3 (m.val 33))
        (cache : RingProgram.ScalarCache 3 (m.val 33))
        (u : RingProgram.ScalarCode 3 (m.val 33)),
      Eval producerCommand n a e ∧ Produced m hd M cache u e ∧
      (∀ i,320 ≤ i.val → i.val < 340 → e.stacks i=a.stacks i) := by
  let b0 := numberBudget m initialWidth V bankWidth
  let b1 := coreBudget (m.val 33) (m.val 34) bankWidth
  let w1 := initialWidth+b0+b1+1
  let b2 := constantsBudget w1 (baseWidth 3 (m.val 33)) (m.val 34)
  let w2 := w1+b2+1
  let b3 := nodesBudget w2 (m.val 33) (m.val 34) (m.val 21)
  let w3 := w2+b3+1
  let b4 := idempotentBudget (m.val 33) w3
  let w4 := w3+b4+1
  obtain ⟨n0,hn0,a0,w',he0,hshape,hinput,h191,h209,h243,h296,hbank,hcollector⟩ :=
    numberPhase_eval a m w r hs ha initialWidth V bankWidth (fun i _ => hinit i) hv hw
  have hval (i : Fin 64) (hi44 : i≠44) (hi45 : i≠45) :
      BinaryArithmetic.toNat (w' i)=m.val i :=
    (hshape.1 i).trans (Serialization.frame m i hi44 hi45)
  let depth := List.replicate (m.val 34) true
  have hdp : 0 < depth.length := by simpa [depth] using hd
  have hcoreInput : CoreInput (w' 33) depth a0 := by
    simpa [depth,hval 34 (by decide) (by decide)] using hinput
  have htword : CounterPrograms.value (w' 33)=m.val 33 := by
    simpa only [CounterPrograms.value_eq_toNat] using hval 33 (by decide) (by decide)
  obtain ⟨n1,hn1,a1,M,cache,u,he1,hcore,hcoreframe⟩ :=
    coreCommand_eval a0 (w' 33) depth (m.val 33) ht hdp htword hcoreInput
  have hcore' : CoreOutput (m.val 33) (m.val 34) (IrreducibleSearch.data hd) M cache u a1 := by
    exact hcore.reindex (by simp [depth]) hdp hd
  have hn1' : n1 ≤ b1 := by
    simp only [depth,List.length_replicate] at hn1
    apply hn1.trans
    have hlen := (hshape.2 33).trans (hw 33)
    dsimp [b1]
    unfold coreBudget scalarBudget
    gcongr
  have hwidth1 : ∀ i,(a1.stacks i).length ≤ w1 := by
    intro i
    have hh := eval_width_le (he0.seq he1) hinit i
    dsimp [w1,b0]
    omega
  have hmeta1 (i : Fin 640) (hi : i∉coreWritePorts) : a1.stacks i=a0.stacks i := hcoreframe i hi
  obtain ⟨n2,hn2,a2,he2,hcache2,hcf⟩ := constantsPhase_produces a1 hcore' w1 hwidth1
  have hwidth2 : ∀ i,(a2.stacks i).length ≤ w2 := by
    intro i
    have hh := eval_width_le he2 hwidth1 i
    dsimp [w2,b2]
    omega
  have hmeta2 (i : Fin 640) (hi : i∉constantStartPorts)
      (hj : i∉([190,249,250,251] : List (Fin 640))) (hk : i∉coreWritePorts) :
      a2.stacks i=a0.stacks i := (hcf i ⟨hi,hj⟩).trans (hmeta1 i hk)
  have hq2 : BinaryArithmetic.toNat (a2.stacks 361)=m.val 21 := by
    rw [hmeta2 361 (by decide) (by decide) (by decide)]
    rw [show a0.stacks 361=w' 21 from hbank 21]
    exact hval 21 (by decide) (by decide)
  have hc2 : a2.stacks 296=List.replicate (m.val 21) true := by
    rw [hmeta2 296 (by decide) (by decide) (by decide),h296,hval 21 (by decide) (by decide)]
  have hz2 : a2.stacks 203=List.replicate (baseWidth 3 (m.val 33)) false :=
    hcache2.scalarZero.trans (IdempotentPreparationProgram.Scalar.canonical_zero_bytes _ _ hcache2.canonical)
  have hw2 : (a2.stacks 280).length=(m.val 34)*baseWidth 3 (m.val 33) := by
    rw [hcache2.fullZero,←LeafProgram.Constants.constantCode_flat,RingProgram.flat_length]
  obtain ⟨n3,hn3,a3,he3,hflat,hframed,hnf⟩ := nodesPhase_eval a2 (m.val 33) (m.val 34)
    (m.val 21) w2 ht hwidth2 hz2 hcache2.degree hq2 hc2 hw2
  have hcache3 := hcache2.frame (e:=a3) (by
    intro i hi
    apply hnf
    simp only [ringCachePorts,List.mem_cons,List.not_mem_nil,or_false] at hi
    rcases hi with rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl <;> decide)
  have hwidth3 : ∀ i,(a3.stacks i).length ≤ w3 := by
    intro i
    have hh := eval_width_le he3 hwidth2 i
    dsimp [w3,b3]
    omega
  have ht3 : CounterPrograms.value (a3.stacks 373)=m.val 33 := by
    rw [hnf 373 (by decide),hmeta2 373 (by decide) (by decide) (by decide)]
    rw [show a0.stacks 373=w' 33 from hbank 33]
    exact htword
  obtain ⟨n4,hn4,a4,MI,cacheI,uI,he4,hidem,hiinv,hif⟩ :=
    idempotentPhase_eval a3 (m.val 33) w3 ht ht3 hwidth3
  have hcache4 := hcache3.frame (e:=a4) (by
    intro i hi
    apply hif
    simp only [ringCachePorts,List.mem_cons,List.not_mem_nil,or_false] at hi
    rcases hi with rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl <;> decide)
  have hwidth4 : ∀ i,(a4.stacks i).length ≤ w4 := by
    intro i
    have hh := eval_width_le he4 hwidth3 i
    dsimp [w4,b4]
    omega
  obtain ⟨e,he5,hcache5,hnative,hclean,hff⟩ := finalCleanup_produces a4 hcache4
  have hn5 := clearPortsCost_bound finalDiscard a4 w4 (fun i _ => hwidth4 i)
  have hmeta (i : Fin 640) (hfin : i∉finalDiscard) (hid : i∉idempotentStartPorts)
      (hnd : i∉296::nodesStartPorts) (hcs : i∉constantStartPorts)
      (halias : i∉([190,249,250,251] : List (Fin 640))) (hco : i∉coreWritePorts) :
      e.stacks i=a0.stacks i :=
    (hff i hfin).trans ((hif i hid).trans ((hnf i hnd).trans (hmeta2 i hcs halias hco)))
  refine ⟨n0+n1+n2+n3+n4+(clearPortsCost finalDiscard a4+32),?_,e,M,cache,u,?_,?_,?_⟩
  · change _ ≤ b0+b1+b2+b3+b4+finalDiscard.length*(2*w4+3)+32
    omega
  · simpa only [producerCommand,Nat.add_assoc] using
      he0.seq (he1.seq (he2.seq (he3.seq (he4.seq he5))))
  · refine ⟨hcache5,hnative,?_,?_,?_,?_,?_,?_,hclean⟩
    · rw [hmeta 191 (by decide) (by decide) (by decide) (by decide) (by decide) (by decide),h191,
        hval 0 (by decide) (by decide)]
    · rw [hmeta 209 (by decide) (by decide) (by decide) (by decide) (by decide) (by decide),h209,hshape.1 44]
    · rw [hmeta 243 (by decide) (by decide) (by decide) (by decide) (by decide) (by decide),h243,
        hval 42 (by decide) (by decide)]
    · rw [hff 256 (by decide),hif 256 (by decide),hflat]
    · rw [hff 300 (by decide),hif 300 (by decide),hframed]
    · exact ⟨MI,cacheI,uI,(hff 281 (by decide)).trans hidem,hiinv⟩
  · intro i hlo hhi
    obtain ⟨hf,hi,hn,hc,ha,hk⟩ := collector_not_touched i hlo hhi
    exact (hmeta i hf hi hn hc ha hk).trans (hcollector i hlo hhi)

end SubexponentialSAT.SqrtLog.LeafRingSetupProgram

namespace SubexponentialSAT.SqrtLog.LeafRingSetupProgram

/-- Public names refer to the fully assembled, measured producer. -/
abbrev command := producerCommand
abbrev program := producerProgram
abbrev wideCall := producerWideCall

end SubexponentialSAT.SqrtLog.LeafRingSetupProgram

namespace SubexponentialSAT.SqrtLog.LeafRingSetupProgram
open BitProgram StructuredCalls LeafParametersProgram
local instance : Fact (Nat.Prime 3) := ⟨by decide⟩

/-- The fixed finite instruction table realizes the full producer contract. -/
theorem producerProgram_runs (a : Data) (m : Circuit.Model)
    (w : Bank.Words) (r : Bank.Regs) (hs : Circuit.Shape m w)
    (ha : projectState (registers 8 (by decide)) parameters a=Bank.state r w)
    (initialWidth V bankWidth : ℕ)
    (hinit : ∀ i,(a.stacks i).length ≤ initialWidth)
    (hv : ∀ i,(Circuit.result Serialization.code m).val i ≤ V)
    (hw : ∀ i,(Circuit.result Serialization.code m).len i ≤ bankWidth)
    (ht : 0 < m.val 33) (hd : 0 < m.val 34) :
    ∃ e : Data, ∃ (M : SubexpPreparedQuartic.Modulus 3 (m.val 33))
      (cache : RingProgram.ScalarCache 3 (m.val 33))
      (u : RingProgram.ScalarCode 3 (m.val 33)),
      RunsIn producerProgram (producerBudget m initialWidth V bankWidth+1)
        (a.withPC (some producerProgram.entry)) (e.withPC none) ∧
      Produced m hd M cache u e ∧
      (∀ i,320 ≤ i.val → i.val < 340 → e.stacks i=a.stacks i) := by
  obtain ⟨n,hn,e,M,cache,u,he,hp,hf⟩ :=
    producerCommand_eval a m w r hs ha initialWidth V bankWidth hinit hv hw ht hd
  exact ⟨e,M,cache,u,⟨n+1,Nat.add_le_add_right hn 1,compiled_halt_trace he (parameters 0) 300⟩,hp,hf⟩

/-- The outer leaf uses the same actual producer in its larger fixed
ambient. Parser/branch registers and the collector's tapes are retained. -/
theorem producerProgram_lifted (base : StructuredProgram.State 40 768)
    (a : Data) (hbase : projectState wideRegisters wideStacks base=a)
    (m : Circuit.Model) (w : Bank.Words) (r : Bank.Regs) (hs : Circuit.Shape m w)
    (ha : projectState (registers 8 (by decide)) parameters a=Bank.state r w)
    (initialWidth V bankWidth : ℕ)
    (hinit : ∀ i,(a.stacks i).length ≤ initialWidth)
    (hv : ∀ i,(Circuit.result Serialization.code m).val i ≤ V)
    (hw : ∀ i,(Circuit.result Serialization.code m).len i ≤ bankWidth)
    (ht : 0 < m.val 33) (hd : 0 < m.val 34) :
    ∃ n ≤ producerBudget m initialWidth V bankWidth+1, ∃ e : Data,
      ∃ (M : SubexpPreparedQuartic.Modulus 3 (m.val 33))
        (cache : RingProgram.ScalarCache 3 (m.val 33))
        (u : RingProgram.ScalarCode 3 (m.val 33)),
      Eval producerWideCall n base (embedState wideRegisters wideStacks base e) ∧
      Produced m hd M cache u e ∧
      (∀ i : Fin 40,16 ≤ i.val → i.val < 24 →
        (embedState wideRegisters wideStacks base e).regs i=base.regs i) ∧
      (∀ i : Fin 768,640 ≤ i.val →
        (embedState wideRegisters wideStacks base e).stacks i=base.stacks i) ∧
      (∀ i : Fin 640,320 ≤ i.val → i.val < 340 →
        (embedState wideRegisters wideStacks base e).stacks (wideStacks i)=base.stacks (wideStacks i)) := by
  obtain ⟨e,M,cache,u,⟨n,hn,hr⟩,hp,hf⟩ :=
    producerProgram_runs a m w r hs ha initialWidth V bankWidth hinit hv hw ht hd
  refine ⟨n,hn,e,M,cache,u,?_,hp,?_,?_,?_⟩
  · exact eval_call_from_state producerProgram wideRegisters wideStacks base
      wideRegisters_injective wideStacks_injective (hbase.symm ▸ hr)
  · intro i hlo hhi
    apply embedState_register_frame
    rintro ⟨j,hj⟩
    have hh := congrArg Fin.val hj
    dsimp [wideRegisters] at hh
    split_ifs at hh <;> simp only [] at hh <;> omega
  · intro i hlo
    apply embedState_stack_frame
    rintro ⟨j,hj⟩
    have hh := congrArg Fin.val hj
    dsimp [wideStacks] at hh
    have := j.isLt
    omega
  · intro i hlo hhi
    rw [embedState_stack _ _ _ _ wideStacks_injective i,hf i hlo hhi]
    exact congrArg (fun z : Data => z.stacks i) hbase.symm

end SubexponentialSAT.SqrtLog.LeafRingSetupProgram

