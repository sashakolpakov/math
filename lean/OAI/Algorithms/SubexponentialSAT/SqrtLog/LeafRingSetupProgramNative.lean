/-! Arithmetic consumers use the same bytes generated by the preceding
stages.  These are structural handoff lemmas; the complete production
trace must establish `NativeBytes` before invoking them. -/
namespace SubexponentialSAT.SqrtLog.LeafRingSetupProgram
open SubexpLiftRing SubexpQuarticRing

local instance : Fact (Nat.Prime 3) := ⟨by decide⟩

def nativeView (a : Data) : SubexpCRTOuterProgram.Data :=
  ⟨fun i => a.regs (i.castLE (by decide)), fun i => a.stacks (i.castLE (by decide))⟩

structure NativeBytes (t d : ℕ) (model : RingModel.Data d)
    (M : SubexpPreparedQuartic.Modulus 3 t) (cache : RingProgram.ScalarCache 3 t)
    (a : Data) : Prop where
  modulus : a.stacks 194 = M.bits
  width : (a.stacks 202).length = baseWidth 3 t
  zero : a.stacks 203 = cache.zero.val
  table : a.stacks 201 = RingTriple.tableEncoding (HornerProgram.modelTable t model M cache)
  degree : (a.stacks 204).length = d
  fullZeroLength : (a.stacks 280).length = d*baseWidth 3 t
  clean : ∀ i ∈ ReconstructionProgram.InputReady.emptyPorts,
    a.stacks (i.castLE (by decide))=[]

/-- Setup supplies the physical shared scalar/extension-ring context.
The consumer still pays its own entry copies into ports5,10 and104. -/
theorem NativeBytes.nativeReady {t d : ℕ} {model : RingModel.Data d}
    {M : SubexpPreparedQuartic.Modulus 3 t} {cache : RingProgram.ScalarCache 3 t}
    {a : Data} (h : NativeBytes t d model M cache a) :
    HornerProgram.Services.NativeReady 3 t M cache
      (HornerProgram.modelTable t model M cache)
      (ReconstructionProgram.InputReady.base (nativeView a)) :=
  ReconstructionProgram.InputReady.nativeReady 3 t M cache
    (HornerProgram.modelTable t model M cache) (nativeView a)
    h.clean h.modulus h.width h.zero h.table h.degree

theorem NativeBytes.polynomialReady {t d : ℕ} {model : RingModel.Data d}
    {M : SubexpPreparedQuartic.Modulus 3 t} {cache : RingProgram.ScalarCache 3 t}
    {a : Data} (h : NativeBytes t d model M cache a) :
    DensePolynomialProgram.PairSpec.BaseReady 3 t M cache
      (HornerProgram.modelTable t model M cache)
      (ReconstructionProgram.InputReady.base (nativeView a))
      ((nativeView a).stacks 202) (ReconstructionProgram.InputReady.lowFrame (nativeView a)) :=
  ReconstructionProgram.InputReady.polynomialReady 3 t M cache
    (HornerProgram.modelTable t model M cache) (nativeView a)
    h.clean h.modulus h.width h.zero h.table h.degree h.fullZeroLength

