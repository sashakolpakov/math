import OAI.Algorithms.SubexponentialSAT.LeanCompat
import OAI.Algorithms.SubexponentialSAT.SubexpBlueprintRows
import OAI.Algorithms.SubexponentialSAT.SubexpBlueprintPreparedServices

namespace OAI.Algorithms

/-! The complete fixed raw-factor producer: origin dot products, lifted beta,
Ce construction, row packing, and actual scalar-literal preparation. -/

namespace SubexponentialSAT.SubexpBlueprintExecution

open BitProgram StructuredCalls SubexpBlueprintFactor
open SubexpSelectedConversions SubexpInputBitProgram

variable {p D : ℕ} [Fact p.Prime]

def preparedRows (ctx : Context) (source : Prepared p 0) (target : Prepared p D)
    (minusOne : SubexpQuarticRing.Word (SubexpLiftRing.baseWidth p (D+1)))
    (point : Fin D → ResidueCode p) (rows : List (SubexpBlueprintRows.Row p D)) :
    List SubexpTableSource.Row :=
  SubexpPreparedFactor.prepareRows ctx.dimension
    (SubexpBlueprintRows.rowsOutput ctx source target minusOne point rows)

def runCost (ctx : Context) (source : Prepared p 0) (target : Prepared p D)
    (minusOne : SubexpQuarticRing.Word (SubexpLiftRing.baseWidth p (D+1)))
    (point : Fin D → ResidueCode p) (rows : List (SubexpBlueprintRows.Row p D)) : ℕ :=
  SubexpBlueprintRows.rowsCost ctx source target minusOne point rows+8+
    SubexpPreparedFactor.runCost ctx.dimension
      (SubexpBlueprintRows.rowsOutput ctx source target minusOne point rows)+1

theorem command_eval (ctx : Context) (source : Prepared p 0) (target : Prepared p D)
    (minusOne : SubexpQuarticRing.Word (SubexpLiftRing.baseWidth p (D+1)))
    (point : Fin D → ResidueCode p)
    (hc : SubexpBlueprintCoordinate.ContextGood ctx source target minusOne point)
    (hindex : ctx.indexWidth = SubexpSymbolicCost.indexBits ctx.dimension)
    (rows : List (SubexpBlueprintRows.Row p D)) (regs : Fin 8 → Bool) :
    ∃ n, n+1 ≤ runCost ctx source target minusOne point rows ∧
      Eval command n
        (serviceState ctx regs
          (Subexp.FactorBlueprint.encodeRows (rows.map SubexpBlueprintRows.Row.packet)))
        (serviceState ctx (fun _ => false)
          (SubexpTableSource.encodeRows (preparedRows ctx source target minusOne point rows))) := by
  obtain ⟨n,rf,hn,ht⟩ := SubexpBlueprintRows.rawRows_eval ctx source target minusOne point hc rows regs
  have hp := SubexpBlueprintPreparedServices.prepare_eval ctx hindex rf
    (SubexpBlueprintRows.rowsOutput ctx source target minusOne point rows)
  refine ⟨n+(8+SubexpPreparedFactor.runCost ctx.dimension
    (SubexpBlueprintRows.rowsOutput ctx source target minusOne point rows)),?_,ht.seq hp⟩
  unfold runCost
  omega

/-- No raw Ce literal, prepared scalar literal, or postfix source is an input
to this machine. All such bytes are generated by its actual called programs. -/
theorem program_runsIn (ctx : Context) (source : Prepared p 0) (target : Prepared p D)
    (minusOne : SubexpQuarticRing.Word (SubexpLiftRing.baseWidth p (D+1)))
    (point : Fin D → ResidueCode p)
    (hc : SubexpBlueprintCoordinate.ContextGood ctx source target minusOne point)
    (hindex : ctx.indexWidth = SubexpSymbolicCost.indexBits ctx.dimension)
    (rows : List (SubexpBlueprintRows.Row p D)) (regs : Fin 8 → Bool) :
    RunsIn program (runCost ctx source target minusOne point rows)
      ((serviceState ctx regs
        (Subexp.FactorBlueprint.encodeRows (rows.map SubexpBlueprintRows.Row.packet))).withPC
          (some program.entry))
      ((serviceState ctx (fun _ => false)
        (SubexpTableSource.encodeRows (preparedRows ctx source target minusOne point rows))).withPC none) := by
  obtain ⟨n,hn,h⟩ := command_eval ctx source target minusOne point hc hindex rows regs
  exact ⟨n+1,hn,compiled_halt_trace h 100 100⟩

theorem primitive_execution (ctx : Context) (source : Prepared p 0) (target : Prepared p D)
    (minusOne : SubexpQuarticRing.Word (SubexpLiftRing.baseWidth p (D+1)))
    (point : Fin D → ResidueCode p)
    (hc : SubexpBlueprintCoordinate.ContextGood ctx source target minusOne point)
    (hindex : ctx.indexWidth = SubexpSymbolicCost.indexBits ctx.dimension)
    (rows : List (SubexpBlueprintRows.Row p D)) (regs : Fin 8 → Bool) :
    Computation.RunsIn (BitProgram.primitive program).step
      (primitiveOverhead program * runCost ctx source target minusOne point rows)
      (BitProgram.primitiveCfg program ((serviceState ctx regs
        (Subexp.FactorBlueprint.encodeRows (rows.map SubexpBlueprintRows.Row.packet))).withPC
          (some program.entry)))
      (BitProgram.primitiveCfg program ((serviceState ctx (fun _ => false)
        (SubexpTableSource.encodeRows (preparedRows ctx source target minusOne point rows))).withPC none)) :=
  BitProgram.primitive_execution program
    (program_runsIn ctx source target minusOne point hc hindex rows regs)

end SubexponentialSAT.SubexpBlueprintExecution

end OAI.Algorithms
