import OAI.Algorithms.SubexponentialSAT.SqrtLogSpace.QueryReadyConstruction
import OAI.Algorithms.SubexponentialSAT.SqrtLogSpace.QueryVisitorHead

/-! A proof-only native source snapshot retains the actual readiness words.
It does not clear the running machine. The loader starts from the same native
input and generated cache, so all of its eighteen masters remain identical.
Unrelated scratch from earlier nodes is excluded from the source-local cap. -/
noncomputable section
namespace OAI.Algorithms.SubexponentialSAT.SqrtLogSpace.QuerySourceSnapshot
open OAI BitProgram StructuredCalls SqrtLog SubexpSetupStorage
open LeafHeadSetupProgram LeafParametersProgram LeafProgram LeafProgram.PreparedSource

/-- These are exactly the source fields inspected by `Native.Ready`.
The four high loader masters are generated by `Native.start`. -/
def retainedPorts : List (Fin 768) :=
  [128,129,130,131,132,133,134,135,136,138,139,140,141,307,660,665]

/-- A proof snapshot, with every retained byte copied from the actual source. -/
def snapshot (a : LeafHeadSetupProgram.Data) : LeafHeadSetupProgram.Data :=
  ⟨a.regs,fun i => if i ∈ retainedPorts then a.stacks i else []⟩

theorem snapshot_retained (a : LeafHeadSetupProgram.Data) (i : Fin 768)
    (hi : i ∈ retainedPorts) : (snapshot a).stacks i=a.stacks i := ite_eq_left hi

theorem snapshot_empty (a : LeafHeadSetupProgram.Data) (i : Fin 768)
    (hi : i∉retainedPorts) : (snapshot a).stacks i=[] := ite_eq_right hi

/-- Only the sixteen actual source words enter this bound. -/
theorem snapshot_bound (a : LeafHeadSetupProgram.Data) (A : ℕ)
    (ha : ∀ i ∈ retainedPorts,(a.stacks i).length ≤ A) : WordBound A (snapshot a) := by
  intro i
  change (if i ∈ retainedPorts then a.stacks i else []).length ≤ A
  split_ifs with hi
  · exact ha i hi
  · exact Nat.zero_le _

theorem snapshot_ready {s : Native.Inputs} {a : LeafHeadSetupProgram.Data}
    (ha : Native.Ready s a) : Native.Ready s (snapshot a) := by
  have hf := snapshot_retained a
  exact ⟨(hf 128 (by decide)).trans ha.ambient,(hf 129 (by decide)).trans ha.factors,
    (hf 130 (by decide)).trans ha.colors,(hf 131 (by decide)).trans ha.nodes,
    (hf 132 (by decide)).trans ha.wordWidth,(hf 133 (by decide)).trans ha.words,
    (hf 134 (by decide)).trans ha.low,(hf 135 (by decide)).trans ha.metadata,
    (hf 136 (by decide)).trans ha.plans,(hf 138 (by decide)).trans ha.order,
    (hf 139 (by decide)).trans ha.height,(hf 140 (by decide)).trans ha.width,
    (congrArg BinaryArithmetic.toNat (hf 141 (by decide))).trans ha.offset,
    (hf 307 (by decide)).trans ha.node,(hf 660 (by decide)).trans ha.tuples,
    (hf 665 (by decide)).trans ha.marker⟩

/-- Both starts regenerate the cache and dimension masters from the same
input and cache witness; no old high-scratch length is assumed. -/
theorem snapshot_masters (s : Native.Inputs) (a : LeafHeadSetupProgram.Data)
    (ra : Fin 3 → Bool) (rd rc : Fin 8 → Bool) (words : List (List Bool)) :
    SignatureHeadLoader.MasterFrame (Native.start s a ra rd rc words)
      (Native.start s (snapshot a) ra rd rc words) := by
  have low (i : Fin 768) (hi : i.val < 340) (hp : i ∈ retainedPorts) :
      (Native.start s (snapshot a) ra rd rc words).stacks i=
        (Native.start s a ra rd rc words).stacks i := by
    rw [Native.start_low _ _ _ _ _ _ _ hi,Native.start_low _ _ _ _ _ _ _ hi]
    exact snapshot_retained a i hp
  constructor
  intro i hi
  simp only [SignatureHeadLoader.masters,List.mem_cons,
    List.not_mem_nil,or_false] at hi
  rcases hi with rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl
  · exact low _ (by decide) (by decide)
  · exact low _ (by decide) (by decide)
  · exact low _ (by decide) (by decide)
  · exact low _ (by decide) (by decide)
  · exact low _ (by decide) (by decide)
  · exact low _ (by decide) (by decide)
  · exact low _ (by decide) (by decide)
  · exact low _ (by decide) (by decide)
  · exact low _ (by decide) (by decide)
  · exact low _ (by decide) (by decide)
  · exact low _ (by decide) (by decide)
  · exact low _ (by decide) (by decide)
  · exact low _ (by decide) (by decide)
  · exact low _ (by decide) (by decide)
  · exact (Native.start_positive s _ ra rd rc words).trans
      (Native.start_positive s a ra rd rc words).symm
  · exact (Native.start_negative s _ ra rd rc words).trans
      (Native.start_negative s a ra rd rc words).symm
  · exact (Native.start_denominator s _ ra rd rc words).trans
      (Native.start_denominator s a ra rd rc words).symm
  · exact (QueryReadyConstruction.native_start_dimension s _ ra rd rc words).trans
      (QueryReadyConstruction.native_start_dimension s a ra rd rc words).symm

/-- Restrict only the proof-side source state. All actual native inputs,
owners, plans, cache words and cache/register witnesses stay unchanged. -/
def restrictedSource (s : SignatureTupleSource.ProducedSource) (A : ℕ)
    (ha : ∀ i ∈ retainedPorts,(s.source.stacks i).length ≤ A) :
    SignatureTupleSource.ProducedSource :=
  {s with source := snapshot s.source
          ready := snapshot_ready s.ready
          bound := A
          bounded := snapshot_bound s.source A ha}

/-- The actual caller is unchanged: it still matches every native master. -/
theorem restricted_caller_frame (s : SignatureTupleSource.ProducedSource) (A : ℕ)
    (ha : ∀ i ∈ retainedPorts,(s.source.stacks i).length ≤ A) (a : State 40 896)
    (hm : SignatureHeadLoader.MasterFrame s.masters
      (projectState SignatureHeadLoader.leafRegs SignatureHeadLoader.lowStacks a)) :
    SignatureHeadLoader.MasterFrame (restrictedSource s A ha).masters
      (projectState SignatureHeadLoader.leafRegs SignatureHeadLoader.lowStacks a) := by
  constructor
  intro i hi
  exact (hm.stored i hi).trans
    ((snapshot_masters s.input s.source s.addressRegisters s.dimensionRegisters
      s.cacheRegisters s.cacheWords).stored i hi).symm

section Specification
variable (src : SignatureTupleSource.ProducedSource)
    (m : Circuit.Model) (ht : 0 < m.val 33) (hd : 0 < m.val 34)
    (M : SubexpPreparedQuartic.Modulus 3 (m.val 33))
    (cache : RingProgram.ScalarCache 3 (m.val 33))
    (half : RingProgram.ScalarCode 3 (m.val 33)) (e : LeafRingSetupProgram.Data)
    (hp : LeafRingSetupProgram.Produced m hd M cache half e)
    (hfield : src.input.Q < 3^(m.val 34)) (q : LeafQueryFrontend.Query) (hv : q.Valid)
    (hJ : 0 < m.val 42) (source : List (List (SAT.Literal (Fin src.input.n))))
    (hsource : q.clauses=HashInputProgram.Expansion.encodedClauses source)

local notation "spec" => QueryReadyConstruction.sourceSpec src m ht hd M cache half e hp
  hfield q hv hJ source hsource

/-- The authentic factor specification does not inspect discarded scratch. -/
theorem sourceSpec_restricted (A : ℕ)
    (ha : ∀ i ∈ retainedPorts,(src.source.stacks i).length ≤ A) :
    QueryReadyConstruction.sourceSpec (restrictedSource src A ha) m ht hd M cache half e hp
      hfield q hv hJ source hsource=spec := rfl

/-- Concrete source semantics transport without a fresh alignment premise. -/
theorem sourceFacts_restricted (H : Finset (Fin src.input.n))
    (owner : Fin (spec).ps.length → Fin src.input.n)
    (head : Fin src.input.Q → Fin src.input.n → Fin src.input.r)
    (hs : QueryVisitorHead.SourceFacts src.input spec H owner src.owner head)
    (A : ℕ) (ha : ∀ i ∈ retainedPorts,(src.source.stacks i).length ≤ A) :
    QueryVisitorHead.SourceFacts (restrictedSource src A ha).input
      (QueryReadyConstruction.sourceSpec (restrictedSource src A ha) m ht hd M cache half e hp
        hfield q hv hJ source hsource) H owner (restrictedSource src A ha).owner head := hs

end Specification
end OAI.Algorithms.SubexponentialSAT.SqrtLogSpace.QuerySourceSnapshot
