/-- The shadow erases only proof-side caller data. The actual fixed query on
the original state executes exactly the same number of source steps. -/
theorem shadow_eval {steps : ℕ} {a b : State 40 896}
    (he : Eval QueryStreamProgram.command steps (rebaseState H (fun _ => []) a) b) :
    Eval QueryStreamProgram.command steps a (rebaseState H a.stacks b) :=
  CommandStackTransport.eval_shadow H command_avoids he

/-- Actual query prefixes retain the maximum of local storage and the opaque
collector frame, independently of the number of query or loop steps. -/
theorem shadow_prefix_bound {steps localBound frameBound : ℕ} {a b : State 40 896}
    (he : Eval QueryStreamProgram.command steps (rebaseState H (fun _ => []) a) b)
    (hlocal : ∀ prefixSteps source, prefixSteps ≤ steps+1 →
      Trace QueryStreamProgram.program prefixSteps
        ((rebaseState H (fun _ => []) a).withPC (some QueryStreamProgram.program.entry)) source →
      ∀ i, ¬ H i → (source.stacks i).length ≤ localBound)
    (hframe : ∀ i, H i → (a.stacks i).length ≤ frameBound) :
    ∀ prefixSteps intermediate, prefixSteps ≤ steps+1 →
      Trace QueryStreamProgram.program prefixSteps
        (a.withPC (some QueryStreamProgram.program.entry)) intermediate →
      ∀ i, (intermediate.stacks i).length ≤ max localBound frameBound :=
  CommandStackTransport.eval_shadow_prefix_bound H command_avoids 330 323 he hlocal hframe

end OAI.Algorithms.SubexponentialSAT.SqrtLogSpace.QueryStreamFrames
