import OAI.Algorithms.SubexponentialSAT.LeanCompat
import OAI.Algorithms.SubexponentialSAT.SubexpNodeNumericSetup
import OAI.Algorithms.SubexponentialSAT.SubexpNodeConstantInit

namespace OAI.Algorithms

/-!
# Concrete local setup before the node traversal

The header supplies the actual target-width shape, target flat one and
unary dimension. This fixed program constructs the retained-key width,
exponent master, canonical empty raw zero, raw one and scalar one. It does
not assume any of those five generated byte strings on entry.
-/

namespace SubexponentialSAT.SubexpNodeLocalSetup

open BitProgram StructuredCalls

abbrev Data := State 16 256

abbrev command : Cmd 16 256 :=
  .seq SubexpNodeNumericSetup.command SubexpNodeConstantInit.command

def resultStacks (d : Data) (D : ℕ) : Fin 256 → List Bool :=
  Function.update (Function.update (Function.update (Function.update
    (Function.update d.stacks 92 (List.replicate (SubexpSymbolicCost.indexBits D) true))
      127 (Encoding.encodeList id (SubexpOuterJobs.momentRecords D)))
        122 [false]) 123 (SubexpScalarLiteralProgram.rawLiteral D (d.stacks 120)))
          124 (SubexpLiftRing.fixedBits (d.stacks 10).length 1)

def budget (d : Data) (D : ℕ) : ℕ :=
  SubexpNodeNumericSetup.budget D d + SubexpNodeConstantInit.cost d D

theorem command_eval (d : Data) (D : ℕ)
    (hD : d.stacks 109 = List.replicate D true)
    (h0 : d.stacks 0 = []) (h1 : d.stacks 1 = []) (h4 : d.stacks 4 = [])
    (hexp : ∀ i ∈ SubexpNodeExponentMaster.work, d.stacks i = [])
    (hraw : SubexpNodeRawConstants.WorkEmpty d)
    (h122 : d.stacks 122 = []) (h123 : d.stacks 123 = []) (h124 : d.stacks 124 = [])
    (hwidth : 0 < (d.stacks 10).length) :
    ∃ n ≤ budget d D, ∃ e : Data, Eval command n d e ∧
      e.stacks = resultStacks d D := by
  obtain ⟨n, hn, a, ha, hs⟩ := SubexpNodeNumericSetup.command_eval d D hD h0 h1 h4 hexp
  have haRaw : SubexpNodeRawConstants.WorkEmpty a := by
    intro i hi hj
    have hi92 : i ≠ 92 := by intro h; subst i; norm_num [Fin.coe_ofNat_eq_mod] at hi
    have hi127 : i ≠ 127 := by intro h; subst i; norm_num [Fin.coe_ofNat_eq_mod] at hi
    simpa [hs, hi92, hi127] using hraw i hi hj
  obtain ⟨e, he, ht⟩ := SubexpNodeConstantInit.command_eval a D
    (by simpa [hs] using h0) haRaw
    (by simpa [hs] using hD) (by simp [hs])
    (by simpa [hs] using h122) (by simpa [hs] using h123)
    (by simpa [hs] using h124) (by simpa [hs] using hwidth)
  have hc : SubexpNodeConstantInit.cost a D = SubexpNodeConstantInit.cost d D := by
    simp [SubexpNodeConstantInit.cost, hs]
  refine ⟨n + SubexpNodeConstantInit.cost a D, ?_, e, ha.seq he, ?_⟩
  · simpa only [budget, hc] using Nat.add_le_add_right hn (SubexpNodeConstantInit.cost d D)
  · simpa [resultStacks, hs] using ht

abbrev program : Program 16 256 (size command + 1) := compiled command 109 127

theorem program_runs (d : Data) (D : ℕ)
    (hD : d.stacks 109 = List.replicate D true)
    (h0 : d.stacks 0 = []) (h1 : d.stacks 1 = []) (h4 : d.stacks 4 = [])
    (hexp : ∀ i ∈ SubexpNodeExponentMaster.work, d.stacks i = [])
    (hraw : SubexpNodeRawConstants.WorkEmpty d)
    (h122 : d.stacks 122 = []) (h123 : d.stacks 123 = []) (h124 : d.stacks 124 = [])
    (hwidth : 0 < (d.stacks 10).length) :
    ∃ e : Data, RunsIn program (budget d D + 1)
      (d.withPC (some program.entry)) (e.withPC none) ∧ e.stacks = resultStacks d D := by
  obtain ⟨n, hn, e, he, hs⟩ := command_eval d D hD h0 h1 h4 hexp hraw h122 h123 h124 hwidth
  exact ⟨e, ⟨n + 1, by omega, compiled_halt_trace he 109 127⟩, hs⟩

theorem result_frame (d : Data) (D : ℕ) (i : Fin 256)
    (h92 : i ≠ 92) (h127 : i ≠ 127) (h122 : i ≠ 122) (h123 : i ≠ 123) (h124 : i ≠ 124) :
    resultStacks d D i = d.stacks i := by
  simp [resultStacks, h92, h127, h122, h123, h124]

end SubexponentialSAT.SubexpNodeLocalSetup

end OAI.Algorithms
