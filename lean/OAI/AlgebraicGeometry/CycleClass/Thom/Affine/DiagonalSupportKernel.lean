import OAI.AlgebraicGeometry.CycleClass.Thom.Affine.SupportCoordinates
import OAI.AlgebraicGeometry.CycleClass.Thom.Affine.SupportKernel
import OAI.AlgebraicGeometry.CycleClass.Thom.Affine.DiagonalEquations

/-! # Diagonal Support Kernel -/

namespace OAI.AlgebraicGeometry.CycleClass.Thom.Affine.DiagonalSupportKernel.Constructions

noncomputable section

/-! The actual geometric diagonal support has precisely the ideal
generated by the genuine polynomial coordinate-difference germs. -/

open _root_.CategoryTheory _root_.CategoryTheory.Limits _root_.AlgebraicGeometry _root_.TopologicalSpace
open scoped TensorProduct

open OAI.AlgebraicGeometry.CycleClass.Thom.Affine.ProductIs.Constructions OAI.AlgebraicGeometry.CycleClass.Thom.Affine.ProductIs.Constructions.CoordinateMaps OAI.AlgebraicGeometry.CycleClass.Thom.Affine.DiagonalStalk.Constructions
open OAI.AlgebraicGeometry.CycleClass.Thom.Closed.ImageStalkKernel.Constructions OAI.AlgebraicGeometry.CycleClass.Thom.Affine.SupportCoordinates.Constructions OAI.AlgebraicGeometry.CycleClass.Thom.Affine.SupportKernel.Constructions OAI.AlgebraicGeometry.CycleClass.Thom.Affine.DiagonalEquations.Constructions
open OAI.AlgebraicGeometry.CycleClass.Thom.StalkPrimeQuotient.Constructions OAI.AlgebraicGeometry.CycleClass.Thom.TorAlgebra.AlgebraDiagonalQuotient

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

variable (X : Over Foundations.Scheme.ProjectiveSpace.complexBase) [IsAffine X.left] [IsIntegral X.left]

local instance : IsIso (ProductIs.Constructions.CoordinateMaps.affineCoordinateMap X) := by
  change IsIso (Foundations.Scheme.AffineSchemeComplexPoints.affineOverIso X).hom.left
  infer_instance

def multiplicationMap : CommRingCat.of (Γ(X.left, ⊤) ⊗[ℂ] Γ(X.left, ⊤)) ⟶ CommRingCat.of Γ(X.left, ⊤) :=
  CommRingCat.ofHom (Algebra.TensorProduct.lmul' ℂ).toRingHom

omit [IsIntegral X.left] in
theorem multiplicationMap_surjective : Function.Surjective (multiplicationMap X) :=
  TorAlgebra.AlgebraDiagonalQuotient.multiplication_surjective ℂ Γ(X.left, ⊤)

local instance : IsClosedImmersion (Spec.map (multiplicationMap X)) :=
  IsClosedImmersion.spec_of_surjective (multiplicationMap X) (multiplicationMap_surjective X)

def geometricDiagonalSupport : IrreducibleCloseds (pullback X.hom X.hom : Scheme) :=
  Geometric.StratumClosure.integralImageClosure (pullback.diagonal X.hom)

def coordinateDiagonalSupport : IrreducibleCloseds (Spec (CommRingCat.of (Γ(X.left, ⊤) ⊗[ℂ] Γ(X.left, ⊤)))) :=
  Geometric.StratumClosure.integralImageClosure (Spec.map (multiplicationMap X))

theorem genericPoint_coordinates :
    (ProductIs.Constructions.affineProductCoordinateIso X X).hom (IntersectionGeometry.supportPoint (geometricDiagonalSupport X)) =
      IntersectionGeometry.supportPoint (coordinateDiagonalSupport X) := by
  change (ProductIs.Constructions.affineProductCoordinateIso X X).hom (IntersectionGeometry.supportPoint (Geometric.StratumClosure.integralImageClosure (pullback.diagonal X.hom))) =
    IntersectionGeometry.supportPoint (Geometric.StratumClosure.integralImageClosure (Spec.map (multiplicationMap X)))
  rw [Closed.ImageStalkKernel.Constructions.imageClosure_genericPoint, Closed.ImageStalkKernel.Constructions.imageClosure_genericPoint]
  have h := congrArg (fun f : X.left ⟶ Spec (CommRingCat.of (Γ(X.left, ⊤) ⊗[ℂ] Γ(X.left, ⊤))) =>
    f (genericPoint X.left)) (ProductIs.Constructions.CoordinateMaps.coordinateIso_diagonal X)
  have hg : ProductIs.Constructions.CoordinateMaps.affineCoordinateMap X (genericPoint X.left) = genericPoint (Spec (CommRingCat.of Γ(X.left, ⊤))) :=
    genericPoint_eq_of_isOpenImmersion (ProductIs.Constructions.CoordinateMaps.affineCoordinateMap X)
  exact h.trans (congrArg (Spec.map (multiplicationMap X)) hg)

omit [IsAffine X.left] in
theorem geometric_point_mem (x : X.left) : pullback.diagonal X.hom x ∈
    (geometricDiagonalSupport X : Set (pullback X.hom X.hom : Scheme)) := Closed.ImageStalkKernel.Constructions.image_mem (pullback.diagonal X.hom) x

theorem coordinate_point_mem (x : X.left) : DiagonalStalk.Constructions.diagonalCoordinatePrime X x ∈
    (coordinateDiagonalSupport X : Set (Spec (CommRingCat.of (Γ(X.left, ⊤) ⊗[ℂ] Γ(X.left, ⊤))))) :=
  Closed.ImageStalkKernel.Constructions.image_mem (Spec.map (multiplicationMap X)) (ProductIs.Constructions.CoordinateMaps.affineCoordinateMap X x)

theorem geometric_kernel_coordinates (x : X.left) :
    ((StalkPrimeQuotient.Constructions.kernelPrime (pullback X.hom X.hom) (geometricDiagonalSupport X) (pullback.diagonal X.hom x)
      (geometric_point_mem X x)).asIdeal).map (DiagonalStalk.Constructions.diagonalStalkIso X x).hom.hom =
      (KaehlerDifferential.ideal ℂ Γ(X.left, ⊤)).map
        (algebraMap (Γ(X.left, ⊤) ⊗[ℂ] Γ(X.left, ⊤)) (Localization.AtPrime (DiagonalStalk.Constructions.diagonalCoordinatePrime X x).asIdeal)) := by
  have h := SupportCoordinates.Constructions.kernelPrime_coordinates (CommRingCat.of (Γ(X.left, ⊤) ⊗[ℂ] Γ(X.left, ⊤)))
    (pullback X.hom X.hom) (ProductIs.Constructions.affineProductCoordinateIso X X) (geometricDiagonalSupport X) (coordinateDiagonalSupport X)
    (genericPoint_coordinates X) (pullback.diagonal X.hom x) (geometric_point_mem X x)
    (DiagonalStalk.Constructions.diagonalCoordinatePrime X x) (DiagonalStalk.Constructions.coordinate_diagonal_point X x) (coordinate_point_mem X x)
  have hn := SupportKernel.Constructions.support_kernel_localization (CommRingCat.of (Γ(X.left, ⊤) ⊗[ℂ] Γ(X.left, ⊤)))
    (CommRingCat.of Γ(X.left, ⊤)) (multiplicationMap X) (multiplicationMap_surjective X) (ProductIs.Constructions.CoordinateMaps.affineCoordinateMap X x)
  exact h.trans hn

variable (n : ℕ) [Algebra (MvPolynomial (Fin n) ℂ) Γ(X.left, ⊤)]
  [IsScalarTower ℂ (MvPolynomial (Fin n) ℂ) Γ(X.left, ⊤)]
  [Algebra.FormallyUnramified (MvPolynomial (Fin n) ℂ) Γ(X.left, ⊤)]
  [IsNoetherianRing (Γ(X.left, ⊤) ⊗[MvPolynomial (Fin n) ℂ] Γ(X.left, ⊤))]

theorem coordinateDifferenceGerms_support_ideal (x : X.left) :
    Ideal.ofList (DiagonalEquations.Constructions.coordinateDifferenceGerms X n x) =
      (StalkPrimeQuotient.Constructions.kernelPrime (pullback X.hom X.hom) (geometricDiagonalSupport X) (pullback.diagonal X.hom x)
        (geometric_point_mem X x)).asIdeal := by
  let f := (DiagonalStalk.Constructions.diagonalStalkIso X x).hom.hom
  have he := (DiagonalEquations.Constructions.coordinateDifferenceGerms_ideal X n x).trans (geometric_kernel_coordinates X x).symm
  exact (Ideal.relIsoOfBijective f (ConcreteCategory.bijective_of_isIso (DiagonalStalk.Constructions.diagonalStalkIso X x).hom)).symm.injective he

end

end OAI.AlgebraicGeometry.CycleClass.Thom.Affine.DiagonalSupportKernel.Constructions
