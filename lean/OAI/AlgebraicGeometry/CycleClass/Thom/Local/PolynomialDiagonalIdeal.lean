import OAI.AlgebraicGeometry.CycleClass.Thom.Local.RelativeDiagonalIdeal
import OAI.AlgebraicGeometry.CycleClass.Thom.PolynomialTensorBalanceIdeal
import Mathlib.Data.List.OfFn
import Mathlib.RingTheory.Regular.RegularSequence

/-! # Polynomial Diagonal Ideal -/

namespace OAI.AlgebraicGeometry.CycleClass.Thom.Local.PolynomialDiagonalIdeal.Constructions

noncomputable section

/-! In unramified polynomial coordinates, the localized diagonal
ideal is generated by the actual coordinate differences. -/

open scoped TensorProduct

open OAI.AlgebraicGeometry.CycleClass.Thom.Tensor.BalanceIdeal.Constructions OAI.AlgebraicGeometry.CycleClass.Thom.PolynomialTensorBalanceIdeal.Constructions

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

universe u
variable (k R : Type u) [CommRing k] [CommRing R] [Algebra k R] (n : ℕ)
  [Algebra (MvPolynomial (Fin n) k) R] [IsScalarTower k (MvPolynomial (Fin n) k) R]
  [Algebra.FormallyUnramified (MvPolynomial (Fin n) k) R]
  [IsNoetherianRing (R ⊗[MvPolynomial (Fin n) k] R)]

def localEquations (q : PrimeSpectrum R) :
    List (Localization.AtPrime (q.asIdeal.comap (Algebra.TensorProduct.lmul' k).toRingHom)) :=
  List.ofFn (fun i : Fin n =>
    algebraMap (R ⊗[k] R)
      (Localization.AtPrime (q.asIdeal.comap (Algebra.TensorProduct.lmul' k).toRingHom))
      (Tensor.BalanceIdeal.Constructions.difference k (MvPolynomial (Fin n) k) R (MvPolynomial.X i)))

theorem ideal_ofList_localEquations (q : PrimeSpectrum R) :
    Ideal.ofList (localEquations k R n q) =
      (KaehlerDifferential.ideal k R).map
        (algebraMap (R ⊗[k] R)
          (Localization.AtPrime (q.asIdeal.comap (Algebra.TensorProduct.lmul' k).toRingHom))) := by
  rw [RelativeDiagonalIdeal.Constructions.localized_diagonal_eq_balance k (MvPolynomial (Fin n) k) R,
    PolynomialTensorBalanceIdeal.Constructions.ker_eq_coordinateIdeal, PolynomialTensorBalanceIdeal.Constructions.coordinateIdeal, Ideal.map_span]
  apply congrArg Ideal.span
  ext x
  simp [localEquations, List.mem_ofFn]

end

end OAI.AlgebraicGeometry.CycleClass.Thom.Local.PolynomialDiagonalIdeal.Constructions
