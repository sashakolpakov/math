import OAI.AlgebraicGeometry.CycleClass.Thom.Tensor.BalanceIdeal
import Mathlib.Algebra.MvPolynomial.CommRing
import Mathlib.RingTheory.Ideal.Quotient.Operations

/-! # Polynomial Tensor Balance Ideal -/

namespace OAI.AlgebraicGeometry.CycleClass.Thom.PolynomialTensorBalanceIdeal.Constructions

noncomputable section

/-! For a polynomial intermediate algebra, the tensor balancing
kernel is generated by the differences of its polynomial coordinates.
Equality on coordinates forces equality of the two polynomial maps. -/

open scoped TensorProduct

open OAI.AlgebraicGeometry.CycleClass.Thom.Tensor.BalanceIdeal.Constructions

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

universe u v
variable (k R : Type u) (σ : Type v) [CommRing k] [CommRing R] [Algebra k R]
  [Algebra (MvPolynomial σ k) R] [IsScalarTower k (MvPolynomial σ k) R]

def coordinateIdeal : Ideal (R ⊗[k] R) :=
  Ideal.span (Set.range (fun i : σ => Tensor.BalanceIdeal.Constructions.difference k (MvPolynomial σ k) R (MvPolynomial.X i)))

theorem difference_mem_coordinateIdeal (p : MvPolynomial σ k) :
    Tensor.BalanceIdeal.Constructions.difference k (MvPolynomial σ k) R p ∈ coordinateIdeal k R σ := by
  let L := coordinateIdeal k R σ
  let f : MvPolynomial σ k →ₐ[k] R ⊗[k] R :=
    Algebra.TensorProduct.includeLeft.comp (IsScalarTower.toAlgHom k (MvPolynomial σ k) R)
  let g : MvPolynomial σ k →ₐ[k] R ⊗[k] R :=
    Algebra.TensorProduct.includeRight.comp (IsScalarTower.toAlgHom k (MvPolynomial σ k) R)
  have he : (Ideal.Quotient.mkₐ k L).comp f = (Ideal.Quotient.mkₐ k L).comp g := by
    apply MvPolynomial.algHom_ext
    intro i
    change Ideal.Quotient.mk L (f (MvPolynomial.X i)) = Ideal.Quotient.mk L (g (MvPolynomial.X i))
    rw [← sub_eq_zero, ← map_sub]
    apply Ideal.Quotient.eq_zero_iff_mem.mpr
    exact Ideal.subset_span (Set.mem_range_self i)
  have hp := DFunLike.congr_fun he p
  change Ideal.Quotient.mk L (f p) = Ideal.Quotient.mk L (g p) at hp
  apply Ideal.Quotient.eq_zero_iff_mem.mp
  change Ideal.Quotient.mk L (f p - g p) = 0
  rw [map_sub, hp, sub_self]

theorem ker_eq_coordinateIdeal :
    RingHom.ker (Tensor.BalanceIdeal.Constructions.balanceMap k (MvPolynomial σ k) R).toRingHom = coordinateIdeal k R σ := by
  apply le_antisymm
  · rw [Tensor.BalanceIdeal.Constructions.ker_eq_span]
    apply Ideal.span_le.mpr
    rintro _ ⟨p, rfl⟩
    exact difference_mem_coordinateIdeal k R σ p
  · apply Ideal.span_le.mpr
    rintro _ ⟨i, rfl⟩
    exact Tensor.BalanceIdeal.Constructions.difference_mem_ker k (MvPolynomial σ k) R (MvPolynomial.X i)

end

end OAI.AlgebraicGeometry.CycleClass.Thom.PolynomialTensorBalanceIdeal.Constructions
