import OAI.AlgebraicTopology.Cohomology.Singular.ManifoldSmoothSimplexComposition
import OAI.AlgebraicTopology.Cohomology.Singular.SmoothConvexComparison
import OAI.AlgebraicGeometry.CycleClass.Geometric.SimplexFillings

/-! # Smooth Simplex Fillings -/

namespace OAI.AlgebraicGeometry.CycleClass.Geometric.SmoothSimplexFillings.Cycles

noncomputable section

/-!
# Genuine smooth singular fillings in convex subsets

The chains here are generated by actual simplex maps admitting smooth ambient
extensions. The affine contraction already constructed for the smooth singular
set gives a chain homotopy equivalence with ordinary singular chains. Thus every
positive cycle in a nonempty convex subset, in particular in a closed standard
simplex, has a filling made of smooth simplices.

No smoothness is inferred for the arbitrary ordinary singular fillings.
-/

open _root_.CategoryTheory _root_.CategoryTheory.Limits
open scoped Simplicial

variable {E : Type} [NormedAddCommGroup E] [NormedSpace ℝ E]

/-- Actual integral chains on the smooth singular set of a subset. -/
abbrev integralSubsetSmoothChains (U : Set E) : ChainComplex (ModuleCat.{0} ℤ) ℕ :=
  (AlgebraicTopology.Cohomology.Singular.SmoothOpen.subsetSmoothSingularSubcomplex U).toSSet.chainComplex (ModuleCat.of ℤ ℤ)

/-- The actual inclusion from ambient-smooth subset chains to continuous chains. -/
def subsetSmoothChainInclusion (U : Set E) :
    integralSubsetSmoothChains U ⟶ LocalHomology.Cycles.integralSingularChains (TopCat.of U) :=
  SSet.chainComplexMap (AlgebraicTopology.Cohomology.Singular.SmoothOpen.subsetSmoothSingularSubcomplex U).ι (ModuleCat.of ℤ ℤ)

/-- The existing affine simplicial contractions give a genuine chain equivalence
on a convex subset, including subsets with boundary. -/
def convexSubsetSmoothChainHomotopyEquiv {U : Set E} (hU : Convex ℝ U) (c : U) :
    _root_.HomotopyEquiv (integralSubsetSmoothChains U)
      (LocalHomology.Cycles.integralSingularChains (TopCat.of U)) where
  hom := subsetSmoothChainInclusion U
  inv := SSet.chainComplexMap (AlgebraicTopology.Cohomology.Singular.SmoothConvexComparison.subsetSmoothComparisonRetraction c) (ModuleCat.of ℤ ℤ)
  homotopyHomInvId := by
    have H := ((AlgebraicTopology.Cohomology.Singular.SmoothConvexComparison.convexSmoothComparisonHomotopy hU c).chainComplexMap
      (ModuleCat.of ℤ ℤ)).symm
    dsimp only [SSet.chainComplexMap] at H
    rw [((SSet.chainComplexFunctor (ModuleCat.{0} ℤ)).obj (ModuleCat.of ℤ ℤ)).map_id,
      ((SSet.chainComplexFunctor (ModuleCat.{0} ℤ)).obj (ModuleCat.of ℤ ℤ)).map_comp] at H
    exact H
  homotopyInvHomId := by
    have H := ((AlgebraicTopology.Cohomology.Singular.SmoothConvexComparison.convexContinuousComparisonHomotopy hU c).chainComplexMap
      (ModuleCat.of ℤ ℤ)).symm
    dsimp only [SSet.chainComplexMap] at H
    rw [((SSet.chainComplexFunctor (ModuleCat.{0} ℤ)).obj (ModuleCat.of ℤ ℤ)).map_id,
      ((SSet.chainComplexFunctor (ModuleCat.{0} ℤ)).obj (ModuleCat.of ℤ ℤ)).map_comp] at H
    exact H

/-- Positive smooth singular homology of a nonempty convex subset vanishes. -/
theorem isZero_integralSubsetSmoothHomology_of_convex {U : Set E}
    (hU : Convex ℝ U) (c : U) (n : ℕ) (hn : n ≠ 0) :
    IsZero ((integralSubsetSmoothChains U).homology n) := by
  let : ContractibleSpace U := hU.contractibleSpace ⟨c, c.property⟩
  exact (ContractibleModel.Cycles.isZero_integralSingularHomology_of_contractible (TopCat.of U) n hn).of_iso
    ((convexSubsetSmoothChainHomotopyEquiv hU c).toHomologyIso n)

/-- Every positive smooth cycle in a convex subset has an actual smooth filling. -/
theorem exists_subsetSmoothBoundary_of_convex {U : Set E} (hU : Convex ℝ U) (c : U)
    (n : ℕ) (hn : n ≠ 0) (z : AlgebraicTopology.Cohomology.Singular.ChainRepresentatives.chainCycles (integralSubsetSmoothChains U) n) :
    ∃ b : (integralSubsetSmoothChains U).X (n + 1),
      (integralSubsetSmoothChains U).d (n + 1) n b = z.1 := by
  let := ModuleCat.subsingleton_of_isZero
    (isZero_integralSubsetSmoothHomology_of_convex hU c n hn)
  exact (AlgebraicTopology.Cohomology.Singular.ChainRepresentatives.chainClass_eq_zero_iff_exists _ n z).mp (Subsingleton.elim _ _)

/-- The unbundled cycle-filling statement used in homotopy induction. -/
theorem exists_subsetSmoothBoundary_succ_of_convex {U : Set E}
    (hU : Convex ℝ U) (c : U) (n : ℕ)
    (z : (integralSubsetSmoothChains U).X (n + 1))
    (hz : (integralSubsetSmoothChains U).d (n + 1) n z = 0) :
    ∃ b : (integralSubsetSmoothChains U).X (n + 2),
      (integralSubsetSmoothChains U).d (n + 2) (n + 1) b = z :=
  exists_subsetSmoothBoundary_of_convex hU c (n + 1) (Nat.succ_ne_zero n)
    ⟨z, (AlgebraicTopology.Cohomology.Singular.ChainRepresentatives.mem_chainCycles_iff_succ _ n z).mpr hz⟩

/-- The smooth chain model associated with the closed geometric standard simplex. -/
abbrev smoothSimplexModelChains (q : ℕ) : ChainComplex (ModuleCat.{0} ℤ) ℕ :=
  (AlgebraicTopology.Cohomology.Singular.ManifoldSmoothSimplexComposition.simplexSmoothSingularSubcomplex q).toSSet.chainComplex (ModuleCat.of ℤ ℤ)

/-- Positive cycles in the actual smooth standard-simplex model admit fillings
within the same smooth model. -/
theorem exists_smoothSimplexModel_boundary_succ (q n : ℕ)
    (z : (smoothSimplexModelChains q).X (n + 1))
    (hz : (smoothSimplexModelChains q).d (n + 1) n z = 0) :
    ∃ b : (smoothSimplexModelChains q).X (n + 2),
      (smoothSimplexModelChains q).d (n + 2) (n + 1) b = z := by
  let e := ((SSet.chainComplexFunctor (ModuleCat.{0} ℤ)).obj (ModuleCat.of ℤ ℤ)).mapIso
    (AlgebraicTopology.Cohomology.Singular.ManifoldSmoothSimplexComposition.simplexSmoothCoordinatesIso q)
  have hzero : IsZero ((smoothSimplexModelChains q).homology (n + 1)) := by
    have hc := isZero_integralSubsetSmoothHomology_of_convex
      (Geometry.Foundations.ConvexStdSimplexMetric.Convexity.StdSimplex.convex_range_weights (Fin (q + 1)))
      (⟨(Convexity.StdSimplex.single 0).weights, ⟨Convexity.StdSimplex.single 0, rfl⟩⟩ :
        AlgebraicTopology.Cohomology.Singular.ManifoldSmoothSimplexComposition.simplexCoordinateRange q) (n + 1) (Nat.succ_ne_zero n)
    exact hc.of_iso (HomologicalComplex.homologyMapIso e (n + 1))
  let := ModuleCat.subsingleton_of_isZero hzero
  exact (AlgebraicTopology.Cohomology.Singular.ChainRepresentatives.chainClass_eq_zero_iff_exists _ (n + 1)
    ⟨z, (AlgebraicTopology.Cohomology.Singular.ChainRepresentatives.mem_chainCycles_iff_succ _ n z).mpr hz⟩).mp (Subsingleton.elim _ _)

end

end OAI.AlgebraicGeometry.CycleClass.Geometric.SmoothSimplexFillings.Cycles
