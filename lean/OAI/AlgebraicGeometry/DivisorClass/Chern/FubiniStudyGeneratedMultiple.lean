import OAI.AlgebraicGeometry.DivisorClass.Chern.HolomorphicSection.Fin
import OAI.AlgebraicGeometry.DivisorClass.Chern.PointLogSolverNonzero

/-! # Fubini Study Generated Multiple -/

namespace OAI.AlgebraicGeometry.DivisorClass.Chern.FubiniStudyGeneratedMultiple

noncomputable section

/-! A positive original Fubini--Study twist multiple is genuinely globally generated by constructed holomorphic sections. -/

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
set_option backward.defeqAttrib.useBackward true

theorem exists_fubiniStudyTwist_globally_generated_multiple (V : Foundations.Scheme.IntegralProjective.IntegralProjectiveVariety) :
    ∃ N : ℕ, 0 < N ∧ HolomorphicSection.Fin.holomorphicLineGloballyGenerated (N • FubiniStudyHolomorphic.fubiniStudyTwistUnitClass V) := by
  apply HolomorphicSection.Fin.exists_holomorphic_globally_generated_multiple
  intro x
  have H := PointLogSolverNonzero.positiveHolomorphicTwist_nonzero_at_point V (HolomorphicMetric.Data.holomorphicLineCanonicalMetric
    (0 : Holomorphic.Connecting.holomorphicUnitCohomology V.analyticModel V.analyticSpace)) x
  let n := H.choose
  have HS := H.choose_spec.2 n le_rfl
  refine ⟨n, H.choose_spec.1, HolomorphicSection.Fin.holomorphicSectionCast (zero_add _) HS.choose, ?_⟩
  exact HolomorphicSection.Fin.holomorphicSectionCast_nonzero (zero_add _) HS.choose x HS.choose_spec

end

end OAI.AlgebraicGeometry.DivisorClass.Chern.FubiniStudyGeneratedMultiple
