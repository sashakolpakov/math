import OAI.AlgebraicGeometry.FormalGeometry.Completion.SectionsDetectMaps
import OAI.AlgebraicGeometry.FormalGeometry.Completion.ClosedSectionGeneration
import OAI.AlgebraicGeometry.FormalGeometry.Completion.GeneratedLineBundleFrames
import OAI.AlgebraicGeometry.FormalGeometry.Completion.LineBundleProjection

/-! # Section Generation -/

namespace OAI.AlgebraicGeometry.FormalGeometry.Completion.Projective.SectionGeneration

noncomputable section

/-! Sufficiently positive twists on an actual closed projective scheme
are generated by global sections. Invertible twists have section frames at every point. -/

set_option backward.isDefEq.respectTransparency false

open _root_.AlgebraicGeometry _root_.CategoryTheory _root_.CategoryTheory.Limits MonoidalCategory

namespace Construction

universe u

attribute [local instance] MvPolynomial.gradedAlgebra SheafCohomology.Projective.Monoidal.Scheme.Modules.monoidalCategory

variable {R : Type u} [CommRing R] {σ : Type} [Fintype σ] {X : Scheme.{u}}
  (f : X ⟶ Proj (MvPolynomial.homogeneousSubmodule σ R)) [IsClosedImmersion f]

theorem closedProjectiveTwist_eventually_sectionsDetectMaps
    (M : X.Modules) [M.IsQuasicoherent] [M.IsFiniteType] (j : σ) :
    ∃ b : ℕ, ∀ n : ℕ, b ≤ n →
      GlobalSectionGeneration.Construction.SectionsDetectMaps (M ⊗ (Scheme.Modules.pullback f).obj
        (SheafCohomology.Projective.TwistPowers.MvPolynomial.coordinateHyperplanePoleSheafPower (R := R) j n)) := by
  let N := (Scheme.Modules.pushforward f).obj M
  have : N.IsQuasicoherent := SheafCohomology.Projective.Quasicoherent.Scheme.Modules.isQuasicoherent_pushforward_of_isAffineHom f
  have : N.IsFiniteType := SheafCohomology.Projective.Quasicoherent.Scheme.Modules.isFiniteType_pushforward_of_isClosedImmersion f
  obtain ⟨b, hb⟩ := SectionsDetectMaps.Construction.projectiveTwist_eventually_sectionsDetectMaps N j
  refine ⟨b, fun n hn => ?_⟩
  let P := (Frame.SectionDetection.Construction.coordinatePositiveTwist_hasFrameSections (R := R) j n).lineBundle
  let e := LineBundleProjection.Construction.lineBundleProjectionIso f P M
  exact ((hb n hn).of_epi e.hom).of_closed_pushforward f _

theorem closedProjectiveLineBundleTwist_eventually_hasFrameSections
    (L : AbelianModuli.HilbertConstruction.Line.Bundles.LineBundle X) (j : σ) :
    ∃ b : ℕ, ∀ n : ℕ, b ≤ n →
      Frame.SectionDetection.Construction.HasFrameSections (L.sheaf ⊗ (Scheme.Modules.pullback f).obj
        (SheafCohomology.Projective.TwistPowers.MvPolynomial.coordinateHyperplanePoleSheafPower (R := R) j n)) := by
  have : L.sheaf.IsQuasicoherent := Quotients.FiniteDescent.LineBundleFree.Construction.LineBundleCoherence.quasicoherent L
  have : L.sheaf.IsFinitePresentation := Quotients.FiniteDescent.LineBundleFree.Construction.LineBundleCoherence.finitePresentation L
  have : L.sheaf.IsFiniteType := inferInstance
  obtain ⟨b, hb⟩ := closedProjectiveTwist_eventually_sectionsDetectMaps f L.sheaf j
  refine ⟨b, fun n hn => ?_⟩
  let P := (Frame.SectionDetection.Construction.coordinatePositiveTwist_hasFrameSections (R := R) j n).lineBundle
  let B := P.pullback f
  let e : L.sheaf ⊗ B.sheaf ≅ (L.tensor B).sheaf :=
    Quotients.FiniteDescent.MonoidalLine.Construction.MonoidalLineBundles.tensorIso L.sheaf B.sheaf
  exact (((hb n hn).of_epi e.hom).lineBundle_frames (L.tensor B)).of_iso e.symm

end Construction

end

end OAI.AlgebraicGeometry.FormalGeometry.Completion.Projective.SectionGeneration
