import OAI.AlgebraicGeometry.FormalGeometry.Completion.GroundSymmetricSection
import OAI.AlgebraicGeometry.FormalGeometry.Completion.Geometric.LineBundleInvariance
import OAI.AlgebraicGeometry.FormalGeometry.Completion.GeneratedAmpleBundle

/-! # Ground Geometrically Ample -/

namespace OAI.AlgebraicGeometry.FormalGeometry.Completion.GroundGeometricallyAmple

noncomputable section

/-! The native group admits an actual ground-field symmetric line bundle
whose geometric pullback is ample and generated by global sections. -/

set_option backward.defeqAttrib.useBackward true
set_option backward.isDefEq.respectTransparency false

open _root_.AlgebraicGeometry _root_.CategoryTheory _root_.CategoryTheory.Limits
open scoped _root_.CategoryTheory.Obj

namespace Construction

universe u

variable (K : Type u) [Field K]
  (A : Over (Spec (CommRingCat.of K))) [GrpObj A] [IsCommMonObj A]
  [Smooth A.hom] [IsProper A.hom] [GeometricallyIntegral A.hom]

theorem geometricPullback_isAmple_of_affine_section (L : AbelianModuli.HilbertConstruction.Line.Bundles.LineBundle A.left)
    (s : AbelianModuli.HilbertConstruction.Line.Bundles.structureModule A.left ⟶ L.sheaf)
    (hne : (AbelianModuli.HilbertConstruction.Ample.LineBundles.sectionNonvanishing s : Set A.left).Nonempty)
    (haff : IsAffineOpen (AbelianModuli.HilbertConstruction.Ample.LineBundles.sectionNonvanishing s)) :
    (L.pullback (pullback.fst A.hom (Geometric.Frobenius.Construction.algebraicClosureBase K))).IsAmple := by
  let B := Geometric.Frobenius.Construction.geometricFiberOver K A
  let p : B.left ⟶ A.left := pullback.fst A.hom (Geometric.Frobenius.Construction.algebraicClosureBase K)
  have : IsProper B.hom := inferInstanceAs (IsProper (pullback.snd A.hom (Geometric.Frobenius.Construction.algebraicClosureBase K)))
  have : Smooth B.hom := inferInstanceAs (Smooth (pullback.snd A.hom (Geometric.Frobenius.Construction.algebraicClosureBase K)))
  have : GeometricallyIntegral B.hom :=
    inferInstanceAs (GeometricallyIntegral (pullback.snd A.hom (Geometric.Frobenius.Construction.algebraicClosureBase K)))
  have : Surjective (Geometric.Frobenius.Construction.algebraicClosureBase K) := (Geometric.MapFaithful.Construction.algebraicClosureBase_flat_surjective K).2
  have : IsAffineHom (Geometric.Frobenius.Construction.algebraicClosureBase K) := inferInstance
  have : Surjective p := inferInstanceAs (Surjective (pullback.fst A.hom (Geometric.Frobenius.Construction.algebraicClosureBase K)))
  have : IsAffineHom p := MorphismProperty.pullback_fst A.hom (Geometric.Frobenius.Construction.algebraicClosureBase K)
    ‹IsAffineHom (Geometric.Frobenius.Construction.algebraicClosureBase K)›
  let t := AbelianModuli.HilbertConstruction.Ample.LineBundles.pullbackSection p s
  have ht : AbelianModuli.HilbertConstruction.Ample.LineBundles.sectionNonvanishing t = p ⁻¹ᵁ AbelianModuli.HilbertConstruction.Ample.LineBundles.sectionNonvanishing s :=
    Quotients.FiniteDescent.SectionBase.Construction.SectionBaseChange.nonvanishing_pullback p L s
  apply Geometric.Projectivity.Construction.lineBundle_isAmple_of_affine_section B (L.pullback p) t
  · obtain ⟨x, hx⟩ := hne
    obtain ⟨y, hy⟩ := (inferInstance : Surjective p).surj x
    exact ⟨y, ht.symm ▸ (show p y ∈ AbelianModuli.HilbertConstruction.Ample.LineBundles.sectionNonvanishing s from hy.symm ▸ hx)⟩
  · rw [ht]
    exact haff.preimage p

theorem exists_ground_geometrically_ample_symmetric_lineBundle :
    ∃ L : AbelianModuli.HilbertConstruction.Line.Bundles.LineBundle A.left,
      (L.pullback (pullback.fst A.hom (Geometric.Frobenius.Construction.algebraicClosureBase K))).IsAmple ∧
        Nonempty ((L.pullback (GrpObj.inv (X := A)).left).sheaf ≅ L.sheaf) := by
  obtain ⟨L, s, hne, haff, hsym⟩ := GroundSymmetricSection.Construction.ground_symmetric_affine_section A
  exact ⟨L, geometricPullback_isAmple_of_affine_section K A L s hne haff, hsym⟩

theorem exists_ground_geometrically_generated_ample_symmetric_lineBundle :
    ∃ L : AbelianModuli.HilbertConstruction.Line.Bundles.LineBundle A.left,
      (L.pullback (pullback.fst A.hom (Geometric.Frobenius.Construction.algebraicClosureBase K))).IsAmple ∧
        Frame.SectionDetection.Construction.HasFrameSections (L.pullback (pullback.fst A.hom (Geometric.Frobenius.Construction.algebraicClosureBase K))).sheaf ∧
        Nonempty ((L.pullback (GrpObj.inv (X := A)).left).sheaf ≅ L.sheaf) := by
  obtain ⟨L, hL, hs⟩ := exists_ground_geometrically_ample_symmetric_lineBundle K A
  let p := pullback.fst A.hom (Geometric.Frobenius.Construction.algebraicClosureBase K)
  obtain ⟨n, hn, hg⟩ := GeneratedAmpleBundle.Construction.ample_exists_power_hasFrameSections (L.pullback p) hL
  let e : ((L.tensorPower n).pullback p).sheaf ≅ ((L.pullback p).tensorPower n).sheaf :=
    Quotients.FiniteDescent.TensorPullback.Construction.TensorPullbackMap.iso p L n
  exact ⟨L.tensorPower n, (hL.tensorPower n hn).of_iso e.symm, hg.of_iso e.symm,
    Geometric.LineBundleInvariance.Construction.symmetric_lineBundle_tensorPower K A L hs n⟩

end Construction

end

end OAI.AlgebraicGeometry.FormalGeometry.Completion.GroundGeometricallyAmple
