import OAI.AlgebraicGeometry.FormalGeometry.Completion.GlobalSectionGeneration
import OAI.AlgebraicGeometry.Quotients.FiniteDescent.LineTrivializationOf
import OAI.AlgebraicGeometry.Quotients.FiniteDescent.FieldPoint

/-! # Generated Line Bundle Frames -/

namespace OAI.AlgebraicGeometry.FormalGeometry.Completion

noncomputable section

/-! A line bundle generated by its actual global sections has a global
section frame at every point. Detection takes place over the residue field. -/

set_option backward.isDefEq.respectTransparency false

open _root_.AlgebraicGeometry _root_.CategoryTheory _root_.CategoryTheory.Limits

universe u

theorem GeneratedLineBundleFrames.Construction.structureModule_field_not_isZero (K : Type u) [Field K] :
    ¬ IsZero (AbelianModuli.HilbertConstruction.Line.Bundles.structureModule (Spec (CommRingCat.of K))) := by
  intro h
  let G := SheafOfModules.evaluation (Spec (CommRingCat.of K)).ringCatSheaf (.op ⊤)
  let : G.PreservesZeroMorphisms := by
    dsimp only [G, SheafOfModules.evaluation]
    infer_instance
  have : Subsingleton (G.obj (AbelianModuli.HilbertConstruction.Line.Bundles.structureModule (Spec (CommRingCat.of K)))) :=
    ModuleCat.subsingleton_of_isZero (G.map_isZero h)
  have h01 : (0 : Γ(Spec (CommRingCat.of K), ⊤)) = 1 :=
    @Subsingleton.elim (G.obj (AbelianModuli.HilbertConstruction.Line.Bundles.structureModule (Spec (CommRingCat.of K)))) _
      (0 : Γ(Spec (CommRingCat.of K), ⊤)) (1 : Γ(Spec (CommRingCat.of K), ⊤))
  let : Field Γ(Spec (CommRingCat.of K), ⊤) := Quotients.FiniteDescent.FieldPoint.Construction.FieldPointPrime.sectionsField K
  exact zero_ne_one h01

theorem GeneratedLineBundleFrames.Construction.lineBundle_not_isZero {X : Scheme.{u}} [Nonempty X] (L : AbelianModuli.HilbertConstruction.Line.Bundles.LineBundle X) :
    ¬ IsZero L.sheaf := by
  intro h
  let x : X := Classical.choice inferInstance
  let f := X.fromSpecResidueField x
  obtain ⟨e⟩ := Quotients.FiniteDescent.LineTrivializationOf.Construction.LineTrivialization.pullback_trivial_over_field f L
  exact GeneratedLineBundleFrames.Construction.structureModule_field_not_isZero (X.residueField x)
    (((Scheme.Modules.pullback f).map_isZero h).of_iso e.symm)

theorem GlobalSectionGeneration.Construction.SectionsDetectMaps.lineBundle_frames {X : Scheme.{u}} (L : AbelianModuli.HilbertConstruction.Line.Bundles.LineBundle X)
    (hL : GlobalSectionGeneration.Construction.SectionsDetectMaps L.sheaf) : Frame.SectionDetection.Construction.HasFrameSections L.sheaf := by
  intro x
  by_contra h
  push Not at h
  let f := X.fromSpecResidueField x
  let F := Scheme.Modules.pullback f
  have hs (s : AbelianModuli.HilbertConstruction.Line.Bundles.structureModule X ⟶ L.sheaf) : F.map s = 0 := by
    have hz : AbelianModuli.HilbertConstruction.Ample.LineBundles.pullbackSection f s = 0 := by
      apply Quotients.FiniteDescent.ReducedSectionsEq.Construction.ReducedSections.section_eq_zero_of_nonvanishing_eq_bot (L.pullback f)
      rw [Quotients.FiniteDescent.SectionBase.Construction.SectionBaseChange.nonvanishing_pullback]
      apply le_antisymm _ bot_le
      intro y hy
      exact False.elim (h s (by
        change f y ∈ AbelianModuli.HilbertConstruction.Ample.LineBundles.sectionNonvanishing s at hy
        simpa only [f, Scheme.fromSpecResidueField_apply] using hy))
    apply (cancel_epi (AbelianModuli.HilbertConstruction.Line.Bundles.structureModulePullbackIso f).inv).mp
    simpa only [AbelianModuli.HilbertConstruction.Ample.LineBundles.pullbackSection, comp_zero] using hz
  let U := fun _ : Γ(L.sheaf, ⊤) => AbelianModuli.HilbertConstruction.Line.Bundles.structureModule X
  have he : F.map (GlobalSectionGeneration.Construction.globalSectionEvaluation L.sheaf) = 0 := by
    apply (isColimitOfPreserves F (coproductIsCoproduct U)).hom_ext
    intro i
    change F.map (Sigma.ι U i.as) ≫ F.map (GlobalSectionGeneration.Construction.globalSectionEvaluation L.sheaf) =
      F.map (Sigma.ι U i.as) ≫ 0
    rw [comp_zero, ← F.map_comp]
    simpa only [GlobalSectionGeneration.Construction.globalSectionEvaluation, Sigma.ι_comp_desc] using hs ((AbelianModuli.HilbertConstruction.Global.Sections.moduleSectionHomEquiv L.sheaf).symm i.as)
  have : Epi (GlobalSectionGeneration.Construction.globalSectionEvaluation L.sheaf) := hL.evaluation_epi
  have hz := IsZero.of_epi_eq_zero (F.map (GlobalSectionGeneration.Construction.globalSectionEvaluation L.sheaf)) he
  obtain ⟨e⟩ := Quotients.FiniteDescent.LineTrivializationOf.Construction.LineTrivialization.pullback_trivial_over_field f L
  exact GeneratedLineBundleFrames.Construction.structureModule_field_not_isZero (X.residueField x) (hz.of_iso e.symm)

end

end OAI.AlgebraicGeometry.FormalGeometry.Completion
