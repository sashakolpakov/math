import OAI.AlgebraicGeometry.Divisors.LineBundles.SymmetricInfinity.GenerationBaseChange
import OAI.AlgebraicGeometry.Divisors.LineBundles.FiniteBasisIteratedEquiv
import OAI.AlgebraicGeometry.Divisors.LineBundles.AffineSource.ChowIsomorphismInverse
import OAI.AlgebraicGeometry.Divisors.LineBundles.Symmetric.RankOneProjective

/-! # Projective Generation Base Change -/

namespace OAI.AlgebraicGeometry.Divisors.LineBundles.ProjectiveGenerationBaseChange.BundleCycles

noncomputable section

/-! Every Chow class on an iterated free augmented projective
bundle is generated by actual hyperplane powers after any base change. -/

open _root_.AlgebraicGeometry _root_.CategoryTheory _root_.CategoryTheory.Limits

variable (R : Type) [CommRing R] {Y : Scheme.{0}} [AlgebraicGeometry.IsNoetherian Y] [Y.IsSeparated]
    (b : Y ⟶ Spec (.of R)) (f : Y ⟶ Foundations.Scheme.ProjectiveSpace.complexBase) [LocallyOfFiniteType f]

theorem iteratedProjectiveChow_baseChange_generated (n : ℕ) :
    ∀ d (α : DimensionChow.BundleCycles.DimensionChowQ (pullback.snd (SymmetricProjective.Scheme.BundleCycles.symmetricProjectiveToBase R (R × FiniteBasisIteratedEquiv.BundleCycles.iteratedAugmentedModule R n)) b ≫ f) d),
      α ∈ ProjectiveChow.Filtration.BundleCycles.projectiveChowGenerated (pullback.snd (SymmetricProjective.Scheme.BundleCycles.symmetricProjectiveToBase R (R × FiniteBasisIteratedEquiv.BundleCycles.iteratedAugmentedModule R n)) b)
        f (n + 1) ((FiniteBasisIteratedEquiv.BundleCycles.iteratedProjective_sourceCharts R (n + 1)).baseChange b)
        ((SymmetricInfinity.Bundle.Cycles.symmetricInfinityIdealLineBundle R (FiniteBasisIteratedEquiv.BundleCycles.iteratedAugmentedModule R n)).pullback
          (pullback.fst (SymmetricProjective.Scheme.BundleCycles.symmetricProjectiveToBase R (R × FiniteBasisIteratedEquiv.BundleCycles.iteratedAugmentedModule R n)) b)) d := by
  induction n with
  | zero =>
    intro d α
    let p := SymmetricProjective.Scheme.BundleCycles.symmetricProjectiveToBase R (R × FiniteBasisIteratedEquiv.BundleCycles.iteratedAugmentedModule R 0)
    let q := SymmetricProjective.Scheme.BundleCycles.symmetricProjectiveToBase R (FiniteBasisIteratedEquiv.BundleCycles.iteratedAugmentedModule R 0)
    let s := SymmetricInfinity.Inclusion.BundleCycles.symmetricInfinityInclusion R (FiniteBasisIteratedEquiv.BundleCycles.iteratedAugmentedModule R 0)
    have hs : s ≫ p = q := SymmetricProjective.Base.BundleCycles.symmetricProjectiveMap_over (LinearMap.snd R R (FiniteBasisIteratedEquiv.BundleCycles.iteratedAugmentedModule R 0)) _
    let : IsIso q := inferInstanceAs (IsIso (SymmetricProjective.Scheme.BundleCycles.symmetricProjectiveToBase R R))
    let hreg := SymmetricInfinity.Bundle.Cycles.symmetricInfinity_regularPrincipalImageIdeals R (FiniteBasisIteratedEquiv.BundleCycles.iteratedAugmentedModule R 0)
    let L := (Cartier.IdealBundle.Cycles.cartierIdealLineBundle s hreg).pullback s
    have hgen (m : ℕ) (β : DimensionChow.BundleCycles.DimensionChowQ (pullback.snd q b ≫ f) m) :
        β ∈ ProjectiveChow.Filtration.BundleCycles.projectiveChowGenerated (pullback.snd q b) f 0 ((FiniteBasisIteratedEquiv.BundleCycles.iteratedProjective_sourceCharts R 0).baseChange b)
          (L.pullback (pullback.fst q b)) m :=
      AffineSource.ChowIsomorphismInverse.BundleCycles.projectiveChowGenerated_of_isIso (pullback.snd q b) f ((FiniteBasisIteratedEquiv.BundleCycles.iteratedProjective_sourceCharts R 0).baseChange b)
        (L.pullback (pullback.fst q b)) m β
    exact Projective.GenerationBaseChangeStep.BundleCycles.projectiveChowGeneration_baseChange_step p q s hs hreg b f 0
      (FiniteBasisIteratedEquiv.BundleCycles.iteratedProjective_sourceCharts R 1) (FiniteBasisIteratedEquiv.BundleCycles.iteratedProjective_sourceCharts R 0) L (Iso.refl _)
      (FiniteBasisIteratedEquiv.BundleCycles.iteratedAugmentedIndex 0) (FiniteBasisIteratedEquiv.BundleCycles.iteratedAugmentedIndex_card 0)
      (Symmetric.AugmentedAffineChart.BundleCycles.symmetricAugmentedAffineChart (FiniteBasisIteratedEquiv.BundleCycles.iteratedAugmentedBasis R 0))
      (Symmetric.AugmentedAffineChart.BundleCycles.symmetricAugmentedAffineChart_over (FiniteBasisIteratedEquiv.BundleCycles.iteratedAugmentedBasis R 0))
      (Symmetric.AugmentedAffineChart.BundleCycles.symmetricAugmentedAffineChart_complement (FiniteBasisIteratedEquiv.BundleCycles.iteratedAugmentedBasis R 0)) hgen d α
  | succ n ih =>
    intro d α
    let : Smooth (SymmetricProjective.Scheme.BundleCycles.symmetricProjectiveToBase R (R × (R × FiniteBasisIteratedEquiv.BundleCycles.iteratedAugmentedModule R n))) :=
      FiniteBasisIteratedEquiv.BundleCycles.iteratedProjective_smooth R ((n + 1) + 1)
    let : GeometricallyIntegral (SymmetricProjective.Scheme.BundleCycles.symmetricProjectiveToBase R (R × (R × FiniteBasisIteratedEquiv.BundleCycles.iteratedAugmentedModule R n))) :=
      FiniteBasisIteratedEquiv.BundleCycles.iteratedProjective_geometricallyIntegral R ((n + 1) + 1)
    exact SymmetricInfinity.GenerationBaseChange.BundleCycles.symmetricInfinityChow_generation_baseChange_step R (FiniteBasisIteratedEquiv.BundleCycles.iteratedAugmentedModule R n)
      (FiniteBasisIteratedEquiv.BundleCycles.iteratedAugmentedBasis R (n + 1)) b f (n + 1) (FiniteBasisIteratedEquiv.BundleCycles.iteratedAugmentedIndex_card (n + 1))
      (FiniteBasisIteratedEquiv.BundleCycles.iteratedProjective_sourceCharts R ((n + 1) + 1)) (FiniteBasisIteratedEquiv.BundleCycles.iteratedProjective_sourceCharts R (n + 1)) ih d α

end

end OAI.AlgebraicGeometry.Divisors.LineBundles.ProjectiveGenerationBaseChange.BundleCycles
