import OAI.AlgebraicGeometry.Divisors.LineBundles.Projective.CoordinateSectionMap
import OAI.AlgebraicGeometry.Divisors.LineBundles.Graded.PrincipalChartKernel
import OAI.AlgebraicGeometry.Divisors.LineBundles.Projective.ClosedImmersion

/-! # Principal Section Kernel -/

namespace OAI.AlgebraicGeometry.Divisors.LineBundles.Projective.PrincipalSectionKernel.BundleCycles

noncomputable section

/-! On each projective chart, the actual kernel ideal of a
homogeneous principal quotient is generated by its coordinate fraction. -/

open _root_.AlgebraicGeometry _root_.CategoryTheory _root_.HomogeneousLocalization

variable {A B σ τ : Type} [CommRing A] [CommRing B]
    [SetLike σ A] [AddSubgroupClass σ A] [SetLike τ B] [AddSubgroupClass τ B]
    {𝒜 : ℕ → σ} {ℬ : ℕ → τ} [GradedRing 𝒜] [GradedRing ℬ]
    (f : 𝒜 →+*ᵍ ℬ)
    (hf : HomogeneousIdeal.irrelevant ℬ ≤ (HomogeneousIdeal.irrelevant 𝒜).map f)
    (v t : A) (hv : v ∈ 𝒜 1) (ht : t ∈ 𝒜 1)
    (hk : RingHom.ker f.toRingHom = Ideal.span {t})

include hk in
theorem projectivePrincipalSection_kernel :
    RingHom.ker ((Proj.map f hf).app (Proj.basicOpen 𝒜 v)).hom =
      Ideal.span {CoordinateSectionMap.BundleCycles.projectiveCoordinateSection 𝒜 v t hv ht} := by
  let e := Proj.basicOpenIsoAway 𝒜 v hv (by decide : 0 < 1)
  let e' := Proj.basicOpenIsoAway ℬ (f v) (f.map_mem hv) (by decide : 0 < 1)
  have H := Proj.awayToSection_comp_appLE f hf hv
  have hPoint (a : Away 𝒜 v) :
      (Proj.map f hf).app (Proj.basicOpen 𝒜 v) (e.hom a) = e'.hom (Away.map f v a) :=
    ConcreteCategory.congr_hom H a
  have hcomap : (RingHom.ker ((Proj.map f hf).app (Proj.basicOpen 𝒜 v)).hom).comap e.hom.hom =
      RingHom.ker (Away.map f v) := by
    ext a
    change (Proj.map f hf).app (Proj.basicOpen 𝒜 v) (e.hom a) = 0 ↔ Away.map f v a = 0
    constructor
    · intro ha
      apply (ConcreteCategory.bijective_of_isIso e'.hom).injective
      exact (hPoint a).symm.trans (ha.trans (e'.hom.hom.map_zero).symm)
    · intro ha
      exact (hPoint a).trans ((congrArg e'.hom ha).trans e'.hom.hom.map_zero)
  have he := Ideal.map_comap_of_surjective e.hom.hom (ConcreteCategory.bijective_of_isIso e.hom).surjective
    (RingHom.ker ((Proj.map f hf).app (Proj.basicOpen 𝒜 v)).hom)
  rw [hcomap, Graded.PrincipalChartKernel.BundleCycles.gradedPrincipalChart_kernel f ht hv hk, Ideal.map_span, Set.image_singleton] at he
  exact he.symm

end

end OAI.AlgebraicGeometry.Divisors.LineBundles.Projective.PrincipalSectionKernel.BundleCycles
