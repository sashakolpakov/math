import OAI.AlgebraicGeometry.AbelianModuli.HilbertConstruction.Balanced.MonomialAlgebra

/-! # Monomial Exponent Extension -/

namespace OAI.AlgebraicGeometry.AbelianModuli.HilbertConstruction.MonomialExponentExtension

noncomputable section

/-! Extending exponents by zero preserves monomial products and all
block degrees. This places monomials using a subset of minors in the
single universal algebra generated by all labeled minors. -/
open scoped BigOperators Classical
universe u v w
variable {κ : Type u} [Fintype κ] {ι : Type v}

def exponentExtendByZero (p : κ → Prop) (a : {k // p k} → ℕ) : κ → ℕ :=
  fun k => if h : p k then a ⟨k, h⟩ else 0

theorem exponentExtendByZero_degree (p : κ → Prop) (a : {k // p k} → ℕ)
    (w : κ → ι → ℕ) (i : ι) :
    Balanced.ExponentFiniteGeneration.monomialMultiDegree w (exponentExtendByZero p a) i =
      Balanced.ExponentFiniteGeneration.monomialMultiDegree (fun k : {k // p k} => w k.val) a i := by
  apply Finset.sum_congr_set {k | p k}
  · intro k hk
    change p k at hk
    simp only [exponentExtendByZero, dite_eq_left hk]
  · intro k hk
    change ¬ p k at hk
    simp only [exponentExtendByZero, dite_eq_right hk, zero_mul]

theorem exponentExtendByZero_balanced (p : κ → Prop) (a : {k // p k} → ℕ)
    (w : κ → ι → ℕ) (ha : a ∈ Balanced.ExponentFiniteGeneration.balancedExponentMonoid (fun k : {k // p k} => w k.val)) :
    exponentExtendByZero p a ∈ Balanced.ExponentFiniteGeneration.balancedExponentMonoid w := by
  apply (Balanced.ExponentFiniteGeneration.mem_balancedExponentMonoid_iff _ _).mpr
  intro i j
  rw [exponentExtendByZero_degree, exponentExtendByZero_degree]
  exact (Balanced.ExponentFiniteGeneration.mem_balancedExponentMonoid_iff _ _).mp ha i j

theorem exponentMonomial_extendByZero {A : Type w} [CommRing A]
    (p : κ → Prop) (a : {k // p k} → ℕ) (D : κ → A) :
    Balanced.MonomialAlgebra.exponentMonomial D (exponentExtendByZero p a) =
      Balanced.MonomialAlgebra.exponentMonomial (fun k : {k // p k} => D k.val) a := by
  apply Finset.prod_congr_set {k | p k}
  · intro k hk
    change p k at hk
    simp only [exponentExtendByZero, dite_eq_left hk]
  · intro k hk
    change ¬ p k at hk
    simp only [exponentExtendByZero, dite_eq_right hk, pow_zero]

theorem exponentMonomial_map {A : Type v} {B : Type w} [CommRing A] [CommRing B]
    (f : A →+* B) (D : κ → A) (a : κ → ℕ) :
    f (Balanced.MonomialAlgebra.exponentMonomial D a) = Balanced.MonomialAlgebra.exponentMonomial (fun k => f (D k)) a := by
  simp only [Balanced.MonomialAlgebra.exponentMonomial, map_prod, map_pow]

end

end OAI.AlgebraicGeometry.AbelianModuli.HilbertConstruction.MonomialExponentExtension
