import OAI.AlgebraicGeometry.AbelianModuli.HilbertConstruction.BalancedChart.OrbitInvariance
import OAI.AlgebraicGeometry.AbelianModuli.HilbertConstruction.Homogeneous.ChartAlgebraEvaluation

/-! # Configuration Orbits -/

namespace OAI.AlgebraicGeometry.AbelianModuli.HilbertConstruction.BalancedChart.ConfigurationOrbits

noncomputable section

/-! The configurations with invertible balanced denominator carry the
equivalence relation generated by common linear coordinate changes and
independent unit scalings of the labeled vectors. -/
open scoped Classical
universe u v
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
variable (A : Type u) [CommRing A] {r m : ℕ} (a : (Fin r → Fin m) → ℕ)

structure BalancedChartConfiguration where
  vector : Fin m → Fin r → A
  denominatorUnit : IsUnit (Balanced.MonomialAlgebra.exponentMonomial (fun τ => LabeledDeterminantPolynomials.labeledDeterminant τ vector) a)

def balancedChartConfigurationOrbit (v w : BalancedChartConfiguration A a) : Prop :=
  ∃ T : (Fin r → A) ≃ₗ[A] (Fin r → A), ∃ s : Fin m → Aˣ,
    ∀ z, w.vector z = (s z : A) • T (v.vector z)

def balancedChartConfigurationSetoid : Setoid (BalancedChartConfiguration A a) where
  r := balancedChartConfigurationOrbit A a
  iseqv := {
    refl := by
      intro v
      refine ⟨LinearEquiv.refl A _, fun _ => 1, ?_⟩
      intro z
      simp only [Units.val_one, LinearEquiv.refl_apply, one_smul]
    symm := by
      rintro v w ⟨T, s, h⟩
      refine ⟨T.symm, fun z => (s z)⁻¹, ?_⟩
      intro z
      rw [h z, map_smul, T.symm_apply_apply, ← mul_smul, Units.inv_mul, one_smul]
    trans := by
      rintro v w t ⟨T, s, h⟩ ⟨U, q, h'⟩
      refine ⟨T.trans U, fun z => q z * s z, ?_⟩
      intro z
      rw [h' z, h z, map_smul, smul_smul, Units.val_mul]
      rfl }

variable {R : Type v} [CommRing R] [Algebra R A]

def balancedConfigurationChartAlgebraEvaluation (i : Fin m)
    (ha : a ∈ Balanced.ExponentFiniteGeneration.balancedExponentMonoid DeterminantBlockDegrees.labeledDeterminantWeight) (v : BalancedChartConfiguration A a) :
    Balanced.FrameChartCoordinates.balancedDeterminantChartRing R i a ha →ₐ[R] A :=
  Homogeneous.ChartAlgebraEvaluation.homogeneousAwayAlgebraEvaluation (Balanced.DeterminantGrading.balancedDeterminantGrading R r m i)
    (Balanced.FrameCoordinatePolynomials.balancedDeterminantMonomialElement R a ha)
    (Balanced.ConfigurationChartEvaluation.balancedConfigurationPolynomialEvaluation (R := R) v.vector)
    ((Balanced.ConfigurationChartEvaluation.balancedConfigurationPolynomialEvaluation_denominator (R := R) v.vector a ha).symm ▸ v.denominatorUnit)

theorem balancedConfigurationChartAlgebraEvaluation_eq_of_orbit (hr : 0 < r)
    (i : Fin m) (ha : a ∈ Balanced.ExponentFiniteGeneration.balancedExponentMonoid DeterminantBlockDegrees.labeledDeterminantWeight)
    {v w : BalancedChartConfiguration A a} (h : balancedChartConfigurationOrbit A a v w) :
    balancedConfigurationChartAlgebraEvaluation (R := R) A a i ha v =
      balancedConfigurationChartAlgebraEvaluation (R := R) A a i ha w := by
  obtain ⟨T, s, hs⟩ := h
  apply AlgHom.ext
  intro x
  exact RingHom.congr_fun (OrbitInvariance.balancedConfigurationChartEvaluation_invariant (R := R) hr i v.vector w.vector a ha
    v.denominatorUnit w.denominatorUnit T s hs) x

end

end OAI.AlgebraicGeometry.AbelianModuli.HilbertConstruction.BalancedChart.ConfigurationOrbits
