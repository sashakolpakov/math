import OAI.AlgebraicGeometry.AbelianModuli.HilbertConstruction.Balanced.CommonDegreeGenerators
import OAI.AlgebraicGeometry.AbelianModuli.HilbertConstruction.Veronese.Grading

/-! # Veronese Finite Generation -/

namespace OAI.AlgebraicGeometry.AbelianModuli.HilbertConstruction.Balanced.VeroneseFiniteGeneration

noncomputable section

/-! The full Veronese subalgebra is generated by a finite family in
one original degree. The proof covers arbitrary linear combinations
in the homogeneous pieces, not just determinant monomials. -/
open scoped BigOperators Classical
universe u
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
variable (R : Type u) [CommRing R] {r m : ℕ}

theorem balancedDeterminant_veronese_finite_generation (hr : 0 < r) (i : Fin m) :
    ∃ N : ℕ, 0 < N ∧ ∃ F : Finset (DeterminantAlgebra.balancedDeterminantAlgebra R r m),
      (∀ x ∈ F, x ∈ DeterminantGrading.balancedDeterminantGrading R r m i N) ∧
      Algebra.adjoin R (F : Set (DeterminantAlgebra.balancedDeterminantAlgebra R r m)) =
        Veronese.Subalgebra.veroneseSubalgebra (DeterminantGrading.balancedDeterminantGrading R r m i) N := by
  obtain ⟨N, hN, F, hF, hmon⟩ := CommonDegreeGenerators.balancedDeterminant_common_degree_generators R hr i
  let E := Algebra.adjoin R (F : Set (DeterminantAlgebra.balancedDeterminantAlgebra R r m))
  have hpiece (k : ℕ) : DeterminantGrading.balancedDeterminantGrading R r m i (N * k) ≤ E.toSubmodule := by
    have hspan : MonomialSpan.balancedMonomialDegreeSpan (R := R) (LabeledDeterminantPolynomials.labeledDeterminantPolynomial R)
        DeterminantBlockDegrees.labeledDeterminantWeight i (N * k) ≤
        E.toSubmodule.map (DeterminantAlgebra.balancedDeterminantAlgebra R r m).toSubmodule.subtype := by
      apply Submodule.span_le.mpr
      rintro _ ⟨a, ⟨ha, hdeg⟩, rfl⟩
      exact ⟨FrameCoordinatePolynomials.balancedDeterminantMonomialElement R a ha,
        hmon a ha (hdeg.symm ▸ dvd_mul_right N k), rfl⟩
    intro x hx
    obtain ⟨y, hy, hyx⟩ := hspan hx
    have heq : y = x := Subtype.ext hyx
    exact heq ▸ hy
  refine ⟨N, hN, F, hF, le_antisymm ?_ ?_⟩
  · apply Algebra.adjoin_le
    intro x hx
    apply Veronese.Subalgebra.veronese_homogeneous_mem (DeterminantGrading.balancedDeterminantGrading R r m i) N 1
    simpa only [Nat.mul_one] using hF x hx
  · exact iSup_le hpiece

end

end OAI.AlgebraicGeometry.AbelianModuli.HilbertConstruction.Balanced.VeroneseFiniteGeneration
