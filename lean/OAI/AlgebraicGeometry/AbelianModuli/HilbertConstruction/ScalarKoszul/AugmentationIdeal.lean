import OAI.AlgebraicGeometry.AbelianModuli.HilbertConstruction.ScalarKoszul.FiniteTerms

/-! # Augmentation Ideal -/

namespace OAI.AlgebraicGeometry.AbelianModuli.HilbertConstruction.ScalarKoszul.AugmentationIdeal

noncomputable section

/-! Under the explicit degree-zero identification, the final Koszul differential has image exactly the ideal generated by the parameters. -/
open _root_.CategoryTheory _root_.CategoryTheory.Limits
open _root_.CochainComplex
universe u
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
variable {R : Type u} [CommRing R]

def scalarKoszulLastMap (M : ModuleCat.{u} R) (rs : List R) :
    (KoszulComplex.scalarKoszulComplex M rs).X (-1) →ₗ[R] M :=
  (FiniteTerms.scalarKoszulZeroTermIso M rs).hom.hom.comp ((KoszulComplex.scalarKoszulComplex M rs).d (-1) 0).hom

theorem scalarKoszulLastMap_cons (M : ModuleCat.{u} R) (r : R) (rs : List R)
    (z : (KoszulComplex.scalarKoszulComplex M (r :: rs)).X (-1)) :
    scalarKoszulLastMap M (r :: rs) z =
      r • (FiniteTerms.scalarKoszulZeroTermIso M rs).hom
        ((mappingCone.fst (r • 𝟙 (KoszulComplex.scalarKoszulComplex M rs))).1.v (-1) 0 (by decide) z) +
      scalarKoszulLastMap M rs
        ((mappingCone.snd (r • 𝟙 (KoszulComplex.scalarKoszulComplex M rs))).v (-1) (-1) (by decide) z) := by
  let C := KoszulComplex.scalarKoszulComplex M rs
  let f := r • 𝟙 C
  let E := FiniteTerms.scalarKoszulZeroTermIso M rs
  have h := congrArg (fun a => a ≫ E.hom) (mappingCone.d_snd_v f (-1) 0 (by decide))
  rw [Preadditive.add_comp] at h
  have hz := ConcreteCategory.congr_hom h z
  change scalarKoszulLastMap M (r :: rs) z =
    E.hom (r • ((mappingCone.fst f).1.v (-1) 0 (by decide) z)) +
      scalarKoszulLastMap M rs ((mappingCone.snd f).v (-1) (-1) (by decide) z) at hz
  rw [E.hom.hom.map_smul] at hz
  exact hz

theorem scalarKoszulLastMap_inl (M : ModuleCat.{u} R) (r : R) (rs : List R)
    (x : (KoszulComplex.scalarKoszulComplex M rs).X 0) :
    scalarKoszulLastMap M (r :: rs)
      ((mappingCone.inl (r • 𝟙 (KoszulComplex.scalarKoszulComplex M rs))).v 0 (-1) (by decide) x) =
      r • (FiniteTerms.scalarKoszulZeroTermIso M rs).hom x := by
  let f := r • 𝟙 (KoszulComplex.scalarKoszulComplex M rs)
  have h₁ := ConcreteCategory.congr_hom (mappingCone.inl_v_fst_v f 0 (-1) (by decide)) x
  have h₂ := ConcreteCategory.congr_hom (mappingCone.inl_v_snd_v f 0 (-1) (by decide)) x
  simp only [ModuleCat.comp_apply] at h₁ h₂
  erw [scalarKoszulLastMap_cons, h₁, h₂, map_zero, add_zero]
  rfl

theorem scalarKoszulLastMap_inr (M : ModuleCat.{u} R) (r : R) (rs : List R)
    (x : (KoszulComplex.scalarKoszulComplex M rs).X (-1)) :
    scalarKoszulLastMap M (r :: rs)
      ((mappingCone.inr (r • 𝟙 (KoszulComplex.scalarKoszulComplex M rs))).f (-1) x) = scalarKoszulLastMap M rs x := by
  let f := r • 𝟙 (KoszulComplex.scalarKoszulComplex M rs)
  have h₁ := ConcreteCategory.congr_hom (mappingCone.inr_f_fst_v f (-1) 0 (by decide)) x
  have h₂ := ConcreteCategory.congr_hom (mappingCone.inr_f_snd_v f (-1)) x
  simp only [ModuleCat.comp_apply] at h₁ h₂
  erw [scalarKoszulLastMap_cons, h₁, h₂, map_zero, smul_zero, zero_add]
  rfl

theorem scalarKoszulLastMap_range (rs : List R) :
    (scalarKoszulLastMap (ModuleCat.of R R) rs).range = Regular.SequenceBasic.Ideal.ofList rs := by
  induction rs with
  | nil =>
    have : Subsingleton ((KoszulComplex.scalarKoszulComplex (ModuleCat.of R R) []).X (-1)) :=
      ModuleCat.subsingleton_of_isZero (KoszulComplex.scalarKoszulComplex_isZero_X _ [] (-1) (Or.inl (by simp)))
    have hz : scalarKoszulLastMap (ModuleCat.of R R) [] = 0 := Subsingleton.elim _ _
    rw [hz, LinearMap.range_zero, Regular.SequenceBasic.Ideal.ofList_nil]
  | cons r rs ih =>
    let M := ModuleCat.of R R
    let C := KoszulComplex.scalarKoszulComplex M rs
    let E := FiniteTerms.scalarKoszulZeroTermIso M rs
    let f := r • 𝟙 C
    apply le_antisymm
    · rintro x ⟨z, rfl⟩
      rw [scalarKoszulLastMap_cons]
      apply Ideal.add_mem
      · have hr : r ∈ Regular.SequenceBasic.Ideal.ofList (r :: rs) := Ideal.subset_span (by simp)
        exact (Regular.SequenceBasic.Ideal.ofList (r :: rs)).mul_mem_right _ hr
      · have hle : Regular.SequenceBasic.Ideal.ofList rs ≤ Regular.SequenceBasic.Ideal.ofList (r :: rs) := by
          rw [Regular.SequenceBasic.Ideal.ofList_cons]
          exact le_sup_right
        exact hle (ih ▸ LinearMap.mem_range_self (scalarKoszulLastMap M rs) _)
    · rw [Regular.SequenceBasic.Ideal.ofList_cons]
      apply sup_le
      · apply Ideal.span_le.mpr
        intro x hx
        have hx' : x = r := Set.mem_singleton_iff.mp hx
        subst x
        refine ⟨(mappingCone.inl f).v 0 (-1) (by decide) (E.inv 1), ?_⟩
        rw [scalarKoszulLastMap_inl]
        have he : E.hom (E.inv 1) = 1 := ConcreteCategory.congr_hom E.inv_hom_id 1
        rw [he]
        exact mul_one r
      · rw [← ih]
        rintro x ⟨z, hz⟩
        exact ⟨(mappingCone.inr f).f (-1) z, (scalarKoszulLastMap_inr M r rs z).trans hz⟩

def scalarKoszulCokernelQuotientIso (rs : List R) :
    cokernel ((KoszulComplex.scalarKoszulComplex (ModuleCat.of R R) rs).d (-1) 0) ≅
      ModuleCat.of R (R ⧸ Regular.SequenceBasic.Ideal.ofList rs) := by
  let C := KoszulComplex.scalarKoszulComplex (ModuleCat.of R R) rs
  let E := (FiniteTerms.scalarKoszulZeroTermIso (ModuleCat.of R R) rs).toLinearEquiv
  have hmap : (C.d (-1) 0).hom.range.map E.toLinearMap = Regular.SequenceBasic.Ideal.ofList rs := by
    rw [← LinearMap.range_comp]
    exact scalarKoszulLastMap_range rs
  exact ModuleCat.cokernelIsoRangeQuotient (C.d (-1) 0) ≪≫
    (Submodule.Quotient.equiv (C.d (-1) 0).hom.range (Regular.SequenceBasic.Ideal.ofList rs) E hmap).toModuleIso

end

end OAI.AlgebraicGeometry.AbelianModuli.HilbertConstruction.ScalarKoszul.AugmentationIdeal
