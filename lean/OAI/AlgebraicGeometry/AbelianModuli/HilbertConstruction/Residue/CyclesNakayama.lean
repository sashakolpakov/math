import OAI.AlgebraicGeometry.AbelianModuli.HilbertConstruction.FiberFlatCriterion

/-! # Cycles Nakayama -/

namespace OAI.AlgebraicGeometry.AbelianModuli.HilbertConstruction.Residue.CyclesNakayama.LocalSectionLifting

noncomputable section

/-! A finite module generated by liftable residue cycles has zero differential. -/

open scoped TensorProduct

variable {R M N : Type*} [CommRing R] [IsLocalRing R]
    [AddCommGroup M] [Module R M] [Module.Finite R M]
    [AddCommGroup N] [Module R N]

theorem linearMap_eq_zero_of_residue_cycles_lift (f : M →ₗ[R] N)
    (h : ∀ z : IsLocalRing.ResidueField R ⊗[R] M,
      ∃ x : M, f x = 0 ∧ (1 : IsLocalRing.ResidueField R) ⊗ₜ[R] x = z) : f = 0 := by
  have hself : IsLocalHom (algebraMap R R) := ⟨fun _ h ↦ h⟩
  have hs : Function.Surjective (LinearMap.ker f).subtype := by
    apply FiberFlatCriterion.LocalSectionLifting.surjective_of_residueField_tensor (R := R) (A := R) (LinearMap.ker f).subtype
    intro z
    obtain ⟨x, hx, hz⟩ := h z
    exact ⟨(1 : IsLocalRing.ResidueField R) ⊗ₜ[R] (⟨x, hx⟩ : LinearMap.ker f), hz⟩
  apply LinearMap.ext
  intro x
  obtain ⟨y, rfl⟩ := hs x
  exact y.property

end

end OAI.AlgebraicGeometry.AbelianModuli.HilbertConstruction.Residue.CyclesNakayama.LocalSectionLifting
