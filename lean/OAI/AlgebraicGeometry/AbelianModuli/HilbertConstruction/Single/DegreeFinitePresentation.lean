import OAI.AlgebraicGeometry.AbelianModuli.HilbertConstruction.Single.DegreeRelationExtension
import Mathlib.RingTheory.Flat.EquationalCriterion

/-! # Degree Finite Presentation -/

namespace OAI.AlgebraicGeometry.AbelianModuli.HilbertConstruction.Single.DegreeFinitePresentation

noncomputable section

/-! Every degree quotient generated by a finite homogeneous relation module is finitely presented, over arbitrary rings. -/

universe u v

variable {R : Type u} [CommRing R] {σ : Type v} [Finite σ] (N : ℕ)
variable (K : Submodule R (MvPolynomial.homogeneousSubmodule σ R N)) (hK : K.FG)

include hK in
theorem singleDegreePiece_fg (d : ℕ) : (DegreeRelationExtension.singleDegreePiece N K d).FG := by
  induction d with
  | zero =>
    by_cases h : 0 = N
    · subst N
      rw [DegreeRelationExtension.singleDegreePiece_at]
      exact hK
    · rw [DegreeRelationExtension.singleDegreePiece_below N K 0 (by omega)]
      exact Submodule.fg_bot
  | succ d ih =>
    by_cases he : d + 1 = N
    · subst N
      rw [DegreeRelationExtension.singleDegreePiece_at]
      exact hK
    · by_cases hd : N ≤ d
      · rw [DegreeRelationExtension.singleDegreePiece_succ N K d hd]
        exact Submodule.fg_iSup _ (fun i => ih.map (Homogeneous.MultiplicationMatrices.homogeneousMultiplyX R σ d i))
      · rw [DegreeRelationExtension.singleDegreePiece_below N K (d + 1) (by omega)]
        exact Submodule.fg_bot

include hK in
theorem singleDegreeQuotient_finitePresentation (d : ℕ) :
    Module.FinitePresentation R
      (MvPolynomial.homogeneousSubmodule σ R d ⧸ DegreeRelationExtension.singleDegreePiece N K d) := by
  let : Module.Free R (MvPolynomial.homogeneousSubmodule σ R d) :=
    Module.Free.of_basis (Homogeneous.Coordinates.homogeneousMonomialBasis R σ d)
  let : Module.Finite R (MvPolynomial.homogeneousSubmodule σ R d) :=
    Module.Finite.of_basis (Homogeneous.Coordinates.homogeneousMonomialBasis R σ d)
  apply Module.finitePresentation_of_free_of_surjective
    (DegreeRelationExtension.singleDegreePiece N K d).mkQ (DegreeRelationExtension.singleDegreePiece N K d).mkQ_surjective
  rw [Submodule.ker_mkQ]
  exact singleDegreePiece_fg N K hK d

theorem homogeneousGrassmannian_relations_fg {r : ℕ}
    (Q : Module.Grassmannian R (MvPolynomial.homogeneousSubmodule σ R N) r) :
    Q.toSubmodule.FG := by
  let : Module.Finite R (MvPolynomial.homogeneousSubmodule σ R N) :=
    Module.Finite.of_basis (Homogeneous.Coordinates.homogeneousMonomialBasis R σ N)
  let : Module.FinitePresentation R (MvPolynomial.homogeneousSubmodule σ R N ⧸ Q.toSubmodule) :=
    Module.finitePresentation_of_projective _ _
  have h := Module.FinitePresentation.fg_ker Q.toSubmodule.mkQ Q.toSubmodule.mkQ_surjective
  rwa [Submodule.ker_mkQ] at h

end

end OAI.AlgebraicGeometry.AbelianModuli.HilbertConstruction.Single.DegreeFinitePresentation
