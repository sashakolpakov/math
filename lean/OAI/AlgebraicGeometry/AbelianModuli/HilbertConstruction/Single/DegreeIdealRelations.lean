import OAI.AlgebraicGeometry.AbelianModuli.HilbertConstruction.Single.DegreeRelationExtension

/-! # Degree Ideal Relations -/

namespace OAI.AlgebraicGeometry.AbelianModuli.HilbertConstruction.Single.DegreeIdealRelations

noncomputable section

/-! The degree relations of an ideal generated by one homogeneous submodule are its repeated variable-multiplication extension. -/

universe u v

variable {R : Type u} [CommRing R] {σ : Type v} (N : ℕ)
variable (K : Submodule R (MvPolynomial.homogeneousSubmodule σ R N))
variable (I : HomogeneousIdeal (MvPolynomial.homogeneousSubmodule σ R))
variable (hI : I.toIdeal = Ideal.span
  (K.map (MvPolynomial.homogeneousSubmodule σ R N).subtype : Set (MvPolynomial σ R)))

include hI in
theorem singleDegreeRelations_reconstruct : (DegreeRelationExtension.singleDegreeRelations N K).toHomogeneousIdeal = I :=
  HomogeneousIdeal.ext ((DegreeRelationExtension.singleDegreeRelations_ideal N K).trans hI.symm)

include hI in
theorem singleDegreePiece_eq_relations (d : ℕ) :
    DegreeRelationExtension.singleDegreePiece N K d = Homogeneous.IdealIncidence.homogeneousDegreeRelations I d := by
  have h := (DegreeRelationExtension.singleDegreeRelations N K).toHomogeneousIdeal_degree d
  rw [singleDegreeRelations_reconstruct N K I hI] at h
  exact h.symm

include hI in
theorem singleDegreeIdeal_relations_below (d : ℕ) (hd : d < N) :
    Homogeneous.IdealIncidence.homogeneousDegreeRelations I d = ⊥ := by
  rw [← singleDegreePiece_eq_relations N K I hI d, DegreeRelationExtension.singleDegreePiece_below N K d hd]

include hI in
theorem singleDegreeIdeal_relations_succ (d : ℕ) (hd : N ≤ d) :
    Homogeneous.IdealIncidence.homogeneousDegreeRelations I (d + 1) =
      ⨆ i : σ, (Homogeneous.IdealIncidence.homogeneousDegreeRelations I d).map (Homogeneous.MultiplicationMatrices.homogeneousMultiplyX R σ d i) := by
  rw [← singleDegreePiece_eq_relations N K I hI (d + 1),
    DegreeRelationExtension.singleDegreePiece_succ N K d hd, singleDegreePiece_eq_relations N K I hI d]

end

end OAI.AlgebraicGeometry.AbelianModuli.HilbertConstruction.Single.DegreeIdealRelations
