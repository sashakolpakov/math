import OAI.AlgebraicGeometry.AbelianModuli.HilbertConstruction.Section.CoverGlobalGeneration
import OAI.AlgebraicGeometry.AbelianModuli.HilbertConstruction.ProjectiveCoordinate.Nonvanishing
import OAI.AlgebraicGeometry.AbelianModuli.HilbertConstruction.ProjectiveTwisting.TensorPowers

/-! # Twist Global Generation -/

namespace OAI.AlgebraicGeometry.AbelianModuli.HilbertConstruction.Projective.TwistGlobalGeneration

noncomputable section

/-! Every positive projective twisting bundle is generated by the actual tensor powers of its homogeneous coordinate sections. -/
open _root_.CategoryTheory _root_.AlgebraicGeometry
universe u

variable {R : Type u} [CommRing R] {n : ℕ} (I : HomogeneousIdeal (HilbertScheme.Presentations.Hilbert.Polynomial.GradedHilbert.grading R n))

theorem projectiveTwistingBundle_positive_hasFiniteGlobalGenerators (d : ℕ) (hd : 0 < d) :
    Finite.GlobalModuleGenerators.HasFiniteGlobalGenerators (ProjectiveTwisting.Bundle.projectiveTwistingBundle I d).sheaf := by
  let s : ULift.{u} (Fin (n + 1)) →
      (Line.Bundles.structureModule (Proj (HilbertScheme.Presentations.Graded.Quotient.GradedHilbert.quotientGrading I)) ⟶ (ProjectiveTwisting.Bundle.projectiveTwistingBundle I 1).sheaf) :=
    fun i => ProjectiveCoordinate.GlobalSections.projectiveCoordinateSection I i.down
  have hs : ∀ x : Proj (HilbertScheme.Presentations.Graded.Quotient.GradedHilbert.quotientGrading I), ∃ i, x ∈ Ample.LineBundles.sectionNonvanishing (s i) := by
    intro x
    obtain ⟨i, hi⟩ := ProjectiveTwisting.Bundle.projectiveTwistingCover I x
    exact ⟨i, (ProjectiveCoordinate.Nonvanishing.projectiveCoordinateSection_nonvanishing I i.down).symm ▸ hi⟩
  exact (Section.CoverGlobalGeneration.lineBundle_tensorPower_finiteGlobalGenerators_of_cover
    (ProjectiveTwisting.Bundle.projectiveTwistingBundle I 1) s hs d hd).of_iso (ProjectiveTwisting.TensorPowers.projectiveTwistingBundle_tensorPowerIso I d)

end

end OAI.AlgebraicGeometry.AbelianModuli.HilbertConstruction.Projective.TwistGlobalGeneration
