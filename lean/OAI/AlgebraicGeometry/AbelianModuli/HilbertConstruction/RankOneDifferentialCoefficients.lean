import OAI.AlgebraicGeometry.AbelianModuli.HilbertConstruction.DifferentialCoefficientIdeal

/-! # Rank One Differential Coefficients -/

namespace OAI.AlgebraicGeometry.AbelianModuli.HilbertConstruction.RankOneDifferentialCoefficients

noncomputable section

/-! If the source of a differential is a free rank-one module with a chosen generator, its full coefficient ideal is generated by the coordinates of the image of that single generator. -/
open _root_.Module
universe u

theorem differentialCoefficientIdeal_of_rank_one_source
    {R M N : Type u} [CommRing R] [AddCommGroup M] [AddCommGroup N]
    [Module R M] [Module R N] {ι κ : Type u}
    (b : Basis ι R M) (c : Basis κ R N) (f : M →ₗ[R] N) (e : R ≃ₗ[R] M) :
    DifferentialCoefficientIdeal.differentialCoefficientIdeal b c f = Ideal.span (Set.range fun i : κ => c.repr (f (e 1)) i) := by
  let b' : Basis (ULift.{u} Unit) R M := (Basis.singleton (ULift.{u} Unit) R).map e
  rw [DifferentialCoefficientIdeal.differentialCoefficientIdeal_basis_independent b c f b' c]
  apply congrArg Ideal.span
  ext r
  constructor
  · rintro ⟨⟨i, j⟩, hr⟩
    refine ⟨j, ?_⟩
    simpa only [b', Basis.map_apply, Basis.singleton_apply] using hr
  · rintro ⟨j, hr⟩
    refine ⟨(⟨()⟩, j), ?_⟩
    simpa only [b', Basis.map_apply, Basis.singleton_apply] using hr

end

end OAI.AlgebraicGeometry.AbelianModuli.HilbertConstruction.RankOneDifferentialCoefficients
