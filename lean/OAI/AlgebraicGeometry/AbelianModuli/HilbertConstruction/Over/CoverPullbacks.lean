import OAI.AlgebraicGeometry.AbelianModuli.HilbertConstruction.Embedded.FamilyCoverSheaf
import Mathlib.AlgebraicGeometry.PullbackCarrier

/-! # Cover Pullbacks -/

namespace OAI.AlgebraicGeometry.AbelianModuli.HilbertConstruction.Over.CoverPullbacks

noncomputable section

/-! Pullbacks of open-cover maps in the over-category remain jointly covering open immersions. -/

open _root_.CategoryTheory _root_.CategoryTheory.Limits _root_.AlgebraicGeometry

universe u

variable {S : Scheme.{u}} {T V : Over S} (f : V ⟶ T) (C : Scheme.OpenCover.{u} T.left)

/-- The projection of the pullback of a cover map in the category of test schemes. -/
def overCoverPullbackMap (i : C.I₀) : pullback f (Embedded.FamilyOpenCover.overOpenCoverMap T C i) ⟶ V :=
  pullback.fst _ _

theorem overCoverPullback_isPullback (i : C.I₀) :
    IsPullback (overCoverPullbackMap f C i).left
      (pullback.snd f (Embedded.FamilyOpenCover.overOpenCoverMap T C i)).left f.left (C.f i) :=
  (IsPullback.of_hasPullback f (Embedded.FamilyOpenCover.overOpenCoverMap T C i)).map (Over.forget S)

instance overCoverPullbackMap_open (i : C.I₀) : IsOpenImmersion (overCoverPullbackMap f C i).left :=
  MorphismProperty.of_isPullback (overCoverPullback_isPullback f C i).flip (C.map_prop i)

/-- The pulled-back test-scheme maps jointly cover the new base. -/
theorem overCoverPullback_covers : ∀ x : V.left, ∃ i y, (overCoverPullbackMap f C i).left y = x := by
  intro x
  obtain ⟨i, y, hy⟩ := C.exists_eq (f.left x)
  obtain ⟨z, hz, _⟩ := Scheme.exists_preimage_of_isPullback
    (overCoverPullback_isPullback f C i) x y hy.symm
  exact ⟨i, z, hz⟩

/-- Each pulled-back cover map lies in the pullback of the sieve generated by the original cover. -/
theorem overCoverPullback_mem (i : C.I₀) :
    (Sieve.ofArrows (Embedded.FamilyOpenCover.overOpenCoverObject T C) (Embedded.FamilyOpenCover.overOpenCoverMap T C)).pullback f
      (overCoverPullbackMap f C i) := by
  change Sieve.ofArrows (Embedded.FamilyOpenCover.overOpenCoverObject T C) (Embedded.FamilyOpenCover.overOpenCoverMap T C)
    (pullback.fst f (Embedded.FamilyOpenCover.overOpenCoverMap T C i) ≫ f)
  rw [pullback.condition]
  exact (Sieve.ofArrows (Embedded.FamilyOpenCover.overOpenCoverObject T C) (Embedded.FamilyOpenCover.overOpenCoverMap T C)).downward_closed
    (Sieve.ofArrows_mk _ _ i) (pullback.snd f (Embedded.FamilyOpenCover.overOpenCoverMap T C i))

end

end OAI.AlgebraicGeometry.AbelianModuli.HilbertConstruction.Over.CoverPullbacks
