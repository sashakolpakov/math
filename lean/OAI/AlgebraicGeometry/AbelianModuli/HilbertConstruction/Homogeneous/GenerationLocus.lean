import OAI.AlgebraicGeometry.AbelianModuli.HilbertConstruction.GenerationAffinePointCriterion
import OAI.AlgebraicGeometry.AbelianModuli.HilbertConstruction.LiftedGenerationConditions
import OAI.AlgebraicGeometry.AbelianModuli.HilbertConstruction.Homogeneous.QuotientClassification

/-! # Generation Locus -/

namespace OAI.AlgebraicGeometry.AbelianModuli.HilbertConstruction.Homogeneous.GenerationLocus

noncomputable section

/-! An actual open locus where the next homogeneous relation module is generated by variable multiplication. -/

open _root_.CategoryTheory _root_.AlgebraicGeometry

universe u v

variable (σ : Type v) [Fintype σ] [DecidableEq σ] (d r s : ℕ)
variable {S : Scheme.{max u v}} {M : Over S}
variable (q : M ⟶ QuotientParameters.homogeneousQuotientParameterScheme.{u, v} σ d r S)
variable (k : M ⟶ QuotientParameters.homogeneousQuotientParameterScheme.{u, v} σ (d + 1) s S)
variable (hF : ∀ i : σ, Grassmann.IncidenceCondition.GrassmannIncidenceCondition q k
  (LiftedHomogeneousMatrices.liftedHomogeneousMultiplicationMatrix.{u, v} Γ(M.left, ⊤) σ d i) (𝟙 M))

def homogeneousGenerationOpen : M.left.Opens :=
  Grassmann.GenerationOpen.grassmannGenerationOpen q k
    (fun i : ULift.{u} σ => LiftedHomogeneousMatrices.liftedHomogeneousMultiplicationMatrix.{u, v} Γ(M.left, ⊤) σ d i.down)
    (fun i => hF i.down)

theorem homogeneousGenerationOpen_affine_point_iff
    (R : CommRingCat.{max u v}) (f : Spec R ⟶ S) (x : Over.mk f ⟶ M)
    (N : Module.Grassmannian R (MvPolynomial.homogeneousSubmodule σ R d) r)
    (K : Module.Grassmannian R (MvPolynomial.homogeneousSubmodule σ R (d + 1)) s)
    (hN : x ≫ q = QuotientParameters.homogeneousQuotientAffinePointEquiv.{u, v} σ d r R f N)
    (hK : x ≫ k = QuotientParameters.homogeneousQuotientAffinePointEquiv.{u, v} σ (d + 1) s R f K) :
    Set.range x.left ⊆ (homogeneousGenerationOpen σ d r s q k hF : Set M.left) ↔
      K.toSubmodule = ⨆ i : σ, N.toSubmodule.map (MultiplicationMatrices.homogeneousMultiplyX R σ d i) := by
  have hcoeff (i : ULift.{u} σ) :
      (LiftedHomogeneousMatrices.liftedHomogeneousMultiplicationMatrix.{u, v} Γ(M.left, ⊤) σ d i.down).map x.left.appTop.hom =
        (LiftedHomogeneousMatrices.liftedHomogeneousMultiplicationMatrix.{u, v} R σ d i.down).map (Scheme.ΓSpecIso R).inv.hom :=
    (LiftedHomogeneousMatrices.liftedHomogeneousMultiplicationMatrix_map _ σ d x.left.appTop.hom i.down).trans
      (LiftedHomogeneousMatrices.liftedHomogeneousMultiplicationMatrix_map R σ d (Scheme.ΓSpecIso R).inv.hom i.down).symm
  have h := GenerationAffinePointCriterion.grassmannGenerationOpen_affine_point_iff q k
    (fun i : ULift.{u} σ => LiftedHomogeneousMatrices.liftedHomogeneousMultiplicationMatrix.{u, v} Γ(M.left, ⊤) σ d i.down)
    (fun i => hF i.down) R f x
    (QuotientClassification.homogeneousLiftedQuotient.{u, v} σ d r R N)
    (QuotientClassification.homogeneousLiftedQuotient.{u, v} σ (d + 1) s R K)
    (hN.trans (QuotientClassification.homogeneousQuotientAffinePointEquiv_coordinates σ d r R f N))
    (hK.trans (QuotientClassification.homogeneousQuotientAffinePointEquiv_coordinates σ (d + 1) s R f K))
    (fun i : ULift.{u} σ => LiftedHomogeneousMatrices.liftedHomogeneousMultiplicationMatrix.{u, v} R σ d i.down) hcoeff
  rw [QuotientClassification.homogeneousLiftedQuotient_relations, QuotientClassification.homogeneousLiftedQuotient_relations, iSup_ulift] at h
  exact h.trans (LiftedGenerationConditions.liftedHomogeneous_generation_iff R σ d N.toSubmodule K.toSubmodule).symm

end

end OAI.AlgebraicGeometry.AbelianModuli.HilbertConstruction.Homogeneous.GenerationLocus
