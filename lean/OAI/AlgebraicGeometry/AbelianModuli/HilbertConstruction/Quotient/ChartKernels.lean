import OAI.AlgebraicGeometry.AbelianModuli.HilbertConstruction.Quotient.Charts
import Mathlib.LinearAlgebra.Basis.Basic

/-! # Chart Kernels -/

namespace OAI.AlgebraicGeometry.AbelianModuli.HilbertConstruction.Quotient.ChartKernels

noncomputable section

/-! Explicit generators of the kernels in quotient charts. -/

universe u v w t

variable {R : Type u} [Ring R] {U : Type v} {V : Type w}
  [AddCommGroup U] [AddCommGroup V] [Module R U] [Module R V]

/-- The kernel of a split projection is parametrized by the remaining summand. -/
def quotientKernelSection (L : V →ₗ[R] U) : V →ₗ[R] (U × V) :=
  (-L).prod LinearMap.id

theorem quotientKernelSection_range (L : V →ₗ[R] U) :
    (quotientKernelSection L).range = (LinearMap.id.coprod L).ker := by
  ext x
  constructor
  · rintro ⟨v, rfl⟩
    change -L v + L v = 0
    exact neg_add_cancel _
  · intro hx
    refine ⟨x.2, ?_⟩
    apply Prod.ext
    · change -L x.2 = x.1
      exact (eq_neg_of_add_eq_zero_left hx).symm
    · rfl

/-- Applying a linear map to a basis gives a spanning family of its image. -/
theorem linearMap_range_span_basis {ι : Type t} (b : Module.Basis ι R V) (f : V →ₗ[R] U) :
    f.range = Submodule.span R (Set.range (fun i => f (b i))) := by
  rw [LinearMap.range_eq_map, ← b.span_eq, Submodule.map_span, ← Set.range_comp]
  rfl

/-- The split-projection kernel is generated by the explicit vectors `(-L(bᵢ), bᵢ)`. -/
theorem quotientChart_kernel_span {ι : Type t} (b : Module.Basis ι R V) (L : V →ₗ[R] U) :
    (LinearMap.id.coprod L).ker =
      Submodule.span R (Set.range (fun i => (-L (b i), b i))) := by
  rw [← quotientKernelSection_range, linearMap_range_span_basis b]
  rfl

end

end OAI.AlgebraicGeometry.AbelianModuli.HilbertConstruction.Quotient.ChartKernels
