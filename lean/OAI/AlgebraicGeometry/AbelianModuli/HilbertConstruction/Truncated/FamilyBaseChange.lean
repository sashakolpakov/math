import OAI.AlgebraicGeometry.AbelianModuli.HilbertConstruction.Truncated.ProjectiveFamily
import OAI.AlgebraicGeometry.AbelianModuli.HilbertConstruction.Truncated.QuotientBaseChange
import OAI.AlgebraicGeometry.HilbertScheme.Presentations.Projective.BaseChange

/-! # Family Base Change -/

namespace OAI.AlgebraicGeometry.AbelianModuli.HilbertConstruction.Truncated

noncomputable section

/-! Projective families generated by finite quotient data commute with arbitrary coefficient changes. -/

open _root_.CategoryTheory _root_.AlgebraicGeometry
open OAI.AlgebraicGeometry.HilbertScheme.Presentations.Projective.BaseChange.GradedHilbert

universe u

variable {R : Type u} [CommRing R] {n B : ℕ} {r : ℕ → ℕ}
variable (D : GradedClassification.TruncatedGradedQuotientData R (Fin (n + 1)) B r)
variable (A : Type u) [CommRing A] [Algebra R A]

def GradedClassification.TruncatedGradedQuotientData.projectiveFamilyExtensionIso : (D.baseChange A).projectiveFamily ≅
    Over.mk (HilbertScheme.Presentations.Projective.Flatness.GradedHilbert.projectiveStructureMap (HilbertScheme.Presentations.Graded.Quotient.GradedHilbert.quotientGrading
      (HilbertScheme.Presentations.Graded.BaseChange.GradedHilbert.extendedHomogeneousIdeal (S := A) D.generatedIdeal))) :=
  eqToIso (congrArg (fun I : HomogeneousIdeal (HilbertScheme.Presentations.Hilbert.Polynomial.GradedHilbert.grading A n) =>
    Over.mk (HilbertScheme.Presentations.Projective.Flatness.GradedHilbert.projectiveStructureMap (HilbertScheme.Presentations.Graded.Quotient.GradedHilbert.quotientGrading I))) (D.baseChange_generatedIdeal A))

def GradedClassification.TruncatedGradedQuotientData.projectiveFamilyBaseChangeIso :
    (D.baseChange A).projectiveFamily ≅
      (Over.pullback (Spec.map (CommRingCat.ofHom (algebraMap R A)))).obj D.projectiveFamily :=
  D.projectiveFamilyExtensionIso A ≪≫
    Over.isoMk (HilbertScheme.Presentations.Projective.BaseChange.GradedHilbert.projectiveQuotientBaseChangeIso (S := A) D.generatedIdeal)
      ((HilbertScheme.Presentations.Projective.BaseChange.GradedHilbert.projectiveQuotient_isPullback (S := A) D.generatedIdeal).isoPullback_hom_snd)

end

end OAI.AlgebraicGeometry.AbelianModuli.HilbertConstruction.Truncated
