import OAI.AlgebraicGeometry.AbelianModuli.HilbertConstruction.Truncated.IdealExtension
import OAI.AlgebraicGeometry.AbelianModuli.HilbertConstruction.Projective.QuotientFinitePresentation
import OAI.AlgebraicGeometry.AbelianModuli.HilbertConstruction.Projective.SpaceReindex
import OAI.AlgebraicGeometry.AbelianModuli.HilbertConstruction.Closed.Families

/-! # Projective Family -/

namespace OAI.AlgebraicGeometry.AbelianModuli.HilbertConstruction.Truncated

noncomputable section

/-!
The homogeneous ideal generated by finite quotient data gives an actual
proper finitely presented closed projective scheme over the coefficient
ring. Eventual flatness of its degree quotients supplies a flat family.
-/

open _root_.CategoryTheory _root_.AlgebraicGeometry

universe u

variable {R : Type u} [CommRing R] {n B : ℕ} {r : ℕ → ℕ}
variable (D : GradedClassification.TruncatedGradedQuotientData R (Fin (n + 1)) B r)

def GradedClassification.TruncatedGradedQuotientData.projectiveFamily : Over (Spec (CommRingCat.of R)) :=
  Over.mk (HilbertScheme.Presentations.Projective.Flatness.GradedHilbert.projectiveStructureMap (HilbertScheme.Presentations.Graded.Quotient.GradedHilbert.quotientGrading D.generatedIdeal))

instance GradedClassification.TruncatedGradedQuotientData.projectiveFamily_proper : IsProper D.projectiveFamily.hom :=
  HilbertScheme.Presentations.Projective.Properness.GradedHilbert.projectiveQuotient_proper D.generatedIdeal

instance GradedClassification.TruncatedGradedQuotientData.projectiveFamily_locallyFinitePresentation : LocallyOfFinitePresentation D.projectiveFamily.hom :=
  Projective.QuotientFinitePresentation.projectiveQuotient_locallyFinitePresentation D.generatedIdeal D.generatedIdeal_fg

def GradedClassification.TruncatedGradedQuotientData.projectiveEmbedding : D.projectiveFamily ⟶ Projective.ProjectivePresentations.affineProjectiveSpace R n :=
  Over.homMk (HilbertScheme.Presentations.Projective.Quotient.GradedHilbert.projectiveQuotientInclusion D.generatedIdeal) (by
    change Proj.map (HilbertScheme.Presentations.Graded.Quotient.GradedHilbert.gradedQuotientMap D.generatedIdeal) (HilbertScheme.Presentations.Graded.Quotient.GradedHilbert.irrelevant_quotient_le_map D.generatedIdeal) ≫
      (Proj.toSpecZero (Projective.ProjectivePresentations.coordinateGrading R n) ≫
        Spec.map (CommRingCat.ofHom (Projective.ProjectivePresentations.degreeZeroConstants R n).toRingHom)) = _
    rw [Projective.SpaceReindex.degreeZeroConstants_eq_algebraMap]
    exact Projective.MapOverBase.projectiveMap_over_base _ _ (HilbertScheme.Presentations.Graded.Quotient.GradedHilbert.gradedQuotientMap D.generatedIdeal)
      (HilbertScheme.Presentations.Graded.Quotient.GradedHilbert.irrelevant_quotient_le_map D.generatedIdeal) (fun _ => rfl))

instance GradedClassification.TruncatedGradedQuotientData.projectiveEmbedding_closed : IsClosedImmersion D.projectiveEmbedding.left :=
  HilbertScheme.Presentations.Projective.Quotient.GradedHilbert.projectiveQuotientInclusion_isClosedImmersion D.generatedIdeal

theorem GradedClassification.TruncatedGradedQuotientData.projectiveFamily_flat (N : ℕ)
    (h : ∀ d ≥ N, Module.Flat R (HilbertScheme.Presentations.Hilbert.Polynomial.GradedHilbert.DegreeQuotient D.generatedIdeal.toIdeal d)) :
    Flat D.projectiveFamily.hom :=
  HilbertScheme.Presentations.Projective.Flatness.GradedHilbert.projectiveQuotient_flat_of_eventually_flat D.generatedIdeal N h

def GradedClassification.TruncatedGradedQuotientData.flatClosedFamily (N : ℕ)
    (h : ∀ d ≥ N, Module.Flat R (HilbertScheme.Presentations.Hilbert.Polynomial.GradedHilbert.DegreeQuotient D.generatedIdeal.toIdeal d)) :
    Closed.Families.FlatClosedFamily (Projective.ProjectivePresentations.affineProjectiveSpace R n) := by
  have := D.projectiveFamily_flat N h
  exact Closed.Families.FlatClosedFamily.ofEmbedding D.projectiveEmbedding

end

end OAI.AlgebraicGeometry.AbelianModuli.HilbertConstruction.Truncated
