import OAI.AlgebraicGeometry.AbelianModuli.HilbertConstruction.Truncated.IdealUniversality
import OAI.AlgebraicGeometry.HilbertScheme.Presentations.Graded.BaseChange

/-! # Quotient Base Change -/

namespace OAI.AlgebraicGeometry.AbelianModuli.HilbertConstruction.Truncated

noncomputable section

/-!
Finite compatible homogeneous quotient data extend over arbitrary coefficient
rings. The retained quotients are the expected tensor products, and the ideal
generated by the extended data is exactly the extended original ideal.
-/

open TensorProduct
open OAI.AlgebraicGeometry.HilbertScheme.Presentations.Graded.BaseChange.GradedHilbert

universe u v

variable {R : Type u} [CommRing R] {n B : ℕ} {r : ℕ → ℕ}
variable (D : GradedClassification.TruncatedGradedQuotientData R (Fin (n + 1)) B r)
variable (A : Type v) [CommRing A] [Algebra R A]
attribute [local instance] MvPolynomial.gradedAlgebra

theorem GradedClassification.TruncatedGradedQuotientData.retainedDegreeQuotient_projective (d : Fin (B + 1)) :
    Module.Projective R (HilbertScheme.Presentations.Hilbert.Polynomial.GradedHilbert.DegreeQuotient D.generatedIdeal.toIdeal d) := by
  change Module.Projective R (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) R d ⧸
    Homogeneous.IdealIncidence.homogeneousDegreeRelations D.generatedIdeal d)
  rw [D.generatedIdeal_degree]
  infer_instance

def GradedClassification.TruncatedGradedQuotientData.baseChangeQuotient (d : Fin (B + 1)) : Module.Grassmannian A (HilbertScheme.Presentations.Hilbert.Polynomial.GradedHilbert.grading A n d) (r d) := by
  have : Module.Projective R (HilbertScheme.Presentations.Hilbert.Polynomial.GradedHilbert.DegreeQuotient D.generatedIdeal.toIdeal d) :=
    D.retainedDegreeQuotient_projective d
  let e := HilbertScheme.Presentations.Graded.BaseChange.GradedHilbert.degreeQuotientBaseChangeEquiv (S := A) D.generatedIdeal d
  refine
    { toSubmodule := HilbertScheme.Presentations.Hilbert.Polynomial.GradedHilbert.degreeRelations (HilbertScheme.Presentations.Graded.BaseChange.GradedHilbert.extendedHomogeneousIdeal (S := A) D.generatedIdeal).toIdeal d
      finite_quotient := HilbertScheme.Presentations.Hilbert.Polynomial.GradedHilbert.degreeQuotient_finite _ _
      projective_quotient := Module.Projective.of_equiv e
      rankAtStalk_eq := ?_ }
  intro p
  have hr : Module.rankAtStalk (R := R) (HilbertScheme.Presentations.Hilbert.Polynomial.GradedHilbert.DegreeQuotient D.generatedIdeal.toIdeal d)
      (p.comap (algebraMap R A)) = r d := by
    change Module.rankAtStalk (R := R)
      (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) R d ⧸
        Homogeneous.IdealIncidence.homogeneousDegreeRelations D.generatedIdeal d) _ = _
    rw [D.generatedIdeal_degree]
    exact (D.quotient d).rankAtStalk_eq _
  exact (congrFun (Module.rankAtStalk_eq_of_equiv e) p).symm.trans
    ((Module.rankAtStalk_baseChange (R := R)
      (M := HilbertScheme.Presentations.Hilbert.Polynomial.GradedHilbert.DegreeQuotient D.generatedIdeal.toIdeal d) p).trans hr)

def GradedClassification.TruncatedGradedQuotientData.baseChange : GradedClassification.TruncatedGradedQuotientData A (Fin (n + 1)) B r where
  quotient := D.baseChangeQuotient A
  variable_mul d i := Homogeneous.IdealIncidence.homogeneousDegreeRelations_multiply
    (HilbertScheme.Presentations.Graded.BaseChange.GradedHilbert.extendedHomogeneousIdeal (S := A) D.generatedIdeal) d i

theorem GradedClassification.TruncatedGradedQuotientData.baseChange_generatedIdeal : (D.baseChange A).generatedIdeal =
    HilbertScheme.Presentations.Graded.BaseChange.GradedHilbert.extendedHomogeneousIdeal (S := A) D.generatedIdeal := by
  apply HomogeneousIdeal.ext
  apply le_antisymm
  · exact ((D.baseChange A).generatedIdeal_le_iff _).mpr (fun _ => le_rfl)
  · change Ideal.map (MvPolynomial.map (algebraMap R A)) D.generatedIdeal.toIdeal ≤ _
    apply Ideal.map_le_iff_le_comap.mpr
    rw [← D.generatedIdeal_generated]
    apply Ideal.span_le.mpr
    change D.generatedRelations.lowDegreeRelations B ≤
      ((D.baseChange A).generatedIdeal.toIdeal.comap
        (MvPolynomial.map (algebraMap R A))).restrictScalars R
    apply iSup_le
    intro d
    rintro _ ⟨p, hp, rfl⟩
    have hpI : p ∈ Homogeneous.IdealIncidence.homogeneousDegreeRelations D.generatedIdeal d := by
      change p ∈ D.extensionPiece d at hp
      rw [D.extensionPiece_retained d (Nat.le_of_lt_succ d.isLt)] at hp
      rw [D.generatedIdeal_degree]
      exact hp
    let p' : HilbertScheme.Presentations.Hilbert.Polynomial.GradedHilbert.grading A n d := ⟨MvPolynomial.map (algebraMap R A) p.val,
      p.property.map (algebraMap R A)⟩
    have hp' : p' ∈ ((D.baseChange A).quotient d).toSubmodule :=
      Ideal.mem_map_of_mem (MvPolynomial.map (algebraMap R A)) hpI
    have hpgen : p' ∈ Homogeneous.IdealIncidence.homogeneousDegreeRelations (D.baseChange A).generatedIdeal d := by
      rw [(D.baseChange A).generatedIdeal_degree]
      exact hp'
    exact hpgen

def GradedClassification.TruncatedGradedQuotientData.baseChangeDegreeEquiv (d : Fin (B + 1)) :
    A ⊗[R] HilbertScheme.Presentations.Hilbert.Polynomial.GradedHilbert.DegreeQuotient D.generatedIdeal.toIdeal d ≃ₗ[A]
      (HilbertScheme.Presentations.Hilbert.Polynomial.GradedHilbert.grading A n d ⧸ ((D.baseChange A).quotient d).toSubmodule) :=
  HilbertScheme.Presentations.Graded.BaseChange.GradedHilbert.degreeQuotientBaseChangeEquiv D.generatedIdeal d

end

end OAI.AlgebraicGeometry.AbelianModuli.HilbertConstruction.Truncated
