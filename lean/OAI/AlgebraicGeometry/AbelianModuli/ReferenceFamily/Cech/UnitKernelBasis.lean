import OAI.AlgebraicGeometry.AbelianModuli.ReferenceFamily.Cech.UnitFunctionEquiv

/-! # Unit Kernel Basis -/

namespace OAI.AlgebraicGeometry.AbelianModuli.ReferenceFamily.Cech.UnitKernelBasis.CechModelUnit

noncomputable section

/-! When the pulled-back family has only base functions, its Cech
degree-zero kernel is freely generated by the actual transported unit
cycle. This supplies the residue-kernel condition for contraction. -/

universe u
open _root_.CategoryTheory _root_.AlgebraicGeometry Opposite
open _root_.AlgebraicGeometry.Scheme.Modules

variable {X Y S T : Scheme.{u}} (a : Y ⟶ X) (f : X ⟶ S) (ρ : Y ⟶ T) (g : T ⟶ S)
  (h : a ≫ f = ρ ≫ g) {I : Type u} [LinearOrder I]
  (U : I → X.Opens) (hU : iSup U = ⊤)
  {D : CochainComplex (ModuleCat.{u} Γ(S, ⊤)) ℕ}
  (φ : D ⟶ SheafCohomology.Projective.OrderedBaseCech.Scheme.Modules.orderedBaseCechComplex f (SheafCohomology.Projective.Invertible.Scheme.Modules.unitObj X) U)
  [QuasiIsoAt φ 0] [QuasiIsoAt (Quotients.FiniteDescent.CechModelBaseChange.Construction.CechBaseChangeMap.modelMap a f ρ g h (SheafCohomology.Projective.Invertible.Scheme.Modules.unitObj X) U φ) 0]

def baseChangeUnitKernelMap : Γ(T, ⊤) →ₗ[Γ(T, ⊤)]
    ((((ModuleCat.extendScalars g.appTop.hom).mapHomologicalComplex
        (ComplexShape.up ℕ)).obj D).d 0 1).hom.ker :=
  LinearMap.toSpanSingleton Γ(T, ⊤) _ (Quotients.FiniteDescent.ModelOneTensor.Construction.CechBaseChangeMap.oneCycle g (ModelUnit.CechModelUnit.cycle f U hU φ))

theorem baseChangeUnitKernelMap_functions (r : Γ(T, ⊤)) :
    UnitFunctionEquiv.CechModelUnit.baseChangeFunctionsEquiv a f ρ g h U hU φ (baseChangeUnitKernelMap f g U hU φ r) =
      BaseStructureSections.baseStructureUnitMap ρ r := by
  change UnitFunctionEquiv.CechModelUnit.baseChangeFunctionsEquiv a f ρ g h U hU φ
    (r • Quotients.FiniteDescent.ModelOneTensor.Construction.CechBaseChangeMap.oneCycle g (ModelUnit.CechModelUnit.cycle f U hU φ)) =
      r • (show (SheafCohomology.Cech.SchemeModuleBaseBasic.Scheme.Modules.baseModulePresheaf ρ (SheafCohomology.Projective.Invertible.Scheme.Modules.unitObj Y)).obj (op ⊤) from (1 : Γ(Y, ⊤)))
  rw [(UnitFunctionEquiv.CechModelUnit.baseChangeFunctionsEquiv a f ρ g h U hU φ).map_smul,
    UnitFunctionEquiv.CechModelUnit.baseChangeFunctionsEquiv_unit a f ρ g h U hU φ]

include h in
theorem baseChangeUnitKernelMap_bijective [IsIso ρ.appTop] :
    Function.Bijective (baseChangeUnitKernelMap f g U hU φ) := by
  let e := UnitFunctionEquiv.CechModelUnit.baseChangeFunctionsEquiv a f ρ g h U hU φ
  let u := baseChangeUnitKernelMap f g U hU φ
  have he (r : Γ(T, ⊤)) : e (u r) = BaseStructureSections.baseStructureUnitMap ρ r :=
    baseChangeUnitKernelMap_functions a f ρ g h U hU φ r
  constructor
  · intro x y hxy
    apply (BaseStructureSections.baseStructureUnitMap_bijective ρ).injective
    exact (he x).symm.trans ((congrArg e hxy).trans (he y))
  · intro v
    obtain ⟨r, hr⟩ := (BaseStructureSections.baseStructureUnitMap_bijective ρ).surjective (e v)
    exact ⟨r, e.injective ((he r).trans hr)⟩

end

end OAI.AlgebraicGeometry.AbelianModuli.ReferenceFamily.Cech.UnitKernelBasis.CechModelUnit
