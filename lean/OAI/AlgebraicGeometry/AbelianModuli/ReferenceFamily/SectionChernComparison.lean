import OAI.AlgebraicGeometry.AbelianModuli.ReferenceFamily.Intrinsic.SectionCoordinates
import OAI.AlgebraicGeometry.AbelianModuli.ReferenceFamily.SectionFrameEvaluation
import OAI.AlgebraicGeometry.AbelianModuli.ReferenceFamily.Frame.ChernComparison
import OAI.AlgebraicGeometry.ComplexMultiplication.HodgeComparison.IntrinsicProjectiveCharts
import OAI.AlgebraicGeometry.ComplexMultiplication.HodgeComparison.ProjectiveChernCocycle

/-! # Section Chern Comparison -/

namespace OAI.AlgebraicGeometry.AbelianModuli.ReferenceFamily.SectionChernComparison

noncomputable section

/-! The original rational Chern class of a line bundle generated by
sections is the original projective logarithmic class of its actual
native section morphism. All coordinate and frame comparisons are proved. -/

open _root_.CategoryTheory _root_.AlgebraicGeometry
open scoped _root_.Manifold ContDiff

theorem nativeSectionCoordinates_holomorphic (V : Foundations.Scheme.IntegralProjective.IntegralProjectiveVariety)
    {M : V.toOver.left.Modules} {n : ℕ}
    (s : Fin (n + 1) → (HilbertConstruction.Line.Bundles.structureModule V.toOver.left ⟶ M))
    (hs : ∀ x : V.toOver.left, ∃ i, x ∈ HilbertConstruction.Ample.LineBundles.sectionNonvanishing (s i)) (i : Fin (n + 1)) :
    ContMDiffOn 𝓘(ℂ, V.analyticModel) 𝓘(ℂ, Fin (n + 1) → ℂ) ∞
      (Geometry.ComplexTorus.RiemannProjectivity.ProjectivityCriterion.Construction.projectivePullbackChart (Intrinsic.SectionCoordinates.nativeSectionCoordinates V.toOver s hs) i)
      (ComplexMultiplication.HodgeComparison.ProjectiveGluing.CM.Construction.projectiveLiftDomain (Intrinsic.SectionCoordinates.nativeSectionCoordinates V.toOver s hs)
        (Intrinsic.SectionCoordinates.nativeSectionCoordinates_continuous V.toOver s hs) i : Set V.analyticSpace) := by
  have : IsIntegral V.toOver.left := V.property
  have : Smooth V.toOver.hom := V.presentation.smooth
  have : IsIntegral (Over.mk (Foundations.Scheme.ProjectiveSpace.projectiveSpaceToBase n)).left := ComplexMultiplication.HodgeComparison.ProjectiveScheme.CM.Construction.projectiveScheme_integral n
  have : Smooth (Over.mk (Foundations.Scheme.ProjectiveSpace.projectiveSpaceToBase n)).hom := Albanese.Construction.ProjectiveCover.projectiveSpace_smooth n
  let : ChartedSpace (ComplexMultiplication.HodgeComparison.ProjectiveScheme.CM.Construction.projectiveSpaceVariety n).analyticModel (ComplexPoints.Analytic.ProjectiveScheme.projectiveSchemeComplexPoints n) :=
    (ComplexMultiplication.HodgeComparison.ProjectiveScheme.CM.Construction.projectiveSpaceVariety n).analyticSpace_chartedSpace
  have h : ContMDiff 𝓘(ℂ, V.analyticModel) 𝓘(ℂ, (ComplexMultiplication.HodgeComparison.ProjectiveScheme.CM.Construction.projectiveSpaceVariety n).analyticModel) ∞
      (ComplexPoints.Analytic.SchemePointHomeomorphs.schemeComplexPoints.map (Intrinsic.SectionMorphism.nativeSectionMorphism V.toOver s hs)) :=
    ComplexPoints.Analytic.IntrinsicSmoothSchemeMaps.contMDiff_nativeScheme_map (Intrinsic.SectionMorphism.nativeSectionMorphism V.toOver s hs) ∞
  exact (ComplexMultiplication.HodgeComparison.IntrinsicProjectiveCharts.CM.Construction.projectiveCoordinates_holomorphic n i).comp h.contMDiffOn (fun _ hx => hx)

theorem lineBundleChernClass_sectionMorphism (V : Foundations.Scheme.IntegralProjective.IntegralProjectiveVariety)
    (L : HilbertConstruction.Line.Bundles.LineBundle V.toOver.left) {n : ℕ}
    (s : Fin (n + 1) → (HilbertConstruction.Line.Bundles.structureModule V.toOver.left ⟶ L.sheaf))
    (hs : ∀ x : V.toOver.left, ∃ i, x ∈ HilbertConstruction.Ample.LineBundles.sectionNonvanishing (s i)) :
    Intrinsic.ChernClasses.lineBundleChernClass V.presentation L =
      ComplexMultiplication.HodgeComparison.ProjectiveChernCocycle.CM.Construction.projectiveLogarithmicClassQ (Intrinsic.SectionCoordinates.nativeSectionCoordinates V.toOver s hs)
        (Intrinsic.SectionCoordinates.nativeSectionCoordinates_continuous V.toOver s hs) (nativeSectionCoordinates_holomorphic V s hs) := by
  let p := Intrinsic.SectionCoordinates.nativeSectionCoordinates V.toOver s hs
  let hp := Intrinsic.SectionCoordinates.nativeSectionCoordinates_continuous V.toOver s hs
  let hh := nativeSectionCoordinates_holomorphic V s hs
  let U := ComplexMultiplication.HodgeComparison.ProjectiveChernCocycle.CM.Construction.projectiveChernCover p hp hh
  let r (a : V.analyticSpace × Fin (n + 1)) := SectionLocalFrames.sectionLocalFrame (s a.2)
  have hr : ∀ a, U a ≤ AnalyticFrameTransitions.frameAnalyticOpen V.presentation (r a) := by
    intro a x hx
    exact (Intrinsic.SectionCoordinates.nativeSectionCoordinates_inPatch V.presentation s hs a.2 x).mp
      ((ComplexMultiplication.HodgeComparison.ProjectiveLogarithmicCover.CM.Construction.projectiveLogRefinement p hp hh).subset a hx)
  apply Frame.ChernComparison.firstChernClass_eq_frameLogs (Intrinsic.ChernClasses.nativeLineBundle V.presentation L)
    U (ComplexMultiplication.HodgeComparison.ProjectiveLogarithmicCover.CM.Construction.projectiveLogRefinement p hp hh).covers r hr (ComplexMultiplication.HodgeComparison.ProjectiveChernCocycle.CM.Construction.projectiveLogCech p hp hh)
    (ComplexMultiplication.HodgeComparison.ProjectiveChernCocycle.CM.Construction.projectiveLogCech_cocycle p hp hh)
  intro a x
  exact (ComplexMultiplication.HodgeComparison.ProjectiveChernCocycle.CM.Construction.projectiveLogCech_exp p hp hh a x).trans
    ((Intrinsic.SectionCoordinates.nativeSectionCoordinates_ratio V.presentation s hs (a 0).2 (a 1).2 x.val
      (hr (a 0) (AlgebraicTopology.DeRham.Comparison.SmoothCech.cechIntersection_le U a 0 x.property))).trans
        (SectionFrameEvaluation.sectionFrame_pointTransition V.presentation (s (a 0).2) (s (a 1).2) x.val
          (hr (a 0) (AlgebraicTopology.DeRham.Comparison.SmoothCech.cechIntersection_le U a 0 x.property))
          (hr (a 1) (AlgebraicTopology.DeRham.Comparison.SmoothCech.cechIntersection_le U a 1 x.property))).symm)

end

end OAI.AlgebraicGeometry.AbelianModuli.ReferenceFamily.SectionChernComparison
