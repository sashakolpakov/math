import OAI.AlgebraicGeometry.AbelianModuli.ReferenceFamily.RankThreeEmbeddingCoordinates
import OAI.AlgebraicGeometry.ComplexMultiplication.EmbeddingHodgeType

/-! # Embedding Hodge Criterion -/

namespace OAI.AlgebraicGeometry.AbelianModuli.ReferenceFamily.EmbeddingHodgeCriterion

noncomputable section

section

/-! The Hodge decomposition restricts to each actual number-field
embedding space when the field preserves Hodge type. -/

open OAI.AlgebraicGeometry.ComplexMultiplication.EmbeddingHodgeType.CM

def submoduleComapSwap {K V : Type*} [Field K] [AddCommGroup V] [Module K V]
    (P Q : Submodule K V) : P.comap Q.subtype ≃ₗ[K] Q.comap P.subtype where
  toFun u := ⟨⟨u.val.val, u.property⟩, u.val.property⟩
  invFun u := ⟨⟨u.val.val, u.property⟩, u.val.property⟩
  left_inv _ := rfl
  right_inv _ := rfl
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

variable {E U : Type*} [Field E] [NumberField E] [Algebra ℚ E]
    [AddCommGroup U] [Module ℚ U] [Module E U] [IsScalarTower ℚ E U]
    (H : ComplexMultiplication.WeightOne.CM.WeightOneHodgeStructure U)
    (hact : ∀ a : E, ComplexMultiplication.WeightOne.CM.IsHodgeMap H H (ComplexMultiplication.WeightOne.CM.scalarEndomorphism E a))

include hact

omit [NumberField E] [IsScalarTower ℚ E U] in
theorem embeddingSpace_holomorphicProjection (σ : E →ₐ[ℚ] ℂ)
    (u : ComplexMultiplication.WeightOne.CM.Complexification U) (hu : u ∈ ComplexMultiplication.EmbeddingDecomposition.CM.embeddingSpace E U σ) :
    H.holomorphic.projection H.antiholomorphic H.complementary u ∈ ComplexMultiplication.EmbeddingDecomposition.CM.embeddingSpace E U σ := by
  apply (ComplexMultiplication.EmbeddingDecomposition.CM.mem_embeddingSpace E U σ _).mpr
  intro a
  rw [← ComplexMultiplication.EmbeddingHodgeType.CM.projection_commutes_of_preserves H.complementary
    ((ComplexMultiplication.WeightOne.CM.scalarEndomorphism E a).baseChange ℂ) (hact a)
    (fun x hx => (hact a).map_antiholomorphic hx),
    (ComplexMultiplication.EmbeddingDecomposition.CM.mem_embeddingSpace E U σ u).mp hu a, map_smul]

omit [NumberField E] [IsScalarTower ℚ E U] in
theorem embeddingSpace_hodge_isCompl (σ : E →ₐ[ℚ] ℂ) :
    IsCompl (H.holomorphic.comap (ComplexMultiplication.EmbeddingDecomposition.CM.embeddingSpace E U σ).subtype)
      (H.antiholomorphic.comap (ComplexMultiplication.EmbeddingDecomposition.CM.embeddingSpace E U σ).subtype) := by
  constructor
  · apply Submodule.disjoint_def.mpr
    intro u hu hv
    apply Subtype.ext
    exact (Submodule.disjoint_def.mp H.complementary.disjoint) u.val hu hv
  · apply codisjoint_iff_le_sup.mpr
    intro u _
    let p := H.holomorphic.projection H.antiholomorphic H.complementary u.val
    have hp : p ∈ ComplexMultiplication.EmbeddingDecomposition.CM.embeddingSpace E U σ := embeddingSpace_holomorphicProjection H hact σ u.val u.property
    have hq : u.val - p ∈ ComplexMultiplication.EmbeddingDecomposition.CM.embeddingSpace E U σ := (ComplexMultiplication.EmbeddingDecomposition.CM.embeddingSpace E U σ).sub_mem u.property hp
    apply Submodule.mem_sup.mpr
    refine ⟨⟨p, hp⟩, Submodule.projection_apply_mem H.complementary u.val,
      ⟨u.val - p, hq⟩, Submodule.sub_projection_mem H.complementary u.val, ?_⟩
    apply Subtype.ext
    change p + (u.val - p) = u.val
    abel

omit [NumberField E] [IsScalarTower ℚ E U] in
theorem embeddingSpace_hodge_finrank (σ : E →ₐ[ℚ] ℂ) :
    Module.finrank ℂ ((ComplexMultiplication.EmbeddingDecomposition.CM.embeddingSpace E U σ).comap H.holomorphic.subtype) +
      Module.finrank ℂ ((ComplexMultiplication.EmbeddingDecomposition.CM.embeddingSpace E U σ).comap H.antiholomorphic.subtype) =
        Module.finrank ℂ (ComplexMultiplication.EmbeddingDecomposition.CM.embeddingSpace E U σ) := by
  let : Module.Finite ℚ U := H.finiteDimensional
  have h := Submodule.finrank_add_eq_of_isCompl (embeddingSpace_hodge_isCompl H hact σ)
  have hp := (submoduleComapSwap H.holomorphic (ComplexMultiplication.EmbeddingDecomposition.CM.embeddingSpace E U σ)).finrank_eq
  have hq := (submoduleComapSwap H.antiholomorphic (ComplexMultiplication.EmbeddingDecomposition.CM.embeddingSpace E U σ)).finrank_eq
  exact (congrArg₂ (· + ·) hp.symm hq.symm).trans h

end

/-! A rank-three Hodge structure is generated by its intersections with
the actual field-embedding spaces. Testing a rational map on those
intersections therefore suffices to prove that it is a Hodge map. -/

open OAI.AlgebraicGeometry.ComplexMultiplication.EmbeddingHodgeType.CM

variable (E : Type*) [Field E] [NumberField E] [Algebra ℚ E]
    {U : Type*} [AddCommGroup U] [Module ℚ U] [Module E U] [IsScalarTower ℚ E U]
    (e : U ≃ₗ[E] (Fin 3 → E))

def rankThreeEmbeddingComponent (σ : E →ₐ[ℚ] ℂ) (u : ComplexMultiplication.WeightOne.CM.Complexification U) : ComplexMultiplication.WeightOne.CM.Complexification U := by
  classical
  exact (RankThreeEmbeddingCoordinates.rankThreeComplexCoordinates E e).symm
    (Pi.single σ (RankThreeEmbeddingCoordinates.rankThreeComplexCoordinates E e u σ))

theorem rankThreeEmbeddingComponent_mem (σ : E →ₐ[ℚ] ℂ) (u : ComplexMultiplication.WeightOne.CM.Complexification U) :
    rankThreeEmbeddingComponent E e σ u ∈ ComplexMultiplication.EmbeddingDecomposition.CM.embeddingSpace E U σ := by
  classical
  exact ((RankThreeEmbeddingCoordinates.rankThreeEmbeddingSpaceEquiv E e σ).symm (RankThreeEmbeddingCoordinates.rankThreeComplexCoordinates E e u σ)).property

theorem rankThreeEmbeddingComponents_sum (u : ComplexMultiplication.WeightOne.CM.Complexification U) :
    ∑ σ : E →ₐ[ℚ] ℂ, rankThreeEmbeddingComponent E e σ u = u := by
  classical
  apply (RankThreeEmbeddingCoordinates.rankThreeComplexCoordinates E e).injective
  rw [map_sum]
  simp only [rankThreeEmbeddingComponent, LinearEquiv.apply_symm_apply]
  ext σ i
  simp [Pi.single_apply, ite_apply]

include e in
theorem isHodgeMap_of_embedding_intersections
    (H : ComplexMultiplication.WeightOne.CM.WeightOneHodgeStructure U)
    (hact : ∀ a : E, ComplexMultiplication.WeightOne.CM.IsHodgeMap H H (ComplexMultiplication.WeightOne.CM.scalarEndomorphism E a))
    {V : Type*} [AddCommGroup V] [Module ℚ V] (K : ComplexMultiplication.WeightOne.CM.WeightOneHodgeStructure V)
    (f : U →ₗ[ℚ] V)
    (hf : ∀ (σ : E →ₐ[ℚ] ℂ) (u : ComplexMultiplication.WeightOne.CM.Complexification U),
      u ∈ ComplexMultiplication.EmbeddingDecomposition.CM.embeddingSpace E U σ → u ∈ H.holomorphic → f.baseChange ℂ u ∈ K.holomorphic) :
    ComplexMultiplication.WeightOne.CM.IsHodgeMap H K f := by
  classical
  intro u hu
  let p := H.holomorphic.projection H.antiholomorphic H.complementary
  have hs : ∑ σ : E →ₐ[ℚ] ℂ, p (rankThreeEmbeddingComponent E e σ u) = u :=
    (map_sum p _ _).symm.trans
      ((congrArg p (rankThreeEmbeddingComponents_sum E e u)).trans
        (Submodule.projection_apply_of_mem_left H.complementary hu))
  have hm : f.baseChange ℂ (∑ σ : E →ₐ[ℚ] ℂ, p (rankThreeEmbeddingComponent E e σ u)) ∈
      K.holomorphic := by
    rw [map_sum]
    apply Submodule.sum_mem
    intro σ _
    exact hf σ _ (embeddingSpace_holomorphicProjection H hact σ _
      (rankThreeEmbeddingComponent_mem E e σ u))
      (Submodule.projection_apply_mem H.complementary _)
  exact (congrArg (fun x => f.baseChange ℂ x ∈ K.holomorphic) hs).mp hm

end

end OAI.AlgebraicGeometry.AbelianModuli.ReferenceFamily.EmbeddingHodgeCriterion
