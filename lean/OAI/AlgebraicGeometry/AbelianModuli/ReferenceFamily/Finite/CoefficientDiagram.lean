import Mathlib.Algebra.Category.Ring.FilteredColimits
import Mathlib.Algebra.Category.Ring.Colimits
import Mathlib.CategoryTheory.Limits.Types.Filtered
import Mathlib.CategoryTheory.Category.Preorder
import Mathlib.RingTheory.FiniteType

/-! # Coefficient Diagram -/

namespace OAI.AlgebraicGeometry.AbelianModuli.ReferenceFamily.Finite.CoefficientDiagram

noncomputable section

/-! Every coefficient algebra is the actual filtered colimit of the
subalgebras generated by its finite sets of elements. -/

open _root_.CategoryTheory _root_.CategoryTheory.Limits

universe u
variable (k R : Type u) [CommRing k] [CommRing R] [Algebra k R]

def finiteCoefficientRing (s : Finset R) : Subalgebra k R := Algebra.adjoin k (s : Set R)

instance finiteCoefficientRing_finiteType (s : Finset R) :
    Algebra.FiniteType k (finiteCoefficientRing k R s) :=
  Algebra.FiniteType.adjoin_of_finite s.finite_toSet

instance finiteCoefficientRing_noetherian [IsNoetherianRing k] (s : Finset R) :
    IsNoetherianRing (finiteCoefficientRing k R s) := Algebra.FiniteType.isNoetherianRing k _

def finiteCoefficientDiagram : Finset R ⥤ CommRingCat.{u} where
  obj s := .of (finiteCoefficientRing k R s)
  map {s t} f := CommRingCat.ofHom (Subalgebra.inclusion
    (Algebra.adjoin_mono (show (s : Set R) ⊆ (t : Set R) from leOfHom f))).toRingHom
  map_id _ := by ext; rfl
  map_comp _ _ := by ext; rfl

def finiteCoefficientCocone : Cocone (finiteCoefficientDiagram k R) where
  pt := .of R
  ι := {
    app s := CommRingCat.ofHom (finiteCoefficientRing k R s).val.toRingHom
    naturality := by intro s t f; ext; rfl }

def finiteCoefficientCocone_isColimit : IsColimit (finiteCoefficientCocone k R) := by
  classical
  let : ReflectsColimit (finiteCoefficientDiagram k R) (forget CommRingCat) :=
    reflectsColimit_of_reflectsIsomorphisms _ _
  apply isColimitOfReflects (forget CommRingCat)
  apply Types.FilteredColimit.isColimitOf'
  · intro x
    change R at x
    refine ⟨{x}, ⟨x, Algebra.subset_adjoin (Finset.mem_singleton_self x)⟩, rfl⟩
  · intro i x y h
    refine ⟨i, 𝟙 i, ?_⟩
    exact Subtype.ext h

end

end OAI.AlgebraicGeometry.AbelianModuli.ReferenceFamily.Finite.CoefficientDiagram
