import OAI.AlgebraicGeometry.AbelianModuli.ReferenceFamily.Tensor.UnitKernel
import OAI.AlgebraicGeometry.AbelianModuli.ReferenceFamily.DetectedKernelContraction

/-! # Unit Kernel Basis -/

namespace OAI.AlgebraicGeometry.AbelianModuli.ReferenceFamily.Tensor.UnitKernelBasis

noncomputable section

/-! A degree-zero unit contraction makes the actual tensor kernel
freely generated by the unit after every coefficient-ring extension. -/

open scoped TensorProduct

variable {R A M N : Type} [CommRing R] [CommRing A] [Algebra R A]
  [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
  (d : M →ₗ[R] N) (u : R →ₗ[R] M) (hd : d.comp u = 0)

theorem tensorUnitKernelMap_bijective_of_injective_exact
    (hu : Function.Injective (u.lTensor A))
    (hex : (d.lTensor A).ker = (u.lTensor A).range) :
    Function.Bijective (UnitKernel.tensorUnitKernelMap (A := A) d u hd) := by
  let e := TensorProduct.AlgebraTensorModule.rid R A A
  constructor
  · intro a b hab
    apply e.symm.injective
    apply hu
    exact (UnitKernel.tensorUnitKernelMap_factor d u hd a).symm.trans
      ((congrArg Subtype.val hab).trans (UnitKernel.tensorUnitKernelMap_factor d u hd b))
  · intro x
    have hx : x.val ∈ (d.lTensor A).ker := x.property
    obtain ⟨y, hy⟩ := (show x.val ∈ (u.lTensor A).range from hex ▸ hx)
    refine ⟨e y, Subtype.ext ?_⟩
    exact (UnitKernel.tensorUnitKernelMap_factor d u hd (e y)).trans
      ((congrArg (u.lTensor A) (e.symm_apply_apply y)).trans hy)

theorem tensorUnitKernelMap_bijective_of_contraction
    (s : M →ₗ[R] R) (v : N →ₗ[R] M)
    (hs : s.comp u = LinearMap.id) (hv : v.comp d + u.comp s = LinearMap.id) :
    Function.Bijective (UnitKernel.tensorUnitKernelMap (A := A) d u hd) := by
  have hsu := congrArg (fun f : Module.End R R => f.lTensor A) hs
  rw [LinearMap.lTensor_comp, LinearMap.lTensor_id] at hsu
  have hu : Function.Injective (u.lTensor A) :=
    Function.HasLeftInverse.injective ⟨s.lTensor A, fun x => LinearMap.congr_fun hsu x⟩
  apply tensorUnitKernelMap_bijective_of_injective_exact d u hd hu
  ext x
  constructor
  · intro hx
    exact ⟨s.lTensor A x, (DetectedKernelContraction.kernel_contraction_tensor d s u v hv A x hx).symm⟩
  · rintro ⟨y, rfl⟩
    have hdu := congrArg (fun f : R →ₗ[R] N => f.lTensor A) hd
    rw [LinearMap.lTensor_comp, LinearMap.lTensor_zero] at hdu
    exact LinearMap.congr_fun hdu y

end

end OAI.AlgebraicGeometry.AbelianModuli.ReferenceFamily.Tensor.UnitKernelBasis
