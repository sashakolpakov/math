import OAI.AlgebraicGeometry.SheafCohomology.Projective.PolynomialChartFrameCoefficient

/-! # Chart Polynomial Map -/

namespace OAI.AlgebraicGeometry.SheafCohomology.Projective.ChartPolynomialMap.Dimension

noncomputable section

/-! Every affine projective chart is generated by dehomogenized coordinate polynomials. -/

open _root_.CategoryTheory _root_.CategoryTheory.Limits _root_.AlgebraicGeometry _root_.MvPolynomial

universe u

variable {R : Type u} [CommRing R] {σ : Type} [Fintype σ]
attribute [local instance] MvPolynomial.gradedAlgebra

def singleProjectiveChartTuple (j : σ) : Fin 1 → ULift.{u} σ := fun _ => ⟨j⟩

omit [Fintype σ] in
theorem singleProjectiveChartIntersection (j : σ) :
    StandardCech.MvPolynomial.coordinateOpenCechIntersection (R := R) (singleProjectiveChartTuple j) =
      MvPolynomialClosure.MvPolynomial.coordinateOpen (R := R) j := by
  rw [show StandardCech.MvPolynomial.coordinateOpenCechIntersection (R := R) (singleProjectiveChartTuple j) =
      ⨅ k : Fin 1, StandardCech.MvPolynomial.coordinateOpenCover (R := R) (singleProjectiveChartTuple j k) from
    (IsLimit.conePointUniqueUpToIso (limit.isLimit _) (Preorder.isLimitIInf _)).to_eq]
  simp only [singleProjectiveChartTuple, StandardCech.MvPolynomial.coordinateOpenCover, iInf_const]

omit [Fintype σ] in
theorem singleProjectiveChartCoefficient_bijective (j : σ) :
    Function.Bijective (PolynomialChartFrameCoefficient.MvPolynomial.coordinateChartCoefficientRingHom (R := R)
      (singleProjectiveChartTuple j)) := by
  let U := MvPolynomialClosure.MvPolynomial.coordinateOpen (R := R) j
  let V := StandardCech.MvPolynomial.coordinateOpenCechIntersection (R := R) (singleProjectiveChartTuple j)
  let h : V ≤ U := StandardCech.MvPolynomial.coordinateOpenCechIntersection_le (singleProjectiveChartTuple j) 0
  have hh : IsIso (homOfLE h) := by
    have he : homOfLE h = (eqToIso (singleProjectiveChartIntersection (R := R) j)).hom :=
      Subsingleton.elim _ _
    rw [he]
    infer_instance
  exact (StandardCech.MvPolynomial.coordinateOpenCechIntersectionBaseLaurentRingEquiv (R := R)
    (singleProjectiveChartTuple j)).bijective.comp
      (ConcreteCategory.bijective_of_isIso
        ((Proj (homogeneousSubmodule σ R)).presheaf.map (homOfLE h).op))

def singleProjectiveChartCoefficientEquiv (j : σ) :
    Γ(Proj (homogeneousSubmodule σ R), MvPolynomialClosure.MvPolynomial.coordinateOpen (R := R) j) ≃+*
      AddMonoidAlgebra Γ(Spec (.of R), ⊤)
        (LaurentExponentLocalization.MvPolynomial.laurentExponentSubmonoid (StandardIntersectionRing.MvPolynomial.coordinateTailExponent (fun _ : Fin 1 => j))) :=
  RingEquiv.ofBijective (PolynomialChartFrameCoefficient.MvPolynomial.coordinateChartCoefficientRingHom (R := R)
    (singleProjectiveChartTuple j)) (singleProjectiveChartCoefficient_bijective j)

theorem singleProjectiveChartExponent_surjective (j : σ) :
    Function.Surjective (PolynomialChartMap.MvPolynomial.polynomialChartExponent (fun _ : Fin 1 => j)) := by
  classical
  intro e
  have hn (i : {i : σ // i ≠ j}) : 0 ≤ e.val i := by
    by_contra h
    have hh := e.property i (lt_of_not_ge h)
    apply hh
    simp only [StandardIntersectionRing.MvPolynomial.coordinateTailExponent, Finset.univ_eq_empty, Finset.sum_empty,
      Finsupp.zero_apply]
  let d : σ →₀ ℕ := Finsupp.equivFunOnFinite.symm
    (fun k => if h : k ≠ j then (e.val ⟨k, h⟩).toNat else 0)
  refine ⟨d, ?_⟩
  apply Subtype.ext
  ext i
  change ((d i.val : ℕ) : ℤ) = e.val i
  simp only [d, Finsupp.coe_equivFunOnFinite_symm, dite_eq_left i.property]
  exact Int.toNat_of_nonneg (hn i)

theorem singleProjectivePolynomialChart_surjective (j : σ) :
    Function.Surjective (PolynomialChartMap.MvPolynomial.polynomialChartRingHom Γ(Spec (.of R), ⊤)
      (fun _ : Fin 1 => j)) := by
  intro p
  obtain ⟨q, hq⟩ := Finsupp.mapDomain_surjective
    (M := Γ(Spec (.of R), ⊤)) (singleProjectiveChartExponent_surjective j) p.coeff
  refine ⟨AddMonoidAlgebra.ofCoeff q, ?_⟩
  apply AddMonoidAlgebra.coeff_injective
  exact hq

def projectiveChartPolynomialMap (j : σ) :
    MvPolynomial σ Γ(Spec (.of R), ⊤) →+*
      Γ(Proj (homogeneousSubmodule σ R), MvPolynomialClosure.MvPolynomial.coordinateOpen (R := R) j) :=
  (singleProjectiveChartCoefficientEquiv (R := R) j).symm.toRingHom.comp
    (PolynomialChartMap.MvPolynomial.polynomialChartRingHom Γ(Spec (.of R), ⊤) (fun _ : Fin 1 => j))

theorem projectiveChartPolynomialMap_surjective (j : σ) :
    Function.Surjective (projectiveChartPolynomialMap (R := R) j) :=
  (singleProjectiveChartCoefficientEquiv (R := R) j).symm.surjective.comp
    (singleProjectivePolynomialChart_surjective j)

theorem projectiveChartPolynomialMap_anchor (j : σ) :
    projectiveChartPolynomialMap (R := R) j (X j) = 1 := by
  classical
  have he : PolynomialChartMap.MvPolynomial.polynomialChartExponent (fun _ : Fin 1 => j) (Finsupp.single j 1) = 0 := by
    apply Subtype.ext
    ext i
    simp [PolynomialChartMap.MvPolynomial.polynomialChartExponent, Finsupp.single_eq_of_ne i.property]
  apply (singleProjectiveChartCoefficientEquiv (R := R) j).injective
  change (singleProjectiveChartCoefficientEquiv (R := R) j)
      ((singleProjectiveChartCoefficientEquiv (R := R) j).symm _) = _
  rw [RingEquiv.apply_symm_apply, map_one]
  change PolynomialChartMap.MvPolynomial.polynomialChartRingHom Γ(Spec (.of R), ⊤) (fun _ : Fin 1 => j)
    (monomial (Finsupp.single j 1) 1) = 1
  rw [PolynomialChartMap.MvPolynomial.polynomialChartRingHom_monomial, he]
  rfl

theorem projectiveChartPolynomialMap_section [LinearOrder σ] (j : σ) (n : ℕ)
    (x : Γ(TwistPowers.MvPolynomial.coordinateHyperplanePoleSheafPower (R := R) j n, ⊤)) :
    projectiveChartPolynomialMap (R := R) j
      (DegreeZeroPolynomials.MvPolynomial.coordinateTwistGlobalSectionsLinearEquivPolynomials (R := R) j n x).val =
    FrameSections.overTrivializationCoefficient (TwistPowers.MvPolynomial.coordinateHyperplanePoleSheafPower (R := R) j n)
      (MvPolynomialClosure.MvPolynomial.coordinateOpen (R := R) j) (PositivePowerChartGenerator.MvPolynomial.coordinateHyperplanePoleSheafPowerOverFrame j j n) x := by
  let a : OrderedBaseCech.Scheme.Modules.OrderedCechIndex (ULift.{u} σ) 0 :=
    ⟨singleProjectiveChartTuple j, fun i k hik => False.elim (by omega)⟩
  apply (singleProjectiveChartCoefficientEquiv (R := R) j).injective
  change (singleProjectiveChartCoefficientEquiv (R := R) j)
      ((singleProjectiveChartCoefficientEquiv (R := R) j).symm _) = _
  rw [RingEquiv.apply_symm_apply]
  exact PolynomialChartFrameCoefficient.MvPolynomial.coordinateTwistPolynomial_chartCoefficientRingHom j n x a

theorem projectiveChartPolynomialMap_section_symm [LinearOrder σ] (j : σ) (n : ℕ)
    (p : homogeneousSubmodule σ Γ(Spec (.of R), ⊤) n) :
    projectiveChartPolynomialMap (R := R) j p.val =
    FrameSections.overTrivializationCoefficient (TwistPowers.MvPolynomial.coordinateHyperplanePoleSheafPower (R := R) j n)
      (MvPolynomialClosure.MvPolynomial.coordinateOpen (R := R) j) (PositivePowerChartGenerator.MvPolynomial.coordinateHyperplanePoleSheafPowerOverFrame j j n)
      ((DegreeZeroPolynomials.MvPolynomial.coordinateTwistGlobalSectionsLinearEquivPolynomials (R := R) j n).symm p) := by
  obtain ⟨x, rfl⟩ := (DegreeZeroPolynomials.MvPolynomial.coordinateTwistGlobalSectionsLinearEquivPolynomials (R := R) j n).surjective p
  rw [LinearEquiv.symm_apply_apply]
  exact projectiveChartPolynomialMap_section j n x

end

end OAI.AlgebraicGeometry.SheafCohomology.Projective.ChartPolynomialMap.Dimension
