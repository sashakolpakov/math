import OAI.AlgebraicGeometry.ComplexMultiplication.CMProjectiveCharts
import Mathlib.AlgebraicGeometry.ProjectiveSpectrum.Functor
import Mathlib.RingTheory.MvPolynomial.Ideal

/-! # Projective Chart Naturality -/

namespace OAI.AlgebraicGeometry.ComplexMultiplication.ProjectiveChartNaturality.ProjectiveCharts

noncomputable section

section

/-! # Actual coefficient maps between projective spaces

The graded coefficient map preserves all homogeneous coordinates. The variables
generate the actual irrelevant ideal, so it induces a genuine scheme morphism
on Proj. This is a step towards comparing the two projective presentations.
-/

open _root_.CategoryTheory _root_.AlgebraicGeometry

variable (R S : Type) [CommRing R] [CommRing S]

/-- Positive homogeneous polynomials lie in the actual ideal of variables. -/
theorem positive_homogeneous_mem_coordinateIdeal (n d : ℕ) (hd : 0 < d)
    (f : CMProjectiveCharts.ProjectiveCharts.homogeneousCoordinateRing R n) (hf : f ∈ CMProjectiveCharts.ProjectiveCharts.projectiveGrading R n d) :
    f ∈ Ideal.span (Set.range (MvPolynomial.X : Fin (n + 1) → CMProjectiveCharts.ProjectiveCharts.homogeneousCoordinateRing R n)) := by
  have hpow : f ∈ MvPolynomial.idealOfVars (Fin (n + 1)) R ^ 1 := by
    rw [MvPolynomial.mem_pow_idealOfVars_iff]
    intro m hm
    have hdeg : m.degree = d := by
      simpa only [Finsupp.degree_eq_weight_one, Pi.one_def] using
        hf (MvPolynomial.mem_support_iff.mp hm)
    simpa only [hdeg] using (Nat.succ_le_iff.mpr hd)
  simpa only [pow_one] using hpow

/-- The irrelevant ideal of the actual polynomial grading is generated by the variables. -/
theorem projective_irrelevant_eq_coordinateIdeal (n : ℕ) :
    (HomogeneousIdeal.irrelevant (CMProjectiveCharts.ProjectiveCharts.projectiveGrading R n)).toIdeal =
      Ideal.span (Set.range (MvPolynomial.X : Fin (n + 1) → CMProjectiveCharts.ProjectiveCharts.homogeneousCoordinateRing R n)) := by
  apply le_antisymm
  · apply (HomogeneousIdeal.toIdeal_irrelevant_le (CMProjectiveCharts.ProjectiveCharts.projectiveGrading R n)).mpr
    intro d hd f hf
    exact positive_homogeneous_mem_coordinateIdeal R n d hd f hf
  · rw [Ideal.span_le]
    rintro f ⟨i, rfl⟩
    exact HomogeneousIdeal.mem_irrelevant_of_mem (CMProjectiveCharts.ProjectiveCharts.projectiveGrading R n) (by decide : 0 < 1)
      (MvPolynomial.isHomogeneous_X R i)

/-- The coefficient homomorphism is a homomorphism of the original total-degree gradings. -/
def gradedCoefficientMap (φ : R →+* S) (n : ℕ) :
    CMProjectiveCharts.ProjectiveCharts.projectiveGrading R n →+*ᵍ CMProjectiveCharts.ProjectiveCharts.projectiveGrading S n where
  __ := MvPolynomial.map φ
  map_mem hf := hf.map φ

@[simp]
theorem gradedCoefficientMap_X (φ : R →+* S) (n : ℕ) (i : Fin (n + 1)) :
    gradedCoefficientMap R S φ n (MvPolynomial.X i) = MvPolynomial.X i :=
  MvPolynomial.map_X φ i

/-- Every positive-degree target coordinate comes from its original source coordinate. -/
theorem irrelevant_le_map_gradedCoefficientMap (φ : R →+* S) (n : ℕ) :
    HomogeneousIdeal.irrelevant (CMProjectiveCharts.ProjectiveCharts.projectiveGrading S n) ≤
      (HomogeneousIdeal.irrelevant (CMProjectiveCharts.ProjectiveCharts.projectiveGrading R n)).map
        (gradedCoefficientMap R S φ n) := by
  change (HomogeneousIdeal.irrelevant (CMProjectiveCharts.ProjectiveCharts.projectiveGrading S n)).toIdeal ≤
    ((HomogeneousIdeal.irrelevant (CMProjectiveCharts.ProjectiveCharts.projectiveGrading R n)).map
      (gradedCoefficientMap R S φ n)).toIdeal
  rw [HomogeneousIdeal.toIdeal_map, projective_irrelevant_eq_coordinateIdeal,
    projective_irrelevant_eq_coordinateIdeal, Ideal.map_span]
  simp only [← Set.range_comp, Function.comp_def, gradedCoefficientMap_X]
  exact le_rfl

/-- The genuine contravariant coefficient map between the actual projective schemes. -/
def projectiveCoefficientMap (φ : R →+* S) (n : ℕ) :
    Proj (CMProjectiveCharts.ProjectiveCharts.projectiveGrading S n) ⟶ Proj (CMProjectiveCharts.ProjectiveCharts.projectiveGrading R n) :=
  Proj.map (gradedCoefficientMap R S φ n)
    (irrelevant_le_map_gradedCoefficientMap R S φ n)

/-- The inverse image of the original standard chart is the same target standard chart. -/
theorem projectiveCoefficientMap_preimage_coordinate (φ : R →+* S) (n : ℕ)
    (i : Fin (n + 1)) :
    projectiveCoefficientMap R S φ n ⁻¹ᵁ
      Proj.basicOpen (CMProjectiveCharts.ProjectiveCharts.projectiveGrading R n) (MvPolynomial.X i) =
        Proj.basicOpen (CMProjectiveCharts.ProjectiveCharts.projectiveGrading S n) (MvPolynomial.X i) := by
  rw [projectiveCoefficientMap, Proj.map_preimage_basicOpen, gradedCoefficientMap_X]

end

/-! # Coefficient change in the actual homogeneous projective charts -/

open _root_.MvPolynomial _root_.HomogeneousLocalization OAI.AlgebraicGeometry.Foundations.Scheme.DehomogenizationC.Algebraic.Dehomogenization

variable (R S : Type) [CommRing R] [CommRing S]

/-- Coefficient change on the original degree-zero homogeneous localization. -/
def projectiveChartCoefficientMap (φ : R →+* S) (n : ℕ) (i : Fin (n + 1)) :
    CMProjectiveCharts.ProjectiveCharts.projectiveChartRing R n i →+* CMProjectiveCharts.ProjectiveCharts.projectiveChartRing S n i :=
  HomogeneousLocalization.map (gradedCoefficientMap R S φ n) <| by
    rintro _ ⟨k, rfl⟩
    exact ⟨k, by simp⟩

/-- Coefficient change sends each actual homogeneous fraction to the corresponding fraction. -/
theorem projectiveChartCoefficientMap_mk (φ : R →+* S) (n : ℕ) (i : Fin (n + 1))
    (k : ℕ) (f : CMProjectiveCharts.ProjectiveCharts.homogeneousCoordinateRing R n)
    (hf : f ∈ CMProjectiveCharts.ProjectiveCharts.projectiveGrading R n (k • (1 : ℕ))) :
    projectiveChartCoefficientMap R S φ n i
      (Away.mk (CMProjectiveCharts.ProjectiveCharts.projectiveGrading R n) (CMProjectiveCharts.ProjectiveCharts.projectiveVariable_homogeneous R n i) k f hf) =
        Away.mk (CMProjectiveCharts.ProjectiveCharts.projectiveGrading S n) (CMProjectiveCharts.ProjectiveCharts.projectiveVariable_homogeneous S n i)
          k (MvPolynomial.map φ f) (hf.map φ) := by
  simp only [projectiveChartCoefficientMap, Away.mk, HomogeneousLocalization.map_mk]
  congr 1
  apply NumDenSameDeg.ext
  · rfl
  · rfl
  · dsimp only
    rw [map_pow, gradedCoefficientMap_X]

/-- Actual dehomogenization commutes with change of coefficient ring. -/
theorem dehomogenize_map (φ : R →+* S) (n : ℕ) (i : Fin (n + 1))
    (f : CMProjectiveCharts.ProjectiveCharts.homogeneousCoordinateRing R n) :
    Foundations.Scheme.DehomogenizationC.Algebraic.Dehomogenization.dehomogenize (R := S) i (MvPolynomial.map φ f) =
      MvPolynomial.map φ (Foundations.Scheme.DehomogenizationC.Algebraic.Dehomogenization.dehomogenize (R := R) i f) := by
  have h : (Foundations.Scheme.DehomogenizationC.Algebraic.Dehomogenization.dehomogenize (R := S) i).comp (MvPolynomial.map φ) =
      (MvPolynomial.map φ).comp (Foundations.Scheme.DehomogenizationC.Algebraic.Dehomogenization.dehomogenize (R := R) i) := by
    apply MvPolynomial.ringHom_ext
    · intro r
      simp
    · intro j
      by_cases hji : j = i
      · subst j
        simp
      · simp [hji]
  exact DFunLike.congr_fun h f

/-- The proved chart equivalences identify the genuine coefficient map with polynomial
coefficient change, retaining the original homogeneous fractions. -/
theorem projectiveChartCoefficientMap_dehomogenizes (φ : R →+* S) (n : ℕ)
    (i : Fin (n + 1)) (c : CMProjectiveCharts.ProjectiveCharts.projectiveChartRing R n i) :
    CMProjectiveCharts.ProjectiveCharts.projectiveChartRingEquiv S n i (projectiveChartCoefficientMap R S φ n i c) =
      MvPolynomial.map φ (CMProjectiveCharts.ProjectiveCharts.projectiveChartRingEquiv R n i c) := by
  obtain ⟨k, f, hf, rfl⟩ := Away.mk_surjective (CMProjectiveCharts.ProjectiveCharts.projectiveGrading R n)
    (CMProjectiveCharts.ProjectiveCharts.projectiveVariable_homogeneous R n i) c
  rw [projectiveChartCoefficientMap_mk]
  simp only [CMProjectiveCharts.ProjectiveCharts.projectiveChartRingEquiv_apply]
  rw [CMProjectiveCharts.ProjectiveCharts.projectiveChartToPolynomial_mk S n i k (MvPolynomial.map φ f) (hf.map φ),
    CMProjectiveCharts.ProjectiveCharts.projectiveChartToPolynomial_mk R n i k f hf]
  exact dehomogenize_map R S φ n i f

end

end OAI.AlgebraicGeometry.ComplexMultiplication.ProjectiveChartNaturality.ProjectiveCharts
