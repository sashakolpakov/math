import OAI.AlgebraicGeometry.Crystalline.Cohomology.WittPolynomial.BasePowers
import OAI.AlgebraicGeometry.Crystalline.Cohomology.PrincipalBase
import OAI.AlgebraicGeometry.Crystalline.Cohomology.PD.EnvelopeDp

/-! # Base Envelope -/

namespace OAI.AlgebraicGeometry.Crystalline.Cohomology.WittPolynomial.BaseEnvelope.WittPolynomialBaseEnvelope

noncomputable section

/-!
# The actual relative PD envelope of the polynomial base ideal is the polynomial ring

Because the ideal is generated by the Witt-base element p, the base
divided-power compatibility forces every target map to preserve its
polynomial divided powers. The original envelope universal property
then gives the two inverse algebra maps.
-/

universe u

variable (p : ℕ) [Fact p.Prime] (k σ : Type u) [Field k] [CharP k p]

local notation "W" => WittVector p k
local notation "P" => MvPolynomial σ W
local notation "I₀" => Ideal.span {(p : W)}
local notation "δ₀" => OAI.AlgebraicGeometry.Crystalline.Cohomology.Witt.DividedPowers.WittDividedPowers.wittDividedPowers p k
local notation "I" => OAI.AlgebraicGeometry.Crystalline.Cohomology.WittPolynomial.BasePowers.WittPolynomialBasePowers.ideal p k σ
local notation "δ" => OAI.AlgebraicGeometry.Crystalline.Cohomology.WittPolynomial.BasePowers.WittPolynomialBasePowers.dividedPowers p k σ
local notation "E" => OAI.AlgebraicGeometry.Crystalline.Cohomology.PD.EnvelopeDp.PDEnvelope.Envelope W P I₀ δ₀ I

omit [CharP k p] in
theorem base_contains : (I₀).map (algebraMap W P) ≤ I := (BasePowers.WittPolynomialBasePowers.base_ideal p k σ).le

def target : PD.EnvelopeDp.PDEnvelope.Target W P I₀ δ₀ I where
  ring := CommRingCat.of P
  ideal := I
  dp := δ
  contains := by
    change (I).map (RingHom.id P) ≤ I
    rw [Ideal.map_id]
  baseDP := by
    change DividedPowers.IsDPMorphism δ₀ δ ((RingHom.id P).comp (algebraMap W P))
    rw [RingHom.id_comp]
    exact BasePowers.WittPolynomialBasePowers.base_isDPMorphism p k σ

theorem ofAlgebra_isDPMorphism : DividedPowers.IsDPMorphism δ
    (PD.EnvelopeDp.PDEnvelope.dividedPowers W P I₀ δ₀ I) (PD.EnvelopeDp.PDEnvelope.ofAlgebra W P I₀ δ₀ I) :=
  PrincipalBase.PrincipalBasePDMorphism.isDPMorphism W P E I₀ δ₀ (p : W)
    (Ideal.subset_span (Set.mem_singleton _)) δ (PD.EnvelopeDp.PDEnvelope.ideal W P I₀ δ₀ I)
    (PD.EnvelopeDp.PDEnvelope.dividedPowers W P I₀ δ₀ I) (PD.EnvelopeDp.PDEnvelope.ofAlgebra W P I₀ δ₀ I)
    (BasePowers.WittPolynomialBasePowers.base_isDPMorphism p k σ)
    (PD.EnvelopeDp.PDEnvelope.base_isDPMorphism W P I₀ δ₀ I (base_contains p k σ))

def retraction : E →ₐ[P] P := PD.EnvelopeDp.PDEnvelope.lift W P I₀ δ₀ I (target p k σ)

theorem retraction_ofAlgebra (a : P) :
    retraction p k σ (PD.EnvelopeDp.PDEnvelope.ofAlgebra W P I₀ δ₀ I a) = a :=
  PD.EnvelopeDp.PDEnvelope.evaluate_ofAlgebra W P I₀ δ₀ I (target p k σ) a

theorem ofAlgebra_retraction : (Algebra.ofId P E).comp (retraction p k σ) = AlgHom.id P E := by
  let T := PD.EnvelopeDp.PDEnvelope.envelopeTarget W P I₀ δ₀ I (base_contains p k σ)
  have hr : DividedPowers.IsDPMorphism (PD.EnvelopeDp.PDEnvelope.dividedPowers W P I₀ δ₀ I)
      (PD.EnvelopeDp.PDEnvelope.dividedPowers W P I₀ δ₀ I) ((Algebra.ofId P E).comp (retraction p k σ)).toRingHom :=
    (ofAlgebra_isDPMorphism p k σ).comp _ (PD.EnvelopeDp.PDEnvelope.evaluate_isDPMorphism W P I₀ δ₀ I (target p k σ))
  have hi : DividedPowers.IsDPMorphism (PD.EnvelopeDp.PDEnvelope.dividedPowers W P I₀ δ₀ I)
      (PD.EnvelopeDp.PDEnvelope.dividedPowers W P I₀ δ₀ I) (AlgHom.id P E).toRingHom := by
    refine ⟨?_, ?_⟩
    · exact le_of_eq (Ideal.map_id _)
    · intro n a ha
      rfl
  exact (PD.EnvelopeDp.PDEnvelope.lift_unique W P I₀ δ₀ I T _ hr).trans
    (PD.EnvelopeDp.PDEnvelope.lift_unique W P I₀ δ₀ I T _ hi).symm

def equiv : E ≃ₐ[P] P :=
  AlgEquiv.ofAlgHom (retraction p k σ) (Algebra.ofId P E)
    (AlgHom.ext (retraction_ofAlgebra p k σ)) (ofAlgebra_retraction p k σ)

end

end OAI.AlgebraicGeometry.Crystalline.Cohomology.WittPolynomial.BaseEnvelope.WittPolynomialBaseEnvelope
