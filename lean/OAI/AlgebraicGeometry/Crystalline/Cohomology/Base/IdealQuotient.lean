import Mathlib.RingTheory.Ideal.Quotient.Operations
import Mathlib.RingTheory.Derivation.Basic

/-! # Ideal Quotient -/

namespace OAI.AlgebraicGeometry.Crystalline.Cohomology.Base.IdealQuotient.BaseIdealQuotient

noncomputable section

/-!
# Linear operations modulo ideals extended from the base

Every base-linear map preserves the submodule generated by a base ideal.
In particular, derivations and linear primitives descend to these quotients.
-/

universe u

variable {R A B C : Type u} [CommRing R] [CommRing A] [CommRing B] [CommRing C]
  [Algebra R A] [Algebra R B] [Algebra R C] (L : Ideal R)

theorem map_mem (f : A →ₗ[R] B) {a : A} (ha : a ∈ L.map (algebraMap R A)) :
    f a ∈ L.map (algebraMap R B) := by
  have hf := Submodule.smul_top_le_comap_smul_top L f
  rw [Ideal.smul_top_eq_map, Ideal.smul_top_eq_map] at hf
  exact hf ha

def map (f : A →ₗ[R] B) :
    (A ⧸ L.map (algebraMap R A)) →ₗ[R] (B ⧸ L.map (algebraMap R B)) :=
  Submodule.mapQ ((L.map (algebraMap R A)).restrictScalars R)
    ((L.map (algebraMap R B)).restrictScalars R) f (fun _ ha => map_mem L f ha)

@[simp] theorem map_mk (f : A →ₗ[R] B) (a : A) :
    BaseIdealQuotient.map L f (Ideal.Quotient.mk (L.map (algebraMap R A)) a) =
      Ideal.Quotient.mk (L.map (algebraMap R B)) (f a) := rfl

theorem map_comp (f : A →ₗ[R] B) (g : B →ₗ[R] C) :
    (BaseIdealQuotient.map L g).comp (BaseIdealQuotient.map L f) = BaseIdealQuotient.map L (g.comp f) := by
  apply LinearMap.ext
  intro a
  obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective a
  rfl

theorem derivation_stable (d : Derivation R A A) (a : A)
    (ha : Ideal.Quotient.mk (L.map (algebraMap R A)) a = 0) :
    Ideal.Quotient.mk (L.map (algebraMap R A)) (d a) = 0 :=
  Ideal.Quotient.eq_zero_iff_mem.mpr
    (map_mem L d.toLinearMap (Ideal.Quotient.eq_zero_iff_mem.mp ha))

def derivation (d : Derivation R A A) :
    Derivation R (A ⧸ L.map (algebraMap R A)) (A ⧸ L.map (algebraMap R A)) :=
  Derivation.liftOfSurjective (f := Ideal.Quotient.mkₐ R (L.map (algebraMap R A)))
    Ideal.Quotient.mk_surjective (derivation_stable L d)

@[simp] theorem derivation_mk (d : Derivation R A A) (a : A) :
    derivation L d (Ideal.Quotient.mk (L.map (algebraMap R A)) a) =
      Ideal.Quotient.mk (L.map (algebraMap R A)) (d a) :=
  Derivation.liftOfSurjective_apply (f := Ideal.Quotient.mkₐ R (L.map (algebraMap R A)))
    Ideal.Quotient.mk_surjective (derivation_stable L d) a

end

end OAI.AlgebraicGeometry.Crystalline.Cohomology.Base.IdealQuotient.BaseIdealQuotient
