import OAI.AlgebraicGeometry.Crystalline.Cohomology.AlgebraicForms
import Mathlib.LinearAlgebra.Finsupp.LSum
import Mathlib.Algebra.Homology.ShortComplex.HomologicalComplex
import Mathlib.Algebra.Category.ModuleCat.Abelian

/-! # De Rham Presentation To -/

namespace OAI.AlgebraicGeometry.Crystalline.Cohomology.DeRhamPresentationTo.DeRhamPresentation

noncomputable section

/-!
# Cohomology: generators and relations for the algebraic de Rham complex

An `n`-form is generated by `a₀ da₁ ∧... ∧ daₙ`. The relations impose
additivity, the Leibniz rule, vanishing on base-ring constants, and alternation.
These are algebraic definitions independent of the crystalline comparison.
-/

open _root_.CategoryTheory

universe u

variable (R A : Type u) [CommRing R] [CommRing A] [Algebra R A]

abbrev Raw (n : ℕ) := (Fin n → A) →₀ A

/-- The defining relations for the differential factors. -/
inductive RelationIndex (n : ℕ)
  | add (v : Fin n → A) (i : Fin n) (x y : A)
  | mul (v : Fin n → A) (i : Fin n) (x y : A)
  | base (v : Fin n → A) (i : Fin n) (r : R)
  | alt (v : Fin n → A) (i j : Fin n) (hij : v i = v j) (hne : i ≠ j)

def relation (n : ℕ) : RelationIndex R A n → Raw A n
  | .add v i x y =>
      Finsupp.single (Function.update v i (x + y)) 1 -
        Finsupp.single (Function.update v i x) 1 - Finsupp.single (Function.update v i y) 1
  | .mul v i x y =>
      Finsupp.single (Function.update v i (x * y)) 1 -
        Finsupp.single (Function.update v i y) x - Finsupp.single (Function.update v i x) y
  | .base v i r => Finsupp.single (Function.update v i (algebraMap R A r)) 1
  | .alt v _ _ _ _ => Finsupp.single v 1

def relations (n : ℕ) : Submodule A (Raw A n) :=
  Submodule.span A (Set.range (relation R A n))

/-- Differential forms in their universal generators-and-relations presentation. -/
abbrev Form (n : ℕ) := Raw A n ⧸ relations R A n

def symbol {n : ℕ} (a : A) (v : Fin n → A) : Form R A n :=
  (relations R A n).mkQ (Finsupp.single v a)

@[simp]
theorem symbol_zero {n : ℕ} (v : Fin n → A) : symbol R A 0 v = 0 := by
  simp [symbol]

theorem symbol_smul_one {n : ℕ} (a : A) (v : Fin n → A) :
    symbol R A a v = a • symbol R A 1 v := by
  change (relations R A n).mkQ (Finsupp.single v a) =
    a • (relations R A n).mkQ (Finsupp.single v 1)
  rw [← (relations R A n).mkQ.map_smul]
  congr 1
  simp only [Finsupp.smul_single, smul_eq_mul, mul_one]

theorem relation_zero {n : ℕ} (r : RelationIndex R A n) :
    (relations R A n).mkQ (relation R A n r) = 0 := by
  exact Submodule.Quotient.mk_eq_zero _ |>.mpr (Submodule.subset_span (Set.mem_range_self r))

theorem symbol_update_add {n : ℕ} (v : Fin n → A) (i : Fin n) (x y : A) :
    symbol R A 1 (Function.update v i (x + y)) =
      symbol R A 1 (Function.update v i x) + symbol R A 1 (Function.update v i y) := by
  have h := relation_zero R A (.add v i x y)
  change (relations R A n).mkQ (_ - _ - _) = 0 at h
  rw [map_sub, map_sub, sub_sub, sub_eq_zero] at h
  exact h

theorem symbol_update_mul {n : ℕ} (v : Fin n → A) (i : Fin n) (x y : A) :
    symbol R A 1 (Function.update v i (x * y)) =
      x • symbol R A 1 (Function.update v i y) +
        y • symbol R A 1 (Function.update v i x) := by
  have h := relation_zero R A (.mul v i x y)
  change (relations R A n).mkQ (_ - _ - _) = 0 at h
  rw [map_sub, map_sub, sub_sub, sub_eq_zero] at h
  change symbol R A 1 (Function.update v i (x * y)) =
    symbol R A x (Function.update v i y) + symbol R A y (Function.update v i x) at h
  rw [symbol_smul_one R A x _, symbol_smul_one R A y _] at h
  exact h

@[simp]
theorem symbol_update_base {n : ℕ} (v : Fin n → A) (i : Fin n) (r : R) :
    symbol R A 1 (Function.update v i (algebraMap R A r)) = 0 :=
  relation_zero R A (.base v i r)

theorem symbol_alt {n : ℕ} (v : Fin n → A) (i j : Fin n)
    (hij : v i = v j) (hne : i ≠ j) : symbol R A 1 v = 0 :=
  relation_zero R A (.alt v i j hij hne)

/-- The universal alternating `R`-multilinear differential symbol. -/
def symbols (n : ℕ) : AlternatingMap R A (Form R A n) (Fin n) where
  toFun v := symbol R A 1 v
  map_update_add' := by
    intro dec
    cases Subsingleton.elim dec (instDecidableEqFin n)
    exact symbol_update_add R A
  map_update_smul' := by
    intro dec
    cases Subsingleton.elim dec (instDecidableEqFin n)
    intro v i r x
    rw [Algebra.smul_def, symbol_update_mul, symbol_update_base, smul_zero, add_zero,
      algebraMap_smul]
  map_eq_zero_of_eq' := symbol_alt R A

@[simp]
theorem symbols_apply (n : ℕ) (v : Fin n → A) : symbols R A n v = symbol R A 1 v := rfl

/-- The derivative of one generator, linear in its coefficient over `R`. -/
def generatorDifferential {n : ℕ} (v : Fin n → A) : A →ₗ[R] Form R A (n + 1) where
  toFun a := symbols R A (n + 1) (Fin.cons a v)
  map_add' a b := by
    simpa using (symbols R A (n + 1)).map_update_add (Fin.cons 0 v) 0 a b
  map_smul' r a := by
    simpa using (symbols R A (n + 1)).map_update_smul (Fin.cons 0 v) 0 r a

/-- Exterior differentiation before quotienting the source relations. -/
def rawDifferential (n : ℕ) : Raw A n →ₗ[R] Form R A (n + 1) :=
  Finsupp.lsum R (generatorDifferential R A)

@[simp]
theorem rawDifferential_single {n : ℕ} (a : A) (v : Fin n → A) :
    rawDifferential R A n (Finsupp.single v a) = symbol R A 1 (Fin.cons a v) := by
  change Finsupp.lsum R (generatorDifferential R A) (Finsupp.single v a) = _
  rw [Finsupp.lsum_single]
  rfl

@[simp]
theorem symbol_cons_one {n : ℕ} (v : Fin n → A) :
    symbol R A 1 (Fin.cons 1 v) = 0 := by
  simpa using symbol_update_base R A (Fin.cons 0 v) 0 1

theorem symbol_cons_mul {n : ℕ} (a b : A) (v : Fin n → A) :
    symbol R A 1 (Fin.cons (a * b) v) =
      a • symbol R A 1 (Fin.cons b v) + b • symbol R A 1 (Fin.cons a v) := by
  simpa using symbol_update_mul R A (Fin.cons 0 v) 0 a b

/-- The two cross terms in the differentiated Leibniz relation cancel. -/
theorem cross_symbols {n : ℕ} (v : Fin n → A) (i : Fin n) (x y : A) :
    symbol R A 1 (Fin.cons x (Function.update v i y)) +
      symbol R A 1 (Fin.cons y (Function.update v i x)) = 0 := by
  have hne : (0 : Fin (n + 1)) ≠ i.succ := by
    intro h
    exact Nat.succ_ne_zero i.val (congrArg Fin.val h).symm
  have hswap :
      (Fin.cons x (Function.update v i y)) ∘ Equiv.swap 0 i.succ =
        Fin.cons y (Function.update v i x) := by
    funext j
    refine Fin.cases ?_ (fun j => ?_) j
    · simp
    · by_cases hj : j = i
      · subst j
        simp [hne]
      · simp [Equiv.swap_apply_def, hj]
  have h := (symbols R A (n + 1)).map_add_swap
    (Fin.cons x (Function.update v i y)) hne
  simpa only [hswap, symbols_apply] using h

/-- The raw differential annihilates every scalar multiple of a defining relation. -/
theorem rawDifferential_smul_relation {n : ℕ} (a : A) (r : RelationIndex R A n) :
    rawDifferential R A n (a • relation R A n r) = 0 := by
  cases r with
  | add v i x y =>
    simp only [relation, smul_sub, Finsupp.smul_single, smul_eq_mul, mul_one,
      map_sub, rawDifferential_single, Fin.cons_update]
    rw [symbol_update_add, add_sub_cancel_left, sub_self]
  | mul v i x y =>
    simp only [relation, smul_sub, Finsupp.smul_single, smul_eq_mul, mul_one,
      map_sub, rawDifferential_single]
    rw [symbol_cons_mul, symbol_cons_mul]
    rw [Fin.cons_update, symbol_update_mul]
    rw [← Fin.cons_update, ← Fin.cons_update]
    have hc := congrArg (fun z : Form R A (n + 1) => a • z) (cross_symbols R A v i x y)
    rw [smul_add, smul_zero] at hc
    calc
      _ = -(a • symbol R A 1 (Fin.cons x (Function.update v i y)) +
        a • symbol R A 1 (Fin.cons y (Function.update v i x))) := by abel
      _ = 0 := by rw [hc, neg_zero]
  | base v i r =>
    simp only [relation, Finsupp.smul_single, smul_eq_mul, mul_one,
      rawDifferential_single, Fin.cons_update]
    exact symbol_update_base R A _ _ _
  | alt v i j hij hne =>
    simp only [relation, Finsupp.smul_single, smul_eq_mul, mul_one, rawDifferential_single]
    exact symbol_alt R A (Fin.cons a v) i.succ j.succ (by simpa using hij)
      (fun h => hne (Fin.succ_injective n h))

theorem rawDifferential_relations {n : ℕ} (f : Raw A n) (hf : f ∈ relations R A n) :
    rawDifferential R A n f = 0 := by
  suffices h : ∀ a : A, rawDifferential R A n (a • f) = 0 by simpa using h 1
  induction hf using Submodule.span_induction with
  | mem f hf => obtain ⟨r, rfl⟩ := hf; exact fun a => rawDifferential_smul_relation R A a r
  | zero => simp
  | add f g hf hg ihf ihg => intro a; simp only [smul_add, map_add, ihf, ihg, zero_add]
  | smul b f hf ih => intro a; simpa only [smul_smul] using ih (a * b)

/-- The exterior differential induced on the universal forms. -/
def differential (n : ℕ) : Form R A n →ₗ[R] Form R A (n + 1) :=
  ((relations R A n).restrictScalars R).liftQ (rawDifferential R A n)
    (fun f hf => rawDifferential_relations R A f hf)

@[simp]
theorem differential_symbol {n : ℕ} (a : A) (v : Fin n → A) :
    differential R A n (symbol R A a v) = symbol R A 1 (Fin.cons a v) :=
  rawDifferential_single R A a v

/-- Exterior differentiation squares to zero in every degree. -/
theorem differential_square (n : ℕ) (ω : Form R A n) :
    differential R A (n + 1) (differential R A n ω) = 0 := by
  obtain ⟨f, rfl⟩ := Submodule.mkQ_surjective (relations R A n) ω
  induction f using Finsupp.induction_linear with
  | zero => simp
  | add f g hf hg => simp only [map_add, hf, hg, zero_add]
  | single v a =>
    change differential R A (n + 1) (differential R A n (symbol R A a v)) = 0
    simp

/-- The algebraic de Rham complex in the explicit presentation. -/
def complex : CochainComplex (ModuleCat.{u} R) ℕ :=
  CochainComplex.of (fun n => ModuleCat.of R (Form R A n))
    (fun n => ModuleCat.ofHom (differential R A n))
    (fun n => ModuleCat.hom_ext (LinearMap.ext (differential_square R A n)))

/-- Interpret the differential symbols in the usual exterior power of
Kähler differentials. -/
def exteriorSymbol (n : ℕ) (v : Fin n → A) : ⋀[A]^n Ω[A⁄R] :=
  exteriorPower.ιMulti A n (fun i => KaehlerDifferential.D R A (v i))

theorem derivation_tuple_update {n : ℕ} (v : Fin n → A) (i : Fin n) (a : A) :
    (fun j => KaehlerDifferential.D R A (Function.update v i a j)) =
      Function.update (fun j => KaehlerDifferential.D R A (v j)) i
        (KaehlerDifferential.D R A a) := by
  funext j
  by_cases h : j = i <;> simp [h]

theorem exteriorSymbol_update_add {n : ℕ} (v : Fin n → A) (i : Fin n) (a b : A) :
    exteriorSymbol R A n (Function.update v i (a + b)) =
      exteriorSymbol R A n (Function.update v i a) +
        exteriorSymbol R A n (Function.update v i b) := by
  simp only [exteriorSymbol, derivation_tuple_update, map_add, AlternatingMap.map_update_add]

theorem exteriorSymbol_update_mul {n : ℕ} (v : Fin n → A) (i : Fin n) (a b : A) :
    exteriorSymbol R A n (Function.update v i (a * b)) =
      a • exteriorSymbol R A n (Function.update v i b) +
        b • exteriorSymbol R A n (Function.update v i a) := by
  simp only [exteriorSymbol, derivation_tuple_update, Derivation.leibniz,
    AlternatingMap.map_update_add, AlternatingMap.map_update_smul]

theorem exteriorSymbol_update_base {n : ℕ} (v : Fin n → A) (i : Fin n) (r : R) :
    exteriorSymbol R A n (Function.update v i (algebraMap R A r)) = 0 := by
  simp [exteriorSymbol, derivation_tuple_update]

theorem relation_toExterior {n : ℕ} (r : RelationIndex R A n) :
    Finsupp.linearCombination A (exteriorSymbol R A n) (relation R A n r) = 0 := by
  cases r with
  | add v i a b =>
    simp [relation, exteriorSymbol_update_add]
  | mul v i a b =>
    simp [relation, exteriorSymbol_update_mul]
  | base v i r =>
    simp [relation, exteriorSymbol_update_base]
  | alt v i j hij hne =>
    simp only [relation, Finsupp.linearCombination_single, one_smul, exteriorSymbol]
    exact (exteriorPower.ιMulti A n).map_eq_zero_of_eq _
      (congrArg (KaehlerDifferential.D R A) hij) hne

/-- The canonical map from the presentation to exterior Kähler forms. -/
def toExterior (n : ℕ) : Form R A n →ₗ[A] ⋀[A]^n Ω[A⁄R] :=
  (relations R A n).liftQ (Finsupp.linearCombination A (exteriorSymbol R A n)) (by
    apply Submodule.span_le.mpr
    rintro _ ⟨r, rfl⟩
    exact relation_toExterior R A r)

@[simp]
theorem toExterior_symbol {n : ℕ} (a : A) (v : Fin n → A) :
    toExterior R A n (symbol R A a v) = a • exteriorSymbol R A n v := by
  exact Finsupp.linearCombination_single A a v

/-- Every exterior Kähler form has a representative in the explicit presentation. -/
theorem toExterior_surjective (n : ℕ) : Function.Surjective (toExterior R A n) := by
  rw [← LinearMap.range_eq_top]
  apply top_unique
  rw [← exteriorPower.ιMulti_span_of_span A n Ω[A⁄R]
    (KaehlerDifferential.span_range_derivation R A)]
  apply Submodule.span_le.mpr
  rintro _ ⟨v, hv, rfl⟩
  have h (i : Fin n) : ∃ a : A, KaehlerDifferential.D R A a = v i :=
    hv (Set.mem_range_self i)
  choose a ha using h
  refine ⟨symbol R A 1 a, ?_⟩
  rw [toExterior_symbol, one_smul]
  unfold exteriorSymbol
  congr 1
  funext i
  exact ha i

end

end OAI.AlgebraicGeometry.Crystalline.Cohomology.DeRhamPresentationTo.DeRhamPresentation
