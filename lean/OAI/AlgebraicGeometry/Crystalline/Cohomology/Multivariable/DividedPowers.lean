import OAI.AlgebraicGeometry.Crystalline.Cohomology.Multivariable.DividedAlgebra
import OAI.AlgebraicGeometry.Crystalline.Cohomology.PD.GeneratorTransfer
import Mathlib.RingTheory.DividedPowers.DPMorphism

/-! # Divided Powers -/

namespace OAI.AlgebraicGeometry.Crystalline.Cohomology.Multivariable.DividedPowers.MultivariableDividedPowers

noncomputable section

/-!
# Relative divided powers in several variables

The base divided powers extend to the ideal generated by the base ideal
and all positive coordinate divided powers in the actual free divided-power
algebra. Polynomial realization verifies integrality and the DP identities.
-/

open OAI.AlgebraicGeometry.Crystalline.Cohomology.Multivariable.DividedAlgebra.MultivariableDividedAlgebra

universe u

variable (R σ : Type u) [CommRing R]
  (K : Type u) [Field K] [CharZero K] [Algebra R K]
  (h : Function.Injective (algebraMap R K))
  (I : Ideal R) (δ : DividedPowers I)

local notation "G" => DividedPowerAlgebra R (σ →₀ R)
local notation "f" => OAI.AlgebraicGeometry.Crystalline.Cohomology.Multivariable.DividedAlgebra.MultivariableDividedAlgebra.realize R σ K

local instance polynomialCharZero : CharZero (MvPolynomial σ K) where
  cast_injective m n hmn := by
    apply Nat.cast_injective (R := K)
    apply MvPolynomial.C_injective (σ := σ)
    simpa only [map_natCast] using hmn

def generators : Set G :=
  Set.range (fun x : I => algebraMap R G x) ∪ Set.range (fun ni : ℕ × σ => DividedAlgebra.MultivariableDividedAlgebra.generator R σ (ni.1 + 1) ni.2)

def ideal : Ideal G := Ideal.span (generators R σ I)

def rationalPowers : DividedPowers (⊤ : Ideal (MvPolynomial σ K)) := by
  classical
  exact DividedPowers.RatAlgebra.dividedPowers ⊤

theorem realize_generator_dpow (n : ℕ) (i : σ) :
    f (DividedAlgebra.MultivariableDividedAlgebra.generator R σ n i) = (rationalPowers σ K).dpow n (MvPolynomial.X i) := by
  classical
  change DividedPowerAlgebra.lift _ _ _ (DividedPowerAlgebra.dp R n (Finsupp.single i (1 : R))) = _
  rw [DividedPowerAlgebra.lift_apply_dp]
  change (rationalPowers σ K).dpow n
    (Finsupp.linearCombination R (MvPolynomial.X : σ → MvPolynomial σ K) (Finsupp.single i (1 : R))) = _
  rw [Finsupp.linearCombination_single, one_smul]

theorem base_dpow (n : ℕ) (x : R) (hx : x ∈ I) :
    f (algebraMap R G (δ.dpow n x)) = (rationalPowers σ K).dpow n (f (algebraMap R G x)) := by
  apply mul_left_cancel₀ (show (n.factorial : MvPolynomial σ K) ≠ 0 from
    Nat.cast_ne_zero.mpr n.factorial_ne_zero)
  calc
    _ = f (algebraMap R G ((n.factorial : R) * δ.dpow n x)) := by simp only [map_mul, map_natCast]
    _ = f (algebraMap R G (x ^ n)) := congrArg (fun a => f (algebraMap R G a)) (δ.factorial_mul_dpow_eq_pow hx)
    _ = (f (algebraMap R G x)) ^ n := by simp only [map_pow]
    _ = _ := ((rationalPowers σ K).factorial_mul_dpow_eq_pow (Submodule.mem_top)).symm

theorem positive_generator_mem (i : σ) (n : ℕ) (hn : n ≠ 0) : DividedAlgebra.MultivariableDividedAlgebra.generator R σ n i ∈ ideal R σ I := by
  obtain ⟨m, rfl⟩ := Nat.exists_eq_succ_of_ne_zero hn
  exact Ideal.subset_span (Or.inr (Set.mem_range_self (m, i)))

theorem realize_generator_comp (n m : ℕ) (i : σ) :
    f ((Nat.uniformBell n (m + 1) : R) • DividedAlgebra.MultivariableDividedAlgebra.generator R σ (n * (m + 1)) i) =
      (rationalPowers σ K).dpow n (f (DividedAlgebra.MultivariableDividedAlgebra.generator R σ (m + 1) i)) := by
  rw [map_smul, realize_generator_dpow, realize_generator_dpow,
    (rationalPowers σ K).dpow_comp (Nat.succ_ne_zero m) (Submodule.mem_top)]
  rw [Nat.cast_smul_eq_nsmul, nsmul_eq_mul]

include δ in
theorem generator_lifts : ∀ s ∈ generators R σ I, ∀ n : ℕ, n ≠ 0 →
    ∃ y ∈ ideal R σ I, f y = (rationalPowers σ K).dpow n (f s) := by
  intro s hs n hn
  rcases hs with ⟨x, rfl⟩ | ⟨⟨m, i⟩, rfl⟩
  · refine ⟨algebraMap R G (δ.dpow n x), ?_, base_dpow R σ K I δ n x x.property⟩
    exact Ideal.subset_span (Or.inl ⟨⟨δ.dpow n x, δ.dpow_mem hn x.property⟩, rfl⟩)
  · refine ⟨(Nat.uniformBell n (m + 1) : R) • DividedAlgebra.MultivariableDividedAlgebra.generator R σ (n * (m + 1)) i, ?_,
      realize_generator_comp R σ K n m i⟩
    exact Submodule.smul_of_tower_mem (ideal R σ I) _
      (positive_generator_mem R σ I i _ (Nat.mul_ne_zero hn (Nat.succ_ne_zero m)))

variable (hunit : ∃ a ∈ I, IsUnit (algebraMap R K a))

include hunit in
theorem ideal_map_eq_top : (ideal R σ I).map (f).toRingHom = ⊤ := by
  obtain ⟨a, ha, hu⟩ := hunit
  have ha' : algebraMap R G a ∈ ideal R σ I := Ideal.subset_span (Or.inl ⟨⟨a, ha⟩, rfl⟩)
  apply Ideal.eq_top_of_isUnit_mem _ (Ideal.mem_map_of_mem (f).toRingHom ha')
  have hu' : IsUnit (MvPolynomial.C (σ := σ) (algebraMap R K a)) := hu.map (MvPolynomial.C (σ := σ))
  change IsUnit (f (algebraMap R G a))
  rw [(f).commutes]
  exact hu'

/-- The relative divided-power structure on the divided-polynomial algebra. -/
def dividedPowers : DividedPowers (ideal R σ I) :=
  PD.GeneratorTransfer.PDGeneratorTransfer.dividedPowers (⊤ : Ideal (MvPolynomial σ K)) (rationalPowers σ K)
    (f).toRingHom (generators R σ I) (generator_lifts R σ K I δ)
    (DividedAlgebra.MultivariableDividedAlgebra.realize_injective R σ K h) (ideal_map_eq_top R σ K I hunit)

theorem realize_dpow (n : ℕ) {x : G} (hx : x ∈ ideal R σ I) :
    f ((MultivariableDividedPowers.dividedPowers R σ K h I δ hunit).dpow n x) = (rationalPowers σ K).dpow n (f x) :=
  PD.GeneratorTransfer.PDGeneratorTransfer.map_dpow (⊤ : Ideal (MvPolynomial σ K)) (rationalPowers σ K)
    (f).toRingHom (generators R σ I) (generator_lifts R σ K I δ)
    (DividedAlgebra.MultivariableDividedAlgebra.realize_injective R σ K h) (ideal_map_eq_top R σ K I hunit) n hx

theorem base_isDPMorphism :
    DividedPowers.IsDPMorphism δ (MultivariableDividedPowers.dividedPowers R σ K h I δ hunit) (algebraMap R G) where
  ideal_comp := Ideal.map_le_iff_le_comap.mpr (fun x hx =>
    Ideal.subset_span (Or.inl ⟨⟨x, hx⟩, rfl⟩))
  dpow_comp {n} x hx := by
    apply DividedAlgebra.MultivariableDividedAlgebra.realize_injective R σ K h
    rw [realize_dpow R σ K h I δ hunit n (Ideal.subset_span (Or.inl ⟨⟨x, hx⟩, rfl⟩))]
    exact (base_dpow R σ K I δ n x hx).symm

theorem generator_dpow (n m : ℕ) (i : σ) :
    (MultivariableDividedPowers.dividedPowers R σ K h I δ hunit).dpow n (DividedAlgebra.MultivariableDividedAlgebra.generator R σ (m + 1) i) =
      (Nat.uniformBell n (m + 1) : R) • DividedAlgebra.MultivariableDividedAlgebra.generator R σ (n * (m + 1)) i := by
  apply DividedAlgebra.MultivariableDividedAlgebra.realize_injective R σ K h
  rw [realize_dpow R σ K h I δ hunit n (positive_generator_mem R σ I i _ (Nat.succ_ne_zero m))]
  exact (realize_generator_comp R σ K n m i).symm

theorem coordinate_dpow (n : ℕ) (i : σ) :
    (MultivariableDividedPowers.dividedPowers R σ K h I δ hunit).dpow n (DividedAlgebra.MultivariableDividedAlgebra.generator R σ 1 i) = DividedAlgebra.MultivariableDividedAlgebra.generator R σ n i := by
  simpa only [Nat.zero_add, Nat.uniformBell_one_right, Nat.mul_one, Nat.cast_one, one_smul] using
    generator_dpow R σ K h I δ hunit n 0 i

end

end OAI.AlgebraicGeometry.Crystalline.Cohomology.Multivariable.DividedPowers.MultivariableDividedPowers
