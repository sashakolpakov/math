import OAI.AlgebraicGeometry.Crystalline.Cohomology.ShiftedPolynomialDP

/-! # Shifted Polynomial Eval -/

namespace OAI.AlgebraicGeometry.Crystalline.Cohomology.ShiftedPolynomialEval.ShiftedPolynomialKernel

noncomputable section

/-!
# The actual kernel of reduction along chosen polynomial lifts

Evaluation at chosen lifts followed by residue reduction has precisely
the ideal generated by the coefficient kernel and the differences
between each variable and its chosen lift.
-/

universe u

variable (R σ : Type u) [CommRing R] (I : Ideal R) (x : σ → R)

local notation "P" => MvPolynomial σ R
local notation "J" => OAI.AlgebraicGeometry.Crystalline.Cohomology.ShiftedPolynomialDP.ShiftedPolynomialEnvelope.polynomialIdeal R σ I x
local notation "q" => Ideal.Quotient.mk J

theorem quotient_X (i : σ) : q (MvPolynomial.X i) = q (MvPolynomial.C (x i)) := by
  apply sub_eq_zero.mp
  rw [← map_sub]
  exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Or.inr (Set.mem_range_self i)))

theorem quotient_eval (a : P) : q a = q (MvPolynomial.C (MvPolynomial.eval x a)) := by
  have he : q = (q).comp (MvPolynomial.C.comp (MvPolynomial.eval x)) := by
    apply MvPolynomial.ringHom_ext
    · intro r
      simp only [RingHom.comp_apply, MvPolynomial.eval_C]
    · intro i
      simp only [RingHom.comp_apply, MvPolynomial.eval_X]
      exact quotient_X R σ I x i
  exact RingHom.congr_fun he a

variable (A : Type u) [CommRing A] (r : R →+* A)

def reduction : P →+* A := r.comp (MvPolynomial.eval x)

theorem reduction_C (a : R) : reduction R σ x A r (MvPolynomial.C a) = r a := by
  simp [reduction]

theorem reduction_X (i : σ) : reduction R σ x A r (MvPolynomial.X i) = r (x i) := by
  simp [reduction]

/-- The shifted polynomial ideal is the exact reduction kernel. -/
theorem reduction_kernel : RingHom.ker (reduction R σ x A r) =
    ShiftedPolynomialDP.ShiftedPolynomialEnvelope.polynomialIdeal R σ (RingHom.ker r) x := by
  apply le_antisymm
  · intro a ha
    apply Ideal.Quotient.eq_zero_iff_mem.mp
    rw [quotient_eval]
    exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Or.inl
      ⟨MvPolynomial.eval x a, ha, rfl⟩))
  · apply Ideal.span_le.mpr
    intro a ha
    rcases ha with ⟨a, ha, rfl⟩ | ⟨i, rfl⟩
    · change reduction R σ x A r (MvPolynomial.C a) = 0
      rw [reduction_C]
      exact ha
    · change reduction R σ x A r (MvPolynomial.X i - MvPolynomial.C (x i)) = 0
      rw [map_sub, reduction_X, reduction_C, sub_self]

theorem reduction_surjective (hr : Function.Surjective r) : Function.Surjective (reduction R σ x A r) := by
  intro a
  obtain ⟨b, rfl⟩ := hr a
  exact ⟨MvPolynomial.C b, reduction_C R σ x A r b⟩

end

end OAI.AlgebraicGeometry.Crystalline.Cohomology.ShiftedPolynomialEval.ShiftedPolynomialKernel
