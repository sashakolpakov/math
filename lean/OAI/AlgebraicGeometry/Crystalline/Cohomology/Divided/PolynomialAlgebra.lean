import OAI.AlgebraicGeometry.Crystalline.Cohomology.Divided.Polynomial
import Mathlib.RingTheory.DividedPowerAlgebra.Init
import Mathlib.RingTheory.DividedPowers.RatAlgebra
import Mathlib.Algebra.Algebra.Rat

/-! # Polynomial Algebra -/

namespace OAI.AlgebraicGeometry.Crystalline.Cohomology.Divided.PolynomialAlgebra.DividedPolynomialAlgebra

noncomputable section

/-!
# The divided-monomial basis of the rank-one divided-power algebra

The algebra generated by the divided powers of one variable is spanned
by those divided monomials. When coefficients embed into a characteristic
zero field, polynomial realization proves their linear independence.
-/

variable (R : Type*) [CommRing R]

local notation "G" => DividedPowerAlgebra R R

def monomial (n : ℕ) : G := DividedPowerAlgebra.dp R n (1 : R)

def fromCoefficients : Divided.Polynomial.DividedPolynomial.Coefficients R →ₗ[R] G :=
  Finsupp.linearCombination R (DividedPolynomialAlgebra.monomial R)

@[simp] theorem fromCoefficients_single (n : ℕ) (a : R) :
    fromCoefficients R (Finsupp.single n a) = a • DividedPolynomialAlgebra.monomial R n := by
  simp [fromCoefficients]

theorem dp_eq_smul (n : ℕ) (a : R) :
    DividedPowerAlgebra.dp R n a = a ^ n • DividedPolynomialAlgebra.monomial R n := by
  change DividedPowerAlgebra.dp R n a = a ^ n • DividedPowerAlgebra.dp R n (1 : R)
  simpa only [smul_eq_mul, mul_one] using
    (DividedPowerAlgebra.dp_smul (R := R) (r := a) (n := n) (m := (1 : R)))

theorem monomial_mul (m n : ℕ) :
    DividedPolynomialAlgebra.monomial R m * DividedPolynomialAlgebra.monomial R n = (Nat.choose (m + n) m : R) • DividedPolynomialAlgebra.monomial R (m + n) := by
  rw [DividedPolynomialAlgebra.monomial, DividedPolynomialAlgebra.monomial, DividedPowerAlgebra.dp_mul]
  exact (Nat.cast_smul_eq_nsmul R _ _).symm

theorem span_monomial_eq_top : Submodule.span R (Set.range (DividedPolynomialAlgebra.monomial R)) = ⊤ := by
  apply top_unique
  intro x hx
  clear hx
  induction x using DividedPowerAlgebra.induction_on with
  | C a =>
    have h : DividedPolynomialAlgebra.monomial R 0 ∈ Submodule.span R (Set.range (DividedPolynomialAlgebra.monomial R)) :=
      Submodule.subset_span (Set.mem_range_self 0)
    have ha := (Submodule.span R (Set.range (DividedPolynomialAlgebra.monomial R))).smul_mem a h
    simpa only [DividedPolynomialAlgebra.monomial, DividedPowerAlgebra.dp_zero, Algebra.smul_def, mul_one] using ha
  | add x y hx hy => exact Submodule.add_mem _ hx hy
  | dp x n a hx =>
    rw [dp_eq_smul, mul_smul_comm]
    apply Submodule.smul_mem
    induction hx using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨m, rfl⟩ := hx
      rw [monomial_mul]
      exact Submodule.smul_mem _ _ (Submodule.subset_span (Set.mem_range_self _))
    | zero => simpa only [zero_mul] using (Submodule.span R (Set.range (DividedPolynomialAlgebra.monomial R))).zero_mem
    | add x y hx hy ihx ihy => rw [add_mul]; exact Submodule.add_mem _ ihx ihy
    | smul a x hx ih => rw [smul_mul_assoc]; exact Submodule.smul_mem _ a ih

theorem fromCoefficients_surjective : Function.Surjective (fromCoefficients R) := by
  rw [← LinearMap.range_eq_top, fromCoefficients, Finsupp.range_linearCombination]
  exact span_monomial_eq_top R

variable (K : Type*) [Field K] [CharZero K] [Algebra R K]

/-- The polynomial realization of the divided-power algebra. -/
def realize : G →ₐ[R] Polynomial K := by
  classical
  exact DividedPowerAlgebra.lift
    (DividedPowers.RatAlgebra.dividedPowers (⊤ : Ideal (Polynomial K)))
    (LinearMap.smulRight (LinearMap.id : R →ₗ[R] R) Polynomial.X)
    (fun _ => Submodule.mem_top)

theorem realize_monomial (n : ℕ) :
    realize R K (DividedPolynomialAlgebra.monomial R n) = Polynomial.monomial n ((n.factorial : K)⁻¹) := by
  classical
  change DividedPowerAlgebra.lift _ _ _ (DividedPowerAlgebra.dp R n (1 : R)) = _
  rw [DividedPowerAlgebra.lift_apply_dp]
  simp only [LinearMap.smulRight_apply, LinearMap.id_apply, one_smul]
  have h := DividedPowers.RatAlgebra.dpow_eq_inv_fact_smul
    (⊤ : Ideal (Polynomial K))
    (DividedPowers.RatAlgebra.dividedPowers (⊤ : Ideal (Polynomial K)))
    (n := n) (x := Polynomial.X) (Submodule.mem_top)
  calc
    _ = (Ring.inverse (n.factorial : ℚ)) • (Polynomial.X : Polynomial K) ^ n := h
    _ = _ := by
      ext m
      simp [Polynomial.coeff_X_pow, Polynomial.coeff_monomial,
        Algebra.smul_def, Ring.inverse_eq_inv', eq_comm]

theorem realize_fromCoefficients (f : Divided.Polynomial.DividedPolynomial.Coefficients R) :
    realize R K (fromCoefficients R f) = Divided.Polynomial.DividedPolynomial.toPolynomial R K f := by
  induction f using Finsupp.induction_linear with
  | zero => simp
  | add f g hf hg => simp only [map_add, hf, hg]
  | single n a => rw [fromCoefficients_single, map_smul, realize_monomial,
      Divided.Polynomial.DividedPolynomial.toPolynomial_single]

theorem fromCoefficients_injective (h : Function.Injective (algebraMap R K)) :
    Function.Injective (fromCoefficients R) := by
  intro f g hfg
  apply Divided.Polynomial.DividedPolynomial.toPolynomial_injective R K h
  simpa only [realize_fromCoefficients] using congrArg (realize R K) hfg

theorem realize_injective (h : Function.Injective (algebraMap R K)) :
    Function.Injective (realize R K) := by
  intro x y hxy
  obtain ⟨x, rfl⟩ := fromCoefficients_surjective R x
  obtain ⟨y, rfl⟩ := fromCoefficients_surjective R y
  apply congrArg (fromCoefficients R)
  apply Divided.Polynomial.DividedPolynomial.toPolynomial_injective R K h
  simpa only [realize_fromCoefficients] using hxy

/-- The actual divided-power algebra has the coefficient module used by the Poincaré contraction. -/
def coefficientEquiv (h : Function.Injective (algebraMap R K)) :
    Divided.Polynomial.DividedPolynomial.Coefficients R ≃ₗ[R] G :=
  LinearEquiv.ofBijective (fromCoefficients R)
    ⟨fromCoefficients_injective R K h, fromCoefficients_surjective R⟩

end

end OAI.AlgebraicGeometry.Crystalline.Cohomology.Divided.PolynomialAlgebra.DividedPolynomialAlgebra
