import OAI.AlgebraicGeometry.Crystalline.Cohomology.PD.Thickening
import Mathlib.AlgebraicGeometry.Sites.BigZariski
import Mathlib.Algebra.Category.ModuleCat.Ulift
import Mathlib.Algebra.Category.ModuleCat.Limits
import Mathlib.Algebra.Category.ModuleCat.FilteredColimits
import Mathlib.CategoryTheory.Sites.LeftExact
import Mathlib.CategoryTheory.Sites.Abelian
import Mathlib.Algebra.Homology.DerivedCategory.Ext.Linear
import Mathlib.CategoryTheory.Linear.FunctorCategory

/-! # Site -/

namespace OAI.AlgebraicGeometry.Crystalline.Cohomology.Site

noncomputable section

/-!
# Cohomology: the affine crystalline site over the Witt-vector base

Objects are divided-power thickenings, with nilpotent `p`, of affine open subschemes of
the special fibre. Covers are generated by Zariski covers of the ambient
thickening. The structure sheaf is the sheafification of the ambient-ring
presheaf, with its Witt-vector module structure. Its global cohomology is
defined by Ext from the constant rank-one coefficient sheaf.

This supplies global cohomology objects; no comparison isomorphism is part
of any definition or hypothesis in this file.
-/

open _root_.CategoryTheory _root_.AlgebraicGeometry Opposite

universe u

variable (p : ℕ) [Fact p.Prime]
variable (k : Type u) [Field k] [CharP k p]
variable (X : Over (Spec (CommRingCat.of k)))

/-- An affine object of the crystalline site of `X` over `W(k)`. -/
structure Object where
  residueRing : CommRingCat.{u}
  [residueAlgebra : Algebra k residueRing]
  thickening : PD.Thickening.AffinePDThickening p k residueRing
  immersion : Spec residueRing ⟶ X.left
  [openImmersion : IsOpenImmersion immersion]
  over_base : immersion ≫ X.hom =
    Spec.map (CommRingCat.ofHom (algebraMap k residueRing))

attribute [instance] Object.residueAlgebra Object.openImmersion

namespace Object

variable {p k X}

/-- Maps of thickenings over the special fibre; the ring maps are contravariant. -/
structure Hom (S T : Object p k X) where
  reducedMap : T.residueRing →ₐ[k] S.residueRing
  ambientMap : T.thickening.ring →ₐ[WittVector p k] S.thickening.ring
  reduction_comm : ∀ x,
    S.thickening.reduction (ambientMap x) = reducedMap (T.thickening.reduction x)
  over_X : Spec.map (CommRingCat.ofHom reducedMap.toRingHom) ≫ T.immersion = S.immersion
  dp_comp : DividedPowers.IsDPMorphism T.thickening.dividedPowers
    S.thickening.dividedPowers ambientMap.toRingHom

@[ext]
theorem Hom.ext {S T : Object p k X} (f g : Object.Hom S T)
    (hr : f.reducedMap = g.reducedMap) (ht : f.ambientMap = g.ambientMap) : f = g := by
  cases f
  cases g
  cases hr
  cases ht
  rfl

instance : Category (Object p k X) where
  Hom := Object.Hom
  id S :=
    { reducedMap := AlgHom.id k S.residueRing
      ambientMap := AlgHom.id (WittVector p k) S.thickening.ring
      reduction_comm := fun _ => rfl
      over_X := by change Spec.map (𝟙 _) ≫ _ = _; simp
      dp_comp := (DividedPowers.DPMorphism.id S.thickening.dividedPowers).isDPMorphism }
  comp f g :=
    { reducedMap := f.reducedMap.comp g.reducedMap
      ambientMap := f.ambientMap.comp g.ambientMap
      reduction_comm := fun x => by
        simp only [AlgHom.comp_apply]
        rw [f.reduction_comm, g.reduction_comm]
      over_X := by
        change Spec.map (CommRingCat.ofHom g.reducedMap.toRingHom ≫
          CommRingCat.ofHom f.reducedMap.toRingHom) ≫ _ = _
        rw [Spec.map_comp, Category.assoc, g.over_X, f.over_X]
      dp_comp := f.dp_comp.comp _ g.dp_comp }
  id_comp f := by apply Object.Hom.ext <;> ext <;> rfl
  comp_id f := by apply Object.Hom.ext <;> ext <;> rfl
  assoc f g h := by apply Object.Hom.ext <;> ext <;> rfl

end Object

/-- Forget to the ambient affine scheme of a divided-power thickening. -/
def ambient : Object p k X ⥤ Scheme.{u} where
  obj S := Spec S.thickening.ring
  map f := Spec.map (CommRingCat.ofHom f.ambientMap.toRingHom)
  map_id S := by change Spec.map (𝟙 _) = _; simp
  map_comp f g := by
    change Spec.map (CommRingCat.ofHom g.ambientMap.toRingHom ≫
      CommRingCat.ofHom f.ambientMap.toRingHom) = _
    exact Spec.map_comp _ _

/-- Remember the open subscheme of the special fibre. -/
def underlyingOpen : Object p k X ⥤ Over X.left where
  obj S := Over.mk S.immersion
  map f := Over.homMk (Spec.map (CommRingCat.ofHom f.reducedMap.toRingHom)) f.over_X
  map_id S := by ext; change Spec.map (𝟙 _) = _; simp
  map_comp f g := by
    ext
    change Spec.map (CommRingCat.ofHom g.reducedMap.toRingHom ≫
      CommRingCat.ofHom f.reducedMap.toRingHom) = _
    exact Spec.map_comp _ _

/-- Zariski coverings of ambient divided-power thickenings. -/
def precoverage : Precoverage (Object p k X) :=
  (Scheme.precoverage IsOpenImmersion).comap (ambient p k X)

/-- The topology generated by the crystalline covering families. -/
def topology : GrothendieckTopology (Object p k X) :=
  (Site.precoverage p k X).toGrothendieck

/-- A covering family is a covering sieve in the generated topology. -/
theorem covering_mem {S : Object p k X} (R : Presieve S)
    (hR : R.map (ambient p k X) ∈ Scheme.precoverage IsOpenImmersion _) :
    Sieve.generate R ∈ topology p k X S :=
  Precoverage.generate_mem_toGrothendieck hR

/-- The ambient functions on crystalline objects, as Witt-vector modules. -/
def functions : (Object p k X)ᵒᵖ ⥤ ModuleCat.{u} (WittVector p k) where
  obj S := ModuleCat.of (WittVector p k) S.unop.thickening.ring
  map f := ModuleCat.ofHom f.unop.ambientMap.toLinearMap
  map_id S := by ext; rfl
  map_comp f g := by ext; rfl

/-- A universe lift of the coefficient ring for the library's sheafification
construction. Its ring is canonically equivalent to `W(k)`. -/
abbrev CoefficientRing := ULift.{u + 1} (WittVector p k)

/-- Lift coefficient universes so sheafification is available on this site. -/
def functionsLarge : (Object p k X)ᵒᵖ ⥤ ModuleCat.{u + 1} (CoefficientRing p k) :=
  functions p k X ⋙ ModuleCat.uliftFunctor.{u + 1} (WittVector p k) ⋙
    ModuleCat.restrictScalars (ULift.ringEquiv : CoefficientRing p k ≃+* WittVector p k).toRingHom

/-- The crystalline structure sheaf with its constant Witt-vector action. -/
def structureSheaf : Sheaf (topology p k X) (ModuleCat.{u + 1} (CoefficientRing p k)) :=
  (presheafToSheaf (topology p k X) (ModuleCat.{u + 1} (CoefficientRing p k))).obj
    (functionsLarge p k X)

/-- The constant free rank-one coefficient sheaf. -/
def coefficientSheaf : Sheaf (topology p k X) (ModuleCat.{u + 1} (CoefficientRing p k)) :=
  (constantSheaf (topology p k X) (ModuleCat.{u + 1} (CoefficientRing p k))).obj
    (ModuleCat.of (CoefficientRing p k) (CoefficientRing p k))

instance cohomologyHasExt : HasExt.{u + 2}
    (Sheaf (topology p k X) (ModuleCat.{u + 1} (CoefficientRing p k))) :=
  HasExt.standard _

/-- Global integral cohomology of the affine crystalline site. -/
abbrev integralCohomology (n : ℕ) : Type (u + 2) :=
  Abelian.Ext (coefficientSheaf p k X) (structureSheaf p k X) n

instance integralCohomologyScalar (n : ℕ) :
    Module (WittVector p k) (integralCohomology p k X n) :=
  Module.compHom (integralCohomology p k X n)
    (ULift.ringEquiv : CoefficientRing p k ≃+* WittVector p k).symm.toRingHom

/-- The integral cohomology groups retain their Witt-vector module structure. -/
def integralCohomologyModule (n : ℕ) : ModuleCat.{u + 2} (WittVector p k) :=
  ModuleCat.of (WittVector p k) (integralCohomology p k X n)

/-- Crystalline cohomology with coefficients in the Witt-vector fraction field.
For perfect `k`, this is the scalar extension obtained by inverting `p`. -/
def rationalCohomology (n : ℕ) :
    ModuleCat.{u + 2} (FractionRing (WittVector p k)) :=
  ModuleCat.of (FractionRing (WittVector p k))
    (TensorProduct (WittVector p k) (FractionRing (WittVector p k))
      (integralCohomology p k X n))

end

end OAI.AlgebraicGeometry.Crystalline.Cohomology.Site
