import Mathlib.RingTheory.DividedPowers.DPMorphism

/-! # Principal Base -/

namespace OAI.AlgebraicGeometry.Crystalline.Cohomology.PrincipalBase.PrincipalBasePDMorphism

/-!
# Maps out of a principal base divided-power ideal

If the source divided-power ideal is generated by an element of the
base ring, compatibility on the base determines all divided powers.
The target may have torsion.
-/

variable (R A B : Type*) [CommRing R] [CommRing A] [CommRing B] [Algebra R A]
  (I₀ : Ideal R) (δ₀ : DividedPowers I₀) (r : R) (hr : r ∈ I₀)
  (δA : DividedPowers (Ideal.span {algebraMap R A r}))
  (J : Ideal B) (δB : DividedPowers J) (f : A →+* B)
  (hA : DividedPowers.IsDPMorphism δ₀ δA (algebraMap R A))
  (hB : DividedPowers.IsDPMorphism δ₀ δB (f.comp (algebraMap R A)))

include hr hA hB in
theorem isDPMorphism : DividedPowers.IsDPMorphism δA δB f := by
  have ha : algebraMap R A r ∈ Ideal.span {algebraMap R A r} := Ideal.subset_span (Set.mem_singleton _)
  have hb : f (algebraMap R A r) ∈ J :=
    hB.ideal_comp (Ideal.mem_map_of_mem (f.comp (algebraMap R A)) hr)
  refine ⟨?_, ?_⟩
  · rw [Ideal.map_span, Set.image_singleton, Ideal.span_singleton_le_iff_mem]
    exact hb
  · intro n x hx
    obtain ⟨a, rfl⟩ := Ideal.mem_span_singleton.mp hx
    rw [f.map_mul, mul_comm (f (algebraMap R A r)) (f a), δB.dpow_mul hb,
      mul_comm (algebraMap R A r) a, δA.dpow_mul ha, f.map_mul, f.map_pow,
      hA.dpow_comp r hr]
    change f a ^ n * δB.dpow n ((f.comp (algebraMap R A)) r) =
      f a ^ n * (f.comp (algebraMap R A)) (δ₀.dpow n r)
    rw [hB.dpow_comp r hr]

end OAI.AlgebraicGeometry.Crystalline.Cohomology.PrincipalBase.PrincipalBasePDMorphism
