import Mathlib

/-! # Special Linear Squares -/

namespace OAI.AlgebraicGeometry.HodgeConjecture.CMExtraction.SpecialLinearSquares.Local

noncomputable section

/-! SL3 over a characteristic-zero field is generated by squares. This
removes the sign ambiguity when comparing homomorphic finite-cover lifts. -/

open _root_.Matrix
open scoped Classical

variable {k : Type} [Field k] [CharZero k]

omit [CharZero k] in
theorem diag2n_transvection_decomposition {ι : Type*} [Fintype ι] [DecidableEq ι]
    (i j : ι) (hij : i ≠ j) (a : k) (ha : a ≠ 0) :
    SpecialLinearGroup.diag2n hij a ha =
      SpecialLinearGroup.transvection hij a *
      SpecialLinearGroup.transvection hij.symm (-a⁻¹) *
      SpecialLinearGroup.transvection hij a *
      SpecialLinearGroup.transvection hij (-1) *
      SpecialLinearGroup.transvection hij.symm 1 *
      SpecialLinearGroup.transvection hij (-1) := by
  apply Subtype.ext
  change diagonal (fun t => if t = i then a else if t = j then a⁻¹ else 1) =
    (1 + single i j a) * (1 + single j i (-a⁻¹)) * (1 + single i j a) *
      (1 + single i j (-1)) * (1 + single j i 1) * (1 + single i j (-1))
  simp only [mul_add, add_mul, mul_one, one_mul, Matrix.single_mul_single_same]
  ext r s
  by_cases hri : r = i <;> by_cases hrj : r = j <;>
    by_cases hsi : s = i <;> by_cases hsj : s = j <;>
    simp_all [Matrix.diagonal_apply, Matrix.add_apply, Matrix.one_apply, Matrix.single_apply, eq_comm]

theorem specialLinear_generated_by_squares {ι : Type*} [Fintype ι] [DecidableEq ι] [Nontrivial ι]
    (H : Subgroup (SpecialLinearGroup ι k))
    (hH : ∀ g : SpecialLinearGroup ι k, g ^ 2 ∈ H) : H = ⊤ := by
  have ht (i j : ι) (hij : i ≠ j) (a : k) : SpecialLinearGroup.transvection hij a ∈ H := by
    have h := hH (SpecialLinearGroup.transvection hij (a / 2))
    rw [pow_two, ← SpecialLinearGroup.transvection_add] at h
    have he : a / 2 + a / 2 = a := by ring
    rwa [he] at h
  apply top_unique
  intro g _
  apply SpecialLinearGroup.diagonal_transvection_induction' (fun g => g ∈ H) g
  · intro i j hij a ha
    rw [diag2n_transvection_decomposition i j hij a ha]
    exact H.mul_mem (H.mul_mem (H.mul_mem (H.mul_mem (H.mul_mem
      (ht i j hij a) (ht j i hij.symm (-a⁻¹))) (ht i j hij a))
      (ht i j hij (-1))) (ht j i hij.symm 1)) (ht i j hij (-1))
  · exact ht
  · exact fun _ _ => H.mul_mem

end

end OAI.AlgebraicGeometry.HodgeConjecture.CMExtraction.SpecialLinearSquares.Local
