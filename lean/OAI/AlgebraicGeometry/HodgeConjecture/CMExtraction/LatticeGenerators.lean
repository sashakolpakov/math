import OAI.AlgebraicGeometry.HodgeConjecture.CMExtraction.LatticeCoordinates
import OAI.AlgebraicGeometry.HodgeConjecture.CMExtraction.PrincipalLatticeGenerators

/-! # Lattice Generators -/

namespace OAI.AlgebraicGeometry.HodgeConjecture.CMExtraction.LatticeGenerators.TestTransport

noncomputable section

/-! The completion of the actual lattice is generated by the images
of its specified integral basis. -/

open scoped Classical

open _root_.Module

theorem span_image_integral_basis {V W J A : Type*}
    [AddCommGroup V] [AddCommGroup W] [CommRing A] [Module A W] [Fintype J]
    (L : Submodule ℤ V) (b : Basis J ℤ L) (f : V →+ W) :
    Submodule.span A (Set.range (fun j => f (b j).val)) =
      Submodule.span A (f '' (L : Set V)) := by
  apply le_antisymm
  · apply Submodule.span_le.mpr
    rintro _ ⟨j, rfl⟩
    exact Submodule.subset_span ⟨(b j).val, (b j).property, rfl⟩
  · apply Submodule.span_le.mpr
    rintro _ ⟨x, hx, rfl⟩
    have he : (∑ j, b.equivFun ⟨x, hx⟩ j • (b j).val) = x := by
      simpa only [Submodule.coe_sum, Submodule.coe_smul] using
        congrArg (fun z : L => z.val) (b.sum_equivFun ⟨x, hx⟩)
    rw [← he, map_sum]
    apply Submodule.sum_mem
    intro j _
    rw [map_zsmul]
    exact (Submodule.span A (Set.range (fun j => f (b j).val))).toAddSubgroup.zsmul_mem
      (Submodule.subset_span (Set.mem_range_self j)) _

variable (E : Type) [Field E] [NumberField E]
  {I J : Type*} [Fintype I] [DecidableEq I] [Fintype J] [DecidableEq J]
  (L : Submodule ℤ (I → E)) [Submodule.IsLattice ℚ L] (b : Basis J ℤ L)

def completedVectorBasis (j : J) : I → AbelianModuli.ReferenceFamily.AdelicData.FiniteCoefficients E :=
  fun i => AbelianModuli.ReferenceFamily.AdelicData.finiteCoefficientEmbedding E ((b j).val i)

omit [Fintype I] [DecidableEq I] [DecidableEq J] [Submodule.IsLattice ℚ L] in
theorem completedVectorLattice_span_basis :
    Submodule.span AbelianModuli.ReferenceFamily.AdelicData.integralFiniteAdeles (Set.range (completedVectorBasis E L b)) =
      LatticeCoordinates.TestTransport.completedVectorLattice E L := by
  exact span_image_integral_basis L b
    (AddMonoidHom.pi (fun i => (AbelianModuli.ReferenceFamily.AdelicData.finiteCoefficientEmbedding E).toAddMonoidHom.comp
      (Pi.evalAddMonoidHom (fun _ : I => E) i)))

end

end OAI.AlgebraicGeometry.HodgeConjecture.CMExtraction.LatticeGenerators.TestTransport
