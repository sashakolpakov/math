import OAI.AlgebraicGeometry.Resolution.Blowups.ExceptionalIdeal

/-! # Principal Blowup -/

namespace OAI.AlgebraicGeometry.Resolution.Blowups.PrincipalBlowup.Construction

noncomputable section

/-! Blowups along principal ideals generated by non-zero-divisors. -/

open _root_.Polynomial _root_.CategoryTheory _root_.AlgebraicGeometry

universe u

variable {R : Type u} [CommRing R] (I : Ideal R)

/-- Divisibility of coefficients gives divisibility of the degree-one Rees generators. -/
theorem reesGenerator_dvd_of_dvd (a b : I) (h : a.val ∣ b.val) :
    Blowup.Charts.Construction.reesGenerator I a ∣ Blowup.Charts.Construction.reesGenerator I b := by
  obtain ⟨c, hc⟩ := h
  refine ⟨algebraMap R (reesAlgebra I) c, ?_⟩
  apply Subtype.ext
  change monomial 1 b.val = monomial 1 a.val * C c
  rw [monomial_mul_C, ← hc]

/-- The chart of a generator of a principal ideal covers its entire blowup. -/
theorem affineBlowup_principal_chart_eq_top (a : I) (hI : I = Ideal.span {a.val}) :
    Proj.basicOpen (ReesGrading.Construction.reesGrade I) (Blowup.Charts.Construction.reesGenerator I a) = ⊤ := by
  apply top_le_iff.mp
  rw [← Blowup.Charts.Construction.affineBlowup_chart_cover I]
  apply iSup_le
  intro b
  apply Proj.basicOpen_mono (ReesGrading.Construction.reesGrade I) (Blowup.Charts.Construction.reesGenerator I a) (Blowup.Charts.Construction.reesGenerator I b)
  apply reesGenerator_dvd_of_dvd
  exact Ideal.mem_span_singleton.mp (hI.le b.property)

/-- The chart of a regular principal ideal is its original coefficient ring. -/
theorem blowupChartConstants_bijective_of_principal (a : I)
    (hI : I = Ideal.span {a.val}) (ha : IsRegular a.val) :
    Function.Bijective (Blowup.Charts.Construction.blowupChartConstants I a) := by
  have hinj : Function.Injective (algebraMap R (Localization.Away a.val)) :=
    IsLocalization.injective (Localization.Away a.val)
      (Submonoid.powers_le.mpr ha.mem_nonZeroDivisors)
  constructor
  · intro r s hrs
    apply hinj
    rw [← Blowup.Charts.Construction.blowupChartToLocalization_constants I a,
      ← Blowup.Charts.Construction.blowupChartToLocalization_constants I a, hrs]
  · intro x
    obtain ⟨n, b, hb, hbx⟩ :=
      (Blowup.Charts.Construction.mem_range_blowupChartToLocalization_iff I a _).mp ⟨x, rfl⟩
    rw [hI, Ideal.span_singleton_pow, Ideal.mem_span_singleton] at hb
    obtain ⟨c, rfl⟩ := hb
    refine ⟨c, Blowup.Charts.Construction.blowupChartToLocalization_injective I a ?_⟩
    rw [Blowup.Charts.Construction.blowupChartToLocalization_constants, ← hbx]
    simp only [Blowup.Charts.Construction.baseFraction, ← Localization.mk_one_eq_algebraMap]
    rw [Localization.mk_eq_mk_iff, Localization.r_iff_exists]
    exact ⟨1, by simp⟩

/-- Blowing up a regular principal ideal is an isomorphism. -/
theorem affineBlowupToSpec_isIso_of_principal (a : I)
    (hI : I = Ideal.span {a.val}) (ha : IsRegular a.val) :
    IsIso (ReesGrading.Construction.affineBlowupToSpec I) := by
  let j : Spec (.of (Blowup.Charts.Construction.blowupChart I a)) ⟶ ReesGrading.Construction.affineBlowup I :=
    Proj.awayι (ReesGrading.Construction.reesGrade I) (Blowup.Charts.Construction.reesGenerator I a) (Blowup.Charts.Construction.reesGenerator_mem I a) (by decide)
  let : IsOpenImmersion j := by
    dsimp [j]
    infer_instance
  let : IsIso j := isIso_of_isOpenImmersion_of_opensRange_eq_top j (by
    dsimp only [j]
    rw [Proj.opensRange_awayι]
    exact affineBlowup_principal_chart_eq_top I a hI)
  let φ : CommRingCat.of R ⟶ CommRingCat.of (Blowup.Charts.Construction.blowupChart I a) :=
    CommRingCat.ofHom (Blowup.Charts.Construction.blowupChartConstants I a)
  let : IsIso φ := (ConcreteCategory.isIso_iff_bijective φ).mpr
    (blowupChartConstants_bijective_of_principal I a hI ha)
  have hj : j ≫ ReesGrading.Construction.affineBlowupToSpec I = Spec.map φ := Blowup.Charts.Construction.affineBlowup_chart_structureMap I a
  let : IsIso (j ≫ ReesGrading.Construction.affineBlowupToSpec I) := by
    rw [hj]
    infer_instance
  exact IsIso.of_isIso_comp_left j (ReesGrading.Construction.affineBlowupToSpec I)

end

end OAI.AlgebraicGeometry.Resolution.Blowups.PrincipalBlowup.Construction
