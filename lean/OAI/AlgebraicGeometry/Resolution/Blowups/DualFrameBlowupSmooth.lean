import OAI.AlgebraicGeometry.Resolution.Blowups.Smooth.BlowupBaseChange
import OAI.AlgebraicGeometry.Resolution.Blowups.Smooth.CoordinateFrame

/-! # Dual Frame Blowup Smooth -/

namespace OAI.AlgebraicGeometry.Resolution.Blowups.DualFrameBlowupSmooth.Construction

noncomputable section

/-! Actual blowups of ideals generated by functions with dual derivations remain smooth. -/

open _root_.CategoryTheory _root_.AlgebraicGeometry

universe u

variable {k A ι : Type u} [CommRing k] [CommRing A] [Algebra k A]
  [Algebra.Smooth k A] [Fintype ι] [DecidableEq ι]

section Coordinates

variable [Algebra (MvPolynomial ι k) A] [IsScalarTower k (MvPolynomial ι k) A]

/-- Dual coordinate derivations make the ambient map to the coordinate
polynomial ring smooth. Actual flat base change then proves blowup smoothness. -/
theorem dual_coordinate_frame_blowup_smooth (D : ι → Derivation k A A)
    (hD : ∀ i j, D i (algebraMap (MvPolynomial ι k) A (MvPolynomial.X j)) =
      if i = j then 1 else 0) :
    Smooth (ReesGrading.Construction.affineBlowupToSpec ((MvPolynomial.idealOfVars ι k).map (algebraMap (MvPolynomial ι k) A)) ≫
      Spec.map (CommRingCat.ofHom (algebraMap k A))) := by
  let : Algebra.Smooth (MvPolynomial ι k) A := Blowups.Smooth.CoordinateFrame.Construction.smooth_over_coordinate_frame D hD
  have h := Blowups.Smooth.BlowupBaseChange.Construction.coordinateCenterBlowup_smooth_of_smooth (R := k) (S := A) (σ := ι)
  rw [← Spec.map_comp] at h
  have he : CommRingCat.ofHom (MvPolynomial.C : k →+* MvPolynomial ι k) ≫
      CommRingCat.ofHom (algebraMap (MvPolynomial ι k) A) =
        CommRingCat.ofHom (algebraMap k A) := by
    apply CommRingCat.hom_ext
    apply RingHom.ext
    intro x
    exact (IsScalarTower.algebraMap_apply k (MvPolynomial ι k) A x).symm
  rw [he] at h
  exact h

end Coordinates

/-- A finite family of functions with dual derivations gives a smooth
actual blowup along its generated ideal, with no preselected polynomial coordinates. -/
theorem dual_derivation_family_blowup_smooth (z : ι → A) (D : ι → Derivation k A A)
    (hD : ∀ i j, D i (z j) = if i = j then 1 else 0) :
    Smooth (ReesGrading.Construction.affineBlowupToSpec (Ideal.span (Set.range z)) ≫
      Spec.map (CommRingCat.ofHom (algebraMap k A))) := by
  let φ : MvPolynomial ι k →ₐ[k] A := MvPolynomial.aeval z
  let : Algebra (MvPolynomial ι k) A := φ.toRingHom.toAlgebra
  let : IsScalarTower k (MvPolynomial ι k) A :=
    IsScalarTower.of_algebraMap_eq (fun x => (φ.commutes x).symm)
  have hframe : ∀ i j, D i (algebraMap (MvPolynomial ι k) A (MvPolynomial.X j)) =
      if i = j then 1 else 0 := by
    intro i j
    change D i ((MvPolynomial.aeval (R := k) z) (MvPolynomial.X j)) = _
    rw [MvPolynomial.aeval_X]
    exact hD i j
  have hmap : (MvPolynomial.idealOfVars ι k).map (algebraMap (MvPolynomial ι k) A) =
      Ideal.span (Set.range z) := by
    change (MvPolynomial.idealOfVars ι k).map (MvPolynomial.aeval (R := k) z).toRingHom = _
    rw [MvPolynomial.idealOfVars, Ideal.map_span, ← Set.range_comp]
    apply congrArg Ideal.span
    apply congrArg Set.range
    funext i
    exact MvPolynomial.aeval_X z i
  have h := dual_coordinate_frame_blowup_smooth D hframe
  rwa [hmap] at h

end

end OAI.AlgebraicGeometry.Resolution.Blowups.DualFrameBlowupSmooth.Construction
