import OAI.AlgebraicGeometry.Resolution.Blowups.PrincipalBlowup
import OAI.AlgebraicGeometry.Resolution.Blowups.Blowup.BaseChange

/-! # Blowup Lift -/

namespace OAI.AlgebraicGeometry.Resolution.Blowups.Blowup.BlowupLift.Construction

noncomputable section

/-! Lifts to blowups when the pulled-back center is regular principal. -/

open _root_.CategoryTheory _root_.CategoryTheory.Limits _root_.AlgebraicGeometry

universe u

variable {R S : Type u} [CommRing R] [CommRing S]
variable (I : Ideal R) (φ : R →+* S)

/-- A morphism of affine bases lifts to the blowup if its extended center
ideal is generated by a non-zero-divisor. -/
def affineBlowupLift (a : I.map φ) (hI : I.map φ = Ideal.span {a.val})
    (ha : IsRegular a.val) : Spec (.of S) ⟶ ReesGrading.Construction.affineBlowup I :=
  letI : IsIso (ReesGrading.Construction.affineBlowupToSpec (I.map φ)) :=
    PrincipalBlowup.Construction.affineBlowupToSpec_isIso_of_principal (I.map φ) a hI ha
  inv (ReesGrading.Construction.affineBlowupToSpec (I.map φ)) ≫ ReesMap.Construction.affineBlowupMap I φ

/-- The constructed lift lies over the original morphism of affine bases. -/
theorem affineBlowupLift_over (a : I.map φ) (hI : I.map φ = Ideal.span {a.val})
    (ha : IsRegular a.val) :
    affineBlowupLift I φ a hI ha ≫ ReesGrading.Construction.affineBlowupToSpec I = Spec.map (CommRingCat.ofHom φ) := by
  let : IsIso (ReesGrading.Construction.affineBlowupToSpec (I.map φ)) :=
    PrincipalBlowup.Construction.affineBlowupToSpec_isIso_of_principal (I.map φ) a hI ha
  unfold affineBlowupLift
  rw [Category.assoc, BaseOpen.Construction.affineBlowupMap_over, IsIso.inv_hom_id_assoc]

/-- Two morphisms into a scheme that is an isomorphism over a given base
change agree if they have the same map into that base change. -/
theorem hom_eq_of_isIso_baseChange
    {B Y U T : Scheme.{u}} (p : B ⟶ Y) (j : U ⟶ Y)
    [IsIso (pullback.snd p j)] (g₁ g₂ : T ⟶ B) (q : T ⟶ U)
    (h₁ : g₁ ≫ p = q ≫ j) (h₂ : g₂ ≫ p = q ≫ j) : g₁ = g₂ := by
  have he : pullback.lift g₁ q h₁ = pullback.lift g₂ q h₂ := by
    apply (cancel_mono (pullback.snd p j)).mp
    simp only [pullback.lift_snd]
  simpa only [pullback.lift_fst] using congrArg (fun g => g ≫ pullback.fst p j) he

/-- A lift into a separated scheme is unique once it is fixed on a dense
open where the structural map is an isomorphism. -/
theorem hom_eq_of_dense_isIso_baseChange
    {B Y U T D : Scheme.{u}} [IsReduced T]
    (p : B ⟶ Y) [IsSeparated p] (j : U ⟶ Y) [IsIso (pullback.snd p j)]
    (ι : D ⟶ T) [IsDominant ι] (g₁ g₂ : T ⟶ B)
    (h : g₁ ≫ p = g₂ ≫ p) (q : D ⟶ U) (hq : ι ≫ g₁ ≫ p = q ≫ j) :
    g₁ = g₂ := by
  apply ext_of_isDominant_of_isSeparated p h ι
  apply hom_eq_of_isIso_baseChange p j (ι ≫ g₁) (ι ≫ g₂) q
  · simpa only [Category.assoc] using hq
  · simpa only [Category.assoc, ← h] using hq

/-- The coefficient map between localizations lies over the original affine map. -/
theorem baseLocalizationMap_naturality (a : R) :
    Spec.map (CommRingCat.ofHom
      (IsLocalization.Away.map (Localization.Away a) (Localization.Away (φ a)) φ a)) ≫
        Blowup.Localization.Construction.baseLocalizationMap a =
      Blowup.Localization.Construction.baseLocalizationMap (φ a) ≫ Spec.map (CommRingCat.ofHom φ) := by
  unfold Blowup.Localization.Construction.baseLocalizationMap
  rw [← Spec.map_comp, ← Spec.map_comp]
  congr 1
  apply CommRingCat.hom_ext
  change (IsLocalization.Away.map (Localization.Away a) (Localization.Away (φ a)) φ a).comp
    (algebraMap R (Localization.Away a)) = (algebraMap S (Localization.Away (φ a))).comp φ
  unfold IsLocalization.Away.map
  exact IsLocalization.map_comp _

/-- For an integral source and Noetherian integral affine base, lifts to a
blowup are unique whenever some center section remains nonzero on the source. -/
theorem affineBlowup_hom_ext [IsDomain R] [IsNoetherianRing R] [IsDomain S]
    (g₁ g₂ : Spec (.of S) ⟶ ReesGrading.Construction.affineBlowup I)
    (h₁ : g₁ ≫ ReesGrading.Construction.affineBlowupToSpec I = Spec.map (CommRingCat.ofHom φ))
    (h₂ : g₂ ≫ ReesGrading.Construction.affineBlowupToSpec I = Spec.map (CommRingCat.ofHom φ))
    (a : I) (ha : φ a.val ≠ 0) : g₁ = g₂ := by
  have ha0 : a.val ≠ 0 := by
    intro hzero
    exact ha (by rw [hzero, map_zero])
  let : IsDomain (Localization.Away (φ a.val)) := Localization.Away.isDomain ha
  let : IsIso (pullback.snd (ReesGrading.Construction.affineBlowupToSpec I) (Blowup.Localization.Construction.baseLocalizationMap a.val)) :=
    Birational.Construction.affineBlowup_localization_isIso I a ha0
  let : IsDominant (Blowup.Localization.Construction.baseLocalizationMap (φ a.val)) := by
    constructor
    exact (Blowup.Localization.Construction.baseLocalizationMap (φ a.val)).opensRange.isOpen.dense
      (Set.range_nonempty (Blowup.Localization.Construction.baseLocalizationMap (φ a.val)))
  apply hom_eq_of_dense_isIso_baseChange (ReesGrading.Construction.affineBlowupToSpec I) (Blowup.Localization.Construction.baseLocalizationMap a.val)
    (Blowup.Localization.Construction.baseLocalizationMap (φ a.val)) g₁ g₂ (h₁.trans h₂.symm)
    (Spec.map (CommRingCat.ofHom
      (IsLocalization.Away.map (Localization.Away a.val) (Localization.Away (φ a.val)) φ a.val)))
  rw [h₁]
  exact (baseLocalizationMap_naturality φ a.val).symm

/-- A nonzero extended ideal contains the nonzero image of some original section. -/
theorem exists_ideal_section_image_ne_zero (hI : I.map φ ≠ ⊥) :
    ∃ a : I, φ a.val ≠ 0 := by
  by_contra h
  push Not at h
  apply hI
  rw [Ideal.map_eq_bot_iff_le_ker]
  intro a ha
  exact h ⟨a, ha⟩

/-- For integral affine schemes, a regular principal pullback of the center
gives a unique lift to the blowup. -/
theorem affineBlowup_existsUnique_lift
    [IsDomain R] [IsNoetherianRing R] [IsDomain S]
    (a : I.map φ) (hI : I.map φ = Ideal.span {a.val}) (ha : IsRegular a.val) :
    ∃! g : Spec (.of S) ⟶ ReesGrading.Construction.affineBlowup I,
      g ≫ ReesGrading.Construction.affineBlowupToSpec I = Spec.map (CommRingCat.ofHom φ) := by
  have hIS : I.map φ ≠ ⊥ := by
    intro hzero
    exact (nonZeroDivisors.ne_zero ha.mem_nonZeroDivisors)
      (Ideal.mem_bot.mp (hzero.le a.property))
  obtain ⟨b, hb⟩ := exists_ideal_section_image_ne_zero I φ hIS
  refine ⟨affineBlowupLift I φ a hI ha, affineBlowupLift_over I φ a hI ha, ?_⟩
  intro g hg
  exact affineBlowup_hom_ext I φ g (affineBlowupLift I φ a hI ha) hg
    (affineBlowupLift_over I φ a hI ha) b hb

end

end OAI.AlgebraicGeometry.Resolution.Blowups.Blowup.BlowupLift.Construction
