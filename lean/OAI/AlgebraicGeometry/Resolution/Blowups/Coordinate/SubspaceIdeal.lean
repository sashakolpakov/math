import OAI.AlgebraicGeometry.Resolution.Blowups.TranslationInvariantPolynomialIdeal

/-! # Subspace Ideal -/

namespace OAI.AlgebraicGeometry.Resolution.Blowups.Coordinate.SubspaceIdeal.Construction

noncomputable section

section

/-! Translation-invariant centers contained in a coordinate subspace are either that whole subspace or empty. -/

open _root_.MvPolynomial

def polynomialCoordinateProjection {σ τ R : Type*} [CommRing R] :
    MvPolynomial (σ ⊕ τ) R →ₐ[R] MvPolynomial τ R :=
  aeval (Sum.elim (fun _ => 0) X)

theorem polynomialCoordinateProjection_rename {σ τ R : Type*} [CommRing R]
    (p : MvPolynomial τ R) : polynomialCoordinateProjection (rename (Sum.inr : τ → σ ⊕ τ) p) = p := by
  have h : (polynomialCoordinateProjection (σ := σ) (τ := τ) (R := R)).comp
      (rename Sum.inr) = AlgHom.id R _ := by
    ext i
    simp [polynomialCoordinateProjection]
  exact DFunLike.congr_fun h p

theorem polynomialCoordinateProjection_surjective {σ τ R : Type*} [CommRing R] :
    Function.Surjective (polynomialCoordinateProjection (σ := σ) (τ := τ) (R := R)) :=
  fun p => ⟨rename Sum.inr p, polynomialCoordinateProjection_rename p⟩

theorem polynomialCoordinateProjection_translation {σ τ R : Type*} [CommRing R] (a : τ → R) :
    (polynomialCoordinateProjection (σ := σ) (τ := τ) (R := R)).toRingHom.comp
        (PolynomialTranslation.Construction.polynomialTranslate (Sum.elim (fun _ => 0) a)).toRingHom =
      (PolynomialTranslation.Construction.polynomialTranslate a).toRingHom.comp polynomialCoordinateProjection.toRingHom := by
  apply MvPolynomial.ringHom_ext
  · intro r
    simp [polynomialCoordinateProjection]
  · intro i
    cases i <;> simp [polynomialCoordinateProjection]

theorem coordinate_subspace_invariant_center_eq_or_top
    {σ τ k : Type*} [Finite τ] [Field k] [IsAlgClosed k] [Infinite k]
    (I : Ideal (MvPolynomial (σ ⊕ τ) k))
    (hker : RingHom.ker polynomialCoordinateProjection.toRingHom ≤ I)
    (hI : ∀ a : τ → k, I.map (PolynomialTranslation.Construction.polynomialTranslate (Sum.elim (fun _ => 0) a)).toRingHom ≤ I) :
    I = RingHom.ker polynomialCoordinateProjection.toRingHom ∨ I = ⊤ := by
  let q := polynomialCoordinateProjection (σ := σ) (τ := τ) (R := k)
  have hstable (a : τ → k) : (I.map q.toRingHom).map (PolynomialTranslation.Construction.polynomialTranslate a).toRingHom ≤ I.map q.toRingHom := by
    rw [Ideal.map_map, ← polynomialCoordinateProjection_translation, ← Ideal.map_map]
    exact Ideal.map_mono (hI a)
  rcases TranslationInvariantPolynomialIdeal.Construction.translation_invariant_polynomial_ideal_eq_bot_or_top (I.map q.toRingHom) hstable with hzero | htop
  · exact Or.inl (le_antisymm ((Ideal.map_eq_bot_iff_le_ker q.toRingHom).mp hzero) hker)
  · right
    have h := congrArg (Ideal.comap q.toRingHom) htop
    rw [Ideal.comap_map_of_surjective q.toRingHom polynomialCoordinateProjection_surjective,
      Ideal.comap_top, ← RingHom.ker_eq_comap_bot, sup_of_le_left hker] at h
    exact h

end

/-! The coordinate projection kernel is exactly the ideal generated by the normal coordinates. -/

open _root_.MvPolynomial

theorem polynomialCoordinateProjection_ker_eq_span {σ τ R : Type*} [CommRing R] :
    RingHom.ker (polynomialCoordinateProjection (σ := σ) (τ := τ) (R := R)).toRingHom =
      Ideal.span (Set.range (fun i : σ => (X (Sum.inl i) : MvPolynomial (σ ⊕ τ) R))) := by
  let I : Ideal (MvPolynomial (σ ⊕ τ) R) := Ideal.span (Set.range (fun i : σ => X (Sum.inl i)))
  let q := polynomialCoordinateProjection (σ := σ) (τ := τ) (R := R)
  let s : MvPolynomial τ R →ₐ[R] (MvPolynomial (σ ⊕ τ) R ⧸ I) :=
    aeval (fun i => Ideal.Quotient.mk I (X (Sum.inr i)))
  have hsq : s.comp q = Ideal.Quotient.mkₐ R I := by
    apply MvPolynomial.algHom_ext
    intro i
    cases i with
    | inl i =>
        change s (q (X (Sum.inl i))) = Ideal.Quotient.mk I (X (Sum.inl i))
        have hz : q (X (Sum.inl i)) = 0 := by simp [q, polynomialCoordinateProjection]
        rw [hz, map_zero]
        have hi : X (Sum.inl i) ∈ I := Ideal.subset_span ⟨i, rfl⟩
        exact (Ideal.Quotient.eq_zero_iff_mem.mpr hi).symm
    | inr i => simp [s, q, polynomialCoordinateProjection]
  apply le_antisymm
  · intro p hp
    apply Ideal.Quotient.eq_zero_iff_mem.mp
    have he := DFunLike.congr_fun hsq p
    change s (q p) = Ideal.Quotient.mk I p at he
    rw [← he, show q p = 0 from hp, map_zero]
  · apply Ideal.span_le.mpr
    rintro p ⟨i, rfl⟩
    change q (X (Sum.inl i)) = 0
    simp [q, polynomialCoordinateProjection]

theorem polynomialCoordinateProjection_ker_ne_top {σ τ R : Type*} [CommRing R] [Nontrivial R] :
    RingHom.ker (polynomialCoordinateProjection (σ := σ) (τ := τ) (R := R)).toRingHom ≠ ⊤ := by
  intro h
  have h1 : (1 : MvPolynomial (σ ⊕ τ) R) ∈ RingHom.ker polynomialCoordinateProjection.toRingHom := by
    rw [h]
    trivial
  change polynomialCoordinateProjection 1 = 0 at h1
  exact one_ne_zero (by simpa only [map_one] using h1)

theorem polynomialCoordinateProjection_ker_ne_bot {σ τ R : Type*} [CommRing R] [Nontrivial R] [Nonempty σ] :
    RingHom.ker (polynomialCoordinateProjection (σ := σ) (τ := τ) (R := R)).toRingHom ≠ ⊥ := by
  obtain ⟨i⟩ := ‹Nonempty σ›
  intro h
  have hi : (X (Sum.inl i) : MvPolynomial (σ ⊕ τ) R) ∈ RingHom.ker polynomialCoordinateProjection.toRingHom := by
    change polynomialCoordinateProjection (X (Sum.inl i)) = 0
    simp [polynomialCoordinateProjection]
  rw [h, Ideal.mem_bot] at hi
  exact X_ne_zero (Sum.inl i) hi

end

end OAI.AlgebraicGeometry.Resolution.Blowups.Coordinate.SubspaceIdeal.Construction
