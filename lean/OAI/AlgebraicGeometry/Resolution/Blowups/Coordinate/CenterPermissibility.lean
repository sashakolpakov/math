import OAI.AlgebraicGeometry.Resolution.Blowups.ClosedWeightedOrder
import OAI.AlgebraicGeometry.Resolution.Blowups.EulerOrderCriterion
import OAI.AlgebraicGeometry.Resolution.Blowups.Etale.CoordinateCenterReduced
import OAI.AlgebraicGeometry.Resolution.Blowups.Etale.CoefficientStep

/-! # Center Permissibility -/

namespace OAI.AlgebraicGeometry.Resolution.Blowups.Coordinate.CenterPermissibility.Construction

noncomputable section

/-! Closed-point order bounds imply actual ideal-power containment along smooth coordinate centers. -/

section

variable {A ι : Type*} [CommRing A] [Algebra ℚ A] [IsJacobsonRing A]
  [Fintype ι] [DecidableEq ι]

/-- For a reduced center with a dual coordinate frame, lying in the high-order
locus at every closed point is equivalent to ideal-power permissibility. -/
theorem coordinateCenter_permissible_iff_closedPoint_order
    (z : ι → A) (D : ι → Derivation ℤ A A)
    (hD : ∀ i j, D i (z j) = if i = j then 1 else 0)
    (hI : (Ideal.span (Set.range z)).IsRadical) (J : Ideal A) (b : ℕ) :
    J ≤ Ideal.span (Set.range z) ^ (b + 1) ↔
      ∀ (q : Ideal A) [q.IsMaximal], Ideal.span (Set.range z) ≤ q →
        J.map (algebraMap A (Localization.AtPrime q)) ≤
          IsLocalRing.maximalIdeal (Localization.AtPrime q) ^ (b + 1) := by
  constructor
  · intro h q _ hq
    exact (ClosedWeightedOrder.Construction.closedPoint_local_order_iff J q (b + 1)).mpr
      (h.trans (pow_le_pow_left' hq (b + 1)))
  · intro h
    apply (EulerOrderCriterion.Construction.coordinate_ideal_order_iff_differentialIdeal z D hD J b).mpr
    rw [← IsJacobsonRing.out (inferInstance : IsJacobsonRing A) hI]
    apply le_sInf
    intro q hq
    let : q.IsMaximal := hq.2
    have hJq := (ClosedWeightedOrder.Construction.closedPoint_local_order_iff J q (b + 1)).mp (h q hq.1)
    simpa only [pow_one] using DifferentialIdealTransform.Construction.iteratedDifferentialIdeal_le_pow q J 1 b
      (by simpa only [Nat.add_comm 1 b] using hJq)

end

universe u

variable {σ K S : Type u} [Field K] [IsAlgClosed K] [CharZero K] [CommRing S]
  [Finite σ] [DecidableEq σ]
  [Algebra (MvPolynomial σ K) S] [Algebra.Etale (MvPolynomial σ K) S]

omit [IsAlgClosed K] [CharZero K] [Finite σ] [DecidableEq σ]
    [Algebra.Etale (MvPolynomial σ K) S] in
/-- The actual extended coordinate ideal is generated by the selected family. -/
theorem etaleSubsetCoordinateIdeal_eq_span (C : Finset σ) :
    (SubsetCoordinateBlowup.Construction.subsetCoordinateIdeal C).map (algebraMap (MvPolynomial σ K) S) =
      Ideal.span (Set.range (fun i : C => algebraMap (MvPolynomial σ K) S (MvPolynomial.X i.val))) := by
  rw [SubsetCoordinateBlowup.Construction.subsetCoordinateIdeal, Ideal.map_span]
  congr 1
  ext s
  constructor
  · rintro ⟨p, ⟨i, hi, rfl⟩, rfl⟩
    exact ⟨⟨i, hi⟩, rfl⟩
  · rintro ⟨i, rfl⟩
    exact ⟨MvPolynomial.X i.val, ⟨i.val, i.property, rfl⟩, rfl⟩

/-- For the actual smooth center cut out by any subset of étale coordinates,
pointwise order bounds supply the ideal containment needed by every Rees chart. -/
theorem etale_coordinate_center_permissible_iff_closedPoint_order
    (C : Finset σ) (J : Ideal S) (b : ℕ) :
    J ≤ ((SubsetCoordinateBlowup.Construction.subsetCoordinateIdeal C).map (algebraMap (MvPolynomial σ K) S)) ^ (b + 1) ↔
      ∀ (q : Ideal S) [q.IsMaximal],
        (SubsetCoordinateBlowup.Construction.subsetCoordinateIdeal C).map (algebraMap (MvPolynomial σ K) S) ≤ q →
          J.map (algebraMap S (Localization.AtPrime q)) ≤
            IsLocalRing.maximalIdeal (Localization.AtPrime q) ^ (b + 1) := by
  let : Algebra ℚ S := ((algebraMap (MvPolynomial σ K) S).comp
    ((MvPolynomial.C : K →+* MvPolynomial σ K).comp (algebraMap ℚ K))).toAlgebra
  let : IsJacobsonRing S := isJacobsonRing_of_finiteType (A := MvPolynomial σ K)
  let z : C → S := fun i => algebraMap (MvPolynomial σ K) S (MvPolynomial.X i.val)
  let D : C → Derivation ℤ S S := fun i => Blowups.Etale.LocalOrder.Construction.etalePolynomialCoordinateDerivation (K := K) i.val
  have hD : ∀ i j, D i (z j) = if i = j then 1 else 0 := by
    intro i j
    simpa only [Subtype.ext_iff] using
      Blowups.Etale.CoefficientStep.Construction.etalePolynomialCoordinateDerivation_X (K := K) (S := S) i.val j.val
  have hI : (Ideal.span (Set.range z)).IsRadical := by
    rw [← etaleSubsetCoordinateIdeal_eq_span]
    exact Blowups.Etale.CoordinateCenterReduced.Construction.etaleSubsetCoordinateIdeal_isRadical C
  rw [etaleSubsetCoordinateIdeal_eq_span]
  exact coordinateCenter_permissible_iff_closedPoint_order z D hD hI J b

end

end OAI.AlgebraicGeometry.Resolution.Blowups.Coordinate.CenterPermissibility.Construction
