import OAI.AlgebraicGeometry.Resolution.Blowups.PolynomialBlowupChart

/-! # Polynomial Transform Ideals -/

namespace OAI.AlgebraicGeometry.Resolution.Blowups.PolynomialTransformIdeals.Construction

noncomputable section

/-! Coefficient systems and controlled ideals on actual polynomial blowup charts. -/

open _root_.Polynomial

universe u

variable {R S : Type u} [CommRing R] [CommRing S]

/-- Principal ideal quotients commute with ring isomorphisms. -/
theorem map_colon_principal_equiv (e : R ≃+* S) (J : Ideal R) (c : R) :
    (J.colon (Ideal.span {c})).map e.toRingHom =
      (J.map e.toRingHom).colon (Ideal.span {e c}) := by
  ext y
  have he (L : Ideal R) : L.map e.toRingHom = L.comap e.symm := Ideal.map_comap_of_equiv e
  simp only [he, Ideal.mem_comap, Ideal.mem_colon_span_singleton,
    map_mul, RingEquiv.symm_apply_apply]

/-- An ideal map is generated by the images of its sections. -/
theorem ideal_map_eq_span_range (J : Ideal R) (φ : R →+* S) :
    J.map φ = Ideal.span (Set.range (fun p : J => φ p.val)) := by
  apply le_antisymm
  · rw [Ideal.map_le_iff_le_comap]
    intro p hp
    exact Ideal.subset_span ⟨⟨p, hp⟩, rfl⟩
  · apply Ideal.span_le.mpr
    rintro y ⟨p, rfl⟩
    exact Ideal.mem_map_of_mem φ p.property

/-- A regular common factor can be divided from all generators of an
extended ideal, giving generators of its ideal quotient. -/
theorem ideal_colon_eq_span_divisions (J : Ideal R) (φ : R →+* S) (c : S)
    (hc : IsRegular c) (q : J → S) (hq : ∀ p, φ p.val = c * q p) :
    (J.map φ).colon (Ideal.span {c}) = Ideal.span (Set.range q) := by
  rw [ideal_map_eq_span_range]
  have he : (fun p : J => φ p.val) = fun p => c * q p := funext hq
  rw [he, ResidualCoefficientTransform.Construction.span_range_mul_left, ResidualCoefficientTransform.Construction.colon_principal_mul_of_regular _ _ hc]

/-- The `j`th coefficient ideal of all sections of a polynomial ideal. -/
def polynomialCoefficientIdeal (J : Ideal R[X]) (j : ℕ) : Ideal R :=
  Ideal.span (Set.range (fun p : J => p.val.coeff j))

/-- Order of an ideal generated by any family is detected coefficient by
coefficient, with the respective exponents. -/
theorem span_polynomials_le_centerPower_iff {ι : Type*}
    (q : ι → R[X]) (K : Ideal R) (b : ℕ) :
    Ideal.span (Set.range q) ≤ Coefficient.Filtration.Construction.polynomialCenterIdeal K ^ b ↔
      ∀ j < b, Ideal.span (Set.range (fun p => (q p).coeff j)) ≤ K ^ (b - j) := by
  constructor
  · intro h j _
    apply Ideal.span_le.mpr
    rintro c ⟨p, rfl⟩
    exact (Coefficient.Filtration.Construction.polynomial_mem_centerPower_iff K b (q p)).mp (h (Ideal.subset_span ⟨p, rfl⟩)) j
  · intro h
    apply Ideal.span_le.mpr
    rintro f ⟨p, rfl⟩
    apply (Coefficient.Filtration.Construction.polynomial_mem_centerPower_iff K b (q p)).mpr
    intro j
    by_cases hj : j < b
    · exact h j hj (Ideal.subset_span ⟨p, rfl⟩)
    · simp only [Nat.sub_eq_zero_of_le (Nat.le_of_not_gt hj), pow_zero, Ideal.one_eq_top]
      trivial

variable (I : Ideal R) (J : Ideal R[X]) (a : I) (b : ℕ)
variable (hJ : J ≤ Coefficient.Filtration.Construction.polynomialCenterIdeal I ^ b)

/-- Divide each original section by the required exceptional power. -/
def polynomialChartTransformSection (p : J) : (Blowup.Charts.Construction.blowupChart I a)[X] :=
  Classical.choose (PolynomialControlledTransform.Construction.blowupChart_existsUnique_polynomialControlledTransform I a p.val b
    (hJ p.property)).exists

theorem polynomialChartTransformSection_spec (p : J) :
    PolynomialControlledTransform.Construction.scaledPolynomialMap (Blowup.Charts.Construction.blowupChartConstants I a) (Blowup.Charts.Construction.blowupChartConstants I a a.val) p.val =
      C ((Blowup.Charts.Construction.blowupChartConstants I a a.val) ^ b) * polynomialChartTransformSection I J a b hJ p :=
  Classical.choose_spec (PolynomialControlledTransform.Construction.blowupChart_existsUnique_polynomialControlledTransform I a p.val b
    (hJ p.property)).exists

/-- In the actual chart identification, the controlled transform is exactly
the ideal generated by the divided sections. -/
theorem polynomialBlowup_controlledIdeal_eq :
    (ControlledTransform.Construction.blowupControlledTransform (Coefficient.Filtration.Construction.polynomialCenterIdeal I) J b (PolynomialBlowupChart.Construction.polynomialCenterElement I a)).map
        (PolynomialBlowupChart.Construction.polynomialBlowupChartEquiv I a).toRingHom =
      Ideal.span (Set.range (polynomialChartTransformSection I J a b hJ)) := by
  unfold ControlledTransform.Construction.blowupControlledTransform
  have hcolon := map_colon_principal_equiv (PolynomialBlowupChart.Construction.polynomialBlowupChartEquiv I a)
    (J.map (Blowup.Charts.Construction.blowupChartConstants (Coefficient.Filtration.Construction.polynomialCenterIdeal I) (PolynomialBlowupChart.Construction.polynomialCenterElement I a)))
    (Blowup.Charts.Construction.blowupChartConstants (Coefficient.Filtration.Construction.polynomialCenterIdeal I) (PolynomialBlowupChart.Construction.polynomialCenterElement I a)
      (PolynomialBlowupChart.Construction.polynomialCenterElement I a).val ^ b)
  rw [hcolon, Ideal.map_map]
  have hbase : (PolynomialBlowupChart.Construction.polynomialBlowupChartEquiv I a).toRingHom.comp
      (Blowup.Charts.Construction.blowupChartConstants (Coefficient.Filtration.Construction.polynomialCenterIdeal I) (PolynomialBlowupChart.Construction.polynomialCenterElement I a)) =
        PolynomialControlledTransform.Construction.scaledPolynomialMap (Blowup.Charts.Construction.blowupChartConstants I a) (Blowup.Charts.Construction.blowupChartConstants I a a.val) := by
    apply RingHom.ext
    intro p
    exact PolynomialBlowupChart.Construction.polynomialBlowupChartEquiv_base I a p
  have hparam : PolynomialBlowupChart.Construction.polynomialBlowupChartEquiv I a
      (Blowup.Charts.Construction.blowupChartConstants (Coefficient.Filtration.Construction.polynomialCenterIdeal I) (PolynomialBlowupChart.Construction.polynomialCenterElement I a)
        (PolynomialBlowupChart.Construction.polynomialCenterElement I a).val ^ b) = C ((Blowup.Charts.Construction.blowupChartConstants I a a.val) ^ b) := by
    rw [map_pow (PolynomialBlowupChart.Construction.polynomialBlowupChartEquiv I a)]
    change (PolynomialBlowupChart.Construction.polynomialBlowupChartEquiv I a (PolynomialBlowupChart.Construction.polynomialBlowupBase I a (C a.val))) ^ b = _
    rw [PolynomialBlowupChart.Construction.polynomialBlowupChartEquiv_base, map_C, C_comp,
      map_pow (C : Blowup.Charts.Construction.blowupChart I a →+* (Blowup.Charts.Construction.blowupChart I a)[X])]
  rw [hbase, hparam]
  exact ideal_colon_eq_span_divisions J _ _
    (PolynomialControlledTransform.Construction.polynomial_C_regular _ ((ExceptionalIdeal.Construction.blowupChart_exceptionalParameter_regular I a).pow b))
    (polynomialChartTransformSection I J a b hJ)
    (polynomialChartTransformSection_spec I J a b hJ)

/-- Each coefficient system transforms with its own control exponent `b-j`. -/
theorem polynomialBlowup_controlledCoefficient_eq (j : ℕ) (hj : j ≤ b) :
    ControlledTransform.Construction.blowupControlledTransform I (polynomialCoefficientIdeal J j) (b - j) a =
      Ideal.span (Set.range (fun p => (polynomialChartTransformSection I J a b hJ p).coeff j)) :=
  ResidualCoefficientTransform.Construction.coefficientIdeal_controlledTransform (Blowup.Charts.Construction.blowupChartConstants I a) (fun p : J => p.val)
    (polynomialChartTransformSection I J a b hJ) (Blowup.Charts.Construction.blowupChartConstants I a a.val) b j
    (ExceptionalIdeal.Construction.blowupChart_exceptionalParameter_regular I a) hj
    (polynomialChartTransformSection_spec I J a b hJ)

include hJ in
/-- On the distinguished hypersurface in an actual blowup chart, the order
of the controlled ideal is detected by the controlled coefficient system. -/
theorem polynomialBlowup_controlled_order_iff (K : Ideal (Blowup.Charts.Construction.blowupChart I a)) :
    (ControlledTransform.Construction.blowupControlledTransform (Coefficient.Filtration.Construction.polynomialCenterIdeal I) J b (PolynomialBlowupChart.Construction.polynomialCenterElement I a)).map
        (PolynomialBlowupChart.Construction.polynomialBlowupChartEquiv I a).toRingHom ≤ Coefficient.Filtration.Construction.polynomialCenterIdeal K ^ b ↔
      ∀ j < b, ControlledTransform.Construction.blowupControlledTransform I (polynomialCoefficientIdeal J j) (b - j) a ≤
        K ^ (b - j) := by
  rw [polynomialBlowup_controlledIdeal_eq I J a b hJ, span_polynomials_le_centerPower_iff]
  constructor
  · intro h j hj
    rw [polynomialBlowup_controlledCoefficient_eq I J a b hJ j (Nat.le_of_lt hj)]
    exact h j hj
  · intro h j hj
    rw [← polynomialBlowup_controlledCoefficient_eq I J a b hJ j (Nat.le_of_lt hj)]
    exact h j hj

end

end OAI.AlgebraicGeometry.Resolution.Blowups.PolynomialTransformIdeals.Construction
