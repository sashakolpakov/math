import OAI.AlgebraicGeometry.Resolution.Blowups.Curve.IntrinsicStep

/-! # Center Local Frame -/

namespace OAI.AlgebraicGeometry.Resolution.Blowups.Curve.CenterLocalFrame.Construction

noncomputable section

/-! Explicit local coordinate frames for the intrinsic centers on smooth affine curves. -/

universe u

variable (k : Type u) {R : Type u} [Field k] [IsAlgClosed k] [CommRing R]
  [Algebra k R] [Algebra.Smooth k R] [Algebra ℚ R] [IsNoetherianRing R]

/-- On a derivative neighborhood of a curve, every center containing the
chosen equation has a two-open refinement: it is empty on one member and
is generated by a function with a dual derivation on the other. -/
theorem curve_center_derivative_local_frame
    (hd : ringKrullDim R ≤ 1) (I : Ideal R) (D : Derivation k R R) (z : I) :
    let A := DifferentialHypersurfaceNeighborhood.Construction.derivationNeighborhood D z.val
    let IA := I.map (algebraMap R A)
    ∃ r : A, r ∈ IA ∧
      IA.map (algebraMap A (Localization.Away r)) = ⊤ ∧
      IA.map (algebraMap A (Localization.Away (1 - r))) =
        Ideal.span {algebraMap A (Localization.Away (1 - r)) (algebraMap R A z.val)} ∧
      ∃ E : Derivation k (Localization.Away (1 - r)) (Localization.Away (1 - r)),
        E (algebraMap A (Localization.Away (1 - r)) (algebraMap R A z.val)) = 1 := by
  let A := DifferentialHypersurfaceNeighborhood.Construction.derivationNeighborhood D z.val
  let H := DifferentialHypersurfaceNeighborhood.Construction.differentialHypersurfaceNeighborhood D z.val
  let : Algebra.Smooth k H := DifferentialHypersurfaceNeighborhood.Construction.differentialHypersurfaceNeighborhood_smooth D z.val
  let : IsReduced H := Blowups.Smooth.AlgebraReduced.Construction.smooth_algebra_isReduced k
  have hdH : ringKrullDim H ≤ 0 :=
    HypersurfaceDimension.Construction.differentialHypersurfaceNeighborhood_dimension_induction D z.val 0 (by simpa using hd)
  obtain ⟨r, hr, hgen, hrel⟩ := IdempotentQuotientCenter.Construction.zero_dimensional_hypersurface_center_generators
    (algebraMap R A z.val) hdH (I.map (algebraMap R A)) (Ideal.mem_map_of_mem _ z.property)
  refine ⟨r, hr, IdempotentQuotientCenter.Construction.center_map_away_member_eq_top _ r hr,
    IdempotentQuotientCenter.Construction.idempotent_quotient_center_map_complement _ r (algebraMap R A z.val) hgen hrel, ?_⟩
  let S := Localization.Away (1 - r)
  let : Algebra.FormallyEtale A S := Algebra.FormallyEtale.of_isLocalization (Submonoid.powers (1 - r))
  refine ⟨Etale.Derivation.Construction.extendEtaleRingDerivation (S := S) (NeighborhoodCoefficientOrder.Construction.normalizedNeighborhoodDerivation D z.val), ?_⟩
  rw [Etale.Derivation.Construction.extendEtaleRingDerivation_algebraMap, NeighborhoodCoefficientOrder.Construction.normalizedNeighborhoodDerivation_equation, map_one]

end

end OAI.AlgebraicGeometry.Resolution.Blowups.Curve.CenterLocalFrame.Construction
