import OAI.AlgebraicGeometry.Resolution.Blowups.Blowup.Charts
import Mathlib.Algebra.Regular.Basic

/-! # Exceptional Ideal -/

namespace OAI.AlgebraicGeometry.Resolution.Blowups.ExceptionalIdeal.Construction

noncomputable section

/-! Local principalization of the center ideal by the Rees blowup. -/

open _root_.Polynomial _root_.CategoryTheory _root_.AlgebraicGeometry

universe u

variable {R : Type u} [CommRing R] (I : Ideal R)

/-- The element `b/a` of the Rees blowup chart, represented homogeneously. -/
def blowupChartRatio (a b : I) : Blowup.Charts.Construction.blowupChart I a :=
  HomogeneousLocalization.Away.mk (ReesGrading.Construction.reesGrade I) (Blowup.Charts.Construction.reesGenerator_mem I a) 1
    (Blowup.Charts.Construction.reesGenerator I b) (by simpa using Blowup.Charts.Construction.reesGenerator_mem I b)

theorem blowupChartToLocalization_ratio (a b : I) :
    Blowup.Charts.Construction.blowupChartToLocalization I a (blowupChartRatio I a b) = Blowup.Charts.Construction.baseFraction a.val 1 b.val := by
  unfold blowupChartRatio
  rw [Blowup.Charts.Construction.blowupChartToLocalization_mk]
  simp [Blowup.Charts.Construction.baseFraction, Blowup.Charts.Construction.reesGenerator]

/-- Multiplying the chart ratio `b/a` by the exceptional parameter `a` gives `b`. -/
theorem blowupChartConstants_mul_ratio (a b : I) :
    Blowup.Charts.Construction.blowupChartConstants I a a.val * blowupChartRatio I a b = Blowup.Charts.Construction.blowupChartConstants I a b.val := by
  apply Blowup.Charts.Construction.blowupChartToLocalization_injective I a
  rw [map_mul, Blowup.Charts.Construction.blowupChartToLocalization_constants, blowupChartToLocalization_ratio,
    Blowup.Charts.Construction.blowupChartToLocalization_constants]
  simp only [Blowup.Charts.Construction.baseFraction, ← Localization.mk_one_eq_algebraMap, Localization.mk_mul]
  rw [Localization.mk_eq_mk_iff, Localization.r_iff_exists]
  refine ⟨1, ?_⟩
  simp

/-- On every Rees chart, the extended center ideal is generated by its
distinguished exceptional parameter. -/
theorem blowupChart_extendedIdeal (a : I) :
    I.map (Blowup.Charts.Construction.blowupChartConstants I a) = Ideal.span {Blowup.Charts.Construction.blowupChartConstants I a a.val} := by
  apply le_antisymm
  · rw [Ideal.map_le_iff_le_comap]
    intro b hb
    change Blowup.Charts.Construction.blowupChartConstants I a b ∈ Ideal.span {Blowup.Charts.Construction.blowupChartConstants I a a.val}
    rw [Ideal.mem_span_singleton]
    exact ⟨blowupChartRatio I a ⟨b, hb⟩, (blowupChartConstants_mul_ratio I a ⟨b, hb⟩).symm⟩
  · apply Ideal.span_le.mpr
    intro b hb
    obtain rfl := Set.mem_singleton_iff.mp hb
    exact Ideal.mem_map_of_mem (Blowup.Charts.Construction.blowupChartConstants I a) a.property

/-- The exceptional parameter is a non-zero-divisor on its chart, even when
the original coefficient ring has zero divisors. -/
theorem blowupChart_exceptionalParameter_regular (a : I) :
    IsRegular (Blowup.Charts.Construction.blowupChartConstants I a a.val) := by
  have hc : ∀ b : Blowup.Charts.Construction.blowupChart I a, Commute (Blowup.Charts.Construction.blowupChartConstants I a a.val) b :=
    fun b => mul_comm _ b
  apply (Commute.isRegular_iff hc).mpr
  intro x y hxy
  apply Blowup.Charts.Construction.blowupChartToLocalization_injective I a
  apply (IsLocalization.Away.algebraMap_isUnit (S := Localization.Away a.val) a.val).isRegular.left
  simpa only [map_mul, Blowup.Charts.Construction.blowupChartToLocalization_constants] using
    congrArg (Blowup.Charts.Construction.blowupChartToLocalization I a) hxy

end

end OAI.AlgebraicGeometry.Resolution.Blowups.ExceptionalIdeal.Construction
