import OAI.AlgebraicGeometry.Resolution.Blowups.PrincipalBlowup
import OAI.AlgebraicGeometry.Resolution.Blowups.HomogeneousLocalization

/-! # Chart Lift -/

namespace OAI.AlgebraicGeometry.Resolution.Blowups.ChartLift.Construction

noncomputable section

/-! Universal maps from affine blowup chart rings. -/

universe u

variable {R S : Type u} [CommRing R] [CommRing S]

/-- Coefficient extension induces a map of the corresponding affine charts. -/
def blowupChartMap (I : Ideal R) (φ : R →+* S) (a : I) :
    Blowup.Charts.Construction.blowupChart I a →+*
      Blowup.Charts.Construction.blowupChart (I.map φ) ⟨φ a.val, Ideal.mem_map_of_mem φ a.property⟩ :=
  HomogeneousLocalization.map (ReesMap.Construction.reesGradedMap I φ) (by
    rintro _ ⟨n, rfl⟩
    refine ⟨n, ?_⟩
    change (Blowup.Charts.Construction.reesGenerator (I.map φ) ⟨φ a.val, Ideal.mem_map_of_mem φ a.property⟩) ^ n =
      ReesMap.Construction.reesGradedMap I φ ((Blowup.Charts.Construction.reesGenerator I a) ^ n)
    rw [map_pow]
    congr 1
    exact (ReesMap.Construction.reesRingMap_generator I φ a).symm)

/-- Chart extension agrees with the given map on the base coefficients. -/
theorem blowupChartMap_constants (I : Ideal R) (φ : R →+* S) (a : I) (r : R) :
    blowupChartMap I φ a (Blowup.Charts.Construction.blowupChartConstants I a r) =
      Blowup.Charts.Construction.blowupChartConstants (I.map φ) ⟨φ a.val, Ideal.mem_map_of_mem φ a.property⟩ (φ r) := by
  apply HomogeneousLocalization.val_injective
  change (HomogeneousLocalization.map (ReesMap.Construction.reesGradedMap I φ) _
    (HomogeneousLocalization.mk ⟨0, _, 1, _⟩)).val =
      (HomogeneousLocalization.mk ⟨0, _, 1, _⟩).val
  rw [HomogeneousLocalization.map_mk, HomogeneousLocalization.val_mk,
    HomogeneousLocalization.val_mk]
  refine congrArg₂ Localization.mk ?_ ?_
  · exact ReesMap.Construction.reesRingMap_constants I φ r
  · apply Subtype.ext
    exact map_one (ReesMap.Construction.reesGradedMap I φ)

/-- Every chart element admits an actual equation clearing its denominator. -/
theorem blowupChart_clear_denominator (I : Ideal R) (a : I) (x : Blowup.Charts.Construction.blowupChart I a) :
    ∃ (n : ℕ) (b : R), b ∈ I ^ n ∧
      Blowup.Charts.Construction.blowupChartConstants I a a.val ^ n * x = Blowup.Charts.Construction.blowupChartConstants I a b := by
  obtain ⟨n, b, hb, he⟩ :=
    (Blowup.Charts.Construction.mem_range_blowupChartToLocalization_iff I a _).mp ⟨x, rfl⟩
  refine ⟨n, b, hb, Blowup.Charts.Construction.blowupChartToLocalization_injective I a ?_⟩
  rw [map_mul, map_pow (Blowup.Charts.Construction.blowupChartToLocalization I a), Blowup.Charts.Construction.blowupChartToLocalization_constants,
    Blowup.Charts.Construction.blowupChartToLocalization_constants, ← he]
  rw [← map_pow (algebraMap R (Localization.Away a.val))]
  simp only [Blowup.Charts.Construction.baseFraction, ← Localization.mk_one_eq_algebraMap,
    Localization.mk_mul]
  rw [Localization.mk_eq_mk_iff, Localization.r_iff_exists]
  refine ⟨1, ?_⟩
  simp

/-- A chart map into a ring in which the chosen exceptional parameter is
regular is uniquely determined by its values on the original coefficients. -/
theorem blowupChart_hom_ext (I : Ideal R) (a : I) (φ : R →+* S)
    (hc : IsRegular (φ a.val)) (f g : Blowup.Charts.Construction.blowupChart I a →+* S)
    (hf : ∀ r, f (Blowup.Charts.Construction.blowupChartConstants I a r) = φ r)
    (hg : ∀ r, g (Blowup.Charts.Construction.blowupChartConstants I a r) = φ r) : f = g := by
  ext x
  obtain ⟨n, b, _, he⟩ := blowupChart_clear_denominator I a x
  apply (hc.pow n).left
  have hfe := congrArg f he
  have hge := congrArg g he
  simp only [map_mul, map_pow f, hf] at hfe
  simp only [map_mul, map_pow g, hg] at hge
  exact hfe.trans hge.symm

/-- An extension in which the center is generated by the regular image of
`a` induces a map from the `a`-chart to that extension. -/
def blowupChartLift (I : Ideal R) (a : I) (φ : R →+* S)
    (hI : I.map φ = Ideal.span {φ a.val}) (hc : IsRegular (φ a.val)) :
    Blowup.Charts.Construction.blowupChart I a →+* S :=
  (RingEquiv.ofBijective
    (Blowup.Charts.Construction.blowupChartConstants (I.map φ) ⟨φ a.val, Ideal.mem_map_of_mem φ a.property⟩)
    (PrincipalBlowup.Construction.blowupChartConstants_bijective_of_principal (I.map φ)
      ⟨φ a.val, Ideal.mem_map_of_mem φ a.property⟩ hI hc)).symm.toRingHom.comp
    (blowupChartMap I φ a)

theorem blowupChartLift_constants (I : Ideal R) (a : I) (φ : R →+* S)
    (hI : I.map φ = Ideal.span {φ a.val}) (hc : IsRegular (φ a.val)) (r : R) :
    blowupChartLift I a φ hI hc (Blowup.Charts.Construction.blowupChartConstants I a r) = φ r := by
  dsimp only [blowupChartLift, RingHom.comp_apply]
  rw [blowupChartMap_constants]
  exact (RingEquiv.ofBijective _ _).symm_apply_apply (φ r)

/-- The affine-chart universal property is an existence-and-uniqueness
statement about actual ring homomorphisms. -/
theorem blowupChart_existsUnique_lift (I : Ideal R) (a : I) (φ : R →+* S)
    (hI : I.map φ = Ideal.span {φ a.val}) (hc : IsRegular (φ a.val)) :
    ∃! f : Blowup.Charts.Construction.blowupChart I a →+* S, ∀ r, f (Blowup.Charts.Construction.blowupChartConstants I a r) = φ r := by
  refine ⟨blowupChartLift I a φ hI hc, blowupChartLift_constants I a φ hI hc, ?_⟩
  intro f hf
  exact blowupChart_hom_ext I a φ hc f _ hf (blowupChartLift_constants I a φ hI hc)

end

end OAI.AlgebraicGeometry.Resolution.Blowups.ChartLift.Construction
