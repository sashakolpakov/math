import OAI.AlgebraicGeometry.Resolution.Blowups.Blowup.Charts
import Mathlib.AlgebraicGeometry.ProjectiveSpectrum.Functor

/-! # Rees Map -/

namespace OAI.AlgebraicGeometry.Resolution.Blowups.ReesMap.Construction

noncomputable section

/-! Functorial maps of the actual Rees algebras for Blowups. -/

open _root_.Polynomial _root_.CategoryTheory _root_.AlgebraicGeometry

universe u

variable {R S : Type u} [CommRing R] [CommRing S]
variable (I : Ideal R) (φ : R →+* S)

/-- Mapping coefficients sends `R[It]` into `S[(I S)t]`. -/
def reesRingMap : reesAlgebra I →+* reesAlgebra (I.map φ) where
  toFun p := ⟨p.val.map φ, by
    intro n
    rw [Polynomial.coeff_map]
    simpa only [Ideal.map_pow] using Ideal.mem_map_of_mem φ (p.property n)⟩
  map_one' := by
    apply Subtype.ext
    exact Polynomial.map_one φ
  map_zero' := by
    apply Subtype.ext
    exact Polynomial.map_zero φ
  map_add' p q := by
    apply Subtype.ext
    exact Polynomial.map_add φ
  map_mul' p q := by
    apply Subtype.ext
    exact Polynomial.map_mul φ

/-- Coefficient maps preserve the natural Rees grading. -/
def reesGradedMap : ReesGrading.Construction.reesGrade I →+*ᵍ ReesGrading.Construction.reesGrade (I.map φ) where
  __ := reesRingMap I φ
  map_mem := by
    intro n p hp m hm
    change (p.val.map φ).coeff m = 0
    rw [Polynomial.coeff_map, hp m hm, map_zero]

@[simp]
theorem reesRingMap_generator (a : I) :
    reesRingMap I φ (Blowup.Charts.Construction.reesGenerator I a) =
      Blowup.Charts.Construction.reesGenerator (I.map φ) ⟨φ a.val, Ideal.mem_map_of_mem φ a.property⟩ := by
  apply Subtype.ext
  exact Polynomial.map_monomial φ

@[simp]
theorem reesRingMap_constants (r : R) :
    reesRingMap I φ (algebraMap R (reesAlgebra I) r) =
      algebraMap S (reesAlgebra (I.map φ)) (φ r) := by
  apply Subtype.ext
  exact Polynomial.map_C φ

/-- The underlying polynomial map of the graded Rees morphism. -/
theorem reesGradedMap_coe (p : reesAlgebra I) :
    ((reesGradedMap I φ p : reesAlgebra (I.map φ)) : S[X]) = p.val.map φ := rfl

/-- Degree-one Rees generators depend linearly on the center ideal. -/
def reesGeneratorLinear : I →ₗ[R] reesAlgebra I where
  toFun := Blowup.Charts.Construction.reesGenerator I
  map_add' a b := by
    apply Subtype.ext
    exact (Polynomial.monomial 1).map_add a.val b.val
  map_smul' r a := by
    apply Subtype.ext
    exact (Polynomial.monomial 1).map_smul r a.val

/-- The constant coefficient homomorphism of the Rees algebra. -/
def reesEvalZero : reesAlgebra I →+* R :=
  (Polynomial.evalRingHom 0).comp (reesAlgebra I).val.toRingHom

/-- The constant part, as an endomorphism of the Rees algebra. -/
def reesConstantPart : reesAlgebra I →+* reesAlgebra I :=
  (algebraMap R (reesAlgebra I)).comp (reesEvalZero I)

/-- An ideal containing all degree-one generators contains every element
after subtracting its constant part. -/
theorem rees_sub_constantPart_mem (K : Ideal (reesAlgebra I))
    (hK : ∀ a : I, Blowup.Charts.Construction.reesGenerator I a ∈ K) (p : reesAlgebra I) :
    p - reesConstantPart I p ∈ K := by
  have hp : p ∈ Algebra.adjoin R (Set.range (Blowup.Charts.Construction.reesGenerator I)) := by
    rw [Blowup.Charts.Construction.reesGenerators_adjoin]
    trivial
  induction hp using Algebra.adjoin_induction with
  | mem p hp =>
    obtain ⟨a, rfl⟩ := hp
    simpa [reesConstantPart, reesEvalZero, Blowup.Charts.Construction.reesGenerator] using hK a
  | algebraMap r =>
    simp [reesConstantPart, reesEvalZero]
  | add p q _ _ hp hq =>
    rw [map_add]
    convert K.add_mem hp hq using 1
    ring
  | mul p q _ _ hp hq =>
    rw [map_mul]
    convert K.add_mem (K.mul_mem_left p hq)
      (K.mul_mem_right (reesConstantPart I q) hp) using 1
    ring

/-- The irrelevant ideal of a Rees algebra is generated by its degree-one part. -/
theorem rees_irrelevant_le_of_generators (K : Ideal (reesAlgebra I))
    (hK : ∀ a : I, Blowup.Charts.Construction.reesGenerator I a ∈ K) :
    (HomogeneousIdeal.irrelevant (ReesGrading.Construction.reesGrade I)).toIdeal ≤ K := by
  have hzero : (HomogeneousIdeal.irrelevant (ReesGrading.Construction.reesGrade I)).toIdeal ≤
      RingHom.ker (reesEvalZero I) := by
    rw [HomogeneousIdeal.irrelevant_eq_span]
    apply Ideal.span_le.mpr
    intro p hp
    obtain ⟨n, hn, hp⟩ := (by simpa only [Set.mem_iUnion, SetLike.mem_coe] using hp)
    change Polynomial.eval 0 p.val = 0
    rw [ReesGrading.Construction.reesGrade_eq_monomial I n p hp]
    simp [Nat.ne_of_gt hn]
  intro p hp
  have hp0 : reesEvalZero I p = 0 := hzero hp
  have hc : reesConstantPart I p = 0 := by
    change algebraMap R (reesAlgebra I) (reesEvalZero I p) = 0
    rw [hp0, map_zero]
  simpa only [hc, sub_zero] using rees_sub_constantPart_mem I K hK p

/-- The elements coming from `I` span its extension as a module over `S`. -/
theorem extendedIdeal_span :
    Submodule.span S
      (Set.range (fun a : I => (⟨φ a.val, Ideal.mem_map_of_mem φ a.property⟩ : I.map φ))) = ⊤ := by
  apply Submodule.map_injective_of_injective (I.map φ).subtype_injective
  rw [Submodule.map_span, Submodule.map_top, Submodule.range_subtype]
  change Submodule.span S _ = Submodule.span S (φ '' (I : Set R))
  congr 1
  ext s
  constructor
  · rintro ⟨a, ⟨b, rfl⟩, rfl⟩
    exact ⟨b.val, b.property, rfl⟩
  · rintro ⟨a, ha, rfl⟩
    exact ⟨⟨φ a, Ideal.mem_map_of_mem φ ha⟩, ⟨⟨a, ha⟩, rfl⟩, rfl⟩

/-- Coefficient extension gives a everywhere-defined map on Rees projective spectra. -/
theorem reesGradedMap_irrelevant_le :
    HomogeneousIdeal.irrelevant (ReesGrading.Construction.reesGrade (I.map φ)) ≤
      (HomogeneousIdeal.irrelevant (ReesGrading.Construction.reesGrade I)).map (reesGradedMap I φ) := by
  let K : Ideal (reesAlgebra (I.map φ)) :=
    (HomogeneousIdeal.irrelevant (ReesGrading.Construction.reesGrade I)).toIdeal.map (reesGradedMap I φ)
  change (HomogeneousIdeal.irrelevant (ReesGrading.Construction.reesGrade (I.map φ))).toIdeal ≤ K
  apply rees_irrelevant_le_of_generators
  have hspan : Submodule.span S
      (Set.range (fun a : I => (⟨φ a.val, Ideal.mem_map_of_mem φ a.property⟩ : I.map φ))) ≤
      (K.restrictScalars S).comap (reesGeneratorLinear (I.map φ)) := by
    apply Submodule.span_le.mpr
    rintro _ ⟨a, rfl⟩
    change Blowup.Charts.Construction.reesGenerator (I.map φ) ⟨φ a.val, Ideal.mem_map_of_mem φ a.property⟩ ∈ K
    rw [← reesRingMap_generator]
    exact Ideal.mem_map_of_mem (reesGradedMap I φ)
      (HomogeneousIdeal.mem_irrelevant_of_mem (ReesGrading.Construction.reesGrade I) (by decide) (Blowup.Charts.Construction.reesGenerator_mem I a))
  rw [extendedIdeal_span] at hspan
  intro b
  exact hspan (Submodule.mem_top : b ∈ (⊤ : Submodule S (I.map φ)))

/-- The induced morphism between the actual affine blowup schemes. -/
def affineBlowupMap : ReesGrading.Construction.affineBlowup (I.map φ) ⟶ ReesGrading.Construction.affineBlowup I :=
  Proj.map (reesGradedMap I φ) (reesGradedMap_irrelevant_le I φ)

/-- Injective coefficient maps give injective maps of Rees algebras. -/
theorem reesRingMap_injective (hφ : Function.Injective φ) :
    Function.Injective (reesRingMap I φ) := by
  intro p q hpq
  apply Subtype.ext
  apply Polynomial.map_injective φ hφ
  exact congrArg Subtype.val hpq

/-- After extending scalars, the images of the original degree-one generators
generate the extended Rees algebra over the new coefficient ring. -/
theorem reesMappedGenerators_adjoin :
    Algebra.adjoin S (Set.range (fun a : I => reesRingMap I φ (Blowup.Charts.Construction.reesGenerator I a))) = ⊤ := by
  let A := Algebra.adjoin S (Set.range (fun a : I => reesRingMap I φ (Blowup.Charts.Construction.reesGenerator I a)))
  have hspan : Submodule.span S
      (Set.range (fun a : I => (⟨φ a.val, Ideal.mem_map_of_mem φ a.property⟩ : I.map φ))) ≤
      A.toSubmodule.comap (reesGeneratorLinear (I.map φ)) := by
    apply Submodule.span_le.mpr
    rintro _ ⟨a, rfl⟩
    change Blowup.Charts.Construction.reesGenerator (I.map φ) ⟨φ a.val, Ideal.mem_map_of_mem φ a.property⟩ ∈ A
    rw [← reesRingMap_generator]
    exact Algebra.subset_adjoin ⟨a, rfl⟩
  rw [extendedIdeal_span] at hspan
  apply top_le_iff.mp
  rw [← Blowup.Charts.Construction.reesGenerators_adjoin (I.map φ)]
  apply Algebra.adjoin_le
  rintro _ ⟨b, rfl⟩
  exact hspan (Submodule.mem_top : b ∈ (⊤ : Submodule S (I.map φ)))

end

end OAI.AlgebraicGeometry.Resolution.Blowups.ReesMap.Construction
