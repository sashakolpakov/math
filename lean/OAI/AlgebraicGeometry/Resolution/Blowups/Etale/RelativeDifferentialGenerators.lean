import OAI.AlgebraicGeometry.Resolution.Blowups.Etale.ModuleDerivations
import OAI.AlgebraicGeometry.Resolution.Blowups.Relative.DifferentialBlowup

/-! # Relative Differential Generators -/

namespace OAI.AlgebraicGeometry.Resolution.Blowups.Etale.RelativeDifferentialGenerators.Construction

noncomputable section

/-! Coordinate formulas for the intrinsically defined relative differential ideal. -/

variable {σ K S ι : Type*} [Field K] [CommRing S] [Fintype σ] [DecidableEq σ]
  [Algebra (MvPolynomial σ K) S] [Algebra.Etale (MvPolynomial σ K) S]
  [Algebra K S] [IsScalarTower K (MvPolynomial σ K) S]

/-- The intrinsic relative differential ideal is generated by the
original generators and their coordinate partials. This formula is
proved from the full derivation basis, so it does not define a new
coordinate-dependent differential ideal. -/
theorem etale_firstRelativeDifferentialIdeal_span (p : ι → S) :
    Relative.DifferentialBlowup.Construction.firstRelativeDifferentialIdeal K (Ideal.span (Set.range p)) =
      Ideal.span (Set.range p) ⊔ Ideal.span (Set.range
        (fun t : σ × ι => DifferentialEquation.Construction.etaleRelativePartial (K := K) (S := S) t.1 (p t.2))) := by
  apply le_antisymm
  · apply sup_le le_sup_left
    apply Ideal.span_le.mpr
    rintro x ⟨⟨D, q⟩, rfl⟩
    apply (sup_le le_sup_left ?_ : Ideal.span (Set.range p) ⊔
      Ideal.span (Set.range (fun i => D (p i))) ≤ _)
      (Relative.DifferentialBlowup.Construction.relative_derivation_of_span K D p q.property)
    apply Ideal.span_le.mpr
    rintro y ⟨j, rfl⟩
    change D (p j) ∈ Ideal.span (Set.range p) ⊔ Ideal.span (Set.range
      (fun t : σ × ι => DifferentialEquation.Construction.etaleRelativePartial (K := K) (S := S) t.1 (p t.2)))
    rw [ModuleDerivations.Construction.etale_relative_derivation_apply (σ := σ) D (p j)]
    apply Ideal.sum_mem
    intro i _
    exact Ideal.mul_mem_left _ _ (Submodule.mem_sup_right (Ideal.subset_span ⟨⟨i, j⟩, rfl⟩))
  · apply sup_le (Relative.DifferentialBlowup.Construction.le_firstRelativeDifferentialIdeal K _)
    apply Ideal.span_le.mpr
    rintro x ⟨⟨i, j⟩, rfl⟩
    exact Relative.DifferentialBlowup.Construction.relative_derivation_mem_first K _ (DifferentialEquation.Construction.etaleRelativePartial (K := K) i)
      (Ideal.subset_span ⟨j, rfl⟩)

end

end OAI.AlgebraicGeometry.Resolution.Blowups.Etale.RelativeDifferentialGenerators.Construction
