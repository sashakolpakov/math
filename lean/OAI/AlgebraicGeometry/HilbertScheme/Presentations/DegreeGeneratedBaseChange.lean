import OAI.AlgebraicGeometry.HilbertScheme.Presentations.DegreeGeneratedIdeal
import OAI.AlgebraicGeometry.HilbertScheme.Presentations.RelationsBaseChangeMap

/-! # Degree Generated Base Change -/

namespace OAI.AlgebraicGeometry.HilbertScheme.Presentations.DegreeGeneratedBaseChange.GradedHilbert

noncomputable section

/-! The ideal generated by one homogeneous relation degree commutes with base change over arbitrary coefficient rings. -/

open _root_.MvPolynomial TensorProduct

universe u v

variable {R : Type u} [CommRing R] {S : Type v} [CommRing S] [Algebra R S] {n : ℕ}
variable (I : HomogeneousIdeal (Hilbert.Polynomial.GradedHilbert.grading R n)) (N : ℕ)

theorem degreeGeneratedIdeal_baseChange :
    Graded.BaseChange.GradedHilbert.extendedHomogeneousIdeal (S := S) (DegreeGeneratedIdeal.GradedHilbert.degreeGeneratedIdeal I N) =
      DegreeGeneratedIdeal.GradedHilbert.degreeGeneratedIdeal (Graded.BaseChange.GradedHilbert.extendedHomogeneousIdeal (S := S) I) N := by
  apply HomogeneousIdeal.ext
  apply le_antisymm
  · change Ideal.map (MvPolynomial.map (algebraMap R S))
      (DegreeGeneratedIdeal.GradedHilbert.degreeGeneratedIdeal I N).toIdeal ≤ _
    apply Ideal.map_le_iff_le_comap.mpr
    apply Ideal.span_le.mpr
    rintro f ⟨hf, hI⟩
    exact DegreeGeneratedIdeal.GradedHilbert.mem_degreeGeneratedIdeal (Graded.BaseChange.GradedHilbert.extendedHomogeneousIdeal (S := S) I) N
      (MvPolynomial.map (algebraMap R S) f) (hf.map (algebraMap R S))
      (Ideal.mem_map_of_mem (MvPolynomial.map (algebraMap R S)) hI)
  · apply Ideal.span_le.mpr
    rintro f ⟨hf, hI⟩
    let F := RelationsBaseChangeMap.GradedHilbert.degreeRelationsBaseChangeMap (S := S) I N
    obtain ⟨x, hx⟩ := RelationsBaseChangeMap.GradedHilbert.degreeRelationsBaseChangeMap_surjective (S := S) I N (⟨⟨f, hf⟩, hI⟩ : Hilbert.Polynomial.GradedHilbert.degreeRelations (Graded.BaseChange.GradedHilbert.extendedHomogeneousIdeal (S := S) I).toIdeal N)
    have hmem (y : S ⊗[R] Hilbert.Polynomial.GradedHilbert.degreeRelations I.toIdeal N) :
        (F y).val.val ∈ (Graded.BaseChange.GradedHilbert.extendedHomogeneousIdeal (S := S) (DegreeGeneratedIdeal.GradedHilbert.degreeGeneratedIdeal I N)).toIdeal := by
      induction y using TensorProduct.inductionOn with
      | tmul s b =>
        rw [RelationsBaseChangeMap.GradedHilbert.degreeRelationsBaseChangeMap_tmul]
        apply Submodule.smul_mem ((Graded.BaseChange.GradedHilbert.extendedHomogeneousIdeal (S := S) (DegreeGeneratedIdeal.GradedHilbert.degreeGeneratedIdeal I N)).toIdeal.restrictScalars S)
        exact Ideal.mem_map_of_mem (MvPolynomial.map (algebraMap R S))
          (DegreeGeneratedIdeal.GradedHilbert.mem_degreeGeneratedIdeal I N b.val.val b.val.property b.property)
      | add y z hy hz =>
        simp only [LinearMap.map_add, Submodule.coe_add]
        exact Ideal.add_mem _ hy hz
    change F x = (⟨⟨f, hf⟩, hI⟩ : Hilbert.Polynomial.GradedHilbert.degreeRelations (Graded.BaseChange.GradedHilbert.extendedHomogeneousIdeal (S := S) I).toIdeal N) at hx
    change f ∈ (Graded.BaseChange.GradedHilbert.extendedHomogeneousIdeal (S := S) (DegreeGeneratedIdeal.GradedHilbert.degreeGeneratedIdeal I N)).toIdeal
    simpa only [hx] using hmem x

end

end OAI.AlgebraicGeometry.HilbertScheme.Presentations.DegreeGeneratedBaseChange.GradedHilbert
