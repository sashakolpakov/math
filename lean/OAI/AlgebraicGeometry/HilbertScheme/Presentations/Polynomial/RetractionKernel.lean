import OAI.AlgebraicGeometry.HilbertScheme.Presentations.KillVariables

/-! # Retraction Kernel -/

namespace OAI.AlgebraicGeometry.HilbertScheme.Presentations.Polynomial.RetractionKernel.GradedHilbert

noncomputable section

/-! The kernel of an idempotent polynomial substitution is generated by the differences between the variables and their substitutions. -/

open _root_.MvPolynomial

variable {σ R : Type*} [CommRing R]

theorem polynomial_retraction_kernel
    (φ : MvPolynomial σ R →ₐ[R] MvPolynomial σ R) (hφ : φ.comp φ = φ) :
    RingHom.ker φ.toRingHom = Ideal.span (Set.range (fun i => X i - φ (X i))) := by
  let J : Ideal (MvPolynomial σ R) := Ideal.span (Set.range (fun i => X i - φ (X i)))
  have hJ : J ≤ RingHom.ker φ.toRingHom := by
    apply Ideal.span_le.mpr
    rintro f ⟨i, rfl⟩
    change φ (X i - φ (X i)) = 0
    rw [map_sub, ← AlgHom.comp_apply, hφ, sub_self]
  apply le_antisymm _ hJ
  intro p hp
  let q := Ideal.Quotient.mkₐ R J
  have hq : q.comp φ = q := by
    apply MvPolynomial.algHom_ext
    intro i
    apply Eq.symm
    apply sub_eq_zero.mp
    change q (X i) - q (φ (X i)) = 0
    rw [← map_sub]
    exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_range_self i))
  apply Ideal.Quotient.eq_zero_iff_mem.mp
  change q p = 0
  rw [← hq, AlgHom.comp_apply]
  change q (φ.toRingHom p) = 0
  rw [RingHom.mem_ker.mp hp, map_zero]

theorem polynomial_substitution_difference_mem
    (φ : MvPolynomial σ R →ₐ[R] MvPolynomial σ R) (p : MvPolynomial σ R) :
    p - φ p ∈ Ideal.span (Set.range (fun i => X i - φ (X i))) := by
  let J : Ideal (MvPolynomial σ R) := Ideal.span (Set.range (fun i => X i - φ (X i)))
  let q := Ideal.Quotient.mkₐ R J
  have hq : q.comp φ = q := by
    apply MvPolynomial.algHom_ext
    intro i
    apply Eq.symm
    apply sub_eq_zero.mp
    change q (X i) - q (φ (X i)) = 0
    rw [← map_sub]
    exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_range_self i))
  apply Ideal.Quotient.eq_zero_iff_mem.mp
  change q (p - φ p) = 0
  rw [map_sub, ← AlgHom.comp_apply, hq, sub_self]

end

end OAI.AlgebraicGeometry.HilbertScheme.Presentations.Polynomial.RetractionKernel.GradedHilbert
