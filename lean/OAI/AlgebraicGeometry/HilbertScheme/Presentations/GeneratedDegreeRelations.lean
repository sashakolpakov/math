import OAI.AlgebraicGeometry.HilbertScheme.Presentations.Homogeneous.RelationPresentation

/-! # Generated Degree Relations -/

namespace OAI.AlgebraicGeometry.HilbertScheme.Presentations.GeneratedDegreeRelations.GradedHilbert

noncomputable section

/-! The generating degree of an ideal generated by homogeneous forms is
exactly their coefficient-ring linear span. -/

open _root_.MvPolynomial

universe u v
variable {R : Type u} [CommRing R] {n N : ℕ} {ι : Type v} [Fintype ι]

theorem homogeneous_zero_eq_constant (f : Hilbert.Polynomial.GradedHilbert.grading R n 0) :
    f.val = C (f.val.coeff 0) := by
  exact totalDegree_eq_zero_iff_eq_C.mp
    ((totalDegree_zero_iff_isHomogeneous (Fin (n + 1))).mpr f.property)

theorem homogeneousGenerators_degreeRelations_span
    (g : ι → Hilbert.Polynomial.GradedHilbert.CoordinateRing R n) (hg : ∀ i, (g i).IsHomogeneous N) :
    Hilbert.Polynomial.GradedHilbert.degreeRelations (Homogeneous.RelationPresentation.GradedHilbert.homogeneousGeneratorsIdeal g N hg).toIdeal N =
      Submodule.span R (Set.range (fun i => (⟨g i, hg i⟩ : Hilbert.Polynomial.GradedHilbert.grading R n N))) := by
  apply le_antisymm
  · intro f hf
    have hf' : (⟨f.val, by simpa only [zero_add] using f.property⟩ : Hilbert.Polynomial.GradedHilbert.grading R n (0 + N)) ∈
        (Homogeneous.RelationPresentation.GradedHilbert.homogeneousRelationPresentation g N hg 0).range := by
      rw [Homogeneous.RelationPresentation.GradedHilbert.homogeneousRelationPresentation_range]
      exact hf
    obtain ⟨a, ha⟩ := hf'
    have he : f = ∑ i, (a i).val.coeff 0 • (⟨g i, hg i⟩ : Hilbert.Polynomial.GradedHilbert.grading R n N) := by
      apply Subtype.ext
      have hv := congrArg Subtype.val ha
      change (∑ i, (a i).val * g i) = f.val at hv
      rw [← hv]
      simp only [Submodule.coe_sum, Submodule.coe_smul, smul_eq_C_mul]
      apply Finset.sum_congr rfl
      intro i _
      exact congrArg (fun p => p * g i) (homogeneous_zero_eq_constant (a i))
    rw [he]
    exact Submodule.sum_mem _ (fun i _ => Submodule.smul_mem _ _
      (Submodule.subset_span (Set.mem_range_self i)))
  · apply Submodule.span_le.mpr
    rintro _ ⟨i, rfl⟩
    exact Ideal.subset_span (Set.mem_range_self i)

end

end OAI.AlgebraicGeometry.HilbertScheme.Presentations.GeneratedDegreeRelations.GradedHilbert
