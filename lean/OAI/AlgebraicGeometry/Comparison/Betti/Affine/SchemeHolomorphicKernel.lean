import OAI.AlgebraicGeometry.Comparison.Betti.Affine.SchemeStalkPullbackNormalization
import OAI.AlgebraicGeometry.Comparison.Betti.Affine.OpenChartDimension
import OAI.AlgebraicGeometry.Comparison.Betti.Affine.ClosedGermKernel
import OAI.AlgebraicGeometry.Comparison.Betti.RingKernelEquivTransport

/-! # Scheme Holomorphic Kernel -/

namespace OAI.AlgebraicGeometry.Comparison.Betti.Affine.SchemeHolomorphicKernel

noncomputable section

/-! The original holomorphic stalk kernel of a closed immersion is generated by its actual affine defining ideal. -/

open _root_.CategoryTheory _root_.AlgebraicGeometry

open OAI.AlgebraicGeometry.Comparison.Betti.Affine.ClosedGermKernel.AnalyticLocal

theorem analyticHolomorphicStalkPullback_ker_affine
    {X Y : Over Foundations.Scheme.ProjectiveSpace.complexBase} [IsIntegral X.left] [Smooth X.hom]
    [IsIntegral Y.left] [Smooth Y.hom] (φ : X ⟶ Y) [IsClosedImmersion φ.left]
    (V : Y.left.Opens) (hV : IsAffineOpen V) (hW : IsAffineOpen (φ.left ⁻¹ᵁ V))
    (e : OpenPartialHomeomorph
      (Foundations.Scheme.AffineComplexPoints.affineComplexPoints (ComplexPoints.Analytic.SchemePointHomeomorphs.schemeComplexPoints.affineOpenAlgebra X (φ.left ⁻¹ᵁ V))) (RegularSmoothness.NativeModel X))
    (f : OpenPartialHomeomorph
      (Foundations.Scheme.AffineComplexPoints.affineComplexPoints (ComplexPoints.Analytic.SchemePointHomeomorphs.schemeComplexPoints.affineOpenAlgebra Y V)) (RegularSmoothness.NativeModel Y))
    (he : e ∈ ComplexPoints.Analytic.SmoothSchemeManifold.affineRegularAtlas (ComplexPoints.Analytic.SchemePointHomeomorphs.schemeComplexPoints.affineOpenAlgebra X (φ.left ⁻¹ᵁ V))
      (Betti.AffineDimension.Realization.functionFieldDifferentialDimension X.hom))
    (hf : f ∈ ComplexPoints.Analytic.SmoothSchemeManifold.affineRegularAtlas (ComplexPoints.Analytic.SchemePointHomeomorphs.schemeComplexPoints.affineOpenAlgebra Y V)
      (Betti.AffineDimension.Realization.functionFieldDifferentialDimension Y.hom))
    (x : Foundations.Scheme.AffineComplexPoints.affineComplexPoints (ComplexPoints.Analytic.SchemePointHomeomorphs.schemeComplexPoints.affineOpenAlgebra X (φ.left ⁻¹ᵁ V)))
    (hx : x ∈ e.source) (hfx : x.comp (ComplexPoints.Analytic.IntrinsicSmoothClosedImmersion.nativeAffineOpenPullback φ V) ∈ f.source)
    (p : ComplexPoints.Analytic.SchemePointHomeomorphs.schemeComplexPoints X) (hp : p = ComplexPoints.Analytic.SchemePointHomeomorphs.schemeComplexPoints.affineOpenPointMap X (φ.left ⁻¹ᵁ V) hW x)
    (hpV : Analytification.Base.analytificationMap Y (ComplexPoints.Analytic.SchemePointHomeomorphs.schemeComplexPoints.map φ p) ∈ V) :
    RingHom.ker (Holomorphic.SchemeStalkPullback.analyticHolomorphicStalkPullback φ p) =
      Ideal.map ((ConcreteHolomorphicStalkMap.algebraicHolomorphicStalkMap Y (ComplexPoints.Analytic.SchemePointHomeomorphs.schemeComplexPoints.map φ p)).comp
        (Y.left.presheaf.germ V (Analytification.Base.analytificationMap Y (ComplexPoints.Analytic.SchemePointHomeomorphs.schemeComplexPoints.map φ p)) hpV).hom)
        (RingHom.ker (ComplexPoints.Analytic.IntrinsicSmoothClosedImmersion.nativeAffineOpenPullback φ V).toRingHom) := by
  subst p
  let W := φ.left ⁻¹ᵁ V
  let p := ComplexPoints.Analytic.SchemePointHomeomorphs.schemeComplexPoints.affineOpenPointMap X W hW x
  have hpW : ComplexPoints.Analytic.SchemePointHomeomorphs.schemeComplexPoints.underlying p ∈ W := by
    have hm : p ∈ Set.range (ComplexPoints.Analytic.SchemePointHomeomorphs.schemeComplexPoints.affineOpenPointMap X W hW) := ⟨x, rfl⟩
    rwa [ComplexPoints.Analytic.SchemePointHomeomorphs.schemeComplexPoints.range_affineOpenPointMap] at hm
  let : Nonempty W := ⟨⟨ComplexPoints.Analytic.SchemePointHomeomorphs.schemeComplexPoints.underlying p, hpW⟩⟩
  let B := ComplexPoints.Analytic.SchemePointHomeomorphs.schemeComplexPoints.affineOpenAlgebra X W
  let : IsDomain B := ComplexPoints.Analytic.SchemePointHomeomorphs.schemeComplexPoints.affineOpenAlgebra_isDomain X W
  let : Algebra.Smooth ℂ B := ComplexPoints.Analytic.SchemePointHomeomorphs.schemeComplexPoints.affineOpenAlgebra_smooth X W hW
  have hd := OpenChartDimension.affineOpen_genericDifferentialRank_eq X B
    (ComplexPoints.Analytic.SchemePointHomeomorphs.schemeComplexPoints.affineOpenSchemeMap X W hW) x
  let h := ComplexPoints.Analytic.IntrinsicSmoothClosedImmersion.nativeAffineOpenPullback φ V
  have hq := ComplexPoints.Analytic.IntrinsicSmoothClosedImmersion.nativeAffineOpenPullback_point_square φ V hV hW x
  let eS := SchemeStalkCenters.affineSchemeChartStalkEquivAt Y V hV f hf (x.comp h) hfx
    (ComplexPoints.Analytic.SchemePointHomeomorphs.schemeComplexPoints.map φ p) hq
  let eT := SchemeStalkCenters.affineSchemeChartStalkEquivAt X W hW e he x hx p rfl
  apply RingKernelEquivTransport.ringKernel_eq_map_of_equiv_square
    (Holomorphic.SchemeStalkPullback.analyticHolomorphicStalkPullback φ p) (ClosedGermQuotient.AnalyticLocal.affineChartGermPullback h e f he hf x hx hfx)
    eS eT (SchemeStalkPullbackNormalization.affineSchemeChartStalkEquiv_pullback φ V hV hW e f he hf x hx hfx)
    _ (ChartGermMap.AnalyticLocal.affineChartGermMap f hf (x.comp h) hfx)
  · apply RingHom.ext
    intro s
    exact SchemeStalkCenters.affineSchemeChartStalkEquivAt_algebraic_germ Y V hV f hf (x.comp h) hfx
      (ComplexPoints.Analytic.SchemePointHomeomorphs.schemeComplexPoints.map φ p) hq hpV s
  · exact ClosedGermKernel.AnalyticLocal.affineChartGermPullback_ker_of_dimension hd h
      (ComplexPoints.Analytic.IntrinsicSmoothClosedImmersion.nativeAffineOpenPullback_surjective φ V hV) e f he hf x hx hfx

end

end OAI.AlgebraicGeometry.Comparison.Betti.Affine.SchemeHolomorphicKernel
