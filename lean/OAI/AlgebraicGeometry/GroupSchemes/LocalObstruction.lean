import OAI.AlgebraicGeometry.GroupSchemes.Verschiebung
import OAI.AlgebraicGeometry.GroupSchemes.DualMaps

/-! # Local Obstruction -/

namespace OAI.AlgebraicGeometry.GroupSchemes.LocalObstruction.FiniteEtale

noncomputable section

/-!
# FiniteEtale: the local algebra obstruction at the second level

Finite-dimensional nilpotence gives the first-level Frobenius calculation.
Nakayama then rules out a nonzero proper kernel ideal generated by pth powers
of elements already in that ideal. These are algebraic steps of the connected
height-one argument; the geometric classification is not assumed.
-/

open OAI.AlgebraicGeometry.GroupSchemes.Verschiebung.FiniteEtale

universe u v

variable (k : Type u) [Field k]
variable (A : Type v) [CommRing A] [Algebra k A] [Module.Finite k A]

/-- A nilpotent in a finite-dimensional algebra vanishes by the dimension-th power. -/
theorem nilpotent_pow_finrank (x : A) (hx : IsNilpotent x) :
    x ^ Module.finrank k A = 0 := by
  have hφ : IsNilpotent (Algebra.lmul k A x) := hx.map (Algebra.lmul k A)
  have hz : (Algebra.lmul k A x) ^ Module.finrank k A = 0 := by
    have h := (Algebra.lmul k A x).aeval_self_charpoly
    rw [hφ.charpoly_eq_X_pow_finrank] at h
    simpa using h
  apply Algebra.lmul_injective (R := k) (A := A)
  rw [map_pow, map_zero]
  exact hz

/-- In a local finite-dimensional algebra, the kernel of an augmentation is nilpotent. -/
theorem nilpotent_of_augmentation_zero [IsLocalRing A] (ε : A →ₐ[k] k)
    (x : A) (hx : ε x = 0) : IsNilpotent x := by
  have : IsArtinianRing A := isArtinian_of_tower k inferInstance
  rw [← mem_nilradical, nilradical, ← IsArtinianRing.jacobson_eq_radical, Ideal.zero_eq_bot,
    IsLocalRing.jacobson_eq_maximalIdeal _ bot_ne_top]
  rw [IsLocalRing.mem_maximalIdeal]
  intro hu
  have h := hu.map ε
  simp only [hx, not_isUnit_zero] at h

variable (p : ℕ) [Fact p.Prime] [CharP k p]

/-- Frobenius on a local algebra of dimension p factors through its augmentation. -/
theorem frobenius_of_local_rank_prime [IsLocalRing A] (hdim : Module.finrank k A = p)
    (ε : A →ₐ[k] k) (x : A) : x ^ p = algebraMap k A ((ε x) ^ p) := by
  have hn : (x - algebraMap k A (ε x)) ^ p = 0 := by
    rw [← hdim]
    apply nilpotent_pow_finrank k A
    apply nilpotent_of_augmentation_zero k A ε
    simp
  calc
    x ^ p = ((x - algebraMap k A (ε x)) + algebraMap k A (ε x)) ^ p := by
      rw [sub_add_cancel]
    _ = (x - algebraMap k A (ε x)) ^ p + (algebraMap k A (ε x)) ^ p :=
      Verschiebung.FiniteEtale.algebra_pow_add p k A _ _
    _ = (algebraMap k A (ε x)) ^ p := by rw [hn, zero_add]
    _ = algebraMap k A ((ε x) ^ p) := (map_pow _ _ _).symm

section IdealObstruction

variable {R : Type*} [CommRing R] [IsNoetherianRing R] [IsLocalRing R]

/-- Nakayama's obstruction: a proper ideal cannot be generated by pth powers
of images lying in the same ideal, unless the ideal is zero. -/
theorem kernel_ideal_eq_bot (p : ℕ) (hp : 2 ≤ p) (m I : Ideal R) (V : R →+* R)
    (hproper : I ≠ ⊤) (hV : ∀ x ∈ m, V x ∈ I)
    (hgen : I = Ideal.span ((fun x => V x ^ p) '' (m : Set R))) : I = ⊥ := by
  have hpow : I ≤ I ^ p := by
    conv_lhs => rw [hgen]
    apply Ideal.span_le.mpr
    rintro _ ⟨x, hx, rfl⟩
    exact Ideal.pow_mem_pow (hV x hx) p
  have hsq : I ≤ I * I := by
    simpa only [pow_two] using hpow.trans (Ideal.pow_le_pow_right hp)
  have hid : IsIdempotentElem I := le_antisymm Ideal.mul_le_left hsq
  exact ((Ideal.isIdempotentElem_iff_eq_bot_or_top_of_isLocalRing I).mp hid).resolve_right hproper

end IdealObstruction

section DualLocal

variable (C : Type*) [CommRing C] [HopfAlgebra k C]
  [Coalgebra.IsCocomm k C] [Module.Finite k C] [PerfectRing k p]

local instance : CommRing (AbelianScheme.CartierDuality.DualAlgebra.Construction.DualCoordinate k C) := LinearMap.convCommRing
local instance : Algebra k (AbelianScheme.CartierDuality.DualAlgebra.Construction.DualCoordinate k C) := LinearMap.convAlgebra

variable [IsLocalRing (AbelianScheme.CartierDuality.DualAlgebra.Construction.DualCoordinate k C)]

/-- If the Cartier dual has local coordinate algebra of dimension p,
Verschiebung kills the augmentation ideal of the original group. -/
theorem verschiebung_kills_augmentation (hdim : Module.finrank k C = p)
    (x : C) (hx : Coalgebra.counit (R := k) x = 0) :
    Verschiebung.FiniteEtale.verschiebungFun p k C x = 0 := by
  apply (AbelianScheme.CartierDuality.DualAlgebra.Construction.dualCoordinateBidualLinearEquiv k C).injective
  ext f
  simp only [AbelianScheme.CartierDuality.DualAlgebra.Construction.dualCoordinateBidualLinearEquiv_apply, map_zero]
  apply (frobeniusEquiv k p).injective
  change f (Verschiebung.FiniteEtale.verschiebungFun p k C x) ^ p = (0 : k) ^ p
  rw [Verschiebung.FiniteEtale.eval_verschiebung_pow, zero_pow (Fact.out : p.Prime).ne_zero]
  have hdimD : Module.finrank k (AbelianScheme.CartierDuality.DualAlgebra.Construction.DualCoordinate k C) = p := by
    rw [(AbelianScheme.CartierDuality.DualAlgebra.Construction.dualCoordinateLinearEquiv k C).finrank_eq, Subspace.dual_finrank_eq, hdim]
  rw [frobenius_of_local_rank_prime k (AbelianScheme.CartierDuality.DualAlgebra.Construction.DualCoordinate k C) p hdimD
    (Bialgebra.counitAlgHom k (AbelianScheme.CartierDuality.DualAlgebra.Construction.DualCoordinate k C)) f]
  simp only [LinearMap.convAlgebraMap_apply, hx, map_zero, smul_zero]

end DualLocal

variable (R S : Type*) [CommRing R] [CommRing S]
  [HopfAlgebra k R] [HopfAlgebra k S]
  [Coalgebra.IsCocomm k R] [Coalgebra.IsCocomm k S]
  [Module.Finite k R] [Module.Finite k S] [PerfectRing k p]

/-- The augmentation ideal of the coordinate Hopf algebra. -/
def augmentationIdeal : Ideal R := RingHom.ker (Bialgebra.counitAlgHom k R).toRingHom

/-- The ideal defining the kernel of multiplication by p in affine coordinates. -/
def multiplicationKernelIdeal : Ideal R :=
  Ideal.span ((fun x => ((WithConv.toConv (LinearMap.id : R →ₗ[k] R)) ^ p) x) ''
    (augmentationIdeal k R : Set R))

local instance : CommRing (AbelianScheme.CartierDuality.DualAlgebra.Construction.DualCoordinate k S) := LinearMap.convCommRing
local instance : Algebra k (AbelianScheme.CartierDuality.DualAlgebra.Construction.DualCoordinate k S) := LinearMap.convAlgebra

/-- The connected/connected obstruction for a prime-order first level:
a larger local coordinate Hopf algebra cannot have this multiplication kernel
when the quotient's Cartier dual is local. -/
theorem no_local_local_prime_step [IsLocalRing R] [IsLocalRing (AbelianScheme.CartierDuality.DualAlgebra.Construction.DualCoordinate k S)]
    (hdimR : p < Module.finrank k R) (hdimS : Module.finrank k S = p)
    (q : R →ₐc[k] S)
    (hker : RingHom.ker q.toAlgHom.toRingHom = multiplicationKernelIdeal k p R) : False := by
  have : Nontrivial S := (Bialgebra.counitAlgHom k S).toRingHom.domain_nontrivial
  have : IsNoetherianRing R := IsNoetherianRing.of_finite k R
  have hzero : RingHom.ker q.toAlgHom.toRingHom = ⊥ := by
    apply kernel_ideal_eq_bot p (Fact.out : p.Prime).two_le (augmentationIdeal k R)
      _ (Verschiebung.FiniteEtale.verschiebungRingHom p k R)
    · exact RingHom.ker_ne_top _
    · intro x hx
      change q.toCoalgHom (Verschiebung.FiniteEtale.verschiebungFun p k R x) = 0
      rw [DualMaps.FiniteEtale.verschiebung_natural k p q.toCoalgHom x]
      apply verschiebung_kills_augmentation k p S hdimS
      exact (CoalgHomClass.counit_comp_apply q x).trans hx
    · change RingHom.ker q.toAlgHom.toRingHom =
        Ideal.span ((fun x => Verschiebung.FiniteEtale.verschiebungFun p k R x ^ p) ''
          (augmentationIdeal k R : Set R))
      simpa only [multiplicationKernelIdeal, Verschiebung.FiniteEtale.frobenius_verschiebung] using hker
  have hinj : Function.Injective q.toLinearMap :=
    (RingHom.injective_iff_ker_eq_bot q.toAlgHom.toRingHom).mpr hzero
  have hle := LinearMap.finrank_le_finrank_of_injective hinj
  omega

end

end OAI.AlgebraicGeometry.GroupSchemes.LocalObstruction.FiniteEtale
