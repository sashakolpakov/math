import OAI.AlgebraicGeometry.Albanese.Construction.SegreClosed
import OAI.AlgebraicGeometry.Albanese.Construction.GeneratedClosed

/-! # Common Refinement -/

namespace OAI.AlgebraicGeometry.Albanese.Construction.CommonRefinement

noncomputable section

open _root_.CategoryTheory _root_.AlgebraicGeometry
open MonoidalCategory CartesianMonoidalCategory MonObj

set_option backward.isDefEq.respectTransparency false in
/-- Two pointed maps admit a common generated abelian target. The target
is the abelian subvariety generated by their map into the actual product. -/
theorem exists_common_generated_target (X : Foundations.Scheme.SmoothProjective.SmoothProjectivePresentation)
    [ConnectedSpace X.carrier] (x₀ : Over.mk (𝟙 Foundations.Scheme.ProjectiveSpace.complexBase) ⟶ X.toOver)
    (A B : ComplexMultiplication.CMAbelianVariety.CM.AbelianVariety) (a : X.toOver ⟶ A.toOver) (b : X.toOver ⟶ B.toOver)
    (ha : x₀ ≫ a = 1) (hb : x₀ ≫ b = 1) :
    ∃ (C : ComplexMultiplication.CMAbelianVariety.CM.AbelianVariety) (c : X.toOver ⟶ C.toOver)
      (p : C.toOver ⟶ A.toOver) (q : C.toOver ⟶ B.toOver),
      x₀ ≫ c = 1 ∧ GeneratedClosed.Generates X C c ∧ IsMonHom p ∧ IsMonHom q ∧
        c ≫ p = a ∧ c ≫ q = b := by
  let P := SegreClosed.abelianProduct A B
  let _ : GrpObj P.toOver := P.group
  let f : X.toOver ⟶ P.toOver := lift a b
  have hf : x₀ ≫ f = 1 := by
    apply CartesianMonoidalCategory.hom_ext
    · change x₀ ≫ lift a b ≫ fst A.toOver B.toOver = _
      simp [ha]
    · change x₀ ≫ lift a b ≫ snd A.toOver B.toOver = _
      simp [hb]
  obtain ⟨C, c, j, _, hj, hc, hcf, hgen⟩ := GeneratedClosed.exists_generating_factorization X x₀ P f hf
  let _ := hj
  let p : C.toOver ⟶ A.toOver := j ≫ fst A.toOver B.toOver
  let q : C.toOver ⟶ B.toOver := j ≫ snd A.toOver B.toOver
  refine ⟨C, c, p, q, hc, hgen, ?_, ?_, ?_, ?_⟩
  · exact inferInstanceAs (IsMonHom (j ≫ fst A.toOver B.toOver))
  · exact inferInstanceAs (IsMonHom (j ≫ snd A.toOver B.toOver))
  · change c ≫ j ≫ fst A.toOver B.toOver = a
    rw [← Category.assoc, hcf]
    exact lift_fst a b
  · change c ≫ j ≫ snd A.toOver B.toOver = b
    rw [← Category.assoc, hcf]
    exact lift_snd a b

end

end OAI.AlgebraicGeometry.Albanese.Construction.CommonRefinement
