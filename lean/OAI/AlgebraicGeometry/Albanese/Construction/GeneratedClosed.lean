open _root_.CategoryTheory _root_.AlgebraicGeometry
open MonoidalCategory CartesianMonoidalCategory MonObj

/-- Homomorphisms out of the generated abelian subvariety are determined by
their composite with the original source map. -/
theorem generated_hom_ext (X : Foundations.Scheme.SmoothProjective.SmoothProjectivePresentation)
    (A B C : ComplexMultiplication.CMAbelianVariety.CM.AbelianVariety) (f : X.toOver ⟶ A.toOver)
    (b : X.toOver ⟶ B.toOver) (j : B.toOver ⟶ A.toOver)
    [IsClosedImmersion j.left] [IsMonHom j] (hb : b ≫ j = f)
    (hgen : ∀ q : Over.mk (𝟙 Foundations.Scheme.ProjectiveSpace.complexBase) ⟶ A.toOver,
      (∃ p : Over.mk (𝟙 Foundations.Scheme.ProjectiveSpace.complexBase) ⟶ B.toOver, p ≫ j = q) ↔
        q ∈ Subgroup.closure (WordPoints.differencePointImage X A f))
    (φ ψ : B.toOver ⟶ C.toOver) [IsMonHom φ] [IsMonHom ψ]
    (h : b ≫ φ = b ≫ ψ) : φ = ψ := by
  have : Mono j := Over.mono_of_mono_left j
  have : LocallyOfFiniteType B.toOver.hom :=
    inferInstanceAs (LocallyOfFiniteType B.variety.structureMap)
  have : LocallyOfFiniteType C.toOver.hom :=
    inferInstanceAs (LocallyOfFiniteType C.variety.structureMap)
  have : IsReduced B.toOver.left := inferInstanceAs (IsReduced B.carrier)
  have : IsProper C.toOver.hom := C.variety.presentation.projective.isProper
  let J := IsMonHom.monoidHom j (Over.mk (𝟙 Foundations.Scheme.ProjectiveSpace.complexBase))
  let P := IsMonHom.monoidHom φ (Over.mk (𝟙 Foundations.Scheme.ProjectiveSpace.complexBase))
  let Q := IsMonHom.monoidHom ψ (Over.mk (𝟙 Foundations.Scheme.ProjectiveSpace.complexBase))
  let E := P.eqLocus Q
  let T := E.map J
  have hD : WordPoints.differencePointImage X A f ⊆ T := by
    rintro z ⟨p, rfl⟩
    let r : Over.mk (𝟙 Foundations.Scheme.ProjectiveSpace.complexBase) ⟶ B.toOver :=
      ((p ≫ fst X.toOver X.toOver) ≫ b) / ((p ≫ snd X.toOver X.toOver) ≫ b)
    refine ⟨r, ?_, ?_⟩
    · change r ≫ φ = r ≫ ψ
      simp [r, GrpObj.div_comp, Category.assoc, h]
    · change r ≫ j = p ≫ ImageWords.differenceMap X A f
      simp [r, ImageWords.differenceMap, GrpObj.div_comp, GrpObj.comp_div, Category.assoc, hb]
  have hclosure : Subgroup.closure (WordPoints.differencePointImage X A f) ≤ T :=
    (Subgroup.closure_le _).mpr hD
  apply ClosedPoints.hom_ext_of_points B.toOver C.toOver φ ψ
  intro p
  have hp : p ≫ j ∈ T := hclosure ((hgen _).mp ⟨p, rfl⟩)
  obtain ⟨r, hr, hrj⟩ := hp
  change r ≫ j = p ≫ j at hrj
  have hrp : r = p := (cancel_mono j).mp hrj
  subst r
  exact hr

end

open _root_.CategoryTheory _root_.AlgebraicGeometry
open MonoidalCategory CartesianMonoidalCategory MonObj

/-- The point differences of the source map generate every complex point of
the target. This is a generation condition, not a universal property. -/
def Generates (X : Foundations.Scheme.SmoothProjective.SmoothProjectivePresentation) (A : ComplexMultiplication.CMAbelianVariety.CM.AbelianVariety)
    (a : X.toOver ⟶ A.toOver) : Prop :=
  Subgroup.closure (WordPoints.differencePointImage X A a) = ⊤

/-- The closed subvariety constructed from the point differences is generated
by the factored source map. -/
theorem generated_factor_generates (X : Foundations.Scheme.SmoothProjective.SmoothProjectivePresentation)
    (A B : ComplexMultiplication.CMAbelianVariety.CM.AbelianVariety) (f : X.toOver ⟶ A.toOver)
    (b : X.toOver ⟶ B.toOver) (j : B.toOver ⟶ A.toOver)
    [IsClosedImmersion j.left] [IsMonHom j] (hb : b ≫ j = f)
    (hgen : ∀ q : Over.mk (𝟙 Foundations.Scheme.ProjectiveSpace.complexBase) ⟶ A.toOver,
      (∃ p : Over.mk (𝟙 Foundations.Scheme.ProjectiveSpace.complexBase) ⟶ B.toOver, p ≫ j = q) ↔
        q ∈ Subgroup.closure (WordPoints.differencePointImage X A f)) : Generates X B b := by
  have : Mono j := Over.mono_of_mono_left j
  let J := IsMonHom.monoidHom j (Over.mk (𝟙 Foundations.Scheme.ProjectiveSpace.complexBase))
  let T := Subgroup.closure (WordPoints.differencePointImage X B b)
  have hD : WordPoints.differencePointImage X A f ⊆ T.map J := by
    rintro z ⟨p, rfl⟩
    refine ⟨p ≫ ImageWords.differenceMap X B b, Subgroup.subset_closure ⟨p, rfl⟩, ?_⟩
    change (p ≫ ImageWords.differenceMap X B b) ≫ j = p ≫ ImageWords.differenceMap X A f
    simp [ImageWords.differenceMap, GrpObj.div_comp, GrpObj.comp_div, Category.assoc, hb]
  have hclosure : Subgroup.closure (WordPoints.differencePointImage X A f) ≤ T.map J :=
    (Subgroup.closure_le _).mpr hD
  apply le_antisymm le_top
  intro p _
  obtain ⟨q, hq, hqj⟩ := hclosure ((hgen _).mp ⟨p, rfl⟩)
  change q ≫ j = p ≫ j at hqj
  have hqp : q = p := (cancel_mono j).mp hqj
  exact hqp ▸ hq

/-- Every pointed map has a factorization through a generated abelian target. -/
theorem exists_generating_factorization (X : Foundations.Scheme.SmoothProjective.SmoothProjectivePresentation)
    [ConnectedSpace X.carrier] (x₀ : Over.mk (𝟙 Foundations.Scheme.ProjectiveSpace.complexBase) ⟶ X.toOver)
    (A : ComplexMultiplication.CMAbelianVariety.CM.AbelianVariety) (f : X.toOver ⟶ A.toOver) (hf : x₀ ≫ f = 1) :
    ∃ (B : ComplexMultiplication.CMAbelianVariety.CM.AbelianVariety) (b : X.toOver ⟶ B.toOver) (j : B.toOver ⟶ A.toOver),
      IsClosedImmersion j.left ∧ IsMonHom j ∧ x₀ ≫ b = 1 ∧ b ≫ j = f ∧
        Generates X B b := by
  obtain ⟨B, b, j, hjclosed, hjhom, hb0, hb, hgen⟩ :=
    exists_generated_abelian_subvariety X x₀ A f hf
  let _ := hjclosed
  let _ := hjhom
  exact ⟨B, b, j, hjclosed, hjhom, hb0, hb, generated_factor_generates X A B f b j hb hgen⟩

/-- A homomorphism carrying one source map to a generating source map is
surjective on complex points. -/
theorem refinement_point_surjective (X : Foundations.Scheme.SmoothProjective.SmoothProjectivePresentation)
    (A B : ComplexMultiplication.CMAbelianVariety.CM.AbelianVariety) (a : X.toOver ⟶ A.toOver) (b : X.toOver ⟶ B.toOver)
    (φ : A.toOver ⟶ B.toOver) [IsMonHom φ] (hφ : a ≫ φ = b)
    (hb : Generates X B b) :
    Function.Surjective (fun p : Over.mk (𝟙 Foundations.Scheme.ProjectiveSpace.complexBase) ⟶ A.toOver => p ≫ φ) := by
  let F := IsMonHom.monoidHom φ (Over.mk (𝟙 Foundations.Scheme.ProjectiveSpace.complexBase))
  have hD : WordPoints.differencePointImage X B b ⊆ F.range := by
    rintro z ⟨p, rfl⟩
    refine ⟨p ≫ ImageWords.differenceMap X A a, ?_⟩
    change (p ≫ ImageWords.differenceMap X A a) ≫ φ = p ≫ ImageWords.differenceMap X B b
    simp [ImageWords.differenceMap, GrpObj.div_comp, GrpObj.comp_div, Category.assoc, hφ]
  have hclosure := (Subgroup.closure_le F.range).mpr hD
  rw [hb] at hclosure
  intro p
  exact hclosure (Subgroup.mem_top p)

/-- Such a refinement is surjective on the underlying schemes as well. -/
theorem refinement_surjective (X : Foundations.Scheme.SmoothProjective.SmoothProjectivePresentation)
    (A B : ComplexMultiplication.CMAbelianVariety.CM.AbelianVariety) (a : X.toOver ⟶ A.toOver) (b : X.toOver ⟶ B.toOver)
    (φ : A.toOver ⟶ B.toOver) [IsMonHom φ] (hφ : a ≫ φ = b)
    (hb : Generates X B b) : Surjective φ.left := by
  have : IsProper A.toOver.hom := A.variety.presentation.projective.isProper
  have : IsProper B.toOver.hom := B.variety.presentation.projective.isProper
  have : IsProper (φ.left ≫ B.toOver.hom) := by rw [φ.w]; infer_instance
  have : IsProper φ.left := IsProper.of_comp _ B.toOver.hom
  have hpoints := refinement_point_surjective X A B a b φ hφ hb
  have hfull : Set.range (𝟙 B.toOver : B.toOver ⟶ B.toOver).left ⊆ Set.range φ.left := by
    apply ReducedFactor.range_subset_closed_of_points B.toOver B.toOver (𝟙 B.toOver)
      ⟨Set.range φ.left, φ.left.isClosedMap.isClosed_range⟩
    intro p
    obtain ⟨q, hq⟩ := hpoints p
    refine ⟨q.left (IsLocalRing.closedPoint ℂ), ?_⟩
    exact congrArg (fun r : Over.mk (𝟙 Foundations.Scheme.ProjectiveSpace.complexBase) ⟶ B.toOver =>
      r.left (IsLocalRing.closedPoint ℂ)) hq
  refine ⟨fun y => ?_⟩
  exact hfull ⟨y, rfl⟩

end

