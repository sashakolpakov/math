open _root_.CategoryTheory _root_.CategoryTheory.Limits _root_.AlgebraicGeometry
open MonoidalCategory CartesianMonoidalCategory MonObj

/-- Any pointed morphism to an abelian variety factors through the abelian
subvariety generated by its point differences. This constructs that subvariety
with its algebraic group law and inherited projective presentation. -/
theorem exists_generated_abelian_subvariety (X : Foundations.Scheme.SmoothProjective.SmoothProjectivePresentation)
    [ConnectedSpace X.carrier] (x₀ : Over.mk (𝟙 Foundations.Scheme.ProjectiveSpace.complexBase) ⟶ X.toOver)
    (A : ComplexMultiplication.CMAbelianVariety.CM.AbelianVariety) (f : X.toOver ⟶ A.toOver) (hf : x₀ ≫ f = 1) :
    ∃ (B : ComplexMultiplication.CMAbelianVariety.CM.AbelianVariety) (b : X.toOver ⟶ B.toOver) (j : B.toOver ⟶ A.toOver),
      IsClosedImmersion j.left ∧ IsMonHom j ∧ x₀ ≫ b = 1 ∧ b ≫ j = f ∧
      ∀ q : Over.mk (𝟙 Foundations.Scheme.ProjectiveSpace.complexBase) ⟶ A.toOver,
        (∃ p : Over.mk (𝟙 Foundations.Scheme.ProjectiveSpace.complexBase) ⟶ B.toOver, p ≫ j = q) ↔
          q ∈ Subgroup.closure (WordPoints.differencePointImage X A f) := by
  obtain ⟨Z, hZ⟩ := WordPoints.exists_generated_point_support X x₀ A f
  let W : Over Foundations.Scheme.ProjectiveSpace.complexBase := Over.mk (CycleClass.Geometric.SupportFiniteType.supportStructureMap Z A.variety.structureMap)
  let i : W ⟶ A.toOver := Over.homMk (CycleClass.Geometric.GenericPoint.reducedSupportι Z) rfl
  have hclosed : IsClosedImmersion i.left :=
    inferInstanceAs (IsClosedImmersion (CycleClass.Geometric.GenericPoint.reducedSupportι Z))
  have : Mono i := Over.mono_of_mono_left i
  have : IsIntegral W.left := inferInstanceAs (IsIntegral (CycleClass.Geometric.GenericPoint.reducedSupportScheme Z))
  have : LocallyOfFiniteType W.hom :=
    inferInstanceAs (LocallyOfFiniteType (CycleClass.Geometric.SupportFiniteType.supportStructureMap Z A.variety.structureMap))
  have : LocallyOfFiniteType A.toOver.hom :=
    inferInstanceAs (LocallyOfFiniteType A.variety.structureMap)
  let S := Subgroup.closure (WordPoints.differencePointImage X A f)
  have hS : ∀ q : Over.mk (𝟙 Foundations.Scheme.ProjectiveSpace.complexBase) ⟶ A.toOver,
      (∃ p : Over.mk (𝟙 Foundations.Scheme.ProjectiveSpace.complexBase) ⟶ W, p ≫ i = q) ↔ q ∈ S := by
    intro q
    rw [ClosedPoints.pointMap_range_iff W A.toOver i q]
    change q.left (IsLocalRing.closedPoint ℂ) ∈ Set.range (CycleClass.Geometric.GenericPoint.reducedSupportι Z) ↔ q ∈ S
    rw [CycleClass.Geometric.GenericPoint.range_reducedSupportι]
    exact hZ q
  have hsm : Smooth W.hom := SubgroupScheme.closed_point_subgroup_smooth W A.toOver i S hS
  obtain ⟨g, hg⟩ := exists_closed_point_subgroup_group W A.toOver i S hS
  let _ := g
  have hi : IsMonHom i := hg
  have : IsProper W.hom := (A.variety.presentation.projective.reducedSupport Z).isProper
  have : IsIntegral (W ⊗ W).left := Construction.Smooth.smooth_tensor_integral W W
  have hc : IsCommMonObj W :=
    isCommMonObj_of_isProper_of_isIntegral_tensorObj_of_isAlgClosed W
  let V : Foundations.Scheme.IntegralProjective.IntegralProjectiveVariety :=
    ⟨{ carrier := CycleClass.Geometric.GenericPoint.reducedSupportScheme Z
       structureMap := CycleClass.Geometric.SupportFiniteType.supportStructureMap Z A.variety.structureMap
       projective := A.variety.presentation.projective.reducedSupport Z
       smooth := hsm }, inferInstance⟩
  let B : ComplexMultiplication.CMAbelianVariety.CM.AbelianVariety := { variety := V, group := g, commutative := hc }
  have : LocallyOfFiniteType X.toOver.hom :=
    inferInstanceAs (LocallyOfFiniteType X.structureMap)
  have : IsReduced X.toOver.left := inferInstanceAs (IsReduced X.carrier)
  have hfrange : Set.range f.left ⊆ Set.range i.left := by
    apply range_factor_of_subgroup_points W X.toOver A.toOver i S hS f
    intro p
    apply Subgroup.subset_closure
    refine ⟨lift p x₀, ?_⟩
    simp [ImageWords.differenceMap, GrpObj.comp_div, hf]
  let b : X.toOver ⟶ W := closedFactorOver W X.toOver A.toOver i f hfrange
  have hb : b ≫ i = f := closedFactorOver_comp W X.toOver A.toOver i f hfrange
  have hb0 : x₀ ≫ b = 1 := by
    apply (cancel_mono i).mp
    rw [Category.assoc, hb, hf]
    simp
  exact ⟨B, b, i, hclosed, hi, hb0, hb, hS⟩

end

