open _root_.CategoryTheory _root_.CategoryTheory.Limits _root_.AlgebraicGeometry
open MonoidalCategory CartesianMonoidalCategory MonObj

/-- Factor a morphism over the complex base through a closed immersion. -/
def closedFactorOver (X U G : Over Foundations.Scheme.ProjectiveSpace.complexBase) [IsReduced U.left]
    (i : X ⟶ G) [IsClosedImmersion i.left] (f : U ⟶ G)
    (hf : Set.range f.left ⊆ Set.range i.left) : U ⟶ X :=
  Over.homMk (ReducedFactor.factorThroughClosed i.left f.left hf) (by
    calc
      ReducedFactor.factorThroughClosed i.left f.left hf ≫ X.hom =
          ReducedFactor.factorThroughClosed i.left f.left hf ≫ i.left ≫ G.hom := by rw [i.w]
      _ = f.left ≫ G.hom := by rw [← Category.assoc, ReducedFactor.factorThroughClosed_comp]
      _ = U.hom := f.w)

@[reassoc (attr := simp)]
theorem closedFactorOver_comp (X U G : Over Foundations.Scheme.ProjectiveSpace.complexBase) [IsReduced U.left]
    (i : X ⟶ G) [IsClosedImmersion i.left] (f : U ⟶ G)
    (hf : Set.range f.left ⊆ Set.range i.left) :
    closedFactorOver X U G i f hf ≫ i = f := by
  ext1
  exact ReducedFactor.factorThroughClosed_comp i.left f.left hf

/-- Membership in the rational point subgroup detects set-theoretic
factorization through the corresponding closed immersion. -/
theorem range_factor_of_subgroup_points (X U G : Over Foundations.Scheme.ProjectiveSpace.complexBase)
    [LocallyOfFiniteType X.hom] [LocallyOfFiniteType U.hom]
    [LocallyOfFiniteType G.hom] [GrpObj G]
    (i : X ⟶ G) [IsClosedImmersion i.left]
    (S : Subgroup (Over.mk (𝟙 Foundations.Scheme.ProjectiveSpace.complexBase) ⟶ G))
    (hS : ∀ q : Over.mk (𝟙 Foundations.Scheme.ProjectiveSpace.complexBase) ⟶ G,
      (∃ p : Over.mk (𝟙 Foundations.Scheme.ProjectiveSpace.complexBase) ⟶ X, p ≫ i = q) ↔ q ∈ S)
    (f : U ⟶ G) (hf : ∀ p : Over.mk (𝟙 Foundations.Scheme.ProjectiveSpace.complexBase) ⟶ U, p ≫ f ∈ S) :
    Set.range f.left ⊆ Set.range i.left := by
  apply ReducedFactor.range_subset_closed_of_points U G f
    ⟨Set.range i.left, i.left.isClosedMap.isClosed_range⟩
  intro p
  exact (ClosedPoints.pointMap_range_iff X G i _).mp ((hS _).mpr (hf p))

/-- An integral closed subscheme whose rational points form a subgroup
inherits an actual algebraic group structure, and its inclusion is a homomorphism. -/
theorem exists_closed_point_subgroup_group (X G : Over Foundations.Scheme.ProjectiveSpace.complexBase)
    [LocallyOfFiniteType X.hom] [LocallyOfFiniteType G.hom] [GrpObj G]
    [IsIntegral X.left]
    (i : X ⟶ G) [IsClosedImmersion i.left]
    (S : Subgroup (Over.mk (𝟙 Foundations.Scheme.ProjectiveSpace.complexBase) ⟶ G))
    (hS : ∀ q : Over.mk (𝟙 Foundations.Scheme.ProjectiveSpace.complexBase) ⟶ G,
      (∃ p : Over.mk (𝟙 Foundations.Scheme.ProjectiveSpace.complexBase) ⟶ X, p ≫ i = q) ↔ q ∈ S) :
    ∃ g : GrpObj X, letI := g; IsMonHom i := by
  have : Mono i := Over.mono_of_mono_left i
  have : Smooth X.hom := SubgroupScheme.closed_point_subgroup_smooth X G i S hS
  have : Smooth (X ⊗ X).hom := by dsimp; infer_instance
  have : IsIntegral (X ⊗ X).left := Construction.Smooth.smooth_tensor_integral X X
  obtain ⟨e, he⟩ := (hS 1).mpr S.one_mem
  let mf : X ⊗ X ⟶ G := (fst X X ≫ i) * (snd X X ≫ i)
  have hmrange : Set.range mf.left ⊆ Set.range i.left := by
    apply range_factor_of_subgroup_points X (X ⊗ X) G i S hS mf
    intro p
    simp only [mf, MonObj.comp_mul]
    exact S.mul_mem ((hS _).mp ⟨p ≫ fst X X, Category.assoc _ _ _⟩)
      ((hS _).mp ⟨p ≫ snd X X, Category.assoc _ _ _⟩)
  have hvrange : Set.range (i⁻¹).left ⊆ Set.range i.left := by
    apply range_factor_of_subgroup_points X X G i S hS i⁻¹
    intro p
    rw [GrpObj.comp_inv]
    exact S.inv_mem ((hS _).mp ⟨p, rfl⟩)
  let m := closedFactorOver X (X ⊗ X) G i mf hmrange
  let v := closedFactorOver X X G i i⁻¹ hvrange
  have hm : m ≫ i = (fst X X ≫ i) * (snd X X ≫ i) :=
    closedFactorOver_comp X (X ⊗ X) G i mf hmrange
  have hv : v ≫ i = i⁻¹ := closedFactorOver_comp X X G i i⁻¹ hvrange
  refine ⟨GroupLifts.groupOfMono i e m v he hm hv, ?_⟩
  exact GroupLifts.groupOfMono_isMonHom i e m v he hm hv

end

