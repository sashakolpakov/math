import Mathlib.RingTheory.TensorProduct.Quotient

/-! # Tensor Kernel -/

namespace OAI.AlgebraicGeometry.IntersectionTheory.ProjectionFormula.Relative.TensorKernel

noncomputable section

/-! The kernel of changing the tensor base is generated by the actual
balancing relations. Ideal containment can therefore be checked on the
differences of the two scalar embeddings. -/

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

open scoped TensorProduct

universe u

variable (K P A : Type u) [CommRing K] [CommRing P] [CommRing A]
  [Algebra K P] [Algebra K A] [Algebra P A] [IsScalarTower K P A]

def map : A ⊗[K] A →ₐ[A] A ⊗[P] A :=
  Algebra.TensorProduct.mapOfCompatibleSMul P K A A A

theorem map_tmul (a b : A) : map K P A (a ⊗ₜ[K] b) = a ⊗ₜ[P] b := rfl

theorem surjective : Function.Surjective (map K P A) :=
  Algebra.TensorProduct.mapOfCompatibleSMul_surjective P K A A A

theorem kernel_le (J : Ideal (A ⊗[K] A))
    (hJ : ∀ p : P, algebraMap P A p ⊗ₜ[K] (1 : A) - (1 : A) ⊗ₜ[K] algebraMap P A p ∈ J) :
    RingHom.ker (map K P A).toRingHom ≤ J := by
  have h : (TensorProduct.mapOfCompatibleSMul P K P A A).ker ≤ J.restrictScalars P := by
    rw [TensorProduct.AlgebraTensorModule.ker_mapOfCompatibleSMul]
    apply Submodule.span_le.mpr
    rintro _ ⟨p, a, b, rfl⟩
    change (p • a) ⊗ₜ[K] b - a ⊗ₜ[K] (p • b) ∈ J
    simp only [Algebra.smul_def]
    simpa only [sub_mul, Algebra.TensorProduct.tmul_mul_tmul, one_mul] using J.mul_mem_right (a ⊗ₜ[K] b) (hJ p)
  intro x hx
  exact h hx

end

end OAI.AlgebraicGeometry.IntersectionTheory.ProjectionFormula.Relative.TensorKernel
