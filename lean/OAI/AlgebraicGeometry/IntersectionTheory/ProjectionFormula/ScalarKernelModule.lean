import OAI.AlgebraicGeometry.IntersectionTheory.ProjectionFormula.Parameter.ScalarQuotient
import Mathlib.LinearAlgebra.Isomorphisms

/-! # Scalar Kernel Module -/

namespace OAI.AlgebraicGeometry.IntersectionTheory.ProjectionFormula.ScalarKernelModule

noncomputable section

/-! A surjective algebra map whose kernel is generated by the
image of a parameter gives the actual scalar-quotient module. -/

set_option backward.isDefEq.respectTransparency false

open _root_.CategoryTheory
open scoped Pointwise

universe u

variable (R S T : Type u) [CommRing R] [CommRing S] [CommRing T]
  [Algebra R S] [Algebra R T] (r : R) (φ : S →ₐ[R] T)
  (hφ : Function.Surjective φ)
  (hk : RingHom.ker φ.toRingHom = Ideal.span {algebraMap R S r})

include hk in
theorem kernel : r • (⊤ : Submodule R S) = φ.toLinearMap.ker := by
  ext s
  rw [Submodule.mem_smul_pointwise_iff_exists]
  change (∃ b ∈ (⊤ : Submodule R S), r • b = s) ↔ φ s = 0
  change (∃ b ∈ (⊤ : Submodule R S), r • b = s) ↔ s ∈ RingHom.ker φ.toRingHom
  rw [hk, Ideal.mem_span_singleton]
  simp only [Submodule.mem_top, true_and, Algebra.smul_def, dvd_def]
  exact exists_congr fun b => eq_comm

def equiv : QuotSMulTop r S ≃ₗ[R] T :=
  (Submodule.quotEquivOfEq _ _ (kernel R S T r φ hk)).trans
    (φ.toLinearMap.quotKerEquivOfSurjective hφ)

def quotientEquiv [Algebra (Parameter.ScalarQuotient.Ring R r) T]
    [IsScalarTower R (Parameter.ScalarQuotient.Ring R r) T] :
    QuotSMulTop r S ≃ₗ[Parameter.ScalarQuotient.Ring R r] T :=
  (equiv R S T r φ hφ hk).extendScalarsOfSurjective Ideal.Quotient.mk_surjective

end

end OAI.AlgebraicGeometry.IntersectionTheory.ProjectionFormula.ScalarKernelModule
