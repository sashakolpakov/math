import OAI.AlgebraicGeometry.Picard.Homomorphisms.Diagonalizable
import OAI.AlgebraicGeometry.Picard.Homomorphisms.KernelGroup
import Mathlib.CategoryTheory.Subobject.Basic

/-! # Multiplicative Subgroup -/

namespace OAI.AlgebraicGeometry.Picard.Homomorphisms.MultiplicativeSubgroup

noncomputable section

/-! A Frobenius-independent closed subscheme generated by the finite
split multiplicative p-torsion subgroups. On an algebraically closed
ordinary fiber, its defining ideal is proved to be the ideal of the
Frobenius kernel. All comparisons are scheme-theoretic. -/

open _root_.CategoryTheory _root_.AlgebraicGeometry
open scoped _root_.CategoryTheory.MonObj

set_option backward.isDefEq.respectTransparency.types false

namespace Construction

universe u

variable (p : ℕ) (k : Type u) [Field k]
variable (A : Over (Spec (.of k))) [GrpObj A]

/-- The schematic union of all closed subgroups isomorphic to a finite
product of μ_p. This definition makes no reference to Frobenius. -/
def multiplicativePTorsionIdeal : A.left.IdealSheafData :=
  sInf {I | ∃ (n : ℕ) (j : Diagonalizable.Construction.splitMultiplicativePTorsion p k n ⟶ A),
    IsMonHom j ∧ IsClosedImmersion j.left ∧ j.left.ker = I}

def multiplicativePTorsionScheme : Over (Spec (.of k)) :=
  Over.mk ((multiplicativePTorsionIdeal p k A).subschemeι ≫ A.hom)

def multiplicativePTorsionInclusion : multiplicativePTorsionScheme p k A ⟶ A :=
  Over.homMk (multiplicativePTorsionIdeal p k A).subschemeι rfl

instance multiplicativePTorsionInclusion_closed :
    IsClosedImmersion (multiplicativePTorsionInclusion p k A).left :=
  inferInstanceAs (IsClosedImmersion (multiplicativePTorsionIdeal p k A).subschemeι)

instance multiplicativePTorsionInclusion_mono : Mono (multiplicativePTorsionInclusion p k A) :=
  Over.mono_of_mono_left _

def multiplicativePTorsion : Subobject A := Subobject.mk (multiplicativePTorsionInclusion p k A)

variable [Fact p.Prime] [CharP k p]

theorem frobeniusKernel_inclusion_closed [IsSeparated A.hom] :
    IsClosedImmersion (Kernel.Construction.kernelInclusion (Frobenius.Construction.relativeFrobenius p Fact.out
      (Affine.Construction.prime_eq_zero_spec p k (CharP.cast_eq_zero k p)) A)).left := by
  have : IsSeparated (Frobenius.Construction.frobeniusTwist p Fact.out
      (Affine.Construction.prime_eq_zero_spec p k (CharP.cast_eq_zero k p)) A).hom :=
    inferInstanceAs (IsSeparated (CategoryTheory.Limits.pullback.snd A.hom
      (Frobenius.Construction.absoluteFrobenius p Fact.out (Spec (.of k))
        (Affine.Construction.prime_eq_zero_spec p k (CharP.cast_eq_zero k p)))))
  exact Kernel.Construction.kernelInclusion_closedImmersion _

theorem frobeniusKernel_ideal_le_multiplicativePTorsion :
    (Kernel.Construction.kernelInclusion (Frobenius.Construction.relativeFrobenius p Fact.out
      (Affine.Construction.prime_eq_zero_spec p k (CharP.cast_eq_zero k p)) A)).left.ker ≤
        multiplicativePTorsionIdeal p k A := by
  apply le_sInf
  rintro I ⟨n, j, hj, _, rfl⟩
  have : IsMonHom j := hj
  obtain ⟨a, ha, _⟩ := Diagonalizable.Construction.splitMultiplicativePTorsion_factors_frobeniusKernel
    p Fact.out k (CharP.cast_eq_zero k p) n A j
  have h := a.left.le_ker_comp
    (Kernel.Construction.kernelInclusion (Frobenius.Construction.relativeFrobenius p Fact.out
      (Affine.Construction.prime_eq_zero_spec p k (CharP.cast_eq_zero k p)) A)).left
  exact h.trans_eq (congrArg Scheme.Hom.ker (congrArg Over.Hom.left ha))

theorem multiplicativePTorsionIdeal_eq_of_kernelIso
    [IsSeparated A.hom]
    (n : ℕ) (e : Grp.mk (Kernel.Construction.kernelScheme (Frobenius.Construction.relativeFrobenius p Fact.out
      (Affine.Construction.prime_eq_zero_spec p k (CharP.cast_eq_zero k p)) A)) ≅
        Grp.mk (Diagonalizable.Construction.splitMultiplicativePTorsion p k n)) :
    multiplicativePTorsionIdeal p k A =
      (Kernel.Construction.kernelInclusion (Frobenius.Construction.relativeFrobenius p Fact.out
        (Affine.Construction.prime_eq_zero_spec p k (CharP.cast_eq_zero k p)) A)).left.ker := by
  let F := Frobenius.Construction.relativeFrobenius p Fact.out (Affine.Construction.prime_eq_zero_spec p k (CharP.cast_eq_zero k p)) A
  have : IsClosedImmersion (Kernel.Construction.kernelInclusion F).left := frobeniusKernel_inclusion_closed p k A
  let j := e.inv.hom.hom ≫ Kernel.Construction.kernelInclusion F
  have : IsMonHom j := inferInstanceAs (IsMonHom (e.inv.hom.hom ≫ Kernel.Construction.kernelInclusion F))
  have : IsIso e.inv.hom.hom.left :=
    inferInstanceAs (IsIso ((Grp.forget _ ⋙ Over.forget _).map e.inv))
  have : IsClosedImmersion j.left := inferInstanceAs
    (IsClosedImmersion (e.inv.hom.hom.left ≫ (Kernel.Construction.kernelInclusion F).left))
  apply le_antisymm
  · apply sInf_le
    refine ⟨n, j, inferInstance, inferInstance, ?_⟩
    exact Scheme.Hom.ker_comp_of_isIso e.inv.hom.hom.left (Kernel.Construction.kernelInclusion F).left
  · exact frobeniusKernel_ideal_le_multiplicativePTorsion p k A

theorem closedSubobject_eq_of_ideal_eq {S : Scheme.{u}} {G H A : Over S}
    (i : G ⟶ A) (j : H ⟶ A) [IsClosedImmersion i.left] [IsClosedImmersion j.left]
    [Mono i] [Mono j] (h : i.left.ker = j.left.ker) : Subobject.mk i = Subobject.mk j := by
  let a : G ⟶ H := Over.homMk (IsClosedImmersion.lift j.left i.left h.ge) (by
    rw [← Over.w j, ← Category.assoc, IsClosedImmersion.lift_fac, Over.w i])
  let b : H ⟶ G := Over.homMk (IsClosedImmersion.lift i.left j.left h.le) (by
    rw [← Over.w i, ← Category.assoc, IsClosedImmersion.lift_fac, Over.w j])
  exact le_antisymm
    (Subobject.mk_le_mk_of_comm a (Over.OverMorphism.ext (IsClosedImmersion.lift_fac _ _ _)))
    (Subobject.mk_le_mk_of_comm b (Over.OverMorphism.ext (IsClosedImmersion.lift_fac _ _ _)))

theorem frobeniusKernel_eq_multiplicativePTorsion_of_iso
    [IsSeparated A.hom]
    (n : ℕ) (e : Grp.mk (Kernel.Construction.kernelScheme (Frobenius.Construction.relativeFrobenius p Fact.out
      (Affine.Construction.prime_eq_zero_spec p k (CharP.cast_eq_zero k p)) A)) ≅
        Grp.mk (Diagonalizable.Construction.splitMultiplicativePTorsion p k n)) :
    Subobject.mk (Kernel.Construction.kernelInclusion (Frobenius.Construction.relativeFrobenius p Fact.out
      (Affine.Construction.prime_eq_zero_spec p k (CharP.cast_eq_zero k p)) A)) = multiplicativePTorsion p k A := by
  have := frobeniusKernel_inclusion_closed p k A
  apply closedSubobject_eq_of_ideal_eq
  change _ = (multiplicativePTorsionIdeal p k A).subschemeι.ker
  rw [Scheme.IdealSheafData.ker_subschemeι]
  exact (multiplicativePTorsionIdeal_eq_of_kernelIso p k A n e).symm

end Construction

end

end OAI.AlgebraicGeometry.Picard.Homomorphisms.MultiplicativeSubgroup
