import OAI.AlgebraicGeometry.ComplexPoints.Analytic.AffinePointMaps
import OAI.AlgebraicTopology.Cohomology.Singular.Functor

/-! # Affine -/

namespace OAI.AlgebraicGeometry.Betti.Affine

noncomputable section

/-!
# Betti cohomology of actual affine complex points

This module connects the algebraic and topological constructions. The points
are genuine complex-algebra characters; their topology is generated by the
ordinary complex-valued evaluations. Cohomology is the cohomology of the actual
continuous singular cochain complex of that space.

The variance is important: an algebra map `A → B` induces a continuous map of
points `B(ℂ) → A(ℂ)`, then a pullback `Hⁿ(A(ℂ)) → Hⁿ(B(ℂ))`.

This is an affine construction. It does not supply the still-required global
analytic realization, de Rham comparison, or geometric algebraic cycle map.
-/

open _root_.CategoryTheory Opposite

variable {R : Type} [Ring R]

/-- The ordinary space of complex-valued points of a complex algebra. -/
abbrev affinePointSpace (A : Type) [CommRing A] [Algebra ℂ A] : TopCat :=
  TopCat.of (Foundations.Scheme.AffineComplexPoints.affineComplexPoints A)

/-- Genuine singular cohomology of the ordinary affine complex-point space. -/
abbrev affineBetti (M : ModuleCat R) (A : Type) [CommRing A] [Algebra ℂ A]
    (n : ℕ) : ModuleCat R :=
  AlgebraicTopology.Cohomology.Singular.Basic.singularCohomology M (affinePointSpace A) n

/-- Betti cohomology is covariant as a functor of complex coordinate algebras. -/
def affineBettiFunctor (M : ModuleCat R) (n : ℕ) :
    CommAlgCat ℂ ⥤ ModuleCat R :=
  ComplexPoints.Analytic.AffinePointMaps.affineComplexPointsFunctor.rightOp ⋙ AlgebraicTopology.Cohomology.Singular.Functor.singularCohomologyFunctor M n

@[simp]
theorem affineBettiFunctor_obj (M : ModuleCat R) (n : ℕ) (A : CommAlgCat ℂ) :
    (affineBettiFunctor M n).obj A = affineBetti M A n := rfl

/-- The map induced on affine Betti cohomology by an actual algebra map. -/
def affineBettiMap (M : ModuleCat R) (n : ℕ)
    {A B : Type} [CommRing A] [Algebra ℂ A] [CommRing B] [Algebra ℂ B]
    (f : A →ₐ[ℂ] B) : affineBetti M A n ⟶ affineBetti M B n :=
  AlgebraicTopology.Cohomology.Singular.Functor.singularCohomologyPullback M
    (TopCat.ofHom (Foundations.Scheme.AffineComplexPoints.affineComplexPoints.comap f)) n

@[simp]
theorem affineBettiFunctor_map (M : ModuleCat R) (n : ℕ)
    {A B : CommAlgCat ℂ} (f : A ⟶ B) :
    (affineBettiFunctor M n).map f = affineBettiMap M n f.hom := rfl

/-- Changing coefficients for the singular cohomology of actual affine points. -/
def affineBettiCoefficientMap {M N : ModuleCat R} (u : M ⟶ N)
    (A : Type) [CommRing A] [Algebra ℂ A] (n : ℕ) :
    affineBetti M A n ⟶ affineBetti N A n :=
  AlgebraicTopology.Cohomology.Singular.Coefficients.coefficientMap u (affinePointSpace A) n

/-- The coefficient map commutes with the map coming from an algebra morphism. -/
theorem affineBettiCoefficientMap_naturality {M N : ModuleCat R} (u : M ⟶ N)
    {A B : Type} [CommRing A] [Algebra ℂ A] [CommRing B] [Algebra ℂ B]
    (f : A →ₐ[ℂ] B) (n : ℕ) :
    affineBettiMap M n f ≫ affineBettiCoefficientMap u B n =
      affineBettiCoefficientMap u A n ≫ affineBettiMap N n f :=
  AlgebraicTopology.Cohomology.Singular.Functor.coefficientMap_naturality u
    (TopCat.ofHom (Foundations.Scheme.AffineComplexPoints.affineComplexPoints.comap f)) n

/-- Coefficient change is a natural transformation on the algebra category. -/
def affineBettiCoefficientTransformation {M N : ModuleCat R} (u : M ⟶ N) (n : ℕ) :
    affineBettiFunctor M n ⟶ affineBettiFunctor N n where
  app A := affineBettiCoefficientMap u A n
  naturality _ _ f := affineBettiCoefficientMap_naturality u f.hom n

/-- Isomorphic coordinate algebras induce isomorphic Betti cohomology. -/
def affineBettiIso (M : ModuleCat R) (n : ℕ) {A B : CommAlgCat ℂ} (e : A ≅ B) :
    affineBetti M A n ≅ affineBetti M B n :=
  (affineBettiFunctor M n).mapIso e

@[simp]
theorem affineBettiIso_hom (M : ModuleCat R) (n : ℕ)
    {A B : CommAlgCat ℂ} (e : A ≅ B) :
    (affineBettiIso M n e).hom = affineBettiMap M n e.hom.hom := rfl

end

end OAI.AlgebraicGeometry.Betti.Affine
