import OAI.RepresentationTheory.Weil.Local.LinearOscillatorHom
import Mathlib.LinearAlgebra.Matrix.Permutation

/-! # Special Linear Commutators -/

namespace OAI.RepresentationTheory.Weil.Local.SpecialLinearCommutators.Construction

noncomputable section

section

/-! Determinant-one linear matrices are generated by concrete commutators. -/

open _root_.Matrix
open scoped Classical

variable {ι : Type*} [Fintype ι] [DecidableEq ι] {k : Type} [Field k]

def coordinateDiagonal (i : ι) (a : kˣ) : (Matrix ι ι k)ˣ where
  val := diagonal (fun j => if j = i then a.val else 1)
  inv := diagonal (fun j => if j = i then a.inv else 1)
  val_inv := by
    rw [diagonal_mul_diagonal, diagonal_eq_one]
    funext j
    split_ifs <;> simp
  inv_val := by
    rw [diagonal_mul_diagonal, diagonal_eq_one]
    funext j
    split_ifs <;> simp

def coordinateSwap (i j : ι) : (Matrix ι ι k)ˣ where
  val := (Equiv.swap i j).permMatrix k
  inv := (Equiv.swap i j).permMatrix k
  val_inv := by rw [← Matrix.permMatrix_mul]; simp
  inv_val := by rw [← Matrix.permMatrix_mul]; simp

theorem coordinateDiagonal_swap_commutator (i j : ι) (hij : i ≠ j) (a : kˣ) :
    coordinateDiagonal i a * coordinateSwap i j * (coordinateDiagonal i a)⁻¹ * (coordinateSwap i j)⁻¹ =
      SpecialLinearGroup.toGL (SpecialLinearGroup.diag2n hij a.val a.ne_zero) := by
  apply Units.ext
  apply Matrix.toLin'.injective
  apply LinearMap.ext
  intro v
  change (((coordinateDiagonal i a).val * (coordinateSwap i j).val *
      ((coordinateDiagonal i a)⁻¹).val * ((coordinateSwap i j)⁻¹).val) *ᵥ v) = _
  rw [← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec]
  change diagonal (fun l => if l = i then a.val else 1) *ᵥ
      ((Equiv.swap i j).permMatrix k *ᵥ (diagonal (fun l => if l = i then a.inv else 1) *ᵥ
        ((Equiv.swap i j).permMatrix k *ᵥ v))) =
      diagonal (fun l => if l = i then a.val else if l = j then a.val⁻¹ else 1) *ᵥ v
  simp only [Matrix.permMatrix_mulVec]
  funext l
  by_cases hli : l = i
  · subst l
    simp [Matrix.mulVec_diagonal, Function.comp_def, hij.symm]
  · by_cases hlj : l = j
    · subst l
      simp [Matrix.mulVec_diagonal, Function.comp_def, hij.symm]
    · simp [Matrix.mulVec_diagonal, Function.comp_def, hli, hlj,
        Equiv.swap_apply_of_ne_of_ne hli hlj]

theorem coordinateDiagonal_transvection_conjugation (i j : ι) (hij : i ≠ j) (a : kˣ) (b : k) :
    coordinateDiagonal i a * SpecialLinearGroup.toGL (SpecialLinearGroup.transvection hij b) *
      (coordinateDiagonal i a)⁻¹ =
      SpecialLinearGroup.toGL (SpecialLinearGroup.transvection hij (a.val * b)) := by
  apply Units.ext
  change diagonal (fun l => if l = i then a.val else 1) * (1 + single i j b) *
      diagonal (fun l => if l = i then a.inv else 1) = 1 + single i j (a.val * b)
  rw [mul_add, mul_one, add_mul, diagonal_mul_diagonal]
  have hD : diagonal (fun l => (if l = i then a.val else 1) * (if l = i then a.inv else 1)) =
      (1 : Matrix ι ι k) := by
    rw [diagonal_eq_one]
    funext l
    split_ifs <;> simp
  rw [hD]
  congr 1
  ext r s
  simp only [mul_diagonal, diagonal_mul]
  by_cases hr : r = i
  · subst r
    by_cases hs : s = j
    · subst s
      simp [hij.symm]
    · simp [Ne.symm hs]
  · simp [Ne.symm hr]

theorem specialLinear_toGL_mem_commutator [CharZero k] (A : SpecialLinearGroup ι k) :
    SpecialLinearGroup.toGL A ∈ commutator (Matrix ι ι k)ˣ := by
  rcases subsingleton_or_nontrivial ι with hs | hn
  · let : Subsingleton ι := hs
    have hA : A = 1 := by
      apply Subtype.ext
      rcases isEmpty_or_nonempty ι with he | he
      · let : IsEmpty ι := he
        exact Subsingleton.elim _ _
      · let : Nonempty ι := he
        ext i j
        let : Unique ι := ⟨⟨i⟩, fun l => Subsingleton.elim l i⟩
        have h := A.property
        rw [det_unique] at h
        have hi : i = default := Subsingleton.elim _ _
        have hj : j = default := Subsingleton.elim _ _
        change A.val i j = (1 : Matrix ι ι k) i j
        rw [Matrix.one_apply, ite_eq_left (Subsingleton.elim i j)]
        exact (congrArg₂ A.val hi hj).trans h
    simp [hA]
  · let : Nontrivial ι := hn
    apply SpecialLinearGroup.diagonal_transvection_induction' (fun M =>
      SpecialLinearGroup.toGL M ∈ commutator (Matrix ι ι k)ˣ) A
    · intro i j hij c hc
      have heq := coordinateDiagonal_swap_commutator i j hij (Units.mk0 c hc)
      change _ = SpecialLinearGroup.toGL (SpecialLinearGroup.diag2n hij c hc) at heq
      rw [← heq]
      exact Subgroup.commutator_mem_commutator (Subgroup.mem_top _) (Subgroup.mem_top _)
    · intro i j hij b
      let a : kˣ := Units.mk0 2 (by norm_num)
      have hconj := coordinateDiagonal_transvection_conjugation i j hij a b
      have heq : coordinateDiagonal i a * SpecialLinearGroup.toGL (SpecialLinearGroup.transvection hij b) *
          (coordinateDiagonal i a)⁻¹ * (SpecialLinearGroup.toGL (SpecialLinearGroup.transvection hij b))⁻¹ =
          SpecialLinearGroup.toGL (SpecialLinearGroup.transvection hij b) := by
        rw [hconj, ← map_inv, SpecialLinearGroup.transvection_inv, ← map_mul,
          ← SpecialLinearGroup.transvection_add]
        congr 2
        change 2 * b + -b = b
        ring
      rw [← heq]
      exact Subgroup.commutator_mem_commutator (Subgroup.mem_top _) (Subgroup.mem_top _)
    · intro M N hM hN
      rw [map_mul]
      exact (commutator (Matrix ι ι k)ˣ).mul_mem hM hN

end

/-! Actual bare Levi lifts of every determinant-one matrix. -/

open _root_.MeasureTheory

theorem linearOscillator_mem_of_det_one
    {k : Type} [NormedField k] [LocallyCompactSpace k] [CharZero k]
    [MeasurableSpace k] [BorelSpace k] [SecondCountableTopology k] {n : ℕ}
    (ψ : AddChar k ℂ) (A : FunctionsMetaplectic.Construction.GeneralLinear k n) (hA : A.val.det = 1) :
    LinearIntertwiner.Construction.linearOscillator ψ A ∈ FunctionsMetaplectic.Construction.metaplecticSubgroup k n ψ := by
  let H := (FunctionsMetaplectic.Construction.metaplecticSubgroup k n ψ).comap (LinearOscillatorHom.Construction.linearOscillatorHom n ψ)
  have hder : commutator (FunctionsMetaplectic.Construction.GeneralLinear k n) ≤ H := by
    rw [commutator_eq_closure]
    rw [Subgroup.closure_le]
    rintro z ⟨a, b, rfl⟩
    exact LinearOscillatorHom.Construction.linear_commutator_mem_metaplectic ψ a b
  let S : Matrix.SpecialLinearGroup (Fin n) k := ⟨A.val, hA⟩
  have hS := specialLinear_toGL_mem_commutator S
  have heq : Matrix.SpecialLinearGroup.toGL S = A := Units.ext rfl
  rw [heq] at hS
  exact hder hS

def specialLinearMetaplectic
    {k : Type} [NormedField k] [LocallyCompactSpace k] [CharZero k]
    [MeasurableSpace k] [BorelSpace k]
    (hNondiscrete : ¬ DiscreteTopology k) {n : ℕ}
    (ψ : AddChar k ℂ) (A : FunctionsMetaplectic.Construction.GeneralLinear k n) (hA : A.val.det = 1) : FunctionsMetaplectic.Construction.Metaplectic k n ψ := by
  let : SecondCountableTopology k := FunctionsMetaplectic.Construction.localField_secondCountable k hNondiscrete
  exact ⟨LinearIntertwiner.Construction.linearOscillator ψ A, linearOscillator_mem_of_det_one ψ A hA⟩

theorem specialLinearMetaplectic_projection
    {k : Type} [NormedField k] [LocallyCompactSpace k] [CharZero k]
    [MeasurableSpace k] [BorelSpace k]
    (hNondiscrete : ¬ DiscreteTopology k) {n : ℕ}
    (ψ : AddChar k ℂ) (A : FunctionsMetaplectic.Construction.GeneralLinear k n) (hA : A.val.det = 1) :
    FunctionsMetaplectic.Construction.metaplecticProjection k n ψ (specialLinearMetaplectic hNondiscrete ψ A hA) = Generators.Construction.leviSymplectic A := rfl

theorem specialLinearMetaplectic_apply
    {k : Type} [NormedField k] [LocallyCompactSpace k] [CharZero k]
    [MeasurableSpace k] [BorelSpace k]
    (hNondiscrete : ¬ DiscreteTopology k) {n : ℕ}
    (ψ : AddChar k ℂ) (A : FunctionsMetaplectic.Construction.GeneralLinear k n) (hA : A.val.det = 1)
    (f : FunctionsMetaplectic.Construction.schwartzBruhat k n) (x : FunctionsMetaplectic.Construction.Position k n) :
    (FunctionsMetaplectic.Construction.weilRepresentation k n ψ (specialLinearMetaplectic hNondiscrete ψ A hA) f).val x =
      f.val (Matrix.mulVec (↑(A⁻¹) : Matrix (Fin n) (Fin n) k) x) := by
  let : SecondCountableTopology k := FunctionsMetaplectic.Construction.localField_secondCountable k hNondiscrete
  change ((LinearIntertwiner.Construction.linearOscillator ψ A).val.2 f).val x = _
  rw [LinearIntertwiner.Construction.linearOscillator_apply]
  have hdet : FunctionsMetaplectic.Construction.determinantUnit k A = 1 := Units.ext hA
  simp [hdet, FunctionsMetaplectic.Construction.localModulus_one]

end

end OAI.RepresentationTheory.Weil.Local.SpecialLinearCommutators.Construction
