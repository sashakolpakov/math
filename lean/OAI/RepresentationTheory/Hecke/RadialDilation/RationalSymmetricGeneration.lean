import OAI.RepresentationTheory.Hecke.RadialDilation.QuadraticCommutator

/-! # Rational Symmetric Generation -/

namespace OAI.RepresentationTheory.Hecke.RadialDilation.RationalSymmetricGeneration.Realization

noncomputable section

/-! Rational general linear matrices are generated by symmetric invertible matrices. -/

open scoped Classical _root_.Matrix
open _root_.Matrix

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

def rationalSwapMatrix (i j : ι) : (Matrix ι ι ℚ)ˣ where
  val := (Equiv.swap i j).permMatrix ℚ
  inv := (Equiv.swap i j).permMatrix ℚ
  val_inv := by rw [← Matrix.permMatrix_mul]; simp
  inv_val := by rw [← Matrix.permMatrix_mul]; simp

theorem rationalSwapMatrix_symmetric (i j : ι) : (rationalSwapMatrix i j).val.IsSymm := by
  change ((Equiv.swap i j).permMatrix ℚ).transpose = (Equiv.swap i j).permMatrix ℚ
  rw [Matrix.transpose_permMatrix]
  simp

theorem rationalSwapMatrix_square (i j : ι) : rationalSwapMatrix i j * rationalSwapMatrix i j = 1 := by
  apply Units.ext
  change (Equiv.swap i j).permMatrix ℚ * (Equiv.swap i j).permMatrix ℚ = 1
  rw [← Matrix.permMatrix_mul]
  simp

theorem rational_transvection_mul_swap (t : Matrix.TransvectionStruct ι ℚ) :
    t.toMatrix * (rationalSwapMatrix t.i t.j).val =
      (rationalSwapMatrix t.i t.j).val + Matrix.single t.i t.i t.c := by
  rw [TransvectionStruct.toMatrix, Matrix.transvection, Matrix.add_mul, Matrix.one_mul]
  congr 1
  ext a b
  by_cases ha : a = t.i
  · subst a
    rw [Matrix.single_mul_apply_same]
    simp [rationalSwapMatrix, PEquiv.toMatrix, Equiv.toPEquiv_apply, Matrix.single]
  · rw [Matrix.single_mul_apply_of_ne t.c t.i t.j a b ha]
    simp [Matrix.single, Ne.symm ha]

theorem rational_transvection_mul_swap_symmetric (t : Matrix.TransvectionStruct ι ℚ) :
    (t.toMatrix * (rationalSwapMatrix t.i t.j).val).IsSymm := by
  rw [rational_transvection_mul_swap]
  apply (rationalSwapMatrix_symmetric t.i t.j).add
  change (Matrix.single t.i t.i t.c).transpose = Matrix.single t.i t.i t.c
  simp

theorem rationalGL_generated_by_symmetric (H : Subgroup (Matrix ι ι ℚ)ˣ)
    (hSym : ∀ A : (Matrix ι ι ℚ)ˣ, A.val.IsSymm → A ∈ H) : H = ⊤ := by
  apply top_unique
  intro U _
  have hp : ∀ M : Matrix ι ι ℚ, M.det ≠ 0 →
      ∀ A : (Matrix ι ι ℚ)ˣ, A.val = M → A ∈ H := by
    intro M hM
    apply Matrix.diagonal_transvection_induction_of_det_ne_zero
      (fun M => ∀ A : (Matrix ι ι ℚ)ˣ, A.val = M → A ∈ H) M hM
    · intro D _ A hA
      apply hSym A
      rw [hA]
      exact Matrix.isSymm_diagonal D
    · intro t A hA
      have hAP : A * rationalSwapMatrix t.i t.j ∈ H := by
        apply hSym
        change (A.val * (rationalSwapMatrix t.i t.j).val).IsSymm
        rw [hA]
        exact rational_transvection_mul_swap_symmetric t
      have hP := hSym _ (rationalSwapMatrix_symmetric t.i t.j)
      have h := H.mul_mem hAP hP
      rwa [mul_assoc, rationalSwapMatrix_square, mul_one] at h
    · intro M N hM hN ihM ihN A hA
      obtain ⟨B, hB⟩ := (Matrix.isUnit_iff_isUnit_det M).mpr (isUnit_iff_ne_zero.mpr hM)
      obtain ⟨C, hC⟩ := (Matrix.isUnit_iff_isUnit_det N).mpr (isUnit_iff_ne_zero.mpr hN)
      have heq : A = B * C := by
        apply Units.ext
        rw [hA, Units.val_mul, hB, hC]
      rw [heq]
      exact H.mul_mem (ihM B hB) (ihN C hC)
  exact hp U.val ((Matrix.isUnit_iff_isUnit_det U.val).mp U.isUnit).ne_zero U rfl

def rationalLeviHom : (Matrix ι ι ℚ)ˣ →* Theta.PoissonAutomorphyNormalizationData.Sp ι ℚ where
  toFun := QuadraticCommutator.Realization.ringLevi
  map_one' := by
    apply Subtype.ext
    simp [QuadraticCommutator.Realization.ringLevi]
  map_mul' A B := by
    apply Subtype.ext
    change (QuadraticCommutator.Realization.ringLevi (A * B)).val = (QuadraticCommutator.Realization.ringLevi A).val * (QuadraticCommutator.Realization.ringLevi B).val
    simp [QuadraticCommutator.Realization.ringLevi, _root_.mul_inv_rev, Matrix.transpose_mul, Matrix.fromBlocks_multiply]

end

end OAI.RepresentationTheory.Hecke.RadialDilation.RationalSymmetricGeneration.Realization
