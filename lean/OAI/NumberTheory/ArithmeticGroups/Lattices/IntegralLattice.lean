import OAI.NumberTheory.ArithmeticGroups.Lattices.Algebraic

/-! # Integral Lattice -/

namespace OAI

noncomputable section

namespace NumberTheory.ArithmeticGroups.Lattices

/-! Integral lattice stabilizers and actual archimedean realizations for Lattices.
An arithmetic presentation identifies the supplied groups and map with these
constructions. Only compact archimedean factors may be omitted. -/

open scoped Classical _root_.NumberField

/-- A discrete subgroup with a nonzero finite invariant quotient measure,
normalized here to be a probability measure. -/
def IntegralLattice.IsLattice {H : Type*} [Group H] [TopologicalSpace H] (Γ : Subgroup H) : Prop :=
  letI : MeasurableSpace (H ⧸ Γ) := borel (H ⧸ Γ)
  DiscreteTopology Γ ∧
    ∃ μ : MeasureTheory.Measure (H ⧸ Γ),
      MeasureTheory.IsProbabilityMeasure μ ∧
      MeasureTheory.SMulInvariantMeasure H (H ⧸ Γ) μ

/-- A finitely generated full integral lattice in the representation space. -/
structure IntegralLattice.FullLattice (k : Type) [Field k] [NumberField k] (n : ℕ) where
  module : Submodule (𝓞 k) (Fin n → k)
  finite : module.FG
  full : Submodule.span k (module : Set (Fin n → k)) = ⊤

/-- The standard O_k-lattice, generated by the coordinate vectors. -/
def IntegralLattice.FullLattice.standard (k : Type) [Field k] [NumberField k] (n : ℕ) :
    IntegralLattice.FullLattice k n where
  module := Submodule.span (𝓞 k) (Set.range (Pi.basisFun k (Fin n)))
  finite := Submodule.fg_span (Set.finite_range _)
  full := by
    apply top_le_iff.mp
    rw [← (Pi.basisFun k (Fin n)).span_eq]
    apply Submodule.span_le.mpr
    intro x hx
    exact Submodule.subset_span (Submodule.subset_span hx)

/-- Stabilizer of a lattice under an actual linear representation. -/
def IntegralLattice.linearLatticeStabilizer
    {k H V : Type*} [Field k] [NumberField k] [Group H]
    [AddCommGroup V] [Module k V] [Module (𝓞 k) V]
    (ρ : H →* (V ≃ₗ[k] V)) (Λ : Submodule (𝓞 k) V) : Subgroup H where
  carrier := {g | ∀ x : V, ρ g x ∈ Λ ↔ x ∈ Λ}
  one_mem' := by intro x; simp
  mul_mem' := by
    intro g h hg hh x
    simpa only [map_mul, LinearEquiv.mul_apply] using (hg (ρ h x)).trans (hh x)
  inv_mem' := by
    intro g hg x
    have h := hg (ρ g⁻¹ x)
    have he : ρ g (ρ g⁻¹ x) = x := by
      rw [← LinearEquiv.mul_apply, ← map_mul, mul_inv_cancel, map_one]
      rfl
    exact (he ▸ h).symm

section

variable {k : Type} [Field k] [NumberField k] {n : ℕ}
variable (G : Algebraic.MatrixAlgebraicGroup k n)

/-- The faithful linear representation carried by the matrix presentation. -/
def Algebraic.MatrixAlgebraicGroup.representation : G.RationalPoints →* ((Fin n → k) ≃ₗ[k] (Fin n → k)) :=
  Matrix.SpecialLinearGroup.toLin'.comp (G.subgroup k (RingHom.id k)).subtype

omit [NumberField k] in
theorem Algebraic.MatrixAlgebraicGroup.representation_injective : Function.Injective G.representation :=
  Matrix.SpecialLinearGroup.toLin'_injective.comp Subtype.val_injective

def Algebraic.MatrixAlgebraicGroup.latticeStabilizer (Λ : IntegralLattice.FullLattice k n) : Subgroup G.RationalPoints :=
  IntegralLattice.linearLatticeStabilizer G.representation Λ.module

@[simp] theorem Algebraic.MatrixAlgebraicGroup.mem_latticeStabilizer (Λ : IntegralLattice.FullLattice k n) (g : G.RationalPoints) :
    g ∈ G.latticeStabilizer Λ ↔
      ∀ x, Matrix.SpecialLinearGroup.toLin' g.val x ∈ Λ.module ↔ x ∈ Λ.module :=
  Iff.rfl

abbrev Algebraic.MatrixAlgebraicGroup.AtPlace (v : NumberField.InfinitePlace k) :=
  G.Points (algebraMap k v.Completion)

/-- The product over a specified set of archimedean places. -/
abbrev Algebraic.MatrixAlgebraicGroup.ArchimedeanProduct (S : Set (NumberField.InfinitePlace k)) :=
  (v : S) → G.AtPlace v.val

/-- Actual scalar extension from rational points at one infinite place. -/
def Algebraic.MatrixAlgebraicGroup.diagonalAtPlace (v : NumberField.InfinitePlace k) :
    G.RationalPoints →* G.AtPlace v :=
  G.map (RingHom.id k) (algebraMap k v.Completion)

/-- The diagonal embedding followed by projection to the selected factors. -/
def Algebraic.MatrixAlgebraicGroup.diagonal (S : Set (NumberField.InfinitePlace k)) :
    G.RationalPoints →* G.ArchimedeanProduct S where
  toFun g v := G.diagonalAtPlace v.val g
  map_one' := by funext v; exact map_one (G.diagonalAtPlace v.val)
  map_mul' g h := by funext v; exact map_mul (G.diagonalAtPlace v.val) g h

omit [NumberField k] in
@[simp] theorem Algebraic.MatrixAlgebraicGroup.diagonal_entry (S : Set (NumberField.InfinitePlace k))
    (g : G.RationalPoints) (v : S) (i j : Fin n) :
    (G.diagonal S g v).val i j = algebraMap k v.val.Completion (g.val i j) := rfl

end

/-- Identification with an integral lattice stabilizer and a diagonal
archimedean realization. The omitted-place condition concerns only factors
of the ambient group; it makes no assertion about an arithmetic quotient. -/
def IntegralLattice.IsArithmeticPresentation
    {k Gk GInf : Type} [Field k] [NumberField k]
    [Group Gk] [Group GInf] [TopologicalSpace GInf]
    (G : Algebraic.ConnectedSemisimpleKGroup k)
    (δ : Gk →* GInf) (Γ₀ : Subgroup Gk) : Prop :=
  ∃ (Λ : IntegralLattice.FullLattice k G.dimension)
    (rational : Gk ≃* G.matrixGroup.RationalPoints)
    (places : Set (NumberField.InfinitePlace k))
    (archimedean : GInf ≃ₜ* G.matrixGroup.ArchimedeanProduct places),
    (∀ v, v ∉ places → CompactSpace (G.matrixGroup.AtPlace v)) ∧
    Γ₀.map rational.toMonoidHom = G.matrixGroup.latticeStabilizer Λ ∧
    ∀ g, archimedean (δ g) = G.matrixGroup.diagonal places (rational g)

/-- The literal stabilizer and full diagonal product always form an
arithmetic presentation, without any lattice or compactness theorem. -/
theorem IntegralLattice.canonical_arithmetic_presentation
    {k : Type} [Field k] [NumberField k]
    (G : Algebraic.ConnectedSemisimpleKGroup k) (Λ : IntegralLattice.FullLattice k G.dimension) :
    IntegralLattice.IsArithmeticPresentation G (G.matrixGroup.diagonal Set.univ)
      (G.matrixGroup.latticeStabilizer Λ) := by
  refine ⟨Λ, MulEquiv.refl _, Set.univ, ContinuousMulEquiv.refl _, ?_, ?_, ?_⟩
  · intro v hv
    exact (hv (Set.mem_univ v)).elim
  · exact Subgroup.map_id _
  · intro g
    rfl

end NumberTheory.ArithmeticGroups.Lattices

namespace NumberTheory.ArithmeticGroups.Lattices.IntegralLattice.Construction

/-! Diagonal images of finitely generated integral modules are discrete. -/

open scoped Classical _root_.NumberField nonZeroDivisors
open _root_.NumberField _root_.NumberField.mixedEmbedding

variable {k : Type} [Field k] [NumberField k]

def scalarLatticeImage (J : Submodule (𝓞 k) k) : Submodule ℤ (mixedSpace k) :=
  (J.restrictScalars ℤ).map (mixedEmbedding k).toIntAlgHom.toLinearMap

omit [NumberField k] in
theorem mem_scalarLatticeImage (J : Submodule (𝓞 k) k) (x : mixedSpace k) :
    x ∈ scalarLatticeImage J ↔ ∃ a ∈ J, mixedEmbedding k a = x := Iff.rfl

/-- Clearing a common denominator embeds the image into the standard
Minkowski lattice by multiplication by a unit of the mixed algebra. -/
theorem scalarLatticeImage_discrete (J : Submodule (𝓞 k) k) (hJ : J.FG) :
    DiscreteTopology (scalarLatticeImage J) := by
  obtain ⟨d, hd, hclear⟩ :=
    FractionalIdeal.isFractional_of_fg (S := (𝓞 k)⁰) hJ
  have hd0 : d ≠ 0 := nonZeroDivisors.ne_zero hd
  have hdk : (d : k) ≠ 0 := fun h => hd0 (Subtype.ext h)
  have hu : IsUnit (mixedEmbedding k (d : k)) :=
    (isUnit_iff_ne_zero.mpr hdk).map (mixedEmbedding k)
  let f : scalarLatticeImage J → mixedEmbedding.integerLattice k := fun x =>
    ⟨mixedEmbedding k (d : k) * x.val, by
      obtain ⟨y, hy, he⟩ := (mem_scalarLatticeImage J x.val).mp x.property
      obtain ⟨a, ha⟩ := hclear y hy
      refine ⟨a, ?_⟩
      change mixedEmbedding k (a : k) = mixedEmbedding k (d : k) * x.val
      rw [← he, ← map_mul]
      exact congrArg (mixedEmbedding k) (by simpa only [Algebra.smul_def] using ha)⟩
  apply DiscreteTopology.of_continuous_injective (f := f)
  · exact (continuous_const.mul continuous_subtype_val).subtype_mk _
  · intro x y h
    apply Subtype.ext
    apply hu.mul_right_injective
    exact congrArg Subtype.val h

def vectorMixedEmbedding (n : ℕ) : (Fin n → k) →ₗ[ℤ] (Fin n → mixedSpace k) :=
  LinearMap.pi fun i => (mixedEmbedding k).toIntAlgHom.toLinearMap.comp (LinearMap.proj i)

def vectorLatticeImage {n : ℕ} (Λ : Submodule (𝓞 k) (Fin n → k)) :
    Submodule ℤ (Fin n → mixedSpace k) :=
  (Λ.restrictScalars ℤ).map (vectorMixedEmbedding n)

omit [NumberField k] in
theorem mem_vectorLatticeImage {n : ℕ} (Λ : Submodule (𝓞 k) (Fin n → k))
    (x : Fin n → mixedSpace k) :
    x ∈ vectorLatticeImage Λ ↔
      ∃ a ∈ Λ, vectorMixedEmbedding (k := k) n a = x := Iff.rfl

theorem vectorLatticeImage_discrete {n : ℕ} (Λ : Submodule (𝓞 k) (Fin n → k))
    (hΛ : Λ.FG) : DiscreteTopology (vectorLatticeImage Λ) := by
  let J : Fin n → Submodule (𝓞 k) k := fun i => Λ.map (LinearMap.proj i)
  let : ∀ i, DiscreteTopology (scalarLatticeImage (J i)) :=
    fun i => scalarLatticeImage_discrete (J i) (hΛ.map (LinearMap.proj i))
  let f : vectorLatticeImage Λ → ((i : Fin n) → scalarLatticeImage (J i)) :=
    fun x i => ⟨x.val i, by
      obtain ⟨a, ha, he⟩ := (mem_vectorLatticeImage Λ x.val).mp x.property
      apply (mem_scalarLatticeImage (J i) (x.val i)).mpr
      refine ⟨a i, ⟨a, ha, rfl⟩, ?_⟩
      exact congrFun he i⟩
  apply DiscreteTopology.of_continuous_injective (f := f)
  · apply continuous_pi
    intro i
    exact ((continuous_apply i).comp continuous_subtype_val).subtype_mk _
  · intro x y h
    apply Subtype.ext
    funext i
    exact congrArg (fun a => (a i).val) h

end NumberTheory.ArithmeticGroups.Lattices.IntegralLattice.Construction

end

end OAI
