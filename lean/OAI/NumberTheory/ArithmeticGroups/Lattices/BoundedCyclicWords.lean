import Mathlib.LinearAlgebra.FiniteDimensional.Lemmas
import Mathlib.LinearAlgebra.Span.Basic

/-! # Bounded Cyclic Words -/

namespace OAI.NumberTheory.ArithmeticGroups.Lattices.BoundedCyclicWords.Construction

noncomputable section

/-! A cyclic span generated by linear operators is generated by words
whose length is at most the dimension of the ambient vector space. -/

open scoped Classical
open _root_.Module Set

variable {k V ι : Type*} [Field k] [AddCommGroup V] [Module k V]

def operatorWord (A : ι → Module.End k V) : List ι → Module.End k V
  | [] => 1
  | i :: w => A i * operatorWord A w

def cyclicWordSpan (A : ι → Module.End k V) (x : V) (r : ℕ) : Submodule k V :=
  Submodule.span k ((fun w : List ι => Construction.operatorWord A w x) '' {w | w.length ≤ r})

theorem operatorWord_mem_cyclicWordSpan (A : ι → Module.End k V) (x : V)
    (w : List ι) (r : ℕ) (hw : w.length ≤ r) : Construction.operatorWord A w x ∈ cyclicWordSpan A x r :=
  Submodule.subset_span ⟨w, hw, rfl⟩

theorem self_mem_cyclicWordSpan (A : ι → Module.End k V) (x : V) (r : ℕ) :
    x ∈ cyclicWordSpan A x r :=
  operatorWord_mem_cyclicWordSpan A x [] r (Nat.zero_le r)

theorem cyclicWordSpan_mono (A : ι → Module.End k V) (x : V) : Monotone (cyclicWordSpan A x) := by
  intro r s hrs
  apply Submodule.span_mono
  rintro y ⟨w, hw, rfl⟩
  exact ⟨w, hw.trans hrs, rfl⟩

theorem operator_mem_cyclicWordSpan_succ (A : ι → Module.End k V) (x : V)
    (r : ℕ) (i : ι) (y : V) (hy : y ∈ cyclicWordSpan A x r) :
    A i y ∈ cyclicWordSpan A x (r + 1) := by
  induction hy using Submodule.span_induction with
  | mem y hy =>
      obtain ⟨w, hw, rfl⟩ := hy
      exact operatorWord_mem_cyclicWordSpan A x (i :: w) (r + 1) (by simpa using Nat.succ_le_succ hw)
  | zero => simpa only [map_zero] using (cyclicWordSpan A x (r + 1)).zero_mem
  | add y z _ _ hy hz =>
      simpa only [map_add] using (cyclicWordSpan A x (r + 1)).add_mem hy hz
  | smul c y _ hy =>
      simpa only [map_smul] using (cyclicWordSpan A x (r + 1)).smul_mem c hy

theorem operatorWord_mem_of_cyclicWordSpan_stable
    (A : ι → Module.End k V) (x : V) (r : ℕ)
    (hr : cyclicWordSpan A x r = cyclicWordSpan A x (r + 1)) (w : List ι) :
    Construction.operatorWord A w x ∈ cyclicWordSpan A x r := by
  induction w with
  | nil => exact self_mem_cyclicWordSpan A x r
  | cons i w hw =>
      rw [hr]
      exact operator_mem_cyclicWordSpan_succ A x r i (Construction.operatorWord A w x) hw

theorem exists_cyclicWordSpan_stable [FiniteDimensional k V]
    (A : ι → Module.End k V) (x : V) :
    ∃ r ≤ finrank k V, cyclicWordSpan A x r = cyclicWordSpan A x (r + 1) := by
  by_contra h
  have hs (r : ℕ) (hr : r ≤ finrank k V) :
      finrank k (cyclicWordSpan A x r) < finrank k (cyclicWordSpan A x (r + 1)) := by
    apply Submodule.finrank_lt_finrank_of_lt
    apply lt_of_le_of_ne (cyclicWordSpan_mono A x (Nat.le_succ r))
    intro he
    exact h ⟨r, hr, he⟩
  have hl (r : ℕ) (hr : r ≤ finrank k V + 1) : r ≤ finrank k (cyclicWordSpan A x r) := by
    induction r with
    | zero => exact Nat.zero_le _
    | succ r ih =>
        exact (Nat.succ_le_succ (ih (by omega))).trans (hs r (by omega))
  have hbad := (hl (finrank k V + 1) le_rfl).trans (Submodule.finrank_le (cyclicWordSpan A x (finrank k V + 1)))
  omega

theorem operatorWord_mem_cyclicWordSpan_finrank [FiniteDimensional k V]
    (A : ι → Module.End k V) (x : V) (w : List ι) :
    Construction.operatorWord A w x ∈ cyclicWordSpan A x (finrank k V) := by
  obtain ⟨r, hr, hs⟩ := exists_cyclicWordSpan_stable A x
  exact cyclicWordSpan_mono A x hr (operatorWord_mem_of_cyclicWordSpan_stable A x r hs w)

theorem cyclicWordSpan_finrank_eq_span_words [FiniteDimensional k V]
    (A : ι → Module.End k V) (x : V) :
    cyclicWordSpan A x (finrank k V) =
      Submodule.span k (Set.range (fun w : List ι => Construction.operatorWord A w x)) := by
  apply le_antisymm
  · apply Submodule.span_mono
    rintro _ ⟨w, _, rfl⟩
    exact Set.mem_range_self w
  · apply Submodule.span_le.mpr
    rintro _ ⟨w, rfl⟩
    exact operatorWord_mem_cyclicWordSpan_finrank A x w

theorem cyclicWordSpan_finrank_invariant [FiniteDimensional k V]
    (A : ι → Module.End k V) (x : V) (i : ι) (y : V)
    (hy : y ∈ cyclicWordSpan A x (finrank k V)) :
    A i y ∈ cyclicWordSpan A x (finrank k V) := by
  rw [cyclicWordSpan_finrank_eq_span_words] at hy
  induction hy using Submodule.span_induction with
  | mem y hy =>
      obtain ⟨w, rfl⟩ := hy
      exact operatorWord_mem_cyclicWordSpan_finrank A x (i :: w)
  | zero => simpa only [map_zero] using (cyclicWordSpan A x (finrank k V)).zero_mem
  | add y z _ _ hy hz =>
      simpa only [map_add] using (cyclicWordSpan A x (finrank k V)).add_mem hy hz
  | smul c y _ hy =>
      simpa only [map_smul] using (cyclicWordSpan A x (finrank k V)).smul_mem c hy

end

end OAI.NumberTheory.ArithmeticGroups.Lattices.BoundedCyclicWords.Construction
