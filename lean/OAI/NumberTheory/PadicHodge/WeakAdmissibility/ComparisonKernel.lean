import OAI.NumberTheory.PadicHodge.WeakAdmissibility.FiniteSeriesComparison
import OAI.NumberTheory.PadicHodge.WeakAdmissibility.CrystallineRelation
import OAI.NumberTheory.PadicHodge.WeakAdmissibility.DividedPowerRecurrence

/-! # Comparison Kernel -/

namespace OAI.NumberTheory.PadicHodge.WeakAdmissibility.ComparisonKernel

noncomputable section

/-! The kernel of the completed comparison is generated by the divided-power relation. -/

open OAI.NumberTheory.PadicHodge.WeakAdmissibility.Logarithm.PeriodRings OAI.NumberTheory.PadicHodge.WeakAdmissibility.ThetaKernel OAI.NumberTheory.PadicHodge.WeakAdmissibility.ThetaQuotients OAI.NumberTheory.PadicHodge.WeakAdmissibility.ThetaDividedPowers
open OAI.NumberTheory.PadicHodge.WeakAdmissibility.FiniteDeRhamP OAI.NumberTheory.PadicHodge.WeakAdmissibility.Comparison OAI.NumberTheory.PadicHodge.WeakAdmissibility.DividedPowerCompletion
open OAI.NumberTheory.PadicHodge.WeakAdmissibility.Coordinates OAI.NumberTheory.PadicHodge.WeakAdmissibility.FiniteSeriesComparison OAI.NumberTheory.PadicHodge.WeakAdmissibility.CrystallineRelation
open OAI.NumberTheory.PadicHodge.WeakAdmissibility.RestrictedCoefficients OAI.NumberTheory.PadicHodge.WeakAdmissibility.RestrictedCoefficients.Series OAI.NumberTheory.PadicHodge.WeakAdmissibility.DividedPowerRelation OAI.NumberTheory.PadicHodge.WeakAdmissibility.DividedPowerRecurrence

def weightedPartial {R : Type*} [CommRing R] (ξ : R) (a : ℕ → R) : ℕ → R
  | 0 => a 0
  | n + 1 => (n + 1 : ℕ) * weightedPartial ξ a n + a (n + 1) * ξ ^ (n + 1)

variable (p : ℕ) [Fact p.Prime]

theorem factorial_thetaDividedPower (n : ℕ) :
    (n.factorial : Logarithm.PeriodRings.ACrisUncompleted p) * ThetaDividedPowers.thetaDividedPower p n =
      algebraMap (Logarithm.PeriodRings.AInf p) (Logarithm.PeriodRings.ACrisUncompleted p) (ThetaKernel.thetaGenerator p ^ n) := by
  exact (DeRhamEnvelope.factorial_mul_dividedPower p (ThetaKernel.thetaGenerator p) _ n).trans
    (map_pow _ _ _).symm

theorem weightedPartial_uncompleted (a : ℕ → Logarithm.PeriodRings.AInf p) (n : ℕ) :
    algebraMap (Logarithm.PeriodRings.AInf p) (Logarithm.PeriodRings.ACrisUncompleted p) (ComparisonKernel.weightedPartial (ThetaKernel.thetaGenerator p) a n) =
      (n.factorial : Logarithm.PeriodRings.ACrisUncompleted p) *
        ∑ i ∈ Finset.range (n + 1),
          algebraMap (Logarithm.PeriodRings.AInf p) (Logarithm.PeriodRings.ACrisUncompleted p) (a i) * ThetaDividedPowers.thetaDividedPower p i := by
  induction n with
  | zero =>
    have hzero : ThetaDividedPowers.thetaDividedPower p 0 = 1 := Subtype.ext (ThetaDividedPowers.gammaXi_zero p)
    simp only [ComparisonKernel.weightedPartial, Nat.factorial_zero, Nat.cast_one, Nat.zero_add, Finset.sum_range_one,
      hzero, mul_one, one_mul]
  | succ n ih =>
    rw [Finset.sum_range_succ _ (n + 1)]
    rw [ComparisonKernel.weightedPartial, map_add, map_mul, map_natCast, ih, map_mul,
      Nat.factorial_succ, Nat.cast_mul]
    have ht := factorial_thetaDividedPower p (n + 1)
    rw [Nat.factorial_succ, Nat.cast_mul] at ht
    rw [← ht]
    ring

theorem weightedPartial_finite (a : ℕ → Logarithm.PeriodRings.AInf p) (m n : ℕ) :
    FiniteDeRhamP.integralToFinite p m (Ideal.Quotient.mk _ (ComparisonKernel.weightedPartial (ThetaKernel.thetaGenerator p) a n)) =
      (n.factorial : FiniteDeRhamP.FiniteDeRham p m) *
        ∑ i ∈ Finset.range (n + 1), FiniteSeriesComparison.finiteTerm p m i (a i) := by
  rw [← FiniteDeRhamP.uncompletedToFinite_algebraMap, weightedPartial_uncompleted, map_mul, map_natCast,
    map_sum]
  rfl

theorem kernel_weightedPartial_dvd (x : FiniteSeriesComparison.CoefficientCompletion p)
    (hx : Comparison.aCrisToBdRPlus p (DividedPowerCompletion.completedDividedPowers p x) = 0) (n : ℕ) :
    ThetaKernel.thetaGenerator p ^ (n + 1) ∣
      ComparisonKernel.weightedPartial (ThetaKernel.thetaGenerator p) (fun i => Coordinates.coordinate (p : Logarithm.PeriodRings.AInf p) i x) n := by
  have hf : Comparison.aCrisToFinite p (n + 1) (DividedPowerCompletion.completedDividedPowers p x) = 0 := by
    rw [← Comparison.aCrisToBdRPlus_eval, hx]
    change AdicCompletion.evalₐ (DeRham.deRhamIdeal p) (n + 1)
      (0 : AdicCompletion (DeRham.deRhamIdeal p) (Logarithm.PeriodRings.BInf p)) = 0
    exact map_zero _
  rw [FiniteSeriesComparison.finite_comparison_series] at hf
  apply Ideal.mem_span_singleton.mp
  apply Ideal.Quotient.eq_zero_iff_mem.mp
  apply FiniteDeRhamP.integralToFinite_injective p (n + 1)
  rw [map_zero, weightedPartial_finite, hf, mul_zero]

theorem kernel_recurrence (x : FiniteSeriesComparison.CoefficientCompletion p)
    (hx : Comparison.aCrisToBdRPlus p (DividedPowerCompletion.completedDividedPowers p x) = 0) :
    ∃ b : ℕ → Logarithm.PeriodRings.AInf p,
      ThetaKernel.thetaGenerator p * b 0 = Coordinates.coordinate (p : Logarithm.PeriodRings.AInf p) 0 x ∧
      ∀ n : ℕ, ThetaKernel.thetaGenerator p * b (n + 1) =
        Coordinates.coordinate (p : Logarithm.PeriodRings.AInf p) (n + 1) x + (n + 1 : ℕ) * b n := by
  choose b hb using kernel_weightedPartial_dvd p x hx
  refine ⟨b, ?_, ?_⟩
  · simpa only [ComparisonKernel.weightedPartial, zero_add, pow_one] using (hb 0).symm
  · intro n
    apply mul_left_cancel₀ (pow_ne_zero (n + 1) (ThetaKernel.thetaGenerator_ne_zero p))
    have he := hb (n + 1)
    rw [ComparisonKernel.weightedPartial, hb n] at he
    calc
      ThetaKernel.thetaGenerator p ^ (n + 1) * (ThetaKernel.thetaGenerator p * b (n + 1)) =
          ThetaKernel.thetaGenerator p ^ (n + 1 + 1) * b (n + 1) := by rw [pow_succ]; ring
      _ = (n + 1 : ℕ) * (ThetaKernel.thetaGenerator p ^ (n + 1) * b n) +
          Coordinates.coordinate (p : Logarithm.PeriodRings.AInf p) (n + 1) x * ThetaKernel.thetaGenerator p ^ (n + 1) := he.symm
      _ = ThetaKernel.thetaGenerator p ^ (n + 1) *
          (Coordinates.coordinate (p : Logarithm.PeriodRings.AInf p) (n + 1) x + (n + 1 : ℕ) * b n) := by ring

theorem thetaGenerator_cancel_p_dvd (r : ℕ) (x : Logarithm.PeriodRings.AInf p)
    (hx : (p : Logarithm.PeriodRings.AInf p) ^ r ∣ ThetaKernel.thetaGenerator p * x) : (p : Logarithm.PeriodRings.AInf p) ^ r ∣ x := by
  have hm : ThetaKernel.thetaGenerator p ^ 1 * x ∈ (Ideal.span {(p : Logarithm.PeriodRings.AInf p)}) ^ r := by
    simpa only [Ideal.span_singleton_pow, Ideal.mem_span_singleton, pow_one] using hx
  have he := ThetaQuotients.thetaPower_cancel_pPower p 1 r x hm
  simpa only [Ideal.span_singleton_pow, Ideal.mem_span_singleton] using he

theorem completedDividedPowers_kernel (x : FiniteSeriesComparison.CoefficientCompletion p)
    (hx : Comparison.aCrisToBdRPlus p (DividedPowerCompletion.completedDividedPowers p x) = 0) :
    DividedPowerCompletion.completedDividedPowers p x = 0 := by
  obtain ⟨b, hb0, hbrec⟩ := kernel_recurrence p x hx
  have hb := DividedPowerRecurrence.recurrence_restricted p (ThetaKernel.thetaGenerator p)
    (fun i => Coordinates.coordinate (p : Logarithm.PeriodRings.AInf p) i x) b (Coordinates.coordinates_restricted (p : Logarithm.PeriodRings.AInf p) x)
    (thetaGenerator_cancel_p_dvd p) hbrec
  obtain ⟨c, rfl⟩ := AdicCompletion.mk_surjective (Ideal.span {(p : Logarithm.PeriodRings.AInf p)}) (ℕ →₀ Logarithm.PeriodRings.AInf p) x
  have he := DividedPowerRelation.completed_relation_of_recurrence (p : Logarithm.PeriodRings.AInf p) (ThetaKernel.thetaGenerator p) c
    (fun i => Coordinates.coordinate (p : Logarithm.PeriodRings.AInf p) i (AdicCompletion.mk _ (ℕ →₀ Logarithm.PeriodRings.AInf p) c)) b
    (Coordinates.coordinate_mk_approx (p : Logarithm.PeriodRings.AInf p) c) hb hb0 hbrec
  rw [← he]
  exact CrystallineRelation.completedDividedPowers_relation p _

theorem aCrisToBdRPlus_injective : Function.Injective (Comparison.aCrisToBdRPlus p) := by
  apply (injective_iff_map_eq_zero _).mpr
  intro y hy
  obtain ⟨x, rfl⟩ := DividedPowerCompletion.completedDividedPowers_surjective p y
  exact completedDividedPowers_kernel p x hy

end

end OAI.NumberTheory.PadicHodge.WeakAdmissibility.ComparisonKernel
