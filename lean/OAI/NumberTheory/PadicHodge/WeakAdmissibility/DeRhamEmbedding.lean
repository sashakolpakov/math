import OAI.NumberTheory.PadicHodge.WeakAdmissibility.ThetaQuotients
import OAI.NumberTheory.PadicHodge.WeakAdmissibility.DeRhamEnvelope

/-! # De Rham Embedding -/

namespace OAI

noncomputable section

namespace NumberTheory.PadicHodge.WeakAdmissibility.DeRhamEmbedding

/-!
The rational Fontaine ring embeds faithfully into the actual de Rham
completion. Its theta ideal is generated by the explicit primitive element.
-/

open OAI.NumberTheory.PadicHodge.WeakAdmissibility.Logarithm.PeriodRings OAI.NumberTheory.PadicHodge.WeakAdmissibility.ThetaKernel OAI.NumberTheory.PadicHodge.WeakAdmissibility.ThetaQuotients OAI.NumberTheory.PadicHodge.WeakAdmissibility.DeRham

variable (p : ℕ) [Fact p.Prime]

theorem integerLocalization_algebraMap_injective :
    Function.Injective (algebraMap 𝓞_ℂ_[p] (DeRham.IntegerLocalization p)) :=
  IsLocalization.injective (DeRham.IntegerLocalization p)
    (powers_le_nonZeroDivisors_of_noZeroDivisors
      (show (p : 𝓞_ℂ_[p]) ≠ 0 by exact_mod_cast (Fact.out : p.Prime).ne_zero))

theorem bInfTheta_kernel_eq_map : RingHom.ker (DeRham.bInfTheta p) =
    (RingHom.ker (Logarithm.PeriodRings.theta p)).map (algebraMap (Logarithm.PeriodRings.AInf p) (Logarithm.PeriodRings.BInf p)) := by
  apply le_antisymm
  · intro z hz
    obtain ⟨a, s, rfl⟩ := IsLocalization.exists_mk'_eq (M := Submonoid.powers (p : Logarithm.PeriodRings.AInf p)) z
    have ha : algebraMap (Logarithm.PeriodRings.AInf p) (Logarithm.PeriodRings.BInf p) a ∈ RingHom.ker (DeRham.bInfTheta p) :=
      IsLocalization.mk'_mem_iff.mp hz
    have hθ : Logarithm.PeriodRings.theta p a = 0 := by
      apply integerLocalization_algebraMap_injective p
      have he := RingHom.mem_ker.mp ha
      simpa only [DeRham.bInfTheta_algebraMap, map_zero] using he
    apply IsLocalization.mk'_mem_iff.mpr
    exact Ideal.mem_map_of_mem _ (RingHom.mem_ker.mpr hθ)
  · rw [Ideal.map_le_iff_le_comap]
    intro a ha
    change DeRham.bInfTheta p (algebraMap (Logarithm.PeriodRings.AInf p) (Logarithm.PeriodRings.BInf p) a) = 0
    rw [DeRham.bInfTheta_algebraMap, RingHom.mem_ker.mp ha, map_zero]

def xiBInf : Logarithm.PeriodRings.BInf p := algebraMap (Logarithm.PeriodRings.AInf p) (Logarithm.PeriodRings.BInf p) (ThetaKernel.thetaGenerator p)

theorem deRhamIdeal_eq_span : DeRham.deRhamIdeal p = Ideal.span {xiBInf p} := by
  rw [DeRham.deRhamIdeal, bInfTheta_kernel_eq_map, ThetaKernel.theta_kernel_eq_span, Ideal.map_span, Set.image_singleton]
  rfl

theorem deRhamIdeal_fg : (DeRham.deRhamIdeal p).FG := by
  rw [deRhamIdeal_eq_span]
  exact Submodule.fg_span_singleton _

theorem deRhamIdeal_power_eq_map (n : ℕ) : (DeRham.deRhamIdeal p) ^ n =
    (Ideal.span {ThetaKernel.thetaGenerator p ^ n}).map (algebraMap (Logarithm.PeriodRings.AInf p) (Logarithm.PeriodRings.BInf p)) := by
  rw [deRhamIdeal_eq_span, Ideal.span_singleton_pow, Ideal.map_span, Set.image_singleton, map_pow]
  rfl

instance bInf_thetaHausdorff : IsHausdorff (DeRham.deRhamIdeal p) (Logarithm.PeriodRings.BInf p) where
  haus' z hz := by
    obtain ⟨a, s, rfl⟩ := IsLocalization.exists_mk'_eq (M := Submonoid.powers (p : Logarithm.PeriodRings.AInf p)) z
    have ha (n : ℕ) : ThetaKernel.thetaGenerator p ^ n ∣ a := by
      have hmem : IsLocalization.mk' (Logarithm.PeriodRings.BInf p) a s ∈ (DeRham.deRhamIdeal p) ^ n := by
        simpa only [SModEq.sub_mem, sub_zero, smul_eq_mul, Ideal.mul_top] using hz n
      rw [deRhamIdeal_power_eq_map] at hmem
      obtain ⟨t, ht, hta⟩ :=
        (IsLocalization.mk'_mem_map_algebraMap_iff (Submonoid.powers (p : Logarithm.PeriodRings.AInf p)) (Logarithm.PeriodRings.BInf p)
          (Ideal.span {ThetaKernel.thetaGenerator p ^ n}) a s).mp hmem
      obtain ⟨r, rfl⟩ := ht
      exact Ideal.mem_span_singleton.mp (ThetaQuotients.thetaPower_p_saturated p n r a hta)
    have ha₀ := ThetaQuotients.eq_zero_of_dvd_all_thetaPowers p a ha
    simp [ha₀]

/-- The actual B_dR^+ completion retains every element of A_inf[1/p]. -/
theorem bInfToBdRPlus_injective : Function.Injective (DeRham.bInfToBdRPlus p) :=
  AdicCompletion.of_injective (DeRham.deRhamIdeal p) (Logarithm.PeriodRings.BInf p)

def aInfToBdRPlus : Logarithm.PeriodRings.AInf p →+* Logarithm.PeriodRings.BdRPlus p :=
  (DeRham.bInfToBdRPlus p).comp (algebraMap (Logarithm.PeriodRings.AInf p) (Logarithm.PeriodRings.BInf p))

theorem aInfToBdRPlus_injective : Function.Injective (aInfToBdRPlus p) :=
  (bInfToBdRPlus_injective p).comp (PeriodInvariants.Nontriviality.binf_algebraMap_injective p)

theorem thetaGenerator_deRham_ne_zero : aInfToBdRPlus p (ThetaKernel.thetaGenerator p) ≠ 0 := by
  intro h
  apply ThetaKernel.thetaGenerator_ne_zero p
  apply aInfToBdRPlus_injective p
  simpa only [map_zero] using h

theorem cyclotomicDifference_deRham_ne_zero : aInfToBdRPlus p (Logarithm.PeriodRings.cyclotomicDifference p) ≠ 0 := by
  intro h
  apply Logarithm.PeriodRings.cyclotomicDifference_ne_zero p
  apply aInfToBdRPlus_injective p
  simpa only [map_zero] using h

theorem uncompletedToBdRPlus_injective :
    Function.Injective (DeRhamEnvelope.uncompletedToBdRPlus p) :=
  (bInfToBdRPlus_injective p).comp (DeRhamEnvelope.uncompletedToBInf_injective p)

end NumberTheory.PadicHodge.WeakAdmissibility.DeRhamEmbedding

namespace NumberTheory.PadicHodge.WeakAdmissibility.DeRhamEmbedding.Residue

/-! The residue of the actual de Rham completion is the field C_p. -/

open OAI.NumberTheory.PadicHodge.WeakAdmissibility.Logarithm.PeriodRings OAI.NumberTheory.PadicHodge.WeakAdmissibility.DeRham OAI.NumberTheory.PadicHodge.WeakAdmissibility.DeRhamEmbedding
open Filter _root_.Topology
open scoped NNReal
variable (p : ℕ) [Fact p.Prime]

theorem integerLocalizationToCp_injective : Function.Injective (DeRham.integerLocalizationToCp p) := by
  apply (IsLocalization.injective_iff_map_algebraMap_eq
    (Submonoid.powers (p : 𝓞_ℂ_[p])) (DeRham.integerLocalizationToCp p)).mpr
  intro a b
  rw [(integerLocalization_algebraMap_injective p).eq_iff,
    DeRham.integerLocalizationToCp_algebraMap, DeRham.integerLocalizationToCp_algebraMap]
  exact Subtype.ext_iff

theorem cp_scale_integral (z : ℂ_[p]) :
    ∃ n : ℕ, ∃ a : 𝓞_ℂ_[p], (a : ℂ_[p]) = (p : ℂ_[p]) ^ n * z := by
  have ht : Tendsto (fun n : ℕ => ‖(p : ℂ_[p])‖ ^ n * ‖z‖) atTop (𝓝 0) := by
    simpa using (tendsto_pow_atTop_nhds_zero_of_lt_one (norm_nonneg (p : ℂ_[p]))
      (Logarithm.PeriodRings.norm_p_lt_one p)).mul_const ‖z‖
  obtain ⟨n, hn⟩ := eventually_atTop.mp ((tendsto_order.mp ht).2 1 zero_lt_one)
  have ha : (p : ℂ_[p]) ^ n * z ∈ PadicComplexInt p := by
    change (Valued.v ((p : ℂ_[p]) ^ n * z) : ℝ≥0) ≤ 1
    rw [Logarithm.PeriodRings.valuation_eq_nnnorm]
    have hnorm : ‖(p : ℂ_[p]) ^ n * z‖ ≤ 1 := by
      rw [norm_mul, norm_pow]
      exact (hn n le_rfl).le
    exact_mod_cast hnorm
  exact ⟨n, ⟨_, ha⟩, rfl⟩

theorem integerLocalizationToCp_surjective : Function.Surjective (DeRham.integerLocalizationToCp p) := by
  intro z
  obtain ⟨n, a, ha⟩ := cp_scale_integral p z
  let s : Submonoid.powers (p : 𝓞_ℂ_[p]) := ⟨(p : 𝓞_ℂ_[p]) ^ n, ⟨n, rfl⟩⟩
  refine ⟨IsLocalization.mk' (DeRham.IntegerLocalization p) a s, ?_⟩
  apply mul_right_cancel₀ (pow_ne_zero n (show (p : ℂ_[p]) ≠ 0 by
    exact_mod_cast (Fact.out : p.Prime).ne_zero))
  have he := congrArg (DeRham.integerLocalizationToCp p)
    (IsLocalization.mk'_spec (DeRham.IntegerLocalization p) a s)
  rw [map_mul, DeRham.integerLocalizationToCp_algebraMap, DeRham.integerLocalizationToCp_algebraMap] at he
  change DeRham.integerLocalizationToCp p (IsLocalization.mk' (DeRham.IntegerLocalization p) a s) *
    (p : ℂ_[p]) ^ n = (a : ℂ_[p]) at he
  exact he.trans (ha.trans (mul_comm _ _))

def integerLocalizationEquivCp : DeRham.IntegerLocalization p ≃+* ℂ_[p] :=
  RingEquiv.ofBijective (DeRham.integerLocalizationToCp p)
    ⟨integerLocalizationToCp_injective p, integerLocalizationToCp_surjective p⟩

theorem bInfTheta_surjective : Function.Surjective (DeRham.bInfTheta p) := by
  intro z
  obtain ⟨a, s, rfl⟩ := IsLocalization.exists_mk'_eq (M := Submonoid.powers (p : 𝓞_ℂ_[p])) z
  obtain ⟨n, hn⟩ := s.property
  obtain ⟨b, hb⟩ := Logarithm.PeriodRings.theta_surjective p a
  let t : Submonoid.powers (p : Logarithm.PeriodRings.AInf p) := ⟨(p : Logarithm.PeriodRings.AInf p) ^ n, ⟨n, rfl⟩⟩
  refine ⟨IsLocalization.mk' (Logarithm.PeriodRings.BInf p) b t, ?_⟩
  apply ((IsLocalization.map_units (DeRham.IntegerLocalization p) s)).mul_right_cancel
  have he := congrArg (DeRham.bInfTheta p) (IsLocalization.mk'_spec (Logarithm.PeriodRings.BInf p) b t)
  rw [map_mul, DeRham.bInfTheta_algebraMap, DeRham.bInfTheta_algebraMap, hb] at he
  have ht : Logarithm.PeriodRings.theta p (t : Logarithm.PeriodRings.AInf p) = (s : 𝓞_ℂ_[p]) := by
    change Logarithm.PeriodRings.theta p ((p : Logarithm.PeriodRings.AInf p) ^ n) = _
    rw [map_pow, map_natCast, ← hn]
  rw [ht] at he
  exact he.trans (IsLocalization.mk'_spec (DeRham.IntegerLocalization p) a s).symm

theorem bInfThetaCp_surjective : Function.Surjective ((DeRham.integerLocalizationToCp p).comp (DeRham.bInfTheta p)) :=
  (integerLocalizationToCp_surjective p).comp (bInfTheta_surjective p)

theorem bInfThetaCp_ker : RingHom.ker ((DeRham.integerLocalizationToCp p).comp (DeRham.bInfTheta p)) = DeRham.deRhamIdeal p := by
  ext x
  change DeRham.integerLocalizationToCp p (DeRham.bInfTheta p x) = 0 ↔ DeRham.bInfTheta p x = 0
  exact map_eq_zero_iff _ (integerLocalizationToCp_injective p)

end NumberTheory.PadicHodge.WeakAdmissibility.DeRhamEmbedding.Residue

end

end OAI
