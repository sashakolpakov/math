import OAI.NumberTheory.PadicHodge.GeometricComparison.IntrinsicTruncated.Connected
import OAI.NumberTheory.PadicHodge.IntegralComparison.Truncated.WittFinite
import OAI.NumberTheory.PadicHodge.IntegralComparison.NormalizedTopEdgeScalar
import Mathlib.RingTheory.WittVector.Compare

/-! # Trace Cyclic -/

namespace OAI.NumberTheory.PadicHodge.GeometricComparison.IntrinsicTruncated.TraceCyclic.IntrinsicTruncatedBase

noncomputable section

/-! The actual finite-level trace coefficient ring is additively
generated by one. Consequently its normalized top-edge map is
determined by its value on the unit residue class. -/

open _root_.CategoryTheory _root_.AlgebraicGeometry

variable (q : ℕ) [Fact q.Prime] (n : ℕ)

def zmodEquiv : TruncatedModel.NativeTruncatedBase.Ring q n ≃+* ZMod (q ^ (n + 1)) :=
  (IntegralComparison.Truncated.WittFinite.equivTruncated q (ZMod q) n).trans
    (TruncatedWittVector.zmodEquivTrunc q (n + 1)).symm

def traceCoefficientEquiv :
    IntegralComparison.Projective.TopTracePairing.coefficientRing (TruncatedModel.NativeTruncatedBase.Ring q n) ≃+* ZMod (q ^ (n + 1)) :=
  (Scheme.ΓSpecIso (CommRingCat.of (TruncatedModel.NativeTruncatedBase.Ring q n))).commRingCatIsoToRingEquiv.trans (zmodEquiv q n)

theorem traceCoefficient_generated_by_one
    (z : IntegralComparison.Projective.TopTracePairing.coefficientRing (TruncatedModel.NativeTruncatedBase.Ring q n)) :
    ∃ m : ℕ, m • (1 : IntegralComparison.Projective.TopTracePairing.coefficientRing (TruncatedModel.NativeTruncatedBase.Ring q n)) = z := by
  let : NeZero (q ^ (n + 1)) := ⟨pow_ne_zero _ (Fact.out : q.Prime).ne_zero⟩
  refine ⟨(traceCoefficientEquiv q n z).val, ?_⟩
  rw [nsmul_eq_mul, mul_one]
  apply (traceCoefficientEquiv q n).injective
  rw [map_natCast]
  exact ZMod.natCast_zmod_val (traceCoefficientEquiv q n z)

theorem normalizedEdge_eq_of_one {T₁ T₂ H : Type*}
    [AddCommGroup T₁] [AddCommGroup T₂] [AddCommGroup H]
    (e₁ : T₁ →+ H) (e₂ : T₂ →+ H)
    (t₁ : T₁ ≃+ IntegralComparison.Projective.TopTracePairing.coefficientRing (TruncatedModel.NativeTruncatedBase.Ring q n))
    (t₂ : T₂ ≃+ IntegralComparison.Projective.TopTracePairing.coefficientRing (TruncatedModel.NativeTruncatedBase.Ring q n))
    (h : e₁ (t₁.symm 1) = e₂ (t₂.symm 1))
    (z : IntegralComparison.Projective.TopTracePairing.coefficientRing (TruncatedModel.NativeTruncatedBase.Ring q n)) :
    e₁ (t₁.symm z) = e₂ (t₂.symm z) :=
  IntegralComparison.NormalizedTopEdgeScalar.normalized_of_generator e₁ e₂ t₁ t₂ 1
    (traceCoefficient_generated_by_one q n) h z

end

end OAI.NumberTheory.PadicHodge.GeometricComparison.IntrinsicTruncated.TraceCyclic.IntrinsicTruncatedBase
