import OAI.NumberTheory.PadicHodge.GeometricComparison.Intrinsic.AffineFormMaps
import OAI.NumberTheory.PadicHodge.GeometricComparison.Forms.HomExt

/-! # Affine Forms Hom Ext -/

namespace OAI.NumberTheory.PadicHodge.GeometricComparison.Intrinsic.AffineFormsHomExt.AffineCoordinates

noncomputable section

section

/-! Native relative affine forms are generated by their actual differential symbols. -/

open _root_.CategoryTheory _root_.AlgebraicGeometry Opposite

variable (R A : Type) [CommRing R] [CommRing A] [Algebra R A]

theorem nativeForms_hom_ext (U : (Spec (CommRingCat.of A)).Opens) (n : ℕ)
    (N : ModuleCat R)
    {f g : (AlgebraicGeometry.Crystalline.Cohomology.DeRhamGlobalId.DeRhamGlobal.formsPresheaf R (RelativeSectionCoefficients.AffineCoordinates.relativeSpecModel R A) n).obj (op U) ⟶ N}
    (h : ∀ (b : Γ(Spec (CommRingCat.of A), U)) (v : Fin n → Γ(Spec (CommRingCat.of A), U)),
      f (AffineFormMaps.AffineCoordinates.nativeSymbol R A U n b v) = g (AffineFormMaps.AffineCoordinates.nativeSymbol R A U n b v)) : f = g := by
  let : Algebra R Γ(Spec (CommRingCat.of A), U) :=
    AlgebraicGeometry.Crystalline.Cohomology.AlgebraicForms.AlgebraicDeRham.sectionAlgebra R (RelativeSectionCoefficients.AffineCoordinates.relativeSpecModel R A) U
  exact Forms.HomExt.FormsHomExt.hom_ext R Γ(Spec (CommRingCat.of A), U) n N h

end

/-! The module comparison identifies the actual native and coordinate affine-form presheaves naturally in every open set. -/

open _root_.CategoryTheory _root_.AlgebraicGeometry

variable (R A : Type) [CommRing R] [CommRing A] [Algebra R A]

def nativeFormsPresheafIso (n : ℕ) :
    AlgebraicGeometry.Crystalline.Cohomology.DeRhamGlobalId.DeRhamGlobal.formsPresheaf R (RelativeSectionCoefficients.AffineCoordinates.relativeSpecModel R A) n ≅
      Affine.FormsCech.CoordinateForms.specPresheaf R A n ⋙ ModuleCat.restrictScalars (algebraMap R A) :=
  NatIso.ofComponents (fun U => AffineFormMaps.AffineCoordinates.nativeFormsModuleIso R A U.unop n) (by
    intro U V f
    apply nativeForms_hom_ext R A U.unop n _
    intro b v
    symm
    exact ((congrArg ((Affine.FormsCech.CoordinateForms.specPresheaf R A n).map f)
      (AffineFormMaps.AffineCoordinates.nativeSymbol_comparison R A U.unop n b v)).trans (AffineFormMaps.AffineCoordinates.coordinateSymbol_map R A f n b v)).trans
        ((congrArg (AffineFormMaps.AffineCoordinates.nativeFormsModuleIso R A V.unop n).hom (AffineFormMaps.AffineCoordinates.nativeSymbol_map R A f n b v)).trans
          (AffineFormMaps.AffineCoordinates.nativeSymbol_comparison R A V.unop n ((Spec (CommRingCat.of A)).presheaf.map f b)
            (fun i => (Spec (CommRingCat.of A)).presheaf.map f (v i)))).symm)

end

end OAI.NumberTheory.PadicHodge.GeometricComparison.Intrinsic.AffineFormsHomExt.AffineCoordinates
