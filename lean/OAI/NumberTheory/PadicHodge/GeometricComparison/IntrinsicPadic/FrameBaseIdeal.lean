import OAI.NumberTheory.PadicHodge.GeometricComparison.IntrinsicPadic.PadicFrameRestriction
import OAI.NumberTheory.PadicHodge.GeometricComparison.Crystalline.CartesianMorphism
import OAI.NumberTheory.PadicHodge.GeometricComparison.Smooth.WittFrameIdeal

/-! # Frame Base Ideal -/

namespace OAI

noncomputable section

namespace NumberTheory.PadicHodge.GeometricComparison.IntrinsicPadic.FrameBaseIdeal.IntrinsicPadicFrameCartesian

/-! Native affine frame morphisms are cartesian on the original closed and
ambient schemes, since both defining ideals are the actual prime ideal. -/

open _root_.CategoryTheory _root_.AlgebraicGeometry

theorem map_span {R S : Type*} [CommRing R] [CommRing S] (p : ℕ)
    (I : Ideal R) (J : Ideal S) (φ : R →+* S)
    (hI : I = Ideal.span {(p : R)}) (hJ : J = Ideal.span {(p : S)}) : I.map φ = J := by
  rw [hI, hJ, Ideal.map_span, Set.image_singleton, map_natCast]

variable (p : ℕ) [Fact p.Prime]
  (X : Over (Spec (CommRingCat.of ℤ_[p]))) [Smooth X.hom]
  (Y : Over (Spec (CommRingCat.of (ZMod p)))) (f : Y.left ⟶ X.left)
  (hp : IsPullback f Y.hom X.hom (Spec.map (CommRingCat.ofHom (PadicInt.toZMod : ℤ_[p] →+* ZMod p))))
  (n : ℕ)

theorem ideal_eq_span (U : X.left.Opens) (hU : IsAffineOpen U) :
    (ChartImage.IntrinsicPadicOpenFrame.frame p X Y f hp U hU n).obj.ideal =
      Ideal.span {(p : (ChartImage.IntrinsicPadicOpenFrame.frame p X Y f hp U hU n).obj.ring)} :=
  GeometricComparison.Smooth.WittFrameIdeal.SmoothWittFrameIdeal.eq_span p (AffineFrame.IntrinsicPadicAffineFrame.sourceRing p X U) n

variable (U V : X.left.Opens) (hU : IsAffineOpen U) (hV : IsAffineOpen V)
  (α : ChartImage.IntrinsicPadicOpenFrame.frame p X Y f hp U hU n ⟶ ChartImage.IntrinsicPadicOpenFrame.frame p X Y f hp V hV n)

theorem ideal_map : (ChartImage.IntrinsicPadicOpenFrame.frame p X Y f hp V hV n).obj.ideal.map α.hom.ringMap.toRingHom =
    (ChartImage.IntrinsicPadicOpenFrame.frame p X Y f hp U hU n).obj.ideal :=
  IntrinsicPadicFrameCartesian.map_span p _ _ α.hom.ringMap.toRingHom (ideal_eq_span p X Y f hp n V hV)
    (ideal_eq_span p X Y f hp n U hU)

open OAI.NumberTheory.PadicHodge.IntegralComparison.BigCrystallineSite in
theorem cartesian : IsPullback (IntegralComparison.BigCrystallineSite.Object.closed.map α.hom)
    (IntegralComparison.BigCrystallineSite.Object.closedImmersion.app (ChartImage.IntrinsicPadicOpenFrame.frame p X Y f hp U hU n).obj)
    (IntegralComparison.BigCrystallineSite.Object.closedImmersion.app (ChartImage.IntrinsicPadicOpenFrame.frame p X Y f hp V hV n).obj)
    (IntegralComparison.BigCrystallineSite.Object.ambient.map α.hom) :=
  Crystalline.CartesianMorphism.CrystallineCartesianMorphism.cartesian α.hom (ideal_map p X Y f hp n U V hU hV α)

end NumberTheory.PadicHodge.GeometricComparison.IntrinsicPadic.FrameBaseIdeal.IntrinsicPadicFrameCartesian

namespace NumberTheory.PadicHodge.GeometricComparison.IntrinsicPadic.FrameBaseIdeal.IntrinsicPadicFrameBaseIdeal

/-! The native frame ideal is generated by the original Witt base ideal. -/

open _root_.CategoryTheory _root_.AlgebraicGeometry

variable (p : ℕ) [Fact p.Prime]
  (X : Over (Spec (CommRingCat.of ℤ_[p]))) [Smooth X.hom]
  (Y : Over (Spec (CommRingCat.of (ZMod p)))) (f : Y.left ⟶ X.left)
  (hp : IsPullback f Y.hom X.hom (Spec.map (CommRingCat.ofHom (PadicInt.toZMod : ℤ_[p] →+* ZMod p))))
  (n : ℕ) (U : X.left.Opens) (hU : IsAffineOpen U)

theorem generated : (ChartImage.IntrinsicPadicOpenFrame.frame p X Y f hp U hU n).obj.ideal =
    (Ideal.span {(p : WittVector p (ZMod p))}).map
      (ChartImage.IntrinsicPadicOpenFrame.frame p X Y f hp U hU n).obj.base :=
  (IntrinsicPadicFrameCartesian.ideal_eq_span p X Y f hp n U hU).trans
    (IntrinsicPadicFrameCartesian.map_span p _ _
      (ChartImage.IntrinsicPadicOpenFrame.frame p X Y f hp U hU n).obj.base rfl rfl).symm

end NumberTheory.PadicHodge.GeometricComparison.IntrinsicPadic.FrameBaseIdeal.IntrinsicPadicFrameBaseIdeal

end

end OAI
