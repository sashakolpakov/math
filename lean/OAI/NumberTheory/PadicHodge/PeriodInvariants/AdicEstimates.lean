import OAI.NumberTheory.PadicHodge.PeriodInvariants.Nontriviality

/-! # Adic Estimates -/

namespace OAI

noncomputable section

namespace NumberTheory.PadicHodge.PeriodInvariants.AdicEstimates.Frobenius

/-!
# Frobenius on the concrete PeriodInvariants crystalline envelope

The WeakAdmissibility period-ring construction uses the kernel of theta modulo p. PeriodInvariants uses
the kernel of theta itself. We prove that adjoining divided powers of p does
not enlarge the PeriodInvariants envelope, then prove Frobenius stability of that envelope.
No comparison theorem or fixed-scalar theorem is assumed.
-/

open OAI.NumberTheory.PadicHodge.PeriodInvariants.PeriodRing OAI.NumberTheory.PadicHodge.PeriodInvariants.Nontriviality

variable (p : ℕ) [hp : Fact p.Prime]

local notation "F" => FractionRing (OAI.NumberTheory.PadicHodge.PeriodInvariants.PeriodRing.Ainf p)

theorem padicIntToAinf_injective : Function.Injective (PeriodRing.padicIntToAinf p) :=
  (WittVector.map_injective _
    (ZMod.castHom (dvd_refl p) (PreTilt 𝓞_ℂ_[p] p)).injective).comp
    (WittVector.equiv p).symm.injective

def padicToFraction : ℚ_[p] →+* F :=
  IsFractionRing.lift (A := ℤ_[p]) (K := ℚ_[p])
    (g := (algebraMap (PeriodRing.Ainf p) F).comp (PeriodRing.padicIntToAinf p))
    ((IsFractionRing.injective (PeriodRing.Ainf p) F).comp (padicIntToAinf_injective p))

@[simp]
theorem padicToFraction_integer (x : ℤ_[p]) :
    padicToFraction p (algebraMap ℤ_[p] ℚ_[p] x) =
      algebraMap (PeriodRing.Ainf p) F (PeriodRing.padicIntToAinf p x) :=
  IsFractionRing.lift_algebraMap _ x

/-- The integral coefficient `p^n/n!` is supplied by the proved divided-power
structure on `(p) ⊆ ℤ_p`. -/
def pDividedPowerCoefficient (n : ℕ) : PeriodRing.Ainf p :=
  PeriodRing.padicIntToAinf p ((PadicInt.dividedPowers p).dpow n p)

theorem pDividedPowerCoefficient_fraction (n : ℕ) :
    algebraMap (PeriodRing.Ainf p) F (pDividedPowerCoefficient p n) =
      (p : F) ^ n / (n.factorial : F) := by
  classical
  have h : (((PadicInt.dividedPowers p).dpow n p : ℤ_[p]) : ℚ_[p]) =
      (p : ℚ_[p]) ^ n / (n.factorial : ℚ_[p]) := by
    have hmem : (p : ℤ_[p]) ∈ Ideal.span {(p : ℤ_[p])} :=
      Ideal.subset_span (Set.mem_singleton _)
    simpa +instances only [dite_eq_left hmem, Ring.inverse_eq_inv', PadicInt.coe_natCast,
      div_eq_mul_inv, mul_comm] using PadicInt.coe_dpow_eq p n (p : ℤ_[p])
  rw [pDividedPowerCoefficient, ← padicToFraction_integer]
  change padicToFraction p ((((PadicInt.dividedPowers p).dpow n p : ℤ_[p]) : ℚ_[p])) = _
  rw [h, map_div₀, map_pow, map_natCast, map_natCast]

theorem dividedPower_p_mul_mem (n : ℕ) (a : PeriodRing.Ainf p) :
    (algebraMap (PeriodRing.Ainf p) F ((p : PeriodRing.Ainf p) * a)) ^ n / (n.factorial : F)
      ∈ PeriodRing.acrisZeroSubalgebra p := by
  have h : (algebraMap (PeriodRing.Ainf p) F ((p : PeriodRing.Ainf p) * a)) ^ n / (n.factorial : F) =
      algebraMap (PeriodRing.Ainf p) F (pDividedPowerCoefficient p n * a ^ n) := by
    simp only [map_mul, map_pow, map_natCast, pDividedPowerCoefficient_fraction, mul_pow]
    ring
  rw [h]
  exact (PeriodRing.acrisZeroSubalgebra p).algebraMap_mem _

theorem fraction_dividedPower_add (n : ℕ) (x y : F) :
    (x + y) ^ n / (n.factorial : F) =
      ∑ k ∈ Finset.HasAntidiagonal.antidiagonal n,
        (x ^ k.1 / (k.1.factorial : F)) * (y ^ k.2 / (k.2.factorial : F)) := by
  classical
  have h := (DividedPowers.RatAlgebra.dividedPowers (⊤ : Ideal F)).dpow_add
    (n := n) (x := x) (y := y) (by simp) (by simp)
  simpa only [DividedPowers.RatAlgebra.dpow_apply, Submodule.mem_top, ite_eq_left,
    Ring.inverse_eq_inv', div_eq_mul_inv, mul_comm, mul_left_comm, mul_assoc] using h

/-- Divided powers of every element in `ker(theta mod p)` already belong to
the envelope generated by `ker theta`. -/
theorem dividedPower_mem_of_theta_mem_p (n : ℕ) (x : PeriodRing.Ainf p)
    (hx : PeriodRing.theta p x ∈ Ideal.span {(p : 𝓞_ℂ_[p])}) :
    (algebraMap (PeriodRing.Ainf p) F x) ^ n / (n.factorial : F) ∈ PeriodRing.acrisZeroSubalgebra p := by
  obtain ⟨y, hy⟩ := Ideal.mem_span_singleton.mp hx
  obtain ⟨a, ha⟩ := PeriodRing.theta_surjective p y
  let z : RingHom.ker (PeriodRing.theta p) := ⟨x - (p : PeriodRing.Ainf p) * a, by
    rw [RingHom.mem_ker, map_sub, map_mul, map_natCast, ha, hy, sub_self]⟩
  have hz : x = (z : PeriodRing.Ainf p) + (p : PeriodRing.Ainf p) * a := by
    dsimp [z]
    ring
  rw [hz, map_add, fraction_dividedPower_add]
  apply (PeriodRing.acrisZeroSubalgebra p).sum_mem
  intro k hk
  exact (PeriodRing.acrisZeroSubalgebra p).mul_mem (PeriodRing.dividedPower p k.1 z).property
    (dividedPower_p_mul_mem p k.2 a)

def thetaModP : PeriodRing.Ainf p →+* ModP 𝓞_ℂ_[p] p :=
  (Ideal.Quotient.mk (Ideal.span {(p : 𝓞_ℂ_[p])})).comp (PeriodRing.theta p)

/-- The alternate envelope used in WeakAdmissibility, written using the PeriodInvariants coefficient data. -/
def modPEnvelope : Subalgebra (PeriodRing.Ainf p) F :=
  Algebra.adjoin (PeriodRing.Ainf p)
    {z | ∃ (x : PeriodRing.Ainf p) (n : ℕ), thetaModP p x = 0 ∧
      z = (algebraMap (PeriodRing.Ainf p) F x) ^ n / (n.factorial : F)}

theorem modPEnvelope_eq_acrisZero : modPEnvelope p = PeriodRing.acrisZeroSubalgebra p := by
  apply le_antisymm
  · apply Algebra.adjoin_le
    rintro _ ⟨x, n, hx, rfl⟩
    exact dividedPower_mem_of_theta_mem_p p n x (Ideal.Quotient.eq_zero_iff_mem.mp hx)
  · apply Algebra.adjoin_le
    rintro _ ⟨⟨n, x⟩, rfl⟩
    apply Algebra.subset_adjoin
    refine ⟨x, n, ?_, rfl⟩
    simp only [thetaModP, RingHom.comp_apply, RingHom.mem_ker.mp x.property, map_zero]

def ainfFrobenius : PeriodRing.Ainf p ≃+* PeriodRing.Ainf p :=
  WittVector.frobeniusEquiv p (PreTilt 𝓞_ℂ_[p] p)

theorem thetaModP_frobenius (x : PeriodRing.Ainf p) :
    thetaModP p (ainfFrobenius p x) = thetaModP p x ^ p := by
  change Ideal.Quotient.mk _ (WittVector.fontaineTheta 𝓞_ℂ_[p] p (ainfFrobenius p x)) =
    Ideal.Quotient.mk _ (WittVector.fontaineTheta 𝓞_ℂ_[p] p x) ^ p
  rw [WittVector.mk_fontaineTheta, WittVector.mk_fontaineTheta]
  change PreTilt.coeff 0 ((WittVector.frobenius x).coeff 0) = _
  rw [WittVector.coeff_frobenius_charP, map_pow]

def fractionFrobenius : F ≃+* F :=
  IsFractionRing.ringEquivOfRingEquiv (ainfFrobenius p)

@[simp]
theorem fractionFrobenius_algebraMap (x : PeriodRing.Ainf p) :
    fractionFrobenius p (algebraMap (PeriodRing.Ainf p) F x) =
      algebraMap (PeriodRing.Ainf p) F (ainfFrobenius p x) :=
  IsFractionRing.ringEquivOfRingEquiv_algebraMap _ x

theorem frobenius_preserves_envelope {x : F} (hx : x ∈ PeriodRing.acrisZeroSubalgebra p) :
    fractionFrobenius p x ∈ PeriodRing.acrisZeroSubalgebra p := by
  rw [← modPEnvelope_eq_acrisZero] at hx ⊢
  induction hx using Algebra.adjoin_induction with
  | mem z hz =>
      obtain ⟨x, n, hx, rfl⟩ := hz
      rw [map_div₀, map_pow, map_natCast, fractionFrobenius_algebraMap]
      apply Algebra.subset_adjoin
      refine ⟨ainfFrobenius p x, n, ?_, rfl⟩
      rw [thetaModP_frobenius, hx, zero_pow hp.out.ne_zero]
  | algebraMap a =>
      rw [fractionFrobenius_algebraMap]
      exact (modPEnvelope p).algebraMap_mem _
  | add x y hx hy ihx ihy =>
      rw [map_add]
      exact (modPEnvelope p).add_mem ihx ihy
  | mul x y hx hy ihx ihy =>
      rw [map_mul]
      exact (modPEnvelope p).mul_mem ihx ihy

def acrisZeroFrobenius : PeriodRing.AcrisZero p →+* PeriodRing.AcrisZero p where
  toFun x := ⟨fractionFrobenius p x, frobenius_preserves_envelope p x.property⟩
  map_zero' := Subtype.ext (map_zero _)
  map_one' := Subtype.ext (map_one _)
  map_add' x y := Subtype.ext (map_add _ (x : F) y)
  map_mul' x y := Subtype.ext (map_mul _ (x : F) y)

/-- Frobenius on the p-adically completed PeriodInvariants ring. -/
def acrisFrobenius : PeriodRing.Acris p →+* PeriodRing.Acris p := PeriodRing.pAdicMap p (acrisZeroFrobenius p)

def bcrisPlusFrobenius : PeriodRing.BcrisPlus p →+* PeriodRing.BcrisPlus p :=
  IsLocalization.Away.lift (p : PeriodRing.Acris p)
    (g := (algebraMap (PeriodRing.Acris p) (PeriodRing.BcrisPlus p)).comp (acrisFrobenius p))
    (by simpa only [map_natCast] using PeriodRing.p_isUnit_bcrisPlus p)

@[simp]
theorem bcrisPlusFrobenius_algebraMap (x : PeriodRing.Acris p) :
    bcrisPlusFrobenius p (algebraMap (PeriodRing.Acris p) (PeriodRing.BcrisPlus p) x) =
      algebraMap (PeriodRing.Acris p) (PeriodRing.BcrisPlus p) (acrisFrobenius p x) :=
  IsLocalization.Away.lift_eq _ _ x

end NumberTheory.PadicHodge.PeriodInvariants.AdicEstimates.Frobenius

namespace NumberTheory.PadicHodge.PeriodInvariants.AdicEstimates

/-!
# Integral estimates in the concrete crystalline envelope

Cancellation in principal adic quotients proves that p-torsion does not appear
on completion, and hence that inverting p embeds A_cris into B_cris-plus.
-/

open OAI.NumberTheory.PadicHodge.PeriodInvariants.PeriodRing OAI.NumberTheory.PadicHodge.PeriodInvariants.AdicEstimates.Frobenius

section Cancellation

variable (p : ℕ) {R : Type*} [CommRing R] [IsDomain R]

theorem quotient_pow_cancel (hp : (p : R) ≠ 0) (m n : ℕ) (a : R)
    (h : Ideal.Quotient.mk ((Ideal.span {(p : R)}) ^ (m + n)) ((p : R) ^ m * a) = 0) :
    Ideal.Quotient.mk ((Ideal.span {(p : R)}) ^ n) a = 0 := by
  rw [Ideal.Quotient.eq_zero_iff_mem, Ideal.span_singleton_pow, Ideal.mem_span_singleton] at h ⊢
  obtain ⟨b, hb⟩ := h
  refine ⟨b, ?_⟩
  apply mul_left_cancel₀ (pow_ne_zero m hp)
  rw [← mul_assoc, ← pow_add]
  exact hb

theorem completion_pow_cancel (hp : (p : R) ≠ 0) (m : ℕ)
    (x : AdicCompletion (Ideal.span {(p : R)}) R)
    (h : (p : AdicCompletion (Ideal.span {(p : R)}) R) ^ m * x = 0) : x = 0 := by
  apply AdicCompletion.ext_evalₐ
  intro n
  obtain ⟨a, ha⟩ := Ideal.Quotient.mk_surjective
    (AdicCompletion.evalₐ (Ideal.span {(p : R)}) (m + n) x)
  have hz : Ideal.Quotient.mk ((Ideal.span {(p : R)}) ^ (m + n)) ((p : R) ^ m * a) = 0 := by
    rw [map_mul, map_pow, map_natCast, ha]
    have he := congrArg (AdicCompletion.evalₐ (Ideal.span {(p : R)}) (m + n)) h
    simpa only [map_mul, map_pow, map_natCast, map_zero] using he
  have hcompat := PeriodRing.completionEval_factorPow p (show n ≤ m + n by omega) x
  rw [← ha] at hcompat
  have hzero := quotient_pow_cancel p hp m n a hz
  change Ideal.Quotient.mk ((Ideal.span {(p : R)}) ^ n) a = _ at hcompat
  rw [← hcompat, hzero, map_zero]

theorem completion_eval_pow_cancel (hp : (p : R) ≠ 0) (m n : ℕ)
    (x : AdicCompletion (Ideal.span {(p : R)}) R)
    (h : AdicCompletion.evalₐ (Ideal.span {(p : R)}) (m + n)
      ((p : AdicCompletion (Ideal.span {(p : R)}) R) ^ m * x) = 0) :
    AdicCompletion.evalₐ (Ideal.span {(p : R)}) n x = 0 := by
  obtain ⟨a, ha⟩ := Ideal.Quotient.mk_surjective
    (AdicCompletion.evalₐ (Ideal.span {(p : R)}) (m + n) x)
  have hz : Ideal.Quotient.mk ((Ideal.span {(p : R)}) ^ (m + n)) ((p : R) ^ m * a) = 0 := by
    rw [map_mul, map_pow, map_natCast, ha]
    simpa only [map_mul, map_pow, map_natCast] using h
  have hcompat := PeriodRing.completionEval_factorPow p (show n ≤ m + n by omega) x
  rw [← ha] at hcompat
  change Ideal.Quotient.mk ((Ideal.span {(p : R)}) ^ n) a = _ at hcompat
  exact hcompat.symm.trans (quotient_pow_cancel p hp m n a hz)

end Cancellation

variable (p : ℕ) [Fact p.Prime]

/-- The actual p-adic completion of the envelope has no p-power torsion. -/
theorem acris_pow_cancel (m : ℕ) (x : PeriodRing.Acris p) (h : (p : PeriodRing.Acris p) ^ m * x = 0) : x = 0 :=
  completion_pow_cancel p (by exact_mod_cast (Fact.out : p.Prime).ne_zero) m x h

/-- Inverting p preserves all elements of the actual completed envelope. -/
theorem acris_to_bcrisPlus_injective :
    Function.Injective (algebraMap (PeriodRing.Acris p) (PeriodRing.BcrisPlus p)) := by
  apply IsLocalization.injective (M := Submonoid.powers (p : PeriodRing.Acris p)) (PeriodRing.BcrisPlus p)
  intro a ha
  obtain ⟨m, rfl⟩ := (Submonoid.mem_powers_iff a (p : PeriodRing.Acris p)).mp ha
  rw [mem_nonZeroDivisors_iff_left]
  intro x hx
  exact acris_pow_cancel p m x hx

theorem nat_dvd_descFactorial_succ (n k : ℕ) : n ∣ n.descFactorial (k + 1) := by
  cases n with
  | zero => simp
  | succ n => rw [Nat.succ_descFactorial_succ]; exact dvd_mul_right _ _

/-- The binomial expansion in the divided-power basis has descending-factorial
coefficients, each divisible by the exponent. -/
theorem power_difference_expansion (x : RingHom.ker (PeriodRing.theta p)) (n : ℕ) :
    algebraMap (PeriodRing.Ainf p) (PeriodRing.AcrisZero p) ((1 + (x : PeriodRing.Ainf p)) ^ n - 1) =
      ∑ k ∈ Finset.range n,
        (n.descFactorial (k + 1) : PeriodRing.AcrisZero p) * PeriodRing.dividedPower p (k + 1) x := by
  rw [map_sub, map_pow, map_add, map_one,
    add_comm (1 : PeriodRing.AcrisZero p), add_pow, Finset.sum_range_succ']
  simp only [one_pow, mul_one, pow_zero, Nat.choose_zero_right, Nat.cast_one,
    add_sub_cancel_right]
  apply Finset.sum_congr rfl
  intro k _
  rw [Nat.descFactorial_eq_factorial_mul_choose, Nat.cast_mul,
    mul_right_comm, PeriodRing.factorial_mul_dividedPower]

theorem power_difference_dvd (x : RingHom.ker (PeriodRing.theta p)) (n : ℕ) :
    (n : PeriodRing.AcrisZero p) ∣ algebraMap (PeriodRing.Ainf p) (PeriodRing.AcrisZero p) ((1 + (x : PeriodRing.Ainf p)) ^ n - 1) := by
  rw [power_difference_expansion]
  apply Finset.dvd_sum
  intro k _
  apply dvd_mul_of_dvd_left
  obtain ⟨c, hc⟩ := nat_dvd_descFactorial_succ n k
  refine ⟨(c : PeriodRing.AcrisZero p), ?_⟩
  rw [hc, Nat.cast_mul]

theorem power_difference_mem_pow (x : RingHom.ker (PeriodRing.theta p)) (n : ℕ) :
    algebraMap (PeriodRing.Ainf p) (PeriodRing.AcrisZero p) ((1 + (x : PeriodRing.Ainf p)) ^ (p ^ n) - 1) ∈
      (Ideal.span {(p : PeriodRing.AcrisZero p)}) ^ n := by
  rw [Ideal.span_singleton_pow, Ideal.mem_span_singleton]
  simpa only [Nat.cast_pow] using power_difference_dvd p x (p ^ n)

/-- A p-divisible input has divided powers with explicitly integral coefficients. -/
theorem dividedPower_p_pow (x : RingHom.ker (PeriodRing.theta p)) (M k : ℕ) (a : PeriodRing.AcrisZero p)
    (hx : algebraMap (PeriodRing.Ainf p) (PeriodRing.AcrisZero p) x = (p : PeriodRing.AcrisZero p) ^ (M + 1) * a) :
    PeriodRing.dividedPower p k x = (p : PeriodRing.AcrisZero p) ^ (M * k) *
      algebraMap (PeriodRing.Ainf p) (PeriodRing.AcrisZero p) (Frobenius.pDividedPowerCoefficient p k) * a ^ k := by
  have hfield := congrArg (fun z : PeriodRing.AcrisZero p => (z : FractionRing (PeriodRing.Ainf p))) hx
  change algebraMap (PeriodRing.Ainf p) (FractionRing (PeriodRing.Ainf p)) (x : PeriodRing.Ainf p) =
    (p : FractionRing (PeriodRing.Ainf p)) ^ (M + 1) * (a : FractionRing (PeriodRing.Ainf p)) at hfield
  apply Subtype.val_injective
  change algebraMap (PeriodRing.Ainf p) (FractionRing (PeriodRing.Ainf p)) (x : PeriodRing.Ainf p) ^ k /
      (k.factorial : FractionRing (PeriodRing.Ainf p)) =
    (p : FractionRing (PeriodRing.Ainf p)) ^ (M * k) *
      algebraMap (PeriodRing.Ainf p) (FractionRing (PeriodRing.Ainf p)) (Frobenius.pDividedPowerCoefficient p k) *
        (a : FractionRing (PeriodRing.Ainf p)) ^ k
  rw [hfield, Frobenius.pDividedPowerCoefficient_fraction]
  simp only [mul_pow, ← pow_mul, Nat.one_mul, pow_add]
  ring

theorem dividedPower_mem_pow_of_dvd (x : RingHom.ker (PeriodRing.theta p)) (M k : ℕ)
    (hk : 2 ≤ k)
    (hx : (p : PeriodRing.AcrisZero p) ^ (M + 1) ∣ algebraMap (PeriodRing.Ainf p) (PeriodRing.AcrisZero p) x) :
    PeriodRing.dividedPower p k x ∈ (Ideal.span {(p : PeriodRing.AcrisZero p)}) ^ (2 * M) := by
  obtain ⟨a, ha⟩ := hx
  rw [dividedPower_p_pow p x M k a ha, Ideal.span_singleton_pow,
    Ideal.mem_span_singleton]
  apply dvd_mul_of_dvd_left
  apply dvd_mul_of_dvd_left
  exact pow_dvd_pow (p : PeriodRing.AcrisZero p) (by simpa only [Nat.mul_comm] using Nat.mul_le_mul_left M hk)

theorem logTerm_mem_pow_of_dvd (x : RingHom.ker (PeriodRing.theta p)) (M k : ℕ) (hk : 1 ≤ k)
    (hx : (p : PeriodRing.AcrisZero p) ^ (M + 1) ∣ algebraMap (PeriodRing.Ainf p) (PeriodRing.AcrisZero p) x) :
    PeriodRing.logTerm p x k ∈ (Ideal.span {(p : PeriodRing.AcrisZero p)}) ^ (2 * M) :=
  Ideal.mul_mem_left _ _ (dividedPower_mem_pow_of_dvd p x M (k + 1) (by omega) hx)

theorem logTerm_zero (x : RingHom.ker (PeriodRing.theta p)) :
    PeriodRing.logTerm p x 0 = algebraMap (PeriodRing.Ainf p) (PeriodRing.AcrisZero p) x := by
  simp [PeriodRing.logTerm]

theorem logPartialSum_firstOrder (x : RingHom.ker (PeriodRing.theta p)) (M n : ℕ) (hn : 0 < n)
    (hx : (p : PeriodRing.AcrisZero p) ^ (M + 1) ∣ algebraMap (PeriodRing.Ainf p) (PeriodRing.AcrisZero p) x) :
    PeriodRing.logPartialSum p x n - algebraMap (PeriodRing.Ainf p) (PeriodRing.AcrisZero p) x ∈
      (Ideal.span {(p : PeriodRing.AcrisZero p)}) ^ (2 * M) := by
  have hpn : 1 ≤ p * n := Nat.mul_pos (Fact.out : p.Prime).pos hn
  have hsplit := Finset.sum_range_succ' (PeriodRing.logTerm p x) (p * n - 1)
  rw [Nat.sub_add_cancel hpn, logTerm_zero] at hsplit
  rw [PeriodRing.logPartialSum, hsplit, add_sub_cancel_right]
  apply Ideal.sum_mem
  intro k _
  exact logTerm_mem_pow_of_dvd p x M (k + 1) (by omega) hx

/-- Modulo a fixed p-power, the logarithm is its linear term when the input
is sufficiently p-divisible in the envelope. -/
theorem pdLog_firstOrder_eval (x : RingHom.ker (PeriodRing.theta p)) (M n : ℕ) (hn : n ≤ 2 * M)
    (hx : (p : PeriodRing.AcrisZero p) ^ (M + 1) ∣ algebraMap (PeriodRing.Ainf p) (PeriodRing.AcrisZero p) x) :
    AdicCompletion.evalₐ (Ideal.span {(p : PeriodRing.AcrisZero p)}) n (PeriodRing.pdLog p x) =
      Ideal.Quotient.mk ((Ideal.span {(p : PeriodRing.AcrisZero p)}) ^ n)
        (algebraMap (PeriodRing.Ainf p) (PeriodRing.AcrisZero p) x) := by
  rw [PeriodRing.pdLog_eval]
  apply Ideal.Quotient.eq.mpr
  by_cases hn0 : n = 0
  · subst n
    simp
  · exact Ideal.pow_le_pow_right hn
      (logPartialSum_firstOrder p x M n (Nat.pos_of_ne_zero hn0) hx)

end NumberTheory.PadicHodge.PeriodInvariants.AdicEstimates

end

end OAI
