import OAI.NumberTheory.PadicHodge.PeriodInvariants.AdicSeparation

/-! # De Rham Structure -/

namespace OAI.NumberTheory.PadicHodge.PeriodInvariants.DeRhamStructure

noncomputable section

/-!
# The defining ideal and embedding for the native de Rham period ring

The kernel used by Mathlib's BDeRhamPlus is generated by the image of
[p-flat] - p. Its adic completion contains A_inf[1/p] faithfully.
-/

open OAI.NumberTheory.PadicHodge.PeriodInvariants.PeriodRing OAI.NumberTheory.PadicHodge.PeriodInvariants.ThetaKernel OAI.NumberTheory.PadicHodge.PeriodInvariants.Nontriviality OAI.NumberTheory.PadicHodge.PeriodInvariants.AdicSeparation

variable (p : ℕ) [Fact p.Prime]

abbrev IntegerLocalization := Localization.Away (p : 𝓞_ℂ_[p])

def nativeTheta : Nontriviality.Binf p →+* IntegerLocalization p := fontaineThetaInvertP 𝓞_ℂ_[p] p

theorem nativeTheta_algebraMap (x : PeriodRing.Ainf p) :
    nativeTheta p (algebraMap (PeriodRing.Ainf p) (Nontriviality.Binf p) x) =
      algebraMap 𝓞_ℂ_[p] (IntegerLocalization p) (PeriodRing.theta p x) := by
  unfold nativeTheta fontaineThetaInvertP
  rw [IsLocalization.Away.lift_eq]
  rfl

theorem integerLocalization_injective :
    Function.Injective (algebraMap 𝓞_ℂ_[p] (IntegerLocalization p)) :=
  IsLocalization.injective (IntegerLocalization p)
    (powers_le_nonZeroDivisors_of_noZeroDivisors
      (show (p : 𝓞_ℂ_[p]) ≠ 0 from Nat.cast_ne_zero.mpr (Fact.out : p.Prime).ne_zero))

theorem nativeTheta_kernel : RingHom.ker (nativeTheta p) =
    Ideal.span {algebraMap (PeriodRing.Ainf p) (Nontriviality.Binf p) (ThetaKernel.xi p)} := by
  apply le_antisymm
  · intro x hx
    obtain ⟨⟨a, s⟩, rfl⟩ := IsLocalization.mk'_surjective (Submonoid.powers (p : PeriodRing.Ainf p)) x
    have ha : PeriodRing.theta p a = 0 := by
      apply integerLocalization_injective p
      rw [map_zero, ← nativeTheta_algebraMap]
      rw [← IsLocalization.mk'_spec (Nontriviality.Binf p) a s, map_mul, RingHom.mem_ker.mp hx, zero_mul]
    apply (IsLocalization.mk'_mem_iff).mpr
    have hm := Ideal.mem_map_of_mem (algebraMap (PeriodRing.Ainf p) (Nontriviality.Binf p))
      (show a ∈ Ideal.span {ThetaKernel.xi p} from (ThetaKernel.theta_kernel_eq_span p) ▸ ha)
    simpa only [Ideal.map_span, Set.image_singleton] using hm
  · apply Ideal.span_le.mpr
    intro x hx
    obtain rfl := Set.mem_singleton_iff.mp hx
    change nativeTheta p (algebraMap (PeriodRing.Ainf p) (Nontriviality.Binf p) (ThetaKernel.xi p)) = 0
    rw [nativeTheta_algebraMap, ThetaKernel.theta_xi, map_zero]

instance nativeTheta_separated : IsHausdorff (RingHom.ker (nativeTheta p)) (Nontriviality.Binf p) := by
  rw [nativeTheta_kernel]
  infer_instance

def binfToDeRhamPlus : Nontriviality.Binf p →+* BDeRhamPlus 𝓞_ℂ_[p] p :=
  algebraMap (Nontriviality.Binf p) (AdicCompletion (RingHom.ker (nativeTheta p)) (Nontriviality.Binf p))

/-- The native de Rham completion loses no elements of A_inf[1/p]. -/
theorem binfToDeRhamPlus_injective : Function.Injective (binfToDeRhamPlus p) :=
  AdicCompletion.of_injective (RingHom.ker (nativeTheta p)) (Nontriviality.Binf p)

theorem binf_xi_ne_zero : algebraMap (PeriodRing.Ainf p) (Nontriviality.Binf p) (ThetaKernel.xi p) ≠ 0 := by
  intro h
  exact ThetaKernel.xi_ne_zero p ((Nontriviality.binf_algebraMap_injective p) (h.trans (map_zero _).symm))

/-- Every power of the theta generator stays nonzero in B_dR-plus. -/
theorem deRham_xi_pow_ne_zero (n : ℕ) :
    binfToDeRhamPlus p (algebraMap (PeriodRing.Ainf p) (Nontriviality.Binf p) (ThetaKernel.xi p)) ^ n ≠ 0 := by
  intro h
  have he : (algebraMap (PeriodRing.Ainf p) (Nontriviality.Binf p) (ThetaKernel.xi p)) ^ n = 0 :=
    binfToDeRhamPlus_injective p (by rw [map_pow, h, map_zero])
  have hf := congrArg (Nontriviality.binfToFraction p) he
  rw [map_pow, Nontriviality.binfToFraction_algebraMap, map_zero] at hf
  have hn : algebraMap (PeriodRing.Ainf p) (FractionRing (PeriodRing.Ainf p)) (ThetaKernel.xi p) ≠ 0 := by
    simpa only [map_zero] using
      (IsFractionRing.injective (PeriodRing.Ainf p) (FractionRing (PeriodRing.Ainf p))).ne (ThetaKernel.xi_ne_zero p)
  exact pow_ne_zero n hn hf

end

end OAI.NumberTheory.PadicHodge.PeriodInvariants.DeRhamStructure
