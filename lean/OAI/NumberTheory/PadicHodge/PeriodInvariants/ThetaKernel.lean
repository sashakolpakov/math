import OAI.NumberTheory.PadicHodge.PeriodInvariants.PeriodRing
import OAI.NumberTheory.PadicHodge.PeriodInvariants.PrincipalKernel

/-! # Theta Kernel -/

namespace OAI.NumberTheory.PadicHodge.PeriodInvariants.ThetaKernel

noncomputable section

/-!
# The principal kernel of the actual Fontaine theta map

The generator is [p-flat] - p, using compatible roots of p in O_Cp.
Its reduction generates the kernel modulo p; completeness lifts that fact.
-/

open OAI.NumberTheory.PadicHodge.PeriodInvariants.PeriodRing OAI.NumberTheory.PadicHodge.PeriodInvariants.PeriodRing.TiltDivisibility

variable (p : ℕ) [Fact p.Prime]

def xi : PeriodRing.Ainf p := WittVector.teichmuller p (PeriodRing.TiltDivisibility.pTilt p) - p

theorem theta_xi : PeriodRing.theta p (xi p) = 0 := by
  rw [xi, map_sub, PeriodRing.theta_teichmuller, PeriodRing.TiltDivisibility.pTilt_untilt, map_natCast, sub_self]

theorem xi_coeff_zero : (xi p).coeff 0 = PeriodRing.TiltDivisibility.pTilt p := by
  change WittVector.constantCoeff (WittVector.teichmuller p (PeriodRing.TiltDivisibility.pTilt p) - (p : PeriodRing.Ainf p)) = PeriodRing.TiltDivisibility.pTilt p
  rw [map_sub]
  change (WittVector.teichmuller p (PeriodRing.TiltDivisibility.pTilt p)).coeff 0 - (p : PeriodRing.Ainf p).coeff 0 = _
  rw [WittVector.teichmuller_coeff_zero, WittVector.coeff_p_zero, sub_zero]

theorem pTilt_ne_zero : PeriodRing.TiltDivisibility.pTilt p ≠ 0 := by
  intro h
  have he : PeriodRing.theta p (WittVector.teichmuller p (PeriodRing.TiltDivisibility.pTilt p)) = (p : 𝓞_ℂ_[p]) := by
    rw [PeriodRing.theta_teichmuller, PeriodRing.TiltDivisibility.pTilt_untilt]
  rw [h, WittVector.teichmuller_zero, map_zero] at he
  exact (Nat.cast_ne_zero.mpr (Fact.out : p.Prime).ne_zero) he.symm

theorem xi_ne_zero : xi p ≠ 0 := by
  intro h
  have he := congrArg (fun x : PeriodRing.Ainf p => x.coeff 0) h
  rw [xi_coeff_zero, WittVector.zero_coeff] at he
  exact pTilt_ne_zero p he

theorem kernel_modp_generated (x : RingHom.ker (PeriodRing.theta p)) :
    ∃ b : PeriodRing.Ainf p, (p : PeriodRing.Ainf p) ∣ (x : PeriodRing.Ainf p) - xi p * b := by
  have hc : PreTilt.coeff 0 ((x : PeriodRing.Ainf p).coeff 0) = 0 := by
    rw [← WittVector.mk_fontaineTheta]
    change Ideal.Quotient.mk (Ideal.span {(p : 𝓞_ℂ_[p])}) (PeriodRing.theta p x) = 0
    rw [RingHom.mem_ker.mp x.property, map_zero]
  obtain ⟨b, hb⟩ := PeriodRing.TiltDivisibility.pTilt_dvd_of_coeff_zero p ((x : PeriodRing.Ainf p).coeff 0) hc
  refine ⟨WittVector.teichmuller p b, ?_⟩
  apply Ideal.mem_span_singleton.mp
  apply (WittVector.mem_span_p_iff_coeff_zero_eq_zero _).mpr
  change WittVector.constantCoeff ((x : PeriodRing.Ainf p) - xi p * WittVector.teichmuller p b) = 0
  rw [map_sub, map_mul]
  change (x : PeriodRing.Ainf p).coeff 0 - (xi p).coeff 0 * (WittVector.teichmuller p b).coeff 0 = 0
  rw [xi_coeff_zero, WittVector.teichmuller_coeff_zero, hb, sub_self]

/-- Fontaine's theta kernel is generated by the explicit element [p-flat] - p. -/
theorem theta_kernel_eq_span : RingHom.ker (PeriodRing.theta p) = Ideal.span {xi p} :=
  PrincipalKernel.kernel_eq_span (PeriodRing.theta p) (xi p) (theta_xi p) p
    (by rw [map_natCast]; exact_mod_cast (Fact.out : p.Prime).ne_zero)
    (kernel_modp_generated p)

/-- The actual quotient of A_inf by the explicit theta generator is O_Cp. -/
def thetaQuotientEquiv : (PeriodRing.Ainf p ⧸ Ideal.span {xi p}) ≃+* 𝓞_ℂ_[p] :=
  (Ideal.quotEquivOfEq (theta_kernel_eq_span p).symm).trans
    (RingHom.quotientKerEquivOfSurjective (f := PeriodRing.theta p) (PeriodRing.theta_surjective p))

end

end OAI.NumberTheory.PadicHodge.PeriodInvariants.ThetaKernel
