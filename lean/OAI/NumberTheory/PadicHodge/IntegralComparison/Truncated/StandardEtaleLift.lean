import OAI.NumberTheory.PadicHodge.IntegralComparison.Polynomial.StandardEtaleLift
import OAI.NumberTheory.PadicHodge.IntegralComparison.Truncated.Witt
import OAI.NumberTheory.PadicHodge.IntegralComparison.SmoothWitt.FrameRing

/-! # Standard Etale Lift -/

namespace OAI.NumberTheory.PadicHodge.IntegralComparison.Truncated.StandardEtaleLift

noncomputable section

/-! An actual standard étale chart over a finite Witt ring is the
prescribed quotient of a smooth flat Witt algebra. Its original
special-fiber reduction has kernel generated by the prime. -/

universe u v

variable (p : ℕ) [Fact p.Prime] (k : Type u) [Field k] [Fintype k] [CharP k p]
  (n : ℕ) (σ : Type v) [Finite σ] (A : Type u) [CommRing A]
  [Algebra (Witt.Ring p k n) A]
  [Algebra (MvPolynomial σ (Witt.Ring p k n)) A]
  [IsScalarTower (Witt.Ring p k n)
    (MvPolynomial σ (Witt.Ring p k n)) A]
  (P : StandardEtalePresentation (MvPolynomial σ (Witt.Ring p k n)) A)

local notation "W" => WittVector p k
local notation "S" => OAI.NumberTheory.PadicHodge.IntegralComparison.Truncated.Witt.Ring p k n

abbrev Ring := Polynomial.StandardEtaleLift.Ring W S Ideal.Quotient.mk_surjective σ A P

def reduction : Ring p k n σ A P →+* A :=
  Polynomial.StandardEtaleLift.reduction W S Ideal.Quotient.mk_surjective σ A P

omit [Fintype k] [CharP k p] in
omit [Finite σ] [Algebra S A] [IsScalarTower S (MvPolynomial σ S) A] in
theorem reduction_surjective : Function.Surjective (reduction p k n σ A P) :=
  Polynomial.StandardEtaleLift.reduction_surjective W S Ideal.Quotient.mk_surjective σ A P

omit [Fintype k] [CharP k p] in
omit [Finite σ] in
theorem reduction_base (w : W) :
    reduction p k n σ A P (algebraMap W (Ring p k n σ A P) w) =
      algebraMap S A (Witt.quotient p k n w) :=
  Polynomial.StandardEtaleLift.reduction_base W S Ideal.Quotient.mk_surjective σ A P w

omit [Fintype k] [CharP k p] in
omit [Finite σ] [Algebra S A] [IsScalarTower S (MvPolynomial σ S) A] in
theorem reduction_kernel : RingHom.ker (reduction p k n σ A P) =
    (Ideal.span {(p : Ring p k n σ A P)}) ^ (n + 1) := by
  rw [reduction, Polynomial.StandardEtaleLift.reduction_kernel]
  change (RingHom.ker (Ideal.Quotient.mk ((Ideal.span {(p : W)}) ^ (n + 1)))).map
    (algebraMap W (Ring p k n σ A P)) = _
  rw [Ideal.mk_ker, Ideal.map_pow, Ideal.map_span, Set.image_singleton, map_natCast]

def quotientEquiv : SmoothWitt.FrameRing.Ring p (Ring p k n σ A P) n ≃+* A :=
  (Ideal.quotEquivOfEq (reduction_kernel p k n σ A P).symm).trans
    (RingHom.quotientKerEquivOfSurjective (reduction_surjective p k n σ A P))

omit [Fintype k] [CharP k p] in
omit [Finite σ] [Algebra S A] [IsScalarTower S (MvPolynomial σ S) A] in
theorem quotientEquiv_mk (a : Ring p k n σ A P) :
    quotientEquiv p k n σ A P (Ideal.Quotient.mk ((Ideal.span {(p : Ring p k n σ A P)}) ^ (n + 1)) a) =
      reduction p k n σ A P a := by
  change (RingHom.quotientKerEquivOfSurjective (reduction_surjective p k n σ A P))
    ((Ideal.quotEquivOfEq (reduction_kernel p k n σ A P).symm) (Ideal.Quotient.mk _ a)) = _
  rw [Ideal.quotEquivOfEq_mk]
  rfl

variable (C : Type u) [CommRing C] [Algebra k C] (ρ : A →+* C)
  (hρ : Function.Surjective ρ) (hker : RingHom.ker ρ = Ideal.span {(p : A)})
  (hbase : ∀ w : WittVector p k,
    ρ (algebraMap (Witt.Ring p k n) A (Witt.quotient p k n w)) =
    algebraMap k C (WittVector.constantCoeff w))

def residue : Ring p k n σ A P →+* C := ρ.comp (reduction p k n σ A P)

omit [Fintype k] [CharP k p] [Algebra k C] in
include hρ in
omit [Finite σ] [Algebra S A] [IsScalarTower S (MvPolynomial σ S) A] in
theorem residue_surjective : Function.Surjective (residue p k n σ A P C ρ) :=
  hρ.comp (reduction_surjective p k n σ A P)

omit [Fintype k] [CharP k p] [Algebra k C] in
include hker in
omit [Finite σ] [Algebra S A] [IsScalarTower S (MvPolynomial σ S) A] in
theorem residue_kernel : RingHom.ker (residue p k n σ A P C ρ) =
    Ideal.span {(p : Ring p k n σ A P)} := by
  have hm : (Ideal.span {(p : Ring p k n σ A P)}).map (reduction p k n σ A P) =
      Ideal.span {(p : A)} := by
    rw [Ideal.map_span, Set.image_singleton, map_natCast]
  change (RingHom.ker ρ).comap (reduction p k n σ A P) = _
  rw [hker, ← hm, Ideal.comap_map_of_surjective _ (reduction_surjective p k n σ A P),
    ← RingHom.ker_eq_comap_bot, reduction_kernel]
  exact sup_eq_left.mpr (Ideal.pow_le_self (Nat.succ_ne_zero n))

omit [Fintype k] [CharP k p] in
include hbase in
omit [Finite σ] in
theorem residue_base (w : W) :
    residue p k n σ A P C ρ (algebraMap W (Ring p k n σ A P) w) =
      algebraMap k C (WittVector.constantCoeff w) := by
  change ρ (reduction p k n σ A P (algebraMap W (Ring p k n σ A P) w)) = _
  rw [reduction_base]
  exact hbase w

end

end OAI.NumberTheory.PadicHodge.IntegralComparison.Truncated.StandardEtaleLift
