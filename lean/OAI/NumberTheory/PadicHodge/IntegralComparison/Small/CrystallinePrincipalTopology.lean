import OAI.NumberTheory.PadicHodge.IntegralComparison.Small.CrystallineCocontinuous

/-! # Crystalline Principal Topology -/

namespace OAI.NumberTheory.PadicHodge.IntegralComparison.Small.CrystallinePrincipalTopology

noncomputable section

/-!
# IntegralComparison: the small crystalline topology is generated by principal covers

This identifies a basis for the original small-site topology; the original
definition of that topology is unchanged.
-/

open _root_.CategoryTheory _root_.AlgebraicGeometry

universe u

open OAI.NumberTheory.PadicHodge.IntegralComparison.BigCrystallineSite OAI.NumberTheory.PadicHodge.IntegralComparison.Crystalline.Site
open OAI.NumberTheory.PadicHodge.IntegralComparison.Small.CrystallineLocalization OAI.NumberTheory.PadicHodge.IntegralComparison.Crystalline.CoverRefinement

variable {p : ℕ} {B : Type u} [CommRing B] {J : Ideal B} {δ : DividedPowers J}
variable {X : Scheme.{u}} {f : X ⟶ Spec (CommRingCat.of B)}

def principalPrecoverage : Precoverage (Crystalline.Site.AffineThickening p B J δ f) where
  coverings U := {R | ∃ (ι : Type u) (a : ι → U.ring), Ideal.span (Set.range a) = ⊤ ∧ R = CrystallineLocalization.smallPresieve U a}

lemma principal_le_original :
    principalPrecoverage (p := p) (J := J) (δ := δ) (f := f) ≤ Crystalline.Site.AffineThickening.precoverage := by
  rintro U R ⟨ι, a, ha, rfl⟩
  exact CrystallineLocalization.small_covering U a ha

lemma small_principal_refinement {U : Crystalline.Site.AffineThickening p B J δ f} (R : Presieve U)
    (hR : R ∈ Crystalline.Site.AffineThickening.precoverage U) :
    ∃ a : PrimeSpectrum U.ring → U.ring, Ideal.span (Set.range a) = ⊤ ∧
      ∀ x, Sieve.generate R (CrystallineLocalization.smallHom U (a x)) := by
  have hbig : R.map BigCrystallineSite.fromSmall ∈ BigCrystallineSite.Object.precoverage (BigCrystallineSite.fromSmall.obj U) :=
    Crystalline.Coverings.fromSmall_preserves_coverings U hR
  obtain ⟨a, ha, hgen⟩ := Crystalline.CoverRefinement.principal_refinement (R.map BigCrystallineSite.fromSmall) hbig
  refine ⟨a, ha, ?_⟩
  intro x
  have h := hgen x
  change Sieve.generate (R.map BigCrystallineSite.fromSmall) (BigCrystallineSite.fromSmall.map (CrystallineLocalization.smallHom U (a x))) at h
  rw [Sieve.generate_map_eq_functorPushforward] at h
  change ((Sieve.generate R).functorPushforward BigCrystallineSite.fromSmall).functorPullback BigCrystallineSite.fromSmall
    (CrystallineLocalization.smallHom U (a x)) at h
  rwa [Sieve.functorPullback_functorPushforward_eq] at h

lemma topology_eq_principal :
    Crystalline.Site.AffineThickening.topology (p := p) (J := J) (δB := δ) (f := f) = principalPrecoverage.toGrothendieck := by
  apply le_antisymm
  · apply Precoverage.toGrothendieck_le_iff_le_toPrecoverage.mpr
    intro U R hR
    change Sieve.generate R ∈ principalPrecoverage.toGrothendieck U
    obtain ⟨a, ha, hgen⟩ := small_principal_refinement R hR
    apply principalPrecoverage.toGrothendieck.superset_covering ?_
      (principalPrecoverage.generate_mem_toGrothendieck ⟨PrimeSpectrum U.ring, a, ha, rfl⟩)
    apply (Sieve.generate_le_iff _ _).mpr
    intro V β hβ
    cases hβ with
    | mk x => exact hgen x
  · exact Precoverage.toGrothendieck_mono principal_le_original

end

end OAI.NumberTheory.PadicHodge.IntegralComparison.Small.CrystallinePrincipalTopology
