import OAI.NumberTheory.PadicHodge.IntegralComparison.Small.CrystallinePrincipalTopology

/-! # Crystalline Continuous -/

namespace OAI.NumberTheory.PadicHodge.IntegralComparison.Small.CrystallineContinuous

noncomputable section

/-!
# IntegralComparison: continuity of the original small-site inclusion

The original topology is generated by principal covers. Their pairwise
pullbacks are preserved by the inclusion, so restriction of big-site
sheaves satisfies the small-site sheaf condition.
-/

open _root_.CategoryTheory _root_.CategoryTheory.Limits _root_.AlgebraicGeometry

universe u v

open OAI.NumberTheory.PadicHodge.IntegralComparison.BigCrystallineSite OAI.NumberTheory.PadicHodge.IntegralComparison.Crystalline.Site
open OAI.NumberTheory.PadicHodge.IntegralComparison.Small.CrystallineLocalization OAI.NumberTheory.PadicHodge.IntegralComparison.Small.CrystallinePullback
open OAI.NumberTheory.PadicHodge.IntegralComparison.Small.CrystallinePrincipalTopology

variable {p : ℕ} {B : Type u} [CommRing B] {J : Ideal B} {δ : DividedPowers J}
variable {X : Scheme.{u}} {f : X ⟶ Spec (CommRingCat.of B)}
variable (U : Crystalline.Site.AffineThickening p B J δ f) {ι : Type v} (a : ι → U.ring)

lemma mapped_principal_pullback {T : Crystalline.Site.AffineThickening p B J δ f} (β : T ⟶ U) (r : U.ring) :
    IsPullback (BigCrystallineSite.fromSmall.map (CrystallinePullback.smallLocalizedHom β r))
      (BigCrystallineSite.fromSmall.map (CrystallineLocalization.smallHom T (β.ringMap r))) (BigCrystallineSite.fromSmall.map (CrystallineLocalization.smallHom U r)) (BigCrystallineSite.fromSmall.map β) := by
  rw [CrystallinePullback.smallLocalizedHom_map, CrystallineLocalization.fromSmall_smallHom, CrystallineLocalization.fromSmall_smallHom]
  exact CrystallinePrincipal.PrincipalPullback.principal_pullback (BigCrystallineSite.fromSmall.map β) r

instance principal_pairwise_pullbacks : (CrystallineLocalization.smallPresieve U a).HasPairwisePullbacks where
  has_pullbacks := by
    intro Y Z β hβ γ hγ
    cases hβ with
    | mk i => cases hγ with
      | mk j => exact (CrystallinePullback.small_principal_pullback (CrystallineLocalization.smallHom U (a j)) (a i)).hasPullback

instance inclusion_preserves_principal_pullbacks : BigCrystallineSite.fromSmall.PreservesPairwisePullbacks (CrystallineLocalization.smallPresieve U a) where
  preservesLimit := by
    intro Y Z β γ hβ hγ
    cases hβ with
    | mk i => cases hγ with
      | mk j =>
        apply (CrystallinePullback.small_principal_pullback (CrystallineLocalization.smallHom U (a j)) (a i)).preservesLimit_cospan_iff.mpr
        exact mapped_principal_pullback U (CrystallineLocalization.smallHom U (a j)) (a i)

variable {U} {V : Crystalline.Site.AffineThickening p B J δ f} (β : V ⟶ U)

lemma principal_sieve_pullback :
    (Sieve.generate (CrystallineLocalization.smallPresieve U a)).pullback β =
      Sieve.generate (CrystallineLocalization.smallPresieve V (fun i => β.ringMap (a i))) :=
  (Sieve.ofArrows_eq_pullback_of_isPullback (fun i => CrystallineLocalization.smallHom U (a i))
    (fun i => (CrystallinePullback.small_principal_pullback β (a i)).flip)).symm

instance fromSmall_continuous :
    (BigCrystallineSite.fromSmall (p := p) (J := J) (δ := δ) (f := f)).IsContinuous
      Crystalline.Site.AffineThickening.topology BigCrystallineSite.Object.topology where
  op_comp_isSheaf_of_types G := by
    rw [CrystallinePrincipalTopology.topology_eq_principal]
    apply (CrystallinePrincipalTopology.principalPrecoverage.isSheaf_toGrothendieck_iff _).mpr
    intro U V β R hR
    obtain ⟨ι, a, ha, rfl⟩ := hR
    rw [principal_sieve_pullback, ← Presieve.isSheafFor_iff_generate,
      Presieve.IsSheafFor.comp_iff_of_preservesPairwisePullbacks]
    have hb : Ideal.span (Set.range (fun i => β.ringMap (a i))) = ⊤ := by
      have h := congrArg (Ideal.map β.ringMap.toRingHom) ha
      rw [Ideal.map_span, ← Set.range_comp, Ideal.map_top] at h
      exact h
    have hcov := Crystalline.Coverings.fromSmall_preserves_coverings V
      (CrystallineLocalization.small_covering V (fun i => β.ringMap (a i)) hb)
    exact ((isSheaf_iff_isSheaf_of_type _ _).mp G.property).isSheafFor_of_mem_precoverage hcov

end

end OAI.NumberTheory.PadicHodge.IntegralComparison.Small.CrystallineContinuous
