import OAI.NumberTheory.PadicHodge.IntegralComparison.BigCrystallinePrincipalTopology

/-! # Ambient Continuous -/

namespace OAI.NumberTheory.PadicHodge.IntegralComparison.Crystalline.AmbientContinuous

noncomputable section

/-!
# IntegralComparison: continuity of the ambient-scheme functor

The big crystalline topology is generated by principal covers. Their
pairwise pullbacks are preserved by the ambient functor, so Zariski
sheaves restrict to sheaves on the original big crystalline site.
-/

open _root_.CategoryTheory _root_.CategoryTheory.Limits _root_.AlgebraicGeometry

universe u v

open OAI.NumberTheory.PadicHodge.IntegralComparison.BigCrystallineSite
open OAI.NumberTheory.PadicHodge.IntegralComparison.Crystalline.Localization OAI.NumberTheory.PadicHodge.IntegralComparison.Crystalline.LocalizationMaps
open OAI.NumberTheory.PadicHodge.IntegralComparison.CrystallinePrincipal.PrincipalPullback OAI.NumberTheory.PadicHodge.IntegralComparison.CrystallinePrincipal.Covers
open OAI.NumberTheory.PadicHodge.IntegralComparison.BigCrystallinePrincipalTopology

variable {p : ℕ} {B : Type u} [CommRing B] {J : Ideal B} {δ : DividedPowers J}
variable {X : Scheme.{u}} {f : X ⟶ Spec (CommRingCat.of B)}
variable (U : BigCrystallineSite.Object p B J δ f) {ι : Type v} (a : ι → U.ring)

lemma mapped_principal_pullback {T : BigCrystallineSite.Object p B J δ f} (β : T ⟶ U) (r : U.ring) :
    IsPullback (BigCrystallineSite.Object.ambient.map (LocalizationMaps.localizedHom β r))
      (BigCrystallineSite.Object.ambient.map (Localization.hom T (β.ringMap r))) (BigCrystallineSite.Object.ambient.map (Localization.hom U r)) (BigCrystallineSite.Object.ambient.map β) := by
  exact CrystallinePrincipal.Refinement.ambient_pullback β r

instance principal_pairwise_pullbacks : (CrystallinePrincipal.Covers.presieve U a).HasPairwisePullbacks where
  has_pullbacks := by
    intro Y Z β hβ γ hγ
    cases hβ with
    | mk i => cases hγ with
      | mk j => exact (CrystallinePrincipal.PrincipalPullback.principal_pullback (Localization.hom U (a j)) (a i)).hasPullback

instance inclusion_preserves_principal_pullbacks : BigCrystallineSite.Object.ambient.PreservesPairwisePullbacks (CrystallinePrincipal.Covers.presieve U a) where
  preservesLimit := by
    intro Y Z β γ hβ hγ
    cases hβ with
    | mk i => cases hγ with
      | mk j =>
        apply (CrystallinePrincipal.PrincipalPullback.principal_pullback (Localization.hom U (a j)) (a i)).preservesLimit_cospan_iff.mpr
        exact mapped_principal_pullback U (Localization.hom U (a j)) (a i)

variable {U} {V : BigCrystallineSite.Object p B J δ f} (β : V ⟶ U)

lemma principal_sieve_pullback :
    (Sieve.generate (CrystallinePrincipal.Covers.presieve U a)).pullback β =
      Sieve.generate (CrystallinePrincipal.Covers.presieve V (fun i => β.ringMap (a i))) :=
  (Sieve.ofArrows_eq_pullback_of_isPullback (fun i => Localization.hom U (a i))
    (fun i => (CrystallinePrincipal.PrincipalPullback.principal_pullback β (a i)).flip)).symm

instance ambient_continuous :
    (BigCrystallineSite.Object.ambient (p := p) (J := J) (δ := δ) (f := f)).IsContinuous
      BigCrystallineSite.Object.topology Scheme.zariskiTopology where
  op_comp_isSheaf_of_types G := by
    rw [BigCrystallinePrincipalTopology.topology_eq_principal]
    apply (BigCrystallinePrincipalTopology.principalPrecoverage.isSheaf_toGrothendieck_iff _).mpr
    intro U V β R hR
    obtain ⟨ι, a, ha, rfl⟩ := hR
    rw [principal_sieve_pullback, ← Presieve.isSheafFor_iff_generate,
      Presieve.IsSheafFor.comp_iff_of_preservesPairwisePullbacks]
    have hb : Ideal.span (Set.range (fun i => β.ringMap (a i))) = ⊤ := by
      have h := congrArg (Ideal.map β.ringMap.toRingHom) ha
      rw [Ideal.map_span, ← Set.range_comp, Ideal.map_top] at h
      exact h
    have hcov := (CrystallinePrincipal.Covers.covering V (fun i => β.ringMap (a i)) hb).1
    exact ((isSheaf_iff_isSheaf_of_type _ _).mp G.property).isSheafFor_of_mem_precoverage hcov

end

end OAI.NumberTheory.PadicHodge.IntegralComparison.Crystalline.AmbientContinuous
