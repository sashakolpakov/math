import OAI.NumberTheory.PadicHodge.IntegralComparison.Crystalline.CoverRefinement

/-! # Big Crystalline Principal Topology -/

namespace OAI.NumberTheory.PadicHodge.IntegralComparison.BigCrystallinePrincipalTopology

noncomputable section

/-!
# IntegralComparison: the big crystalline topology is generated by principal covers

This identifies a basis for the original big-site topology; the original
definition of that topology is unchanged.
-/

open _root_.CategoryTheory _root_.AlgebraicGeometry

universe u

open OAI.NumberTheory.PadicHodge.IntegralComparison.BigCrystallineSite
open OAI.NumberTheory.PadicHodge.IntegralComparison.Crystalline.Localization OAI.NumberTheory.PadicHodge.IntegralComparison.Crystalline.CoverRefinement
open OAI.NumberTheory.PadicHodge.IntegralComparison.CrystallinePrincipal.Covers

variable {p : ℕ} {B : Type u} [CommRing B] {J : Ideal B} {δ : DividedPowers J}
variable {X : Scheme.{u}} {f : X ⟶ Spec (CommRingCat.of B)}

def principalPrecoverage : Precoverage (BigCrystallineSite.Object p B J δ f) where
  coverings U := {R | ∃ (ι : Type u) (a : ι → U.ring), Ideal.span (Set.range a) = ⊤ ∧ R = CrystallinePrincipal.Covers.presieve U a}

lemma principal_le_original :
    principalPrecoverage (p := p) (J := J) (δ := δ) (f := f) ≤ BigCrystallineSite.Object.precoverage := by
  rintro U R ⟨ι, a, ha, rfl⟩
  exact CrystallinePrincipal.Covers.covering U a ha

lemma topology_eq_principal :
    BigCrystallineSite.Object.topology (p := p) (J := J) (δ := δ) (f := f) = principalPrecoverage.toGrothendieck := by
  apply le_antisymm
  · apply Precoverage.toGrothendieck_le_iff_le_toPrecoverage.mpr
    intro U R hR
    change Sieve.generate R ∈ principalPrecoverage.toGrothendieck U
    obtain ⟨a, ha, hgen⟩ := Crystalline.CoverRefinement.principal_refinement R hR
    apply principalPrecoverage.toGrothendieck.superset_covering ?_
      (principalPrecoverage.generate_mem_toGrothendieck ⟨PrimeSpectrum U.ring, a, ha, rfl⟩)
    apply (Sieve.generate_le_iff _ _).mpr
    intro V β hβ
    cases hβ with
    | mk x => exact hgen x
  · exact Precoverage.toGrothendieck_mono principal_le_original

end

end OAI.NumberTheory.PadicHodge.IntegralComparison.BigCrystallinePrincipalTopology
