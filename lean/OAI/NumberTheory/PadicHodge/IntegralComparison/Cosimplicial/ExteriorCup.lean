import OAI.NumberTheory.PadicHodge.IntegralComparison.Cosimplicial.CohomologyRing
import Mathlib.LinearAlgebra.ExteriorPower.Basic

/-! # Exterior Cup -/

namespace OAI.NumberTheory.PadicHodge.IntegralComparison.Cosimplicial.ExteriorCup

noncomputable section

/-! The natural exterior-algebra map generated by degree-one classes.
Its homogeneous components land in the original cohomology modules and
evaluate on exterior words as iterated cup products. -/

open _root_.CategoryTheory
open scoped DirectSum Simplicial

open OAI.NumberTheory.PadicHodge.IntegralComparison.Cosimplicial.ModuleComplex OAI.NumberTheory.PadicHodge.IntegralComparison.Cosimplicial.CohomologyRing

universe u v

variable {R : Type u} [CommRing R] (A : CosimplicialObject (CommAlgCat.{v} R))

def iteratedCup : (n : ℕ) → (Fin n → CohomologyRing.cohomology A 1) → CohomologyRing.cohomology A n := fun n =>
  match n with
  | 0 => fun _ => ModuleCupAlgebra.cohomologyOne A
  | n + 1 => fun x => ModuleCup.cohomologyCup A n 1
      (iteratedCup n (fun i => x i.castSucc)) (x (Fin.last n))

theorem inclusion_iteratedCup (n : ℕ) (x : Fin n → CohomologyRing.cohomology A 1) :
    CohomologyRing.inclusion A n (ExteriorCup.iteratedCup A n x) =
      (List.ofFn fun i => CohomologyRing.inclusion A 1 (x i)).prod := by
  induction n with
  | zero => simp only [ExteriorCup.iteratedCup, CohomologyRing.inclusion_one, List.ofFn_zero, List.prod_nil]
  | succ n ih =>
      rw [ExteriorCup.iteratedCup, CohomologyRing.inclusion_cup, List.ofFn_succ', List.prod_concat, ih]

variable [Invertible (2 : A.obj ⦋1⦌)] [Invertible (2 : A.obj ⦋2⦌)]

def exteriorMap : ExteriorAlgebra R (CohomologyRing.cohomology A 1) →ₐ[R] CohomologyRing.total A :=
  ExteriorAlgebra.lift R ⟨CohomologyRing.inclusion A 1, CohomologyRing.inclusion_square_zero A⟩

theorem exteriorMap_ι (x : CohomologyRing.cohomology A 1) :
    exteriorMap A (ExteriorAlgebra.ι R x) = CohomologyRing.inclusion A 1 x :=
  ExteriorAlgebra.lift_ι_apply R _ _ x

theorem exteriorMap_multi (n : ℕ) (x : Fin n → CohomologyRing.cohomology A 1) :
    exteriorMap A (ExteriorAlgebra.ιMulti R n x) = CohomologyRing.inclusion A n (ExteriorCup.iteratedCup A n x) := by
  rw [ExteriorAlgebra.ιMulti_apply, map_list_prod, List.map_ofFn, inclusion_iteratedCup]
  congr 2
  funext i
  exact exteriorMap_ι A (x i)

def exteriorPowerCup (n : ℕ) : (⋀[R]^n (CohomologyRing.cohomology A 1)) →ₗ[R] CohomologyRing.cohomology A n :=
  (CohomologyRing.component A n).comp ((exteriorMap A).toLinearMap.comp
    (Submodule.subtype (⋀[R]^n (CohomologyRing.cohomology A 1))))

theorem exteriorPowerCup_multi (n : ℕ) (x : Fin n → CohomologyRing.cohomology A 1) :
    exteriorPowerCup A n (exteriorPower.ιMulti R n x) = ExteriorCup.iteratedCup A n x := by
  change CohomologyRing.component A n (exteriorMap A (ExteriorAlgebra.ιMulti R n x)) = _
  rw [exteriorMap_multi]
  exact DirectSum.component.lof_self R n _

theorem inclusion_comp_exteriorPowerCup (n : ℕ) :
    (CohomologyRing.inclusion A n).comp (exteriorPowerCup A n) =
      (exteriorMap A).toLinearMap.comp (Submodule.subtype (⋀[R]^n (CohomologyRing.cohomology A 1))) := by
  apply LinearMap.ext_on (exteriorPower.ιMulti_span R n (CohomologyRing.cohomology A 1))
  rintro w ⟨x, rfl⟩
  exact (congrArg (CohomologyRing.inclusion A n) (exteriorPowerCup_multi A n x)).trans
    (exteriorMap_multi A n x).symm

theorem exteriorPowerCup_homogeneous (n : ℕ) (x : ⋀[R]^n (CohomologyRing.cohomology A 1)) :
    CohomologyRing.inclusion A n (exteriorPowerCup A n x) = exteriorMap A x :=
  DFunLike.congr_fun (inclusion_comp_exteriorPowerCup A n) x

end

end OAI.NumberTheory.PadicHodge.IntegralComparison.Cosimplicial.ExteriorCup
