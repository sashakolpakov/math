import OAI.NumberTheory.Quaternion.Arithmetic.SplitMatrices
import OAI.NumberTheory.Quaternion.Arithmetic.SpecialLinear

/-! # Split Group -/

namespace OAI.NumberTheory.Quaternion.Arithmetic.SplitGroup

noncomputable section

/-! The norm-one group of a split quaternion algebra is isomorphic
to SL₂ and is generated by additive one-parameter subgroups. -/

open scoped Classical _root_.Quaternion
open QuaternionAlgebra _root_.Matrix

variable {K : Type*} [Field K] [CharZero K]
  (a b x y : K) (ha : a ≠ 0) (hb : b ≠ 0) (h : x ^ 2 - a * y ^ 2 = b)

def quaternionNormOneToSpecialLinear : (Norm.quaternionUnitNorm a b).ker →* Matrix.SpecialLinearGroup (Fin 2) K where
  toFun q := ⟨SplitMatrices.quaternionSplittingEquiv a b x y ha hb h q.val.val,
    (SplitMatrices.quaternionSplittingMap_det a b x y h q.val.val).trans
      (congrArg Units.val (MonoidHom.mem_ker.mp q.property))⟩
  map_one' := by
    apply Subtype.ext
    exact map_one (SplitMatrices.quaternionSplittingEquiv a b x y ha hb h)
  map_mul' q r := by
    apply Subtype.ext
    exact map_mul (SplitMatrices.quaternionSplittingEquiv a b x y ha hb h) q.val.val r.val.val

def specialLinearToQuaternionNormOne (g : Matrix.SpecialLinearGroup (Fin 2) K) :
    (Norm.quaternionUnitNorm a b).ker := by
  let e := SplitMatrices.quaternionSplittingEquiv a b x y ha hb h
  let q : ℍ[K,a,b]ˣ := Units.map e.symm.toMonoidHom (Matrix.SpecialLinearGroup.toGL g)
  refine ⟨q, ?_⟩
  apply MonoidHom.mem_ker.mpr
  apply Units.ext
  change Norm.quaternionNorm a b (e.symm g.val) = 1
  calc
    Norm.quaternionNorm a b (e.symm g.val) = (e (e.symm g.val)).det :=
      (SplitMatrices.quaternionSplittingMap_det a b x y h (e.symm g.val)).symm
    _ = g.val.det := congrArg Matrix.det (e.apply_symm_apply g.val)
    _ = 1 := g.property

def quaternionNormOneSpecialLinearEquiv :
    (Norm.quaternionUnitNorm a b).ker ≃* Matrix.SpecialLinearGroup (Fin 2) K where
  toFun := quaternionNormOneToSpecialLinear a b x y ha hb h
  invFun := specialLinearToQuaternionNormOne a b x y ha hb h
  left_inv q := by
    apply Subtype.ext
    apply Units.ext
    change (SplitMatrices.quaternionSplittingEquiv a b x y ha hb h).symm
      (SplitMatrices.quaternionSplittingEquiv a b x y ha hb h q.val.val) = q.val.val
    exact AlgEquiv.symm_apply_apply _ _
  right_inv g := by
    apply Subtype.ext
    change SplitMatrices.quaternionSplittingEquiv a b x y ha hb h
      ((SplitMatrices.quaternionSplittingEquiv a b x y ha hb h).symm g.val) = g.val
    exact AlgEquiv.apply_symm_apply _ _
  map_mul' := map_mul (quaternionNormOneToSpecialLinear a b x y ha hb h)

include ha hb h in
theorem quaternionNormOne_additive_generation :
    Subgroup.closure (FiniteIndex.additiveParameterElements (K := K) (G := (Norm.quaternionUnitNorm a b).ker)) = ⊤ := by
  let e := quaternionNormOneSpecialLinearEquiv a b x y ha hb h
  let H := Subgroup.closure (FiniteIndex.additiveParameterElements (K := K) (G := (Norm.quaternionUnitNorm a b).ker))
  have hg (g : Matrix.SpecialLinearGroup (Fin 2) K) : e.symm g ∈ H := by
    apply SpecialLinear.specialLinear_transvection_induction (fun g => e.symm g ∈ H)
    · intro i j hij t
      apply Subgroup.subset_closure
      exact ⟨e.symm.toMonoidHom.comp (FiniteIndex.transvectionParameter hij), t, rfl⟩
    · intro g₁ g₂ h₁ h₂
      rw [map_mul]
      exact H.mul_mem h₁ h₂
  apply top_unique
  intro q _
  simpa only [MulEquiv.symm_apply_apply] using hg (e q)

end

end OAI.NumberTheory.Quaternion.Arithmetic.SplitGroup
