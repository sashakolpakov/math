import Mathlib

/-! # Finite Index -/

namespace OAI.NumberTheory.Quaternion.Arithmetic.FiniteIndex

noncomputable section

section

/-! Finite-index subgroups contain every additive one-parameter subgroup
over a characteristic-zero field. This supplies the group-theoretic
consequence of unipotent generation in the local arithmetic argument. -/

open scoped Classical

variable {K G : Type*} [Field K] [CharZero K] [Group G]

/-- Additive parameter groups over a characteristic-zero field are divisible,
so their images lie in every finite-index subgroup. -/
theorem additive_parameter_mem_finiteIndex (H : Subgroup G) [H.FiniteIndex]
    (u : Multiplicative K →* G) (a : K) : u (Multiplicative.ofAdd a) ∈ H := by
  let N := H.normalCore
  have hn : (N.index : K) ≠ 0 :=
    Nat.cast_ne_zero.mpr (Subgroup.FiniteIndex.index_ne_zero (H := N))
  have he : (Multiplicative.ofAdd (a / (N.index : K))) ^ N.index =
      Multiplicative.ofAdd a := by
    apply Multiplicative.toAdd.injective
    change N.index • (a / (N.index : K)) = a
    rw [nsmul_eq_mul]
    exact mul_div_cancel₀ a hn
  have hu := N.pow_index_mem (u (Multiplicative.ofAdd (a / (N.index : K))))
  rw [← map_pow, he] at hu
  exact H.normalCore_le hu

def additiveParameterElements : Set G :=
  {g | ∃ u : Multiplicative K →* G, ∃ a : K, u (Multiplicative.ofAdd a) = g}

theorem finiteIndex_eq_top_of_additive_generation
    (hgen : Subgroup.closure (additiveParameterElements (K := K) (G := G)) = ⊤)
    (H : Subgroup G) [H.FiniteIndex] : H = ⊤ := by
  apply top_unique
  rw [← hgen]
  apply (Subgroup.closure_le H).mpr
  rintro g ⟨u, a, rfl⟩
  exact additive_parameter_mem_finiteIndex H u a

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

/-- The usual elementary-matrix one-parameter subgroup. -/
def transvectionParameter {i j : ι} (hij : i ≠ j) :
    Multiplicative K →* Matrix.SpecialLinearGroup ι K where
  toFun a := Matrix.SpecialLinearGroup.transvection hij a.toAdd
  map_one' := by
    apply Subtype.ext
    simp
  map_mul' a b := Matrix.SpecialLinearGroup.transvection_add hij a.toAdd b.toAdd

theorem transvection_mem_finiteIndex (H : Subgroup (Matrix.SpecialLinearGroup ι K))
    [H.FiniteIndex] {i j : ι} (hij : i ≠ j) (a : K) :
    Matrix.SpecialLinearGroup.transvection hij a ∈ H :=
  additive_parameter_mem_finiteIndex H (transvectionParameter hij) a

/-- The rank-one split group has no proper finite-index subgroup. -/
theorem sl2_finiteIndex_eq_top (H : Subgroup (Matrix.SpecialLinearGroup (Fin 2) K))
    [H.FiniteIndex] : H = ⊤ := by
  apply top_unique
  intro g _
  exact Matrix.SL2.transvection_induction
    (fun g => g ∈ H)
    (fun i j hij a => transvection_mem_finiteIndex H hij a)
    (fun a b ha hb => H.mul_mem ha hb) g

end

/-! In a finite product, finite-index subgroups contain every factor
generated by additive parameters. Exceptional factors are kept explicit. -/

open scoped Classical

variable {ι : Type*} {K L : ι → Type*} [∀ i, Field (K i)] [∀ i, CharZero (K i)] [∀ i, Group (L i)]

theorem finiteIndex_contains_generated_factor
    (H : Subgroup (∀ i, L i)) [H.FiniteIndex] (i : ι)
    (hgen : Subgroup.closure (additiveParameterElements (K := K i) (G := L i)) = ⊤)
    (x : L i) : Pi.mulSingle i x ∈ H := by
  let e := MonoidHom.mulSingle L i
  have hle : Subgroup.closure (additiveParameterElements (K := K i) (G := L i)) ≤ H.comap e := by
    apply (Subgroup.closure_le (H.comap e)).mpr
    rintro y ⟨u, a, rfl⟩
    exact additive_parameter_mem_finiteIndex H (e.comp u) a
  rw [hgen] at hle
  exact hle (Subgroup.mem_top x)

theorem finiteIndex_product_mem_of_exceptional_one [Finite ι]
    (H : Subgroup (∀ i, L i)) [H.FiniteIndex] (B : Set ι)
    (hgen : ∀ i ∉ B, Subgroup.closure (additiveParameterElements (K := K i) (G := L i)) = ⊤)
    (x : ∀ i, L i) (hx : ∀ i ∈ B, x i = 1) : x ∈ H := by
  apply Subgroup.pi_mem_of_mulSingle_mem x
  intro i
  by_cases hi : i ∈ B
  · simpa only [hx i hi, Pi.mulSingle_one] using H.one_mem
  · exact finiteIndex_contains_generated_factor (K := K) H i (hgen i hi) (x i)

end

end OAI.NumberTheory.Quaternion.Arithmetic.FiniteIndex
