import OAI.NumberTheory.Quaternion.Arithmetic.CommutatorApproximation
import OAI.NumberTheory.Quaternion.Arithmetic.LocalAlgebraUnitsDensity

/-! # Character Kernel Approximation -/

namespace OAI.NumberTheory.Quaternion.Arithmetic.CharacterKernelApproximation

noncomputable section

/-! Approximation in kernels of compatible multiplicative characters.
For a reduced norm, the remaining local hypothesis is precisely that
the norm-one subgroup is generated by ambient commutators. -/

open scoped Classical commutatorElement _root_.NumberField
open IsDedekindDomain

variable {G Z : Type*} [Group G] [CommGroup Z]

theorem commutator_le_character_kernel (ν : G →* Z) : commutator G ≤ ν.ker := by
  rw [commutator_eq_closure]
  apply (Subgroup.closure_le ν.ker).mpr
  rintro x ⟨a, b, rfl⟩
  change ν ⁅a, b⁆ = 1
  rw [map_commutatorElement]
  simp [commutatorElement_def]

variable {ι : Type*} {L W : ι → Type*} [∀ i, Group (L i)] [∀ i, Group (W i)]

def characterKernelPiDiagonal (f : ∀ i, G →* L i) (ν : G →* Z)
    (νlocal : ∀ i, L i →* W i) (σ : ∀ i, Z →* W i)
    (hc : ∀ i g, νlocal i (f i g) = σ i (ν g)) : ν.ker →* (∀ i, (νlocal i).ker) :=
  CommutatorApproximation.subgroupPiDiagonal f ν.ker (fun i => (νlocal i).ker) (by
    intro i g hg
    change νlocal i (f i g) = 1
    rw [hc, MonoidHom.mem_ker.mp hg, map_one])

theorem denseRange_characterKernelPiDiagonal [Finite ι]
    [∀ i, TopologicalSpace (L i)] [∀ i, IsTopologicalGroup (L i)]
    (f : ∀ i, G →* L i) (hd : DenseRange (fun g : G => fun i => f i g))
    (ν : G →* Z) (νlocal : ∀ i, L i →* W i) (σ : ∀ i, Z →* W i)
    (hc : ∀ i g, νlocal i (f i g) = σ i (ν g))
    (hcomm : ∀ i, (νlocal i).ker ≤ commutator (L i)) :
    DenseRange (characterKernelPiDiagonal f ν νlocal σ hc) :=
  CommutatorApproximation.denseRange_subgroupPiDiagonal_of_commutators f hd ν.ker (commutator_le_character_kernel ν)
    (fun i => (νlocal i).ker) hcomm _

variable {F : Type} [Field F] [NumberField F] [Fintype ι]
  (v : ι → HeightOneSpectrum (𝓞 F)) (D : Type*) [Ring D] [Algebra F D] [FiniteDimensional F D]

theorem denseRange_local_character_kernels (hv : Function.Injective v)
    (ν : Dˣ →* Fˣ)
    (νlocal : ∀ i, (NoncommutativeLocalModel.localFiniteAlgebra ((v i).adicCompletion F) F D)ˣ →* ((v i).adicCompletion F)ˣ)
    (hc : ∀ i a, νlocal i (LocalAlgebraUnitsDensity.localFiniteAlgebraUnitMap v D i a) = LocalAlgebraUnitsDensity.finiteCompletionUnitMap v i (ν a))
    (hcomm : ∀ i, (νlocal i).ker ≤ commutator (NoncommutativeLocalModel.localFiniteAlgebra ((v i).adicCompletion F) F D)ˣ) :
    DenseRange (characterKernelPiDiagonal
      (LocalAlgebraUnitsDensity.localFiniteAlgebraUnitMap v D) ν νlocal (LocalAlgebraUnitsDensity.finiteCompletionUnitMap v) hc) := by
  have hd : DenseRange (fun a : Dˣ => fun i => LocalAlgebraUnitsDensity.localFiniteAlgebraUnitMap v D i a) :=
    LocalAlgebraUnitsDensity.denseRange_localFiniteAlgebraUnits v D hv
  exact denseRange_characterKernelPiDiagonal (LocalAlgebraUnitsDensity.localFiniteAlgebraUnitMap v D) hd ν νlocal
    (LocalAlgebraUnitsDensity.finiteCompletionUnitMap v) hc hcomm

end

end OAI.NumberTheory.Quaternion.Arithmetic.CharacterKernelApproximation
