import OAI.NumberTheory.Quaternion.Arithmetic.SplitGroup
import OAI.NumberTheory.Quaternion.Arithmetic.LocalModel
import OAI.NumberTheory.Quaternion.Arithmetic.AlmostAllNorm
import OAI.NumberTheory.Quaternion.Arithmetic.AdditiveGenerationTransport

/-! # Local Generation -/

namespace OAI.NumberTheory.Quaternion.Arithmetic.LocalGeneration

noncomputable section

/-! Outside finitely many finite places, the concrete local
quaternion norm-one groups are generated by additive parameters. -/

open scoped Classical _root_.Quaternion _root_.NumberField
open IsDedekindDomain Filter

variable (F K : Type*) [Field F] [NontriviallyNormedField K] [Algebra F K] (a b : F)

def localQuaternionNormOneEquiv :
    (Norm.quaternionUnitNorm (algebraMap F K a) (algebraMap F K b)).ker ≃*
      (LocalModel.localQuaternionUnitNorm F K a b).ker :=
  AdditiveGenerationTransport.characterKernelEquiv (Units.mapEquiv (LocalModel.localQuaternionModelEquiv F K a b).toMulEquiv)
    (Norm.quaternionUnitNorm (algebraMap F K a) (algebraMap F K b)) (LocalModel.localQuaternionUnitNorm F K a b)
    (by
      intro q
      apply Units.ext
      change Norm.quaternionNorm (algebraMap F K a) (algebraMap F K b)
        ((LocalModel.localQuaternionModelEquiv F K a b).symm (LocalModel.localQuaternionModelEquiv F K a b q.val)) = _
      rw [AlgEquiv.symm_apply_apply]
      rfl)

theorem localQuaternion_additive_generation_of_norm_equation [CharZero K]
    (ha : a ≠ 0) (hb : b ≠ 0) (x y : K)
    (h : x ^ 2 - algebraMap F K a * y ^ 2 = algebraMap F K b) :
    Subgroup.closure (FiniteIndex.additiveParameterElements (K := K) (G := (LocalModel.localQuaternionUnitNorm F K a b).ker)) = ⊤ :=
  AdditiveGenerationTransport.additive_generation_of_mulEquiv (localQuaternionNormOneEquiv F K a b)
    (SplitGroup.quaternionNormOne_additive_generation (algebraMap F K a) (algebraMap F K b) x y
      ((map_ne_zero (algebraMap F K)).mpr ha) ((map_ne_zero (algebraMap F K)).mpr hb) h)

variable {F K a b}

theorem eventually_localQuaternion_additive_generation {F : Type} [Field F] [NumberField F]
    (a b : F) (ha : a ≠ 0) (hb : b ≠ 0) :
    ∀ᶠ v : HeightOneSpectrum (𝓞 F) in cofinite,
      Subgroup.closure (FiniteIndex.additiveParameterElements (K := v.adicCompletion F)
        (G := (LocalModel.localQuaternionUnitNorm F (v.adicCompletion F) a b).ker)) = ⊤ := by
  filter_upwards [AlmostAllNorm.eventually_quaternion_splitting_norm_equation a b ha hb] with v hv
  obtain ⟨x, y, hxy⟩ := hv
  let : CharZero (v.adicCompletion F) :=
    charZero_of_injective_ringHom (algebraMap F (v.adicCompletion F)).injective
  exact localQuaternion_additive_generation_of_norm_equation F (v.adicCompletion F) a b ha hb x y hxy

end

end OAI.NumberTheory.Quaternion.Arithmetic.LocalGeneration
