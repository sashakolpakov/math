import OAI.Analysis.PDE.Dirichlet.Derivative
import OAI.Analysis.PDE.Dirichlet.RigidMotion

noncomputable section
namespace OAI.Analysis.PDE.Dirichlet

section Calculus
variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]

/-- The first-order operator generated by an affine vector field. -/
def affineDerivative (f : E → ℝ) (e : E) (A : E →L[ℝ] E) (x : E) : ℝ :=
  fderiv ℝ f x (e + A x)

theorem contDiff_affineDerivative {f : E → ℝ} {m n : WithTop ENat}
    (hf : ContDiff ℝ n f) (hmn : m + 1 ≤ n) (e : E) (A : E →L[ℝ] E) :
    ContDiff ℝ m (affineDerivative f e A) :=
  (hf.fderiv_right hmn).clm_apply (contDiff_const.add A.contDiff)

theorem directionalDerivative_affineDerivative {f : E → ℝ}
    (hf : ContDiff ℝ 2 f) (e : E) (A : E →L[ℝ] E) (v x : E) :
    directionalDerivative (affineDerivative f e A) v x =
      fderiv ℝ f x (A v) + (fderiv ℝ (fderiv ℝ f) x v) (e + A x) := by
  have hD := (hf.fderiv_right (m := 1) (by norm_num)).differentiable (by norm_num)
  have hX : Differentiable ℝ (fun y : E ↦ e + A y) := (differentiable_const e).add A.differentiable
  unfold directionalDerivative affineDerivative
  rw [fderiv_clm_apply (hD x) (hX x)]
  simp only [fderiv_const_add, ContinuousLinearMap.fderiv, add_apply,
    ContinuousLinearMap.comp_apply, ContinuousLinearMap.flip_apply]

/-- The exact second-derivative commutator for a local affine vector field.
This is the calculus input to the rigid-motion mixed boundary estimate. -/
theorem hessian_affineDerivative {f : E → ℝ} (hf : ContDiff ℝ 3 f)
    (e : E) (A : E →L[ℝ] E) (v w x : E) :
    (fderiv ℝ (fderiv ℝ (affineDerivative f e A)) x v) w =
      (fderiv ℝ (fderiv ℝ (fderiv ℝ f)) x v w) (e + A x) +
        (fderiv ℝ (fderiv ℝ f) x v) (A w) +
        (fderiv ℝ (fderiv ℝ f) x w) (A v) := by
  have hf2 : ContDiff ℝ 2 f := hf.of_le (by norm_num)
  have hXf : ContDiff ℝ 2 (affineDerivative f e A) := contDiff_affineDerivative hf (by norm_num) e A
  have hD1 := (hf.fderiv_right (m := 2) (by norm_num)).differentiable (by norm_num)
  have hD2 := ((hf.fderiv_right (m := 2) (by norm_num)).fderiv_right
    (m := 1) (by norm_num)).differentiable (by norm_num)
  have hP : Differentiable ℝ (fun y ↦ fderiv ℝ (fderiv ℝ f) y w) :=
    hD2.clm_apply (differentiable_const w)
  have hQ : Differentiable ℝ (fun y ↦ fderiv ℝ f y (A w)) :=
    hD1.clm_apply (differentiable_const (A w))
  have hX : Differentiable ℝ (fun y : E ↦ e + A y) := (differentiable_const e).add A.differentiable
  have hfirst : directionalDerivative (affineDerivative f e A) w =
      fun y ↦ fderiv ℝ f y (A w) + (fderiv ℝ (fderiv ℝ f) y w) (e + A y) := by
    funext y
    exact directionalDerivative_affineDerivative hf2 e A w y
  rw [← directionalDerivative_twice hXf v w x, hfirst]
  unfold directionalDerivative
  have hadd : fderiv ℝ (fun y ↦ fderiv ℝ f y (A w) +
      (fderiv ℝ (fderiv ℝ f) y w) (e + A y)) x =
      fderiv ℝ (fun y ↦ fderiv ℝ f y (A w)) x +
        fderiv ℝ (fun y ↦ (fderiv ℝ (fderiv ℝ f) y w) (e + A y)) x :=
    ((hQ x).hasFDerivAt.add ((hP x).clm_apply (hX x)).hasFDerivAt).fderiv
  rw [hadd,
    fderiv_clm_apply (hD1 x) (differentiableAt_const (A w)),
    fderiv_clm_apply (hP x) (hX x),
    fderiv_clm_apply (hD2 x) (differentiableAt_const w)]
  simp only [fderiv_const_add, ContinuousLinearMap.fderiv,
    add_apply, ContinuousLinearMap.comp_apply,
    ContinuousLinearMap.flip_apply]
  simp [add_comm, add_left_comm]

/-- Constant-direction differentiation is the zero-linear-part case. -/
theorem hessian_directionalDerivative {f : E → ℝ} (hf : ContDiff ℝ 3 f)
    (e v w x : E) :
    (fderiv ℝ (fderiv ℝ (directionalDerivative f e)) x v) w =
      (fderiv ℝ (fderiv ℝ (fderiv ℝ f)) x v w) e := by
  have heq : affineDerivative f e 0 = directionalDerivative f e := by
    funext y
    simp [affineDerivative, directionalDerivative]
  have h := hessian_affineDerivative hf e 0 v w x
  rw [heq] at h
  simpa using h

end Calculus
end OAI.Analysis.PDE.Dirichlet
