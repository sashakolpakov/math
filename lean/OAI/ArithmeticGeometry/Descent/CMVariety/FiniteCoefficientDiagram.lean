import Mathlib.Algebra.Category.Ring.FilteredColimits
import Mathlib.CategoryTheory.Limits.Types.Filtered
import Mathlib.RingTheory.Adjoin.FG
import Mathlib.AlgebraicGeometry.AffineTransitionLimit

/-! # Finite Coefficient Diagram -/

namespace OAI.ArithmeticGeometry.Descent.CMVariety.FiniteCoefficientDiagram.Abelian

noncomputable section

section

/-!
The actual coefficient algebra is the filtered colimit of its subalgebras
generated by finite sets of coefficients. This is the arithmetic diagram
for spreading the finitely many actual CM endomorphisms.
-/

open _root_.CategoryTheory _root_.CategoryTheory.Limits _root_.AlgebraicGeometry
open scoped Classical

variable (R B : Type) [CommRing R] [CommRing B] [Algebra R B]

def finiteCoefficientAlgebra (s : Finset B) : Subalgebra R B := Algebra.adjoin R (s : Set B)

instance finiteCoefficientAlgebra_finiteType (s : Finset B) :
  Algebra.FiniteType R (finiteCoefficientAlgebra R B s) :=
  (Subalgebra.fg_iff_finiteType _).mp (Subalgebra.fg_adjoin_finset s)

def finiteCoefficientRingDiagram : Finset B ⥤ CommRingCat where
  obj s := CommRingCat.of (finiteCoefficientAlgebra R B s)
  map {s t} f := CommRingCat.ofHom
    (Subalgebra.inclusion (Algebra.adjoin_mono (show (s : Set B) ⊆ t from leOfHom f))).toRingHom
  map_id s := by ext x; rfl
  map_comp f h := by ext x; rfl

def finiteCoefficientCocone : Cocone (finiteCoefficientRingDiagram R B) where
  pt := CommRingCat.of B
  ι :=
    { app s := CommRingCat.ofHom (finiteCoefficientAlgebra R B s).val.toRingHom
      naturality := by intros; ext x; rfl }

def finiteCoefficientCoconeIsColimit : IsColimit (finiteCoefficientCocone R B) := by
  let : ReflectsColimit (finiteCoefficientRingDiagram R B) (forget CommRingCat) :=
    reflectsColimit_of_reflectsIsomorphisms _ _
  apply isColimitOfReflects (forget CommRingCat)
  apply Types.FilteredColimit.isColimitOf' _ _
  · intro x
    refine ⟨{x}, ⟨x, Algebra.subset_adjoin (Finset.mem_singleton_self x)⟩, rfl⟩
  · intro s x y h
    refine ⟨s, 𝟙 s, ?_⟩
    exact Subtype.ext h

end

/-! The actual affine scheme limit of the finite-coefficient diagram. -/

open _root_.CategoryTheory _root_.CategoryTheory.Limits _root_.AlgebraicGeometry
open scoped Classical

variable (R B : Type) [CommRing R] [CommRing B] [Algebra R B]

def finiteCoefficientSchemeDiagram : (Finset B)ᵒᵖ ⥤ Scheme :=
  (finiteCoefficientRingDiagram R B).op ⋙ Scheme.Spec

def finiteCoefficientSchemeCone : Cone (finiteCoefficientSchemeDiagram R B) :=
  Scheme.Spec.mapCone (finiteCoefficientCocone R B).op

def finiteCoefficientSchemeConeIsLimit : IsLimit (finiteCoefficientSchemeCone R B) :=
  isLimitOfPreserves Scheme.Spec (finiteCoefficientCoconeIsColimit R B).op

def finiteCoefficientBaseMap (s : Finset B) :
    Spec (CommRingCat.of (finiteCoefficientAlgebra R B s)) ⟶ Spec (CommRingCat.of R) :=
  Spec.map (CommRingCat.ofHom (algebraMap R (finiteCoefficientAlgebra R B s)))

instance finiteCoefficientBaseMap_locallyFiniteType (s : Finset B) :
    LocallyOfFiniteType (finiteCoefficientBaseMap R B s) :=
  (HasRingHomProperty.Spec_iff (P := @LocallyOfFiniteType)).mpr
    (RingHom.finiteType_algebraMap.mpr inferInstance)

def finiteCoefficientStructure : finiteCoefficientSchemeDiagram R B ⟶
    (Functor.const (Finset B)ᵒᵖ).obj (Spec (CommRingCat.of R)) where
  app s := finiteCoefficientBaseMap R B s.unop
  naturality {s t} f := by
    change Spec.map _ ≫ Spec.map _ = Spec.map _ ≫ 𝟙 _
    dsimp only [Functor.op_map, Quiver.Hom.unop_op, finiteCoefficientRingDiagram]
    rw [Category.comp_id, ← Spec.map_comp]
    congr 1

theorem finiteCoefficientSchemeCone_structure (s : (Finset B)ᵒᵖ) :
    (finiteCoefficientSchemeCone R B).π.app s ≫ (finiteCoefficientStructure R B).app s =
      Spec.map (CommRingCat.ofHom (algebraMap R B)) := by
  change Spec.map (CommRingCat.ofHom (finiteCoefficientAlgebra R B s.unop).val.toRingHom) ≫
    Spec.map (CommRingCat.ofHom (algebraMap R (finiteCoefficientAlgebra R B s.unop))) =
      Spec.map (CommRingCat.ofHom (algebraMap R B))
  rw [← Spec.map_comp]
  congr 1

instance finiteCoefficientSchemeDiagram_affine_transition
    {s t : (Finset B)ᵒᵖ} (f : s ⟶ t) :
    IsAffineHom ((finiteCoefficientSchemeDiagram R B).map f) := by
  change IsAffineHom (Spec.map _)
  infer_instance

end

end OAI.ArithmeticGeometry.Descent.CMVariety.FiniteCoefficientDiagram.Abelian
